From 46abaf0add3f4a45e23eb72d7107fadb5ea1e41b Mon Sep 17 00:00:00 2001
From: Gayathri S <quic_sgayathr@quicinc.com>
Date: Tue, 6 Dec 2022 17:41:15 +0530
Subject: [PATCH] OpenWRT : Add patch source Makefile of IPA driver

Add patch source Makefile of IPA driver

Signed-off-by: Gayathri S <quic_sgayathr@quicinc.com>
---
 drivers/platform/msm/Makefile | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/platform/msm/Makefile b/drivers/platform/msm/Makefile
index 4a6a225..4f67c22 100644
--- a/drivers/platform/msm/Makefile
+++ b/drivers/platform/msm/Makefile
@@ -3,7 +3,13 @@ KP_MODULE_ROOT=$(KERNEL_SRC)/$(M)
 endif

 KBUILD_OPTIONS+=KBUILD_DTC_INCLUDE=$(KP_MODULE_ROOT)
+KBUILD_OPTIONS += CONFIG_GSI=m
 KBUILD_OPTIONS += CONFIG_IPA3=m
+KBUILD_OPTIONS += CONFIG_IPA_CLIENTS_MANAGER=m
+KBUILD_OPTIONS += CONFIG_RNDIS_IPA=m
+KBUILD_OPTIONS += CONFIG_ECM_IPA=m
+KBUILD_OPTIONS += CONFIG_IPA_UT=m
+KBUILD_OPTIONS += CONFIG_IPA_KERNEL_TESTS_MODULE=m

 all: modules # dtbs

--
