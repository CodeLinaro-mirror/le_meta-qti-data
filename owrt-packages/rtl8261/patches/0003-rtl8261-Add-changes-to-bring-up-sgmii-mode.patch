From d4bee8a3d8b3e9f3fa7b54596dd9d4accf80e075 Mon Sep 17 00:00:00 2001
From: Veena Sri Vallala <vsri@qti.qualcomm.com>
Date: Mon, 21 Apr 2025 20:33:33 +0530
Subject: [PATCH 3/8] rtl8261: Add changes to bring-up sgmii mode

Add changes to bring-up sgmii mode on rtl8261.

Signed-off-by: Veena Sri Vallala <vsri@qti.qualcomm.com>
---
 linux-5.10.146/drivers/net/phy/rtk/rtk_phy.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/linux-5.10.146/drivers/net/phy/rtk/rtk_phy.c b/linux-5.10.146/drivers/net/phy/rtk/rtk_phy.c
index 80d37cb..0504b59 100644
--- a/linux-5.10.146/drivers/net/phy/rtk/rtk_phy.c
+++ b/linux-5.10.146/drivers/net/phy/rtk/rtk_phy.c
@@ -144,12 +144,18 @@ static void rtkphy_remove(struct phy_device *phydev)
 static int rtkphy_config_init(struct phy_device *phydev)
 {
     int ret = 0;
+
     switch (phydev->drv->phy_id)
     {
         case REALTEK_PHY_ID_RTL8261N:
         case REALTEK_PHY_ID_RTL8264B:
             phydev_info(phydev, "%s:%u [RTL8261N/RTL826XB] phy_id: 0x%X PHYAD:%d\n", __FUNCTION__, __LINE__, phydev->drv->phy_id, phydev->mdio.addr);
 
+	    if (phydev->interface == PHY_INTERFACE_MODE_USXGMII) {
+		    phydev_dbg(phydev, "%s:%u setting phy speed to 10G for usxgmii\n", __FUNCTION__, __LINE__);
+
+		    phy_set_max_speed(phydev, SPEED_10000);
+	    }
           #if 1 /* toggle reset */
             phy_write_mmd(phydev, 30, 0x145, 0x0001);
             phy_write_mmd(phydev, 30, 0x145, 0x0000);
@@ -186,6 +192,24 @@ static int rtkphy_config_init(struct phy_device *phydev)
                 return ret;
             }
 
+	    if (phydev->interface == PHY_INTERFACE_MODE_SGMII) {
+		    /* disabling serdes for usxgmii */
+		    rtk_phylib_826xb_sds_write(phydev, 7, 17, 0, 0, 0);
+
+		    phydev_dbg(phydev, "%s:%u setting phy speed to 1G for sgmii\n", __FUNCTION__, __LINE__);
+
+		    phy_set_max_speed(phydev, SPEED_1000);
+
+		    /* enabling  serdes  and putting into fore mode for sgmii */
+		    rtk_phylib_826xb_sds_write(phydev, 0, 2, 9, 9, 1);
+		    rtk_phylib_826xb_sds_write(phydev, 0, 2, 8, 8, 0);
+
+		    /* Register Access APIs */
+		    rtk_phylib_mmd_write(phydev, 30, 0x105, 0, 0, 0x1);
+		    rtk_phylib_mmd_write(phydev, 30, 0xc3, 4, 0, 0x2);
+		    rtk_phylib_mmd_write(phydev, 30, 0xc2, 9, 5, 0x0);
+		    rtk_phylib_mmd_write(phydev, 30, 0x2a2, 7, 7, 0x0);
+	    }
           #if 0 /* Debug: patch check */
             ret = phy_patch(0, phydev, 0, PHY_PATCH_MODE_CMP);
             if (ret)
-- 
