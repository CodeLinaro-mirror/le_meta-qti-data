# wpa_supplicant build time configuration.
# See https://w1.fi/cgit/hostap/tree/wpa_supplicant/defconfig?h=hostap_2_10
# for all the available options and their documentation.

CFLAGS += -Ofast -flto
LDFLAGS += -flto

CONFIG_LIBNL32=y

#CONFIG_DRIVER_WIRED=y
CONFIG_DRIVER_MACSEC_LINUX=y

CONFIG_EAP_PSK=y

CONFIG_MACSEC=y

CONFIG_CTRL_IFACE=y

#CONFIG_NO_WPA=y

CONFIG_BACKEND=file
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_CONFIG_BLOBS=y

CONFIG_DEBUG_FILE=y
CONFIG_DEBUG_SYSLOG=y
