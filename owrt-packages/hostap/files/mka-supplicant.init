# MKA-Supplicant start

USE_PROCD=1
PROCD_DEBUG=1

start_service() {
		procd_open_instance $1
		procd_set_param command /usr/sbin/mka_supplicant -D macsec_linux -i $1 -c /etc/mka_supplicant-$1.conf
		procd_close_instance
}
