[Unit]
SourcePath=/usr/bin/ipacm
Description= IPACM Service
Before= QCMAP_ConnectionManagerd.service
After= dataipa.service local-fs.target systemd-tmpfiles-setup.service
Requires= systemrw.mount
DefaultDependencies=no

[Service]
Restart=no
ExecStartPre=/bin/sleep 15
ExecStartPre=udevadm trigger --settle --subsystem-match=wwan_ioctl --subsystem-match=ipa --subsystem-match=ipaNatTable --subsystem-match=ipa_adpl --subsystem-match=ipa_odl_ctl --action=add
ExecStartPre=/bin/sh -c 'mkdir -p /tmp/data_ipa'
ExecStartPre=+chmod 660 /dev/ipaNatTable /dev/ipaIpv6CTTable
ExecStartPre=+chmod 666 /dev/wwan_ioctl /dev/ipa /dev/ipa_adpl /dev/ipa_odl_ctl
ExecStartPre=+chown -h radio.radio /dev/wwan_ioctl /dev/ipa /dev/ipaNatTable /dev/ipa_adpl /dev/ipa_odl_ctl /dev/ipaIpv6CTTable
ExecStartPre=+/sbin/mount-copybind /systemrw/data/ipa/ /etc/data/ipa/ /tmp/data_ipa
ExecStart=/usr/bin/ipacm
User=radio
Group=radio
SupplementaryGroups=diag inet
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=local-fs.target
