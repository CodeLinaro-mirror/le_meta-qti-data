[Unit]
SourcePath=/usr/bin/ipacm
Description= IPACM Service
Before= QCMAP_ConnectionManagerd.service
After= dataipa.service local-fs.target systemd-tmpfiles-setup.service
Requires= systemrw.mount
DefaultDependencies=no
Conflicts=shutdown.target

[Service]
Restart=on-failure
ExecStartPre=udevadm trigger --settle --subsystem-match=wwan_ioctl --subsystem-match=ipa --subsystem-match=ipaNatTable --action=add
ExecStartPre=+chmod 660 /dev/ipaNatTable /dev/ipaIpv6CTTable
ExecStartPre=+chmod 666 /dev/wwan_ioctl /dev/ipa
ExecStartPre=+chown -h radio.radio /dev/wwan_ioctl /dev/ipa /dev/ipaNatTable /dev/ipaIpv6CTTable
ExecStartPre=+/sbin/mount-copybind /systemrw/data/ipa/ /etc/data/ipa/
ExecStartPre=+/sbin/mount-copybind /systemrw/data/ipa_config.txt /etc/data/ipa_config.txt
ExecStart=/usr/bin/ipacm
ExecStopPost=/bin/sh -c 'rm /var/run/data/monitor/ipacmd.pid'
User=radio
Group=radio
SupplementaryGroups=diag inet
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=local-fs.target
