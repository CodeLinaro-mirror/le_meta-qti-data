[Unit]
SourcePath=/usr/bin/ipacm
Description= IPACM Service
Before= QCMAP_ConnectionManagerd.service CcspCrSsp.service
After= dataipa.service local-fs.target systemd-tmpfiles-setup.service
DefaultDependencies=no

[Service]
Restart=no
ExecStartPre=/bin/sleep 15
ExecStart=/usr/bin/ipacm

[Install]
WantedBy=local-fs.target