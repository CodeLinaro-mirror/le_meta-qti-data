[Unit]
SourcePath=/usr/sbin/pmip6d
Description= PMIPV6 service
DefaultDependencies=no

[Service]
Type=forking
EnvironmentFile=/var/run/data/pmip_options.conf
ExecStartPre=+chown radio.root /dev/socket/data/qcmap_pmip_file
ExecStartPre=+chmod 766 /dev/socket/data/qcmap_pmip_file
ExecStartPre=+chown radio.root /var/run/data/dnsmasq.pid
ExecStartPre=+chmod 766 /var/run/data/dnsmasq.pid
ExecStartPre=+chmod 775 /var/run/data/

ExecStart=/etc/initscripts/pmip6d_exec /var/run/data/pmip_options.conf
ExecStop=/bin/kill -15 $MAINPID

SupplementaryGroups=radio inet net_admin system netdev net_raw

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL
