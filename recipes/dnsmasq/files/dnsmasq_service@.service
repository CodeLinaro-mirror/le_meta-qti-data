[Unit]
SourcePath=/usr/bin/dnsmasq
Description= dnsmasq service
DefaultDependencies=no

[Service]
Restart=on-failure
ExecStart=/usr/bin/dnsmasq -k --conf-file=/var/run/data/dnsmasq.conf.bridge%i --user=radio --group=radio
ExecReload=killall -HUP dnsmasq
ExecStop=/etc/initscripts/qcmap_stop_dnsmasq.sh %i
Type=simple
KillMode=mixed
RemainAfterExit=yes
Nice=-20
