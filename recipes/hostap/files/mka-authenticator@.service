[Unit]
SourcePath=/usr/sbin/hostapd-2.10
Description=MACSEC Key Agreement Protocol (IEEE 802.1X) Authenticator
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
# Increase real interface MTU by 36B to accomodate MACSEC header+icv
# and VLAN header overhead
ExecStartPre=/sbin/ip link set mtu 1536 dev %i
ExecStart=/usr/sbin/hostapd-2.10 -i %i /etc/data/hostapd-%i.conf
ExecStopPost=/sbin/ip link set mtu 1500 dev %i

[Install]
WantedBy=multi-user.target

