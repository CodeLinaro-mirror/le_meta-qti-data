Date: Thu, 3 Aug 2017 12:06:06 +0530

---
 configure              | 4 ++--
 hooks/50-dhcpcd-compat | 6 +++---
 hooks/Makefile         | 1 +
 3 files changed, 6 insertions(+), 5 deletions(-)
 mode change 100755 => 100644 configure

diff --git a/configure b/configure
index 8843435..4018e7e 100755
--- a/configure
+++ b/configure
@@ -260,9 +260,9 @@ echo "/* $OS */" >$CONFIG_H
 : ${SBINDIR:=$PREFIX/sbin}
 : ${LIBDIR:=$PREFIX/lib}
 : ${LIBEXECDIR:=$PREFIX/libexec}
-: ${STATEDIR:=/var}
+: ${STATEDIR:=/var/run}
 : ${DBDIR:=$STATEDIR/db/dhcpcd}
-: ${RUNSTATEDIR:=$STATEDIR/run}
+: ${RUNSTATEDIR:=/var/run}
 : ${RUNDIR:=$RUNSTATEDIR/dhcpcd}
 : ${MANDIR:=${PREFIX:-/usr}/share/man}
 : ${DATADIR:=${PREFIX:-/usr}/share}
diff --git a/hooks/50-dhcpcd-compat b/hooks/50-dhcpcd-compat
index 0d6256e6..e15c8feb 100644
--- a/hooks/50-dhcpcd-compat
+++ b/hooks/50-dhcpcd-compat
@@ -30,12 +30,12 @@ BOUND|INFORM|REBIND|REBOOT|TEST|TIMEOUT|IPV4LL) r="new";;
 esac
 
 if [ "$r" != "down" ]; then
-	rm -f /var/lib/dhcpcd-"$INTERFACE".info
+	rm -f /var/run/dhcpcd-"$INTERFACE".info
 	for x in IPADDR INTERFACE NETMASK BROADCAST NETWORK DHCPSID GATEWAYS \
 		DNSSERVERS DNSDOMAIN DNSSEARCH NISDOMAIN NISSERVERS \
 		NTPSERVERS GATEWAY DNS; do
-		eval echo "$x=\'\$$x\'" >> /var/lib/dhcpcd-"$INTERFACE".info
+		eval echo "$x=\'\$$x\'" >> /var/run/dhcpcd-"$INTERFACE".info
 	done
 fi
 
-set -- /var/lib/dhcpcd-"$INTERFACE".info "$r"
+set -- /var/run/dhcpcd-"$INTERFACE".info "$r"
diff --git a/hooks/Makefile b/hooks/Makefile
index 7a0c3b1d..d081f0fd 100644
--- a/hooks/Makefile
+++ b/hooks/Makefile
@@ -11,6 +11,7 @@ SCRIPTSDIR=	${HOOKDIR}
 SCRIPTS=	01-test
 SCRIPTS+=	20-resolv.conf
 SCRIPTS+=	30-hostname
+SCRIPTS+=	50-dhcpcd-compat
 SCRIPTS+=	${HOOKSCRIPTS}
 CLEANFILES+=	30-hostname
 
