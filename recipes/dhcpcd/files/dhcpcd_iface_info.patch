From 5f1a3c7f1d4bd94bbb72d7aada3173c1f25a7ced Mon Sep 17 00:00:00 2001
From: Mohammed Javid <mjavid@codeaurora.org>
Date: Thu, 3 Aug 2017 12:06:06 +0530

---
 configure                     | 4 ++--
 dhcpcd-hooks/50-dhcpcd-compat | 6 +++---
 dhcpcd-hooks/Makefile         | 2 +-
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/configure b/configure
index 8843435..4018e7e 100755
--- a/configure
+++ b/configure
@@ -66,9 +66,9 @@ done
 : ${SBINDIR:=$PREFIX/sbin}
 : ${LIBDIR:=$PREFIX/lib}
 : ${LIBEXECDIR:=$PREFIX/libexec}
-: ${STATEDIR:=/var}
+: ${STATEDIR:=/var/run}
 : ${DBDIR:=$STATEDIR/db}
-: ${RUNDIR:=$STATEDIR/run}
+: ${RUNDIR:=/var/run}
 : ${MANDIR:=${PREFIX:-/usr}/share/man}
 
 eval SYSCONFDIR="$SYSCONFDIR"
diff --git a/dhcpcd-hooks/50-dhcpcd-compat b/dhcpcd-hooks/50-dhcpcd-compat
index 651bc08..e1ae4da 100644
--- a/dhcpcd-hooks/50-dhcpcd-compat
+++ b/dhcpcd-hooks/50-dhcpcd-compat
@@ -30,12 +30,12 @@ BOUND|INFORM|REBIND|REBOOT|TEST|TIMEOUT|IPV4LL) x="new";;
 esac
 
 if [ "$reason" != "down" ]; then
-	rm -f /var/lib/dhcpcd-"$INTERFACE".info
+	rm -f /var/run/dhcpcd-"$INTERFACE".info
 	for x in IPADDR INTERFACE NETMASK BROADCAST NETWORK DHCPSID GATEWAYS \
 		DNSSERVERS DNSDOMAIN DNSSEARCH NISDOMAIN NISSERVERS \
 		NTPSERVERS GATEWAY DNS; do
-		eval echo "$x=\'\$$x\'" >> /var/lib/dhcpcd-"$INTERFACE".info
+		eval echo "$x=\'\$$x\'" >> /var/run/dhcpcd-"$INTERFACE".info
 	done
 fi
 
-set -- /var/lib/dhcpcd-"$INTERFACE".info "$x"
+set -- /var/run/dhcpcd-"$INTERFACE".info "$x"
diff --git a/dhcpcd-hooks/Makefile b/dhcpcd-hooks/Makefile
index 7563d2d..685cb5a 100644
--- a/dhcpcd-hooks/Makefile
+++ b/dhcpcd-hooks/Makefile
@@ -4,7 +4,7 @@ include ${TOP}/config.mk
 
 SCRIPTSDIR=	${LIBEXECDIR}/dhcpcd-hooks
 SCRIPTS=	01-test 02-dump
-SCRIPTS+=	10-mtu 20-resolv.conf 29-lookup-hostname 30-hostname
+SCRIPTS+=	10-mtu 20-resolv.conf 29-lookup-hostname 30-hostname 50-dhcpcd-compat
 SCRIPTS+=	${HOOKSCRIPTS}
 
 all:
