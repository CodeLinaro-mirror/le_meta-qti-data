[Unit]
Description= Load dataipa dlkm
After=systemrw.mount
Requires= systemrw.mount
DefaultDependencies=no

[Service]
Restart=no
RemainAfterExit=yes
Type=oneshot
ExecStartPre=+/sbin/mount-copybind /systemrw/data/ipa_config.txt /etc/data/ipa_config.txt
ExecStart=/etc/initscripts/start_dataipa_le start
Nice=-20

[Install]
WantedBy=local-fs.target
