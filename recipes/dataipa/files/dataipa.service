[Unit]
Description= Load dataipa dlkm
After=systemrw.mount
Requires= systemrw.mount
DefaultDependencies=no

[Service]
Restart=no
RemainAfterExit=yes
Type=oneshot
ExecStart=/etc/initscripts/start_dataipa_le start
ExecStop=/etc/initscripts/start_dataipa_le stop
Nice=-20

[Install]
WantedBy=local-fs.target
