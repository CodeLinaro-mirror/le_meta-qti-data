[Unit]
Description= Load ecpri dlkm service

[Service]
Restart=on-failure
RemainAfterExit=yes
After=si5518_image_dload_util.service
# This service file has no binary and it is to execute the list of commands in <script>.
# Use Script file only when there is NO binary or commands to be executed/ modules to be installed cases.

ExecStart=/bin/sh /usr/bin/ecpri_install
ExecStop=/bin/sh /usr/bin/ecpri_uninstall

[Install]
WantedBy=multi-user.target
