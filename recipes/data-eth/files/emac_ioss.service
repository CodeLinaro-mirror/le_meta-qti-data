[Unit]
Description=EMAC_IOSS

[Service]
Restart=no
RemainAfterExit=yes
ExecStart=/bin/sh -c '/sbin/modprobe ioss qos_id=$(/usr/bin/id -g radio) && /sbin/modprobe iemac_ioss'
ExecStop=/sbin/rmmod iemac_ioss ioss

[Install]
WantedBy=multi-user.target
