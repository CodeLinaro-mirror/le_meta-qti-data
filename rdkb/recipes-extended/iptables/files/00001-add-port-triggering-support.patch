+/* Port-triggering target.
+ *
+ * Copyright (C) 2003, CyberTAN Corporation
+ * All Rights Reserved.
+ */
+
+/* Shared library add-on to iptables to add port-trigger support. */
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <getopt.h>
+#include <xtables.h>
+#include <linux/netfilter_ipv4/ip_tables.h>
+#include <linux/netfilter_ipv4/ipt_TRIGGER.h>
+
+#define IPT_TRIGGER_USED         (1) << 0
+#define IPT_TRIGGER_MATCH_USED   (1) << 1
+#define IPT_TRIGGER_RELATE_USED  (1) << 2
+#define IPT_TRIGGER_DNAT_USED    (1) << 3
+#define IPT_TRIGGER_IN_USED      (1) << 4
+#define IPT_TRIGGER_OUT_USED     (1) << 5
+#define IPT_TRIGGER_PROTO_USED   (1) << 6
+
+/* fill_mport - fill ipt_mport from a start/end port pair.
+ * Single port : pflags = 0, ports[0] = port
+ * Port range  : pflags = 1, ports[0] = start, ports[1] = end
+ */
+static void fill_mport(struct ipt_mport *mport,
+                       u_int16_t start, u_int16_t end)
+{
+        memset(mport, 0, sizeof(*mport));
+        mport->ports[0] = start;
+        if (end && end != start) {
+                mport->ports[1] = end;
+                mport->pflags   = 1; /* bit 0: ports[0] starts a range */
+        }
+}
+
+/* get_mport_range - read start/end port from ipt_mport */
+static void get_mport_range(const struct ipt_mport *mport,
+                            u_int16_t *start, u_int16_t *end)
+{
+        *start = mport->ports[0];
+        *end   = (mport->pflags & 1) ? mport->ports[1] : mport->ports[0];
+}
+
+static void parse_tcp_ports(const char *portstring, u_int16_t *ports)
+{
+        char *buffer;
+        char *cp;
+
+        buffer = strdup(portstring);
+        if ((cp = strchr(buffer, ':')) == NULL)
+                ports[0] = ports[1] = xtables_parse_port(buffer, "tcp");
+        else {
+                *cp = '\0';
+                cp++;
+                ports[0] = buffer[0] ? xtables_parse_port(buffer, "tcp") : 0;
+                ports[1] = cp[0]     ? xtables_parse_port(cp,     "tcp") : 0xFFFF;
+                if (ports[0] > ports[1])
+                        xtables_error(PARAMETER_PROBLEM,
+                                      "invalid portrange (min > max)");
+        }
+        free(buffer);
+}
+
+static void TRIGGER_help(void)
+{
+        printf(
+            "TRIGGER  options:\n"
+            " --trigger-type (dnat|in|out)\n"
+            "'\t\t Trigger type\n"
+            " --trigger-proto proto\n"
+            "\t\t Trigger protocol tcp|udp|all\n"
+            " --trigger-match port[-port]\n"
+            "\t\tTrigger destination port range\n"
+            " --trigger-relate port[-port]\n"
+            "\t\tPort range to map related destination port range to.\n\n"
+        );
+}
+
+static struct option TRIGGER_opts[] = {
+        { "trigger-type",   1, NULL, '1' },
+        { "trigger-proto",  1, NULL, '2' },
+        { "trigger-match",  1, NULL, '3' },
+        { "trigger-relate", 1, NULL, '4' },
+        { .name = NULL }
+};
+
+/* Parses ports */
+static int parse_ports(const char *arg, u_int16_t *ports)
+{
+        const char *dash;
+        int port;
+
+        ports[0] = 0;
+        ports[1] = 0;
+
+        dash = strchr(arg, ':');
+        if (dash == NULL) {
+                port = (u_int16_t)atoi(arg);
+                if (port == 0 || port > 65535) {
+                        xtables_error(PARAMETER_PROBLEM,
+                                      "Invalid Port %d\n", port);
+                        return -1;
+                }
+                ports[0] = port;
+                ports[1] = 0;
+        } else {
+                int portEnd;
+
+                port    = strtol(arg, NULL, 10);
+                portEnd = (u_int16_t)atoi(dash + 1);
+                if (portEnd == 0 || portEnd > 65535 || portEnd < port) {
+                        xtables_error(PARAMETER_PROBLEM,
+                                      "Port range %d:%d is invalid\n",
+                                      port, portEnd);
+                        return -1;
+                }
+                ports[0] = port;
+                ports[1] = portEnd;
+        }
+        return 1;
+}
+
+/* Function which parses command options; returns true if it
+	ate an option */
+
+static int
+TRIGGER_parse(int c, char **argv, int invert, unsigned int *flags,
+              const void *entry,
+              struct xt_entry_target **target)
+{
+        struct ipt_porttrigger_info *info =
+                (struct ipt_porttrigger_info *)(*target)->data;
+        u_int16_t ports[2];
+
+        if (info == NULL) {
+                xtables_error(PARAMETER_PROBLEM,
+                              "NULL parameter (*target)->data specified");
+                return 0;
+        }
+        if (optarg == NULL) {
+                xtables_error(PARAMETER_PROBLEM,
+                              "NULL parameter optarg specified");
+                return 0;
+        }
+
+        switch (c) {
+        case '1':
+                if (!strncasecmp(optarg, "dnat", 3)) {
+                        info->mode = MODE_TRIGGER_DNAT;
+                        *flags |= IPT_TRIGGER_DNAT_USED;
+                } else if (!strncasecmp(optarg, "in", 2)) {
+                        info->mode = MODE_TRIGGER_FORWARD_IN;
+                        *flags |= IPT_TRIGGER_IN_USED;
+                } else if (!strncasecmp(optarg, "out", 3)) {
+                        info->mode = MODE_TRIGGER_FORWARD_OUT;
+                        *flags |= IPT_TRIGGER_OUT_USED;
+                } else {
+                        xtables_error(PARAMETER_PROBLEM,
+                                      "unknown trigger type specified");
+                        return 0;
+                }
+                return 1;
+
+        case '2':
+                if (!strncasecmp(optarg, "tcp", 3)) {
+                        info->trigger_proto = IPPROTO_TCP;
+                        info->forward_proto = IPPROTO_TCP;
+                        *flags |= IPT_TRIGGER_PROTO_USED;
+                } else if (!strncasecmp(optarg, "udp", 3)) {
+                        info->trigger_proto = IPPROTO_UDP;
+                        info->forward_proto = IPPROTO_UDP;
+                        *flags |= IPT_TRIGGER_PROTO_USED;
+                } else if (!strncasecmp(optarg, "all", 3) ||
+                           !strncasecmp(optarg, "both", 4)) {
+                        info->trigger_proto = 0;
+                        info->forward_proto = 0;
+                        *flags |= IPT_TRIGGER_PROTO_USED;
+                } else {
+                        xtables_error(PARAMETER_PROBLEM,
+                                      "unknown protocol specified");
+                }
+                return 1;
+
+        case '3':
+                if (invert) {
+                        xtables_error(PARAMETER_PROBLEM,
+                              "Unexpected '!' after --trigger-match");
+                        return 0;
+                }
+                if (parse_ports(optarg, ports)) {
+                        fill_mport(&info->trigger_ports,
+                                   ports[0],
+                                   ports[1] ? ports[1] : ports[0]);
+                        *flags |= IPT_TRIGGER_MATCH_USED | IPT_TRIGGER_USED;
+                        return 1;
+                }
+                break;
+
+        case '4':
+                if (invert) {
+                        xtables_error(PARAMETER_PROBLEM,
+                              "Unexpected '!' after --trigger-relate");
+                }
+                if (parse_ports(optarg, ports)) {
+                        fill_mport(&info->forward_ports,
+                                   ports[0],
+                                   ports[1] ? ports[1] : ports[0]);
+                        *flags |= IPT_TRIGGER_RELATE_USED | IPT_TRIGGER_USED;
+                        return 1;
+                }
+                break;
+
+        default:
+                return 0;
+        }
+        return 0;
+}
+
+/* Prints out the targinfo. iptables -L  */
+static void TRIGGER_print(const void *ip,
+                          const struct xt_entry_target *target, int numeric)
+{
+        const struct ipt_porttrigger_info *info =
+                (const struct ipt_porttrigger_info *)target->data;
+        u_int16_t tstart, tend, fstart, fend;
+
+        printf(" TRIGGER ");
+
+        if (info->mode == MODE_TRIGGER_DNAT)
+                printf("type:dnat ");
+        else if (info->mode == MODE_TRIGGER_FORWARD_IN)
+                printf("type:in ");
+        else if (info->mode == MODE_TRIGGER_FORWARD_OUT)
+                printf("type:out ");
+
+        if (info->mode == MODE_TRIGGER_FORWARD_OUT) {
+                if (info->trigger_proto == IPPROTO_TCP)
+                        printf("tcp ");
+                else if (info->trigger_proto == IPPROTO_UDP)
+                        printf("udp ");
+                else
+                        printf("all ");
+
+                get_mport_range(&info->trigger_ports, &tstart, &tend);
+                printf("match:%hu", tstart);
+                if (tend > tstart)
+                        printf("-%hu", tend);
+                printf(" ");
+
+                get_mport_range(&info->forward_ports, &fstart, &fend);
+                printf("relate:%hu", fstart);
+                if (fend > fstart)
+                        printf("-%hu", fend);
+        }
+        printf(" ");
+}
+
+/*
+*
+* last chance for sanity check.
+* It's called when the user enter a new rule, right after arguments parsing is done.
+*
+*/
+static void TRIGGER_final_check(unsigned int flags)
+{
+        if (flags & IPT_TRIGGER_OUT_USED) {
+                if (!(flags & IPT_TRIGGER_RELATE_USED))
+                        xtables_error(PARAMETER_PROBLEM,
+                              "TRIGGER: You must specify trigger relate parameter");
+                if (!(flags & IPT_TRIGGER_MATCH_USED))
+                        xtables_error(PARAMETER_PROBLEM,
+                              "TRIGGER: You must specify trigger match parameter");
+                if (!(flags & IPT_TRIGGER_PROTO_USED))
+                        xtables_error(PARAMETER_PROBLEM,
+                              "TRIGGER: You must specify trigger protocols parameter");
+        }
+}
+
+/*
+* If we have a ruleset that we want to save, iptables provide the tool 'iptables-save' which dumps all your rules.
+* It obviously needs your extension's help to dump proper rules.
+* This is done by calling this function.
+*/
+static void TRIGGER_save(const void *ip,
+                         const struct xt_entry_target *target)
+{
+        const struct ipt_porttrigger_info *info =
+                (const struct ipt_porttrigger_info *)target->data;
+        u_int16_t tstart, tend, fstart, fend;
+
+        printf(" --trigger-proto ");
+        if (info->trigger_proto == IPPROTO_TCP)
+                printf("tcp ");
+        else if (info->trigger_proto == IPPROTO_UDP)
+                printf("udp ");
+        else
+                printf("all ");
+
+        get_mport_range(&info->trigger_ports, &tstart, &tend);
+        printf(" --trigger-match %hu", tstart);
+        if (tend > tstart)
+                printf("-%hu", tend);
+        printf(" ");
+
+        get_mport_range(&info->forward_ports, &fstart, &fend);
+        printf(" --trigger-relate %hu", fstart);
+        if (fend > fstart)
+                printf("-%hu", fend);
+        printf(" ");
+}
+
+static struct xtables_target trigger_tg_reg = {
+        .name          = "TRIGGER",
+        .version       = XTABLES_VERSION,
+        .family        = NFPROTO_IPV4,
+        .size          = XT_ALIGN(sizeof(struct ipt_porttrigger_info)),
+        .userspacesize = XT_ALIGN(sizeof(struct ipt_porttrigger_info)),
+        .help          = TRIGGER_help,
+        .parse         = TRIGGER_parse,
+        .final_check   = TRIGGER_final_check,
+        .print         = TRIGGER_print,
+        .save          = TRIGGER_save,
+        .extra_opts    = TRIGGER_opts,
+};
+
+/*
+*
+*  This function is called when the module is loaded by iptables.
+*   man dlopen.
+*/
+void _init(void)
+{
+        xtables_register_target(&trigger_tg_reg);
+}
