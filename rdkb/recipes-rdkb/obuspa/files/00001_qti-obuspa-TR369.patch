From: Nandakishore S <nans@qti.qualcomm.com>
Date: Sat, 26 Sep 2026 04:30:17 +0000
Subject: [PATCH] new-obuspa

Signed-off-by: Nandakishore S <nans@qti.qualcomm.com>
---
 src/core/nu_macaddr.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/src/core/nu_macaddr.c b/src/core/nu_macaddr.c
index 1286252..7482b73 100644
--- a/src/core/nu_macaddr.c
+++ b/src/core/nu_macaddr.c
@@ -91,7 +91,25 @@ char *nu_macaddr_wan_ifname(void)
     {
         return e;
     }
-
+    
+#ifdef _PLATFORM_SDX_
+    char *cmd="sysevent get current_wan_ifname";
+    static char wan_interface_name[32]={0};
+    FILE *fp;
+    fp = popen(cmd,"r");
+    if ( NULL == fp) {
+        USP_ERR_SetMessage("%s: Failed to run command (errno=%d, %m)", __FUNCTION__, errno);
+    }
+    else{
+      fscanf(fp, "%s", wan_interface_name);
+      if ( -1 == pclose(fp) )
+       {
+          USP_ERR_SetMessage("%s: Failed to close pipe (errno=%d, %m)", __FUNCTION__, errno);
+       }
+
+       return wan_interface_name;
+    }
+#endif
     return DEFAULT_WAN_IFNAME;
 }
 
