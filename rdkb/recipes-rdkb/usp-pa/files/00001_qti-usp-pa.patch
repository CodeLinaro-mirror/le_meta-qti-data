         USP_ERR_SetMessage("%s: rbus_open() failed (%d - %s)", __FUNCTION__, rbus_err, ToRbusErrString(rbus_err));
         return USP_ERR_INTERNAL_ERROR;
     }
-
+    
+    WaitForCurrentWanStateUp();
     // Override data model paths from environment variable
     usp_pa_dm_dir = getenv("USP_PA_DM_DIR");
     if (usp_pa_dm_dir == NULL)
@@ -501,6 +529,41 @@ int VENDOR_Init(void)
     return USP_ERR_OK;
 }
 
+static void WaitForCurrentWanStateUp(void)
+{
+    token_t se_token;
+    int se_fd = -1;
+    static char wan_status[MAX_SYSEVENT_SIZE] = "down";
+    int err = -1;
+
+    USP_ERR_SetMessage("%s: Checking WAN Status ---\n", __FUNCTION__);
+
+    while (strcmp(wan_status, "up") != 0) {
+        if ((se_fd = s_sysevent_connect(&se_token)) >= 0)
+        {
+            err = sysevent_get(se_fd, se_token, "current_wan_state", wan_status, MAX_SYSEVENT_SIZE);
+
+            if (err != 0)
+                USP_ERR_SetMessage("%s: Error retrieving WAN state: --- %d\n", __FUNCTION__, err);
+        }
+        else
+        {
+            USP_ERR_SetMessage("%s: Error connecting to sysevent ---\n", __FUNCTION__);
+        }
+
+        if (strcmp(wan_status, "up") != 0)
+        {
+            sleep(SLEEP_DURATION_SEC);
+        }
+    }
+
+    USP_ERR_SetMessage("%s: WAN status is UP ---\n", __FUNCTION__);
+
+    if (se_fd >= 0)
+    {
+        sysevent_close(se_fd, se_token);
+    }
+}
