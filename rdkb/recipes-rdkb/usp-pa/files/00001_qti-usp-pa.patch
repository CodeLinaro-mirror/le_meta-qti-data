 ** VENDOR_Start
@@ -1483,7 +1546,7 @@ int RDK_RefreshInstances(int group_id, char *path, int *expiry_period)
         len = strlen(name);
 
         // If this is an object instance, then refresh it in the data model
-        if ((len >= 2) && (name[len-1] == '.') && (IS_NUMERIC(name[len-2])))
+        if(IsValidObject(name, len))
         {
             if (USP_DM_IsRegistered(name))
             {
@@ -1988,3 +2051,21 @@ exit:
     fclose(fp);
     return err;
 }
+
+static bool IsValidObject(char *pName, int len)
+{
+    bool isValidObj = false;
+    int i = len-2;
+
+    if((pName == NULL) || (len < 2) || (pName[len-1] != '.'))
+        return false;
+
+    while(i >= 0 && IS_NUMERIC(pName[i]))
+        i--;
+
+    if(i >= 0 && pName[i] == '.')
+        isValidObj = true;
+
+    return isValidObj;
+}
