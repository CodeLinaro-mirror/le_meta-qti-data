+++ b/vendor.c
@@ -70,6 +70,31 @@
 #include "text_utils.h"
 #include "os_utils.h"
 
+#include <sysevent/sysevent.h>
+//-------------------------------------------------------------------------------------------------
+//Max Size for Sysevent current_wan_status
+#define MAX_SYSEVENT_SIZE 16
+#define SLEEP_DURATION_SEC 5
+#define SYSEVENT_SERVER_IP "127.0.0.1"
+#define SYSEVENT_CLIENT_NAME "usp-pa"
+//-------------------------------------------------------------------------------------------------
+//Sysevent utility to handle sysevent connection
+static int s_sysevent_connect (token_t *out_se_token)
+{
+    static int     sysevent_fd = -1;
+    static token_t sysevent_token = 0;
+
+    if (0 > sysevent_fd) {
+        unsigned short sysevent_port = SE_SERVER_WELL_KNOWN_PORT;
+        char          *sysevent_ip = SYSEVENT_SERVER_IP;
+        char          *sysevent_name = SYSEVENT_CLIENT_NAME;
+ 
+        sysevent_fd =  sysevent_open(sysevent_ip, sysevent_port, SE_VERSION, sysevent_name, &sysevent_token);
+
+    }
+    *out_se_token = sysevent_token;
+    return sysevent_fd;
+}
