From 3f72b1a4c9e0d85f2a6c318b94e7051d6cba2f47 Mon Sep 17 00:00:00 2001
From: Nandakishore S <nans@qti.qualcomm.com>
Date: Fri, 26 Sep 2026 06:46:00 +0000
Subject: usp-pa.service: add RdkWanManager dependency and switch to UspPa binary

Signed-off-by: Nandakishore S <nans@qti.qualcomm.com>
---
 usp-pa.service | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

Index: 1.0+gitAUTOINC+6a7dec9995-r0/usp-pa.service
===================================================================
--- a/usp-pa.service
+++ b/usp-pa.service
@@ -1,12 +1,10 @@
 [Unit]
 Description=USP Agent
-After=syslog.target network.target
+After=syslog.target network.target RdkWanManager.service
 
 
 [Service]
-ExecStartPre=/bin/sh -c 'while [ "`sysevent get current_wan_state`" != "up" ] ; do   sleep 1; done'
-ExecStart=/usr/bin/obuspa --plugin /usr/libexec/usp-pa-vendor-rdk.so -v1 --resetfile /etc/usp-pa/usp_factory_reset.conf --truststore /etc/usp-pa/usp_truststore.pem --interface erouter0 --log syslog --dbfile /nvram/usp-pa.db
-
+ExecStart=/usr/bin/UspPa -v1 --resetfile /etc/usp-pa/usp_factory_reset.conf --truststore /etc/usp-pa/usp_truststore.pem --log /rdklogs/logs/TR369_log.txt --dbfile /nvram/usp-pa.db
 
 RestartSec=30
 Restart=always
