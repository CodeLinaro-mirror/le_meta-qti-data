+
+static void forward_router_advertisement(const struct interface *iface, uint8_t *data, size_t len)
+{
+    if (!iface || !data)
+    {
+        do_log(LOG_ERR, "Invalid input : iface or data is NULL");
+        return;
+    }
+    // Check if packet is large enough to contain router advertisement header
+    if (len < sizeof(struct nd_router_advert))
+    {
+        do_log(LOG_ERR, "Packet too small for router advertisement: %zu bytes", len);
+        return;
+    }
+    struct nd_router_advert *adv = (struct nd_router_advert *)data;
+    struct sockaddr_in6 all_nodes;
+    struct icmpv6_opt *opt;
+    struct interface *c;
+    struct iovec iov = { .iov_base = data, .iov_len = len };
+    /* Rewrite options */
+    uint8_t *end = data + len;
+    uint8_t *mac_ptr = NULL;
+    struct in6_addr *dns_ptr = NULL;
+    size_t dns_count = 0;
+
+    icmpv6_for_each_option(opt, &adv[1], end) {
+        if (opt->type == ND_OPT_SOURCE_LINKADDR) {
+            /* Store address of source MAC-address */
+            mac_ptr = opt->data;
+        }
+        else if (opt->type == ND_OPT_RECURSIVE_DNS && opt->len > 1) {
+            /* Check if we have to rewrite DNS */
+            dns_ptr = (struct in6_addr*)&opt->data[6];
+            dns_count = (opt->len - 1) / 2;
+        }
+    }
+
+    do_log(LOG_NOTICE, "Got a RA on %s", iface->ifname);
+    /* Indicate a proxy, however we don't follow the rest of RFC 4389 yet */
+    adv->nd_ra_flags_reserved |= ND_RA_FLAG_PROXY;
+    /* Forward advertisement to all slave interfaces */
+    memset(&all_nodes, 0, sizeof(all_nodes));
+    all_nodes.sin6_family = AF_INET6;
+    inet_pton(AF_INET6, ALL_IPV6_NODES, &all_nodes.sin6_addr);
+
+    for (int i = 0; i < config.cnt; ++i) {
+        struct interface *c = interfaces + i;
+        if (c->ra != MODE_RELAY || c->master)
+            continue;
+        /* Fixup source hardware address option */
+        if (mac_ptr)
+            odhcpd_get_mac(c, mac_ptr);
+
+        /* If we have to rewrite DNS entries */
+        if (c->always_rewrite_dns && dns_ptr && dns_count > 0) {
+            const struct in6_addr *rewrite = c->dns;
+            struct in6_addr addr;
+            size_t rewrite_cnt = c->dns_cnt;
+
+            if (rewrite_cnt == 0) {
+                rewrite = &addr;
+                rewrite_cnt = 1;
+            }
+            /* Copy over any other addresses */
+            for (size_t i = 0; i < dns_count; ++i) {
+                size_t j = (i < rewrite_cnt) ? i : rewrite_cnt - 1;
+                dns_ptr[i] = rewrite[j];
+            }
+        }
+        do_log(LOG_NOTICE, "Forward a RA on %s", c->ifname);
+        odhcpd_send(c->router_event.uloop.fd, &all_nodes, &iov, 1, c);
+    }
+}
+
+static void forward_router_solicitation(const struct interface *iface)
+{
+    struct icmp6_hdr rs = {ND_ROUTER_SOLICIT, 0, 0, {{0}}};
+    struct iovec iov = {&rs, sizeof(rs)};
+    struct sockaddr_in6 all_routers;
+
+    if (!iface)
+        return;
+    memset(&all_routers, 0, sizeof(all_routers));
+    all_routers.sin6_family = AF_INET6;
+    inet_pton(AF_INET6, ALL_IPV6_ROUTERS, &all_routers.sin6_addr);
+    all_routers.sin6_scope_id = iface->ifindex;
+    do_log(LOG_NOTICE, "Sending RS to %s", iface->ifname);
+    odhcpd_send(iface->router_event.uloop.fd, &all_routers, &iov, 1, iface);
+}
+
+static void handle_icmpv6(void *addr, void *data, size_t len,struct interface *iface, _unused void *dest)
+{
+    if (!addr || !iface || !data)
+    {
+        do_log(LOG_ERR, "Invalid input :addr or iface or data is NULL");
+        return;
+    }
+    // Check if packet is large enough to contain ICMPv6 header
+    if (len < sizeof(struct icmp6_hdr))
+    {
+        do_log(LOG_ERR, "Packet too small for ICMPv6 header: %zu bytes", len);
+        return;
+    }
+    struct icmp6_hdr *hdr = data;
+    struct sockaddr_in6 *from = addr;
+    if (iface->ra == MODE_RELAY) { /* Relay mode */
+        if (hdr->icmp6_type == ND_ROUTER_SOLICIT && !iface->master) {
+            for (int i = 0; i < config.cnt; ++i) {
+                struct interface *c = interfaces + i;
+                if (!c->master || c->ra != MODE_RELAY)
+                    continue;
+                forward_router_solicitation(c);
+            }
+        }
+        else if (hdr->icmp6_type == ND_ROUTER_ADVERT && (iface->master || iface->sta_bridge_mode))
+        {
+            forward_router_advertisement(iface, data, len);
+        }
+    }
+}
+
+int router_setup_interface(struct interface *iface, bool enable)
+{
+        if (!iface)
+        {
+            do_log(LOG_ERR, "Invalid input : iface is NULL");
+            return -1;
+        }
+        int ret = 0;
+        if (strstr(iface->ifname,"eth1")!=NULL)
+        {
+            iface->master=true;
+        }
+
+        if (!enable && iface->router_event.uloop.fd >= 0) {
+            uloop_fd_delete(&iface->router_event.uloop);
+            close(iface->router_event.uloop.fd);
+            iface->router_event.uloop.fd = -1;
+        }
+        else if (enable) {
+            struct icmp6_filter filt;
+            struct ipv6_mreq mreq;
+            int val = 2;
+            /* Open ICMPv6 socket */
+            iface->router_event.uloop.fd = socket(AF_INET6, SOCK_RAW | SOCK_CLOEXEC,IPPROTO_ICMPV6);
+            if (iface->router_event.uloop.fd < 0) {
+                do_log(LOG_ERR, "socket(AF_INET6): %m");
+                ret = -1;
+                goto out;
+            }
+            if (setsockopt(iface->router_event.uloop.fd, SOL_SOCKET, SO_BINDTODEVICE,iface->ifname, strlen(iface->ifname)) < 0) {
+                do_log(LOG_ERR, "setsockopt(SO_BINDTODEVICE): %m");
+                ret = -1;
+                goto out;
+            }
+            /* Let the kernel compute our checksums */
+            if (setsockopt(iface->router_event.uloop.fd, IPPROTO_RAW, IPV6_CHECKSUM,&val, sizeof(val)) < 0) {
+                do_log(LOG_ERR, "setsockopt(IPV6_CHECKSUM): %m");
+                ret = -1;
+                goto out;
+            }
+            /* This is required by RFC 4861 */
+            val = 255;
+            if (setsockopt(iface->router_event.uloop.fd, IPPROTO_IPV6, IPV6_MULTICAST_HOPS,&val, sizeof(val)) < 0) {
+                do_log(LOG_ERR, "setsockopt(IPV6_MULTICAST_HOPS): %m");
+                ret = -1;
+                goto out;
+            }
+            if (setsockopt(iface->router_event.uloop.fd, IPPROTO_IPV6, IPV6_UNICAST_HOPS,&val, sizeof(val)) < 0) {
+                do_log(LOG_ERR, "setsockopt(IPV6_UNICAST_HOPS): %m");
+                ret = -1;
+                goto out;
+            }
+            /* We need to know the source interface */
+            val = 1;
+            if (setsockopt(iface->router_event.uloop.fd, IPPROTO_IPV6, IPV6_RECVPKTINFO,&val, sizeof(val)) < 0) {
+                do_log(LOG_ERR, "setsockopt(IPV6_RECVPKTINFO): %m");
+                ret = -1;
+                goto out;
+            }
+            if (setsockopt(iface->router_event.uloop.fd, IPPROTO_IPV6, IPV6_RECVHOPLIMIT,&val, sizeof(val)) < 0) {
+                do_log(LOG_ERR, "setsockopt(IPV6_RECVHOPLIMIT): %m");
+                ret = -1;
+                goto out;
+            }
+            /* Don't loop back */
+            val = 0;
+            if (setsockopt(iface->router_event.uloop.fd, IPPROTO_IPV6, IPV6_MULTICAST_LOOP,&val, sizeof(val)) < 0) {
+                do_log(LOG_ERR, "setsockopt(IPV6_MULTICAST_LOOP): %m");
+                ret = -1;
+                goto out;
+            }
+            /* Filter ICMPv6 package types */
+            ICMP6_FILTER_SETBLOCKALL(&filt);
+            ICMP6_FILTER_SETPASS(ND_ROUTER_ADVERT, &filt);
+            ICMP6_FILTER_SETPASS(ND_ROUTER_SOLICIT, &filt);
+            if (setsockopt(iface->router_event.uloop.fd, IPPROTO_ICMPV6, ICMP6_FILTER,&filt, sizeof(filt)) < 0) {
+                do_log(LOG_ERR, "setsockopt(ICMP6_FILTER): %m");
+                ret = -1;
+                goto out;
+            }
+            iface->router_event.handle_dgram = handle_icmpv6;
+            iface->ra_sent = 0;
+            do_log(LOG_ERR, "odhcpd_register for iface %s", iface->ifname);
+            odhcpd_register(&iface->router_event);
+            memset(&mreq, 0, sizeof(mreq));
+            mreq.ipv6mr_interface = iface->ifindex;
+            inet_pton(AF_INET6, ALL_IPV6_ROUTERS, &mreq.ipv6mr_multiaddr);
+            if (iface->ra == MODE_RELAY && iface->master) {
+                inet_pton(AF_INET6, ALL_IPV6_NODES, &mreq.ipv6mr_multiaddr);
+                forward_router_solicitation(iface);
+            }
+            if (setsockopt(iface->router_event.uloop.fd, IPPROTO_IPV6,IPV6_ADD_MEMBERSHIP, &mreq, sizeof(mreq)) < 0) {
+                ret = -1;
+                do_log(LOG_ERR, "setsockopt(IPV6_ADD_MEMBERSHIP): %m");
+                goto out;
+            }
+        }
+  out:
+        if (ret < 0 && iface->router_event.uloop.fd >= 0) {
+            if (iface->router_event.uloop.registered)
+                uloop_fd_delete(&iface->router_event.uloop);
+            close(iface->router_event.uloop.fd);
+            iface->router_event.uloop.fd = -1;
+        }
+        return ret;
+}
