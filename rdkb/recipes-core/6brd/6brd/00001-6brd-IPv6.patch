+static void forward_dad_packet(struct interface *iface,
+        struct sockaddr_ll *ll, struct ip6_hdr *ip6,
+        uint8_t *data_buf, uint64_t data_buf_length)
+{
+    char ipbuffer[INET6_ADDRSTRLEN];
+
+    /* NULL checks */
+    if (iface == NULL || ll == NULL || ip6 == NULL || (data_buf_length == 0 || data_buf == NULL)) {
+        return;
+    }
+
+    /** NOTE: Indicates NS packet received is DAD */
+    do_log(LOG_DEBUG, "6brd-NS-DAD packet found");
+
+    /** NOTE: Indicates dad packets needs to be forwarded to rmnet_dataX interface */
+    /* Additional check to confirm destination iface has ndp parameter set to relay mode
+    and iface is set as master(Ideal Configurations of rmnet_dataX interface) */
+
+    /* Check if packet is of type AF_PACKET */
+    if (ll->sll_family != AF_PACKET)
+        return;
+
+    /** Construct the message */
+    /* Use the existing ip6_hdr structure to populate the destination address */
+    struct sockaddr_in6 destn = { .sin6_family = AF_INET6, .sin6_addr = ip6->ip6_dst, .sin6_scope_id = iface->ifindex };
+
+    /** NOTE: Total bytes to copy from the received raw message is the sum of IPv6 header length and ICMPv6 header length.
+     *  As per spec: IPv6 header length is 40 bytes. And IPv6 header contains a Payload length field indicating ICMPv6 header length
+     *  plus optional parameters */
+    uint16_t total_bytes_to_copy = 40 + (uint16_t)ntohs(ip6->ip6_ctlun.ip6_un1.ip6_un1_plen);
+    do_log(LOG_DEBUG, "6brd-Total bytes to copy from the received raw message: %d",total_bytes_to_copy);
+
+    uint8_t data_buf_copied[total_bytes_to_copy];
+    for (int i = 0; i < total_bytes_to_copy; i++) {
+        data_buf_copied[i] = data_buf[i];
+    }
+
+    /* Construct iovector */
+    struct iovec iov3 = { data_buf_copied, sizeof(data_buf_copied) };
+
+    struct msghdr msg1 = {
+        .msg_name = (void *) &destn,
+        .msg_namelen = sizeof(destn),
+        .msg_iov = &iov3,
+        .msg_iovlen = 1
+    };
+
+    inet_ntop(AF_INET6, &ip6->ip6_dst, ipbuffer, sizeof(ipbuffer));
+
+    ssize_t sent = sendmsg(iface->ndp_fd, &msg1, MSG_DONTWAIT);
+    if (sent < 0)
+        do_log(LOG_ERR, "6brd-Failed to send to %s%%%s@%s (%m); errno: %d",
+                ipbuffer, iface->name, iface->ifname, errno);
+    else
+        do_log(LOG_DEBUG, "6brd-Sent %zd bytes to %s%%%s@%s",
+                sent, ipbuffer, iface->name, iface->ifname);
+
+} /* End odhcpd_process_dad_packet() */
