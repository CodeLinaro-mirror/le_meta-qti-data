+static inline void __node_add(struct list_head *new,
+                              struct list_head *prev,
+                              struct list_head *next)
+{
+        next->prev = new;
+        new->next = next;
+        new->prev = prev;
+        prev->next = new;
+}
+
+static inline void node_add(struct list_head *new, struct list_head *head)
+{
+        __node_add(new, head, head->next);
