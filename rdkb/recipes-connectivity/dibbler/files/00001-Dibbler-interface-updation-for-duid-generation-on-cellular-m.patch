From: Saravanan B <saravb@qti.qualcomm.com>
Date: Thu, 21 Aug 2026 00:00:00 +0000
Subject: [PATCH] Fix DUID generation to not depend on client.conf

[Description]:
Remove the client.conf parsing logic from setDUID() which created an
incorrect cross-dependency between dibbler-server and client config.
Replace with a proper scan of all interfaces via IfaceMgr, remove the
flagUp() requirement (MAC is a hardware property independent of link
state), and add a retry loop with redetectIfaces() to handle the startup
race condition where interfaces are not yet detected.

Signed-off-by: Saravanan B <saravb@qti.qualcomm.com>
---
--- a/CfgMgr/CfgMgr.cpp
+++ b/CfgMgr/CfgMgr.cpp
@@ -10,6 +10,7 @@
 
 #include <sys/types.h>
 #include <string.h>
+#include <unistd.h>
 #include <iostream>
 #include <fstream>
 #include <string>
@@ -182,45 +183,27 @@
     SPtr<TIfaceIface> realIface;
 
     bool found=false;
-    const char *INTRFACE_SEARCH_STRING="iface";
-    FILE *dibblerClientConfPtr = NULL ;
-    char *line = NULL;
-    size_t len = 0;
-    char *interfaceName = NULL;
-    dibblerClientConfPtr = fopen( DEFAULT_CLNTCONF_FILE , "r");
-    if ( NULL == dibblerClientConfPtr ) {
-        Log(Info) << "Unable to open client config file  " << DEFAULT_CLNTCONF_FILE  << LogEnd;
-    } else {
-       while (getline(&line, &len, dibblerClientConfPtr) != -1) {
-           char *lineWithInterface = NULL ;
-           if ((lineWithInterface = strstr(line,INTRFACE_SEARCH_STRING))) {
-               char *tempConfigValue;
-               strtok_r(lineWithInterface, " ", &tempConfigValue);
-               interfaceName = strtok_r(NULL, " ", &tempConfigValue);
-               break ;
-           }
-       }
-       fclose(dibblerClientConfPtr);
-    }
 
-    if ( NULL != interfaceName ) {
-        ifaceMgr.getIfaceByName(interfaceName);
-    } else {
+    const int DUID_IFACE_DETECT_RETRIES = 5;
+    for (int attempt = 0; !found && attempt < DUID_IFACE_DETECT_RETRIES; attempt++) {
+        if (attempt > 0) {
+            Log(Notice) << "DUID creation: no suitable interface found yet, retrying in 1s "
+                        << "(attempt " << attempt+1 << "/" << DUID_IFACE_DETECT_RETRIES
+                        << ")." << LogEnd;
+            sleep(1);
+            ifaceMgr.redetectIfaces();
+        }
         ifaceMgr.firstIface();
-    }
     if (this->DUIDType == DUID_TYPE_EN) {
-        if ( NULL != interfaceName ) {
-            realIface = ifaceMgr.getIfaceByName(interfaceName);
-        } else {
-            realIface = ifaceMgr.getIface(); // use the first interface. It will be ignored anyway
-        }
-       found = true;
+        realIface = ifaceMgr.getIface(); // use the first interface. It will be ignored anyway
+        found = true;
+
         if (!realIface) {
             Log(Error) << "Unable to find any interfaces. Can't generate DUID" << LogEnd;
             return false;
         }
     }
-    while( (!found) && (realIface = ifaceMgr.getIfaceByName(interfaceName)) )
+    while( (!found) && (realIface=ifaceMgr.getIface()) )
     {
         realIface->firstLLAddress();
         char buf[64];
@@ -247,14 +230,10 @@
                      << " skipped: MAC is all zero. " << LogEnd;
           continue;
         }
-        if ( !realIface->flagUp() ) {
-          Log(Debug) << "DUID creation: Interface " << realIface->getFullName()
-                     << " skipped: Interface is down." << LogEnd;
-          continue;
-        }
 
         found=true;
     }
+    } // end retry loop
 
     if(found) {
         if ( this->generateDUID(filename, realIface->getMac(),
@@ -271,7 +250,7 @@
         }
     }
 
-    Log(Crit) << "Cannot generate DUID, because there is no up and running interface with "
+    Log(Crit) << "Cannot generate DUID, because there is no interface with "
                  << "MAC address at least 6 bytes long." << LogEnd;
     this->DUID=new TDUID();
     return false;
--- a/IfaceMgr/IfaceMgr.h
+++ b/IfaceMgr/IfaceMgr.h
@@ -51,6 +51,8 @@
 
     virtual void closeSockets();
 
+    virtual void redetectIfaces() {}
+
     virtual ~TIfaceMgr();
 
  protected:
