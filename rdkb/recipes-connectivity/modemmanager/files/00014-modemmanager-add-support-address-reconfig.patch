+                                 MMBearerIpConfig *ipv4_config,
+                                 MMBearerIpConfig *ipv6_config)
+{
+    /*
+     * Set the new IP config properties.
+     * The org.freedesktop.DBus.Properties.PropertiesChanged signal is emitted
+     * automatically by the GDBus library when these properties are changed.
+     */
+    if (ipv4_config)
+    {
+        GVariant* ipv4_dict = mm_bearer_ip_config_get_dictionary (ipv4_config);
+        mm_obj_dbg (self, "mm_base_bearer_update_ip_config: get ipv4_dict: %x", ipv4_dict);
+        mm_gdbus_bearer_set_ip4_config (
+            MM_GDBUS_BEARER (self),
+            ipv4_dict);
+    }
+    if (ipv6_config)
+    {
+        GVariant* ipv6_dict = mm_bearer_ip_config_get_dictionary (ipv6_config);
+        mm_obj_dbg (self, "mm_base_bearer_update_ip_config: get ipv6_dict: %x", ipv6_dict);
+        mm_gdbus_bearer_set_ip6_config (
+            MM_GDBUS_BEARER (self),
+            ipv6_dict);
+    }
