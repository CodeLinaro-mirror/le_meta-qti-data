+static gboolean
+dns_arrays_equal (const gchar **dns1, const gchar **dns2)
+{
+    guint i;
+
+    if (!dns1 && !dns2)
+        return TRUE;
+    if (!dns1 || !dns2)
+        return FALSE;
+
+    for (i = 0; dns1[i] && dns2[i]; i++) {
+        if (g_strcmp0 (dns1[i], dns2[i]) != 0)
+            return FALSE;
+    }
+
+    /* Check if both arrays have the same length */
+    return (dns1[i] == NULL && dns2[i] == NULL);
+}
+
+static gboolean
+compare_ip_configs (MMBearerIpConfig *config1, MMBearerIpConfig *config2)
+{
+    const gchar *addr1, *addr2;
+    const gchar **dns1, **dns2;
+    guint prefix1, prefix2;
+    guint mtu1, mtu2;
+
+    if (!config1 && !config2)
+        return FALSE;
+    if (!config1 || !config2)
+        return TRUE;
+
+    /* Compare IP addresses */
+    addr1 = mm_bearer_ip_config_get_address (config1);
+    addr2 = mm_bearer_ip_config_get_address (config2);
+    if (g_strcmp0 (addr1, addr2) != 0)
+        return TRUE;
+
+    /* Compare prefixes */
+    prefix1 = mm_bearer_ip_config_get_prefix (config1);
+    prefix2 = mm_bearer_ip_config_get_prefix (config2);
+    if (prefix1 != prefix2)
+        return TRUE;
+
+    /* Compare DNS servers */
+    dns1 = mm_bearer_ip_config_get_dns (config1);
+    dns2 = mm_bearer_ip_config_get_dns (config2);
+    if (!dns_arrays_equal (dns1, dns2))
+        return TRUE;
+
+    /* Compare MTU */
+    mtu1 = mm_bearer_ip_config_get_mtu (config1);
+    mtu2 = mm_bearer_ip_config_get_mtu (config2);
+    if (mtu1 != mtu2)
+        return TRUE;
+
+    return FALSE; /* No changes detected */
+}
+
+static void
+get_current_settings_for_reconfiguration_ready (QmiClientWds *client,
+                                              GAsyncResult *res,
+                                              GTask        *task)
+{
+    ReconfigurationContext *ctx;
+    MMBearerQmi           *self;
+    GError                *error = NULL;
+    QmiMessageWdsGetCurrentSettingsOutput *output;
+    MMBearerIpConfig      *new_config = NULL;
+    MMBearerIpConfig      *current_config = NULL;
+    guint32 mtu = 0;
+
+    ctx = g_task_get_task_data (task);
+    self = ctx->self;
+
+    output = qmi_client_wds_get_current_settings_finish (client, res, &error);
+    if (!output || !qmi_message_wds_get_current_settings_output_get_result (output, &error)) {
+        mm_obj_warn (self, "failed to get current settings for reconfiguration: %s",
+                   error->message);
+        g_task_return_error (task, error);
+        if (output)
+            qmi_message_wds_get_current_settings_output_unref (output);
+        return;
+    }
+
+    if (!qmi_message_wds_get_current_settings_output_get_mtu (output, &mtu, &error)) {
+        mm_obj_dbg (self, "       MTU: failed (%s)", error->message);
+        g_clear_error (&error);
+    }
+
+    /* Parse the new configuration based on IP family */
+    if (ctx->is_ipv4) {
+        GVariant *ipv4_dict;
+        new_config = get_ipv4_config (self, MM_BEARER_IP_METHOD_STATIC, output, mtu);
+        ipv4_dict = mm_gdbus_bearer_get_ip4_config (MM_GDBUS_BEARER (self));
+        if (ipv4_dict) {
+            mm_obj_dbg(self, "GObject ipv4_dict: %p[%s] ", ipv4_dict, g_variant_get_type_string(ipv4_dict));
+            current_config = mm_bearer_ip_config_new_from_dictionary (ipv4_dict, NULL);
+        }
+    } else {
+        GVariant *ipv6_dict;
+        new_config = get_ipv6_config (self, MM_BEARER_IP_METHOD_STATIC, output, mtu);
+        ipv6_dict = mm_gdbus_bearer_get_ip6_config (MM_GDBUS_BEARER (self));
+        if (ipv6_dict) {
+            mm_obj_dbg(self, "GObject ipv6_dict: %p[%s] ", ipv6_dict, g_variant_get_type_string(ipv6_dict));
+            current_config = mm_bearer_ip_config_new_from_dictionary (ipv6_dict, NULL);
+        }
+    }
+
+    /* Compare configurations to see if update is needed */
+    if (!new_config) {
+        mm_obj_warn (self, "Cannot get new ip config, aborting reconfiguration");
+        ctx->config_updated = FALSE;
+    } else {
+        ctx->config_updated = compare_ip_configs (current_config, new_config);
+        if (ctx->config_updated) {
+            mm_obj_info (self, "%s configuration changed, update required",
+                       ctx->is_ipv4 ? "IPv4" : "IPv6");
+            /* Steal the reference to new_config */
+            ctx->new_ip_config = g_steal_pointer (&new_config);
+        } else {
+            mm_obj_dbg (self, "no %s configuration changes detected",
+                      ctx->is_ipv4 ? "IPv4" : "IPv6");
+        }
+    }
+
+    /* Cleanup */
+    g_clear_object (&new_config);
+    g_clear_object (&current_config);
+    qmi_message_wds_get_current_settings_output_unref (output);
+
+    /* Move to next step */
+    ctx->step++;
+    reconfiguration_step (task);
+}
+
+static void
+get_current_settings_for_reconfiguration (GTask        *task,
+                                        QmiClientWds *client,
+                                        gboolean      is_ipv4)
+{
+    QmiMessageWdsGetCurrentSettingsInput *input;
+    QmiWdsRequestedSettings               requested;
+
+    requested = QMI_WDS_REQUESTED_SETTINGS_DNS_ADDRESS |
+                QMI_WDS_REQUESTED_SETTINGS_GRANTED_QOS |
+                QMI_WDS_REQUESTED_SETTINGS_IP_ADDRESS |
+                QMI_WDS_REQUESTED_SETTINGS_GATEWAY_INFO |
+                QMI_WDS_REQUESTED_SETTINGS_MTU |
+                QMI_WDS_REQUESTED_SETTINGS_DOMAIN_NAME_LIST |
+                QMI_WDS_REQUESTED_SETTINGS_IP_FAMILY |
+                QMI_WDS_REQUESTED_SETTINGS_OPERATOR_RESERVED_PCO;
+
+    input = qmi_message_wds_get_current_settings_input_new ();
+    qmi_message_wds_get_current_settings_input_set_requested_settings (input, requested, NULL);
+
+    qmi_client_wds_get_current_settings (client, input, 10, NULL,
+                                       (GAsyncReadyCallback) get_current_settings_for_reconfiguration_ready,
+                                       task);
+    qmi_message_wds_get_current_settings_input_unref (input);
+}
+
+static void
+reconfiguration_step (GTask *task)
+{
+    ReconfigurationContext *ctx;
+    MMBearerQmi           *self;
+
+    ctx = g_task_get_task_data (task);
+    self = ctx->self;
+
+    switch (ctx->step) {
+        case RECONFIG_STEP_FIRST:
+            ctx->step++;
+            /* fall through */
+
+        case RECONFIG_STEP_GET_CURRENT_SETTINGS:
+            mm_obj_dbg (self, "reconfiguration step: getting current %s settings",
+                      ctx->is_ipv4 ? "IPv4" : "IPv6");
+            get_current_settings_for_reconfiguration (task, ctx->client, ctx->is_ipv4);
+            return;
+
+        case RECONFIG_STEP_UPDATE_BEARER_CONFIG:
+            if (!ctx->config_updated) {
+                mm_obj_dbg(self, "no configuration changes detected, skipping update");
+                ctx->step = RECONFIG_STEP_LAST;
+                reconfiguration_step(task);
+                return;
+            }
+            mm_obj_dbg (self, "reconfiguration step: updating bearer configuration");
+            update_bearer_configuration (task);
+            return;
+
+        case RECONFIG_STEP_LAST:
+            mm_obj_info (self, "%s bearer reconfiguration completed",
+                       ctx->is_ipv4 ? "IPv4" : "IPv6");
+            g_task_return_boolean (task, TRUE);
+            return;
+
+        default:
+            g_assert_not_reached ();
+    }
+}
+
+static void
+handle_reconfiguration_required (MMBearerQmi  *self,
+                               QmiClientWds *client)
+{
+    ReconfigurationContext *ctx;
+    GTask                  *task;
+    gboolean               is_ipv4;
+
+    /* ✅ NEW: Identify which IP family triggered the reconfiguration */
+    is_ipv4 = (client == self->priv->client_ipv4);
+    if (is_ipv4) {
+        if (self->priv->ipv4_reconfiguration_ongoing) {
+            mm_obj_warn(self, "IPv4 reconfiguration already ongoing, skipping");
+            return;
+        }
+        self->priv->ipv4_reconfiguration_ongoing = TRUE;
+    } else {
+        if (self->priv->ipv6_reconfiguration_ongoing) {
+            mm_obj_warn(self, "IPv6 reconfiguration already ongoing, skipping");
+            return;
+        }
+        self->priv->ipv6_reconfiguration_ongoing = TRUE;
+    }
+
+    mm_obj_info (self, "handling %s bearer reconfiguration request",
+                is_ipv4 ? "IPv4" : "IPv6");
+
+    ctx = g_new0 (ReconfigurationContext, 1);
+    ctx->self = g_object_ref (self);
+    ctx->client = g_object_ref (client);
+    ctx->step = RECONFIG_STEP_FIRST;
+    ctx->is_ipv4 = is_ipv4;  /* ✅ NEW: Store IP family information */
+    ctx->new_ip_config = NULL;
+
+    task = g_task_new (self, NULL,
+                     (GAsyncReadyCallback) reconfiguration_complete_cb,
+                     NULL);
+    mm_obj_info (self, "create new task %x", task);
+
+    g_task_set_task_data (task, ctx, (GDestroyNotify) reconfiguration_context_free);
+
+    reconfiguration_step (task);
+}
