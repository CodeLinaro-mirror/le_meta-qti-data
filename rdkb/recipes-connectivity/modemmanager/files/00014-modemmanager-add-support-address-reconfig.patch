+/*****************************************************************************/
+/*  NEW: Bearer Reconfiguration System */
+
+static void
+reconfiguration_context_free (ReconfigurationContext *ctx)
+{
+    if (!ctx)
+        return;
+
+    if (ctx->client)
+    {
+        mm_obj_dbg (NULL, "clear client object %p", ctx->client);
+        g_clear_object (&ctx->client);
+    }
+    if (ctx->self)
+    {
+        mm_obj_dbg (NULL, "clear self object %p", ctx->self);
+        g_clear_object (&ctx->self);
+    }
+    if (ctx->new_ip_config)
+    {
+        mm_obj_dbg (NULL, "clear new_ip_config object %p", ctx->new_ip_config);
+        g_clear_object (&ctx->new_ip_config);
+    }
+    mm_obj_dbg (NULL, "clear ctx object %x", ctx);
+    g_free (ctx);
+}
+
+
+static void reconfiguration_step (GTask *task);
+
+static void
+reconfiguration_complete_cb (GObject      *source,
+                           GAsyncResult *res,
+                           gpointer      user_data)
+{
+    MMBearerQmi *self = MM_BEARER_QMI (source);
+    GError      *error = NULL;
+
+    if (!g_task_propagate_boolean (G_TASK (res), &error)) {
+        mm_obj_warn (self, "bearer reconfiguration failed: %s", error->message);
+        g_error_free (error);
+    } else {
+        mm_obj_dbg (self, "bearer reconfiguration completed successfully");
+    }
+    if (self->priv->ipv4_reconfiguration_ongoing) {
+        self->priv->ipv4_reconfiguration_ongoing = FALSE;
+    }
+    if (self->priv->ipv6_reconfiguration_ongoing) {
+        self->priv->ipv6_reconfiguration_ongoing = FALSE;
+    }
+    g_object_unref(res);
+}
+
+
+static void
+update_bearer_configuration(GTask *task)
+{
+    ReconfigurationContext *ctx;
+    MMBearerQmi           *self;
+    MMBearerIpConfig      *final_ipv4_config = NULL;
+    MMBearerIpConfig      *final_ipv6_config = NULL;
+    const gchar           *interface;
+    gint                   profile_id;
+    gboolean               multiplexed;
+
+    ctx = g_task_get_task_data(task);
+    self = ctx->self;
+
+    /* Get current bearer configuration from D-Bus properties */
+    interface = mm_gdbus_bearer_get_interface(MM_GDBUS_BEARER(self));
+    profile_id = mm_gdbus_bearer_get_profile_id(MM_GDBUS_BEARER(self));
+    multiplexed = mm_gdbus_bearer_get_multiplexed(MM_GDBUS_BEARER(self));
+    mm_obj_dbg(self, "Updating bearer configuration for interface '%s' (profile %d, multiplexed %s)",
+               interface, profile_id, multiplexed ? "yes" : "no");
+
+    if (ctx->is_ipv4) {
+        /* IPv4 reconfig: new config is ipv4, keep current ipv6 */
+        final_ipv4_config = g_object_ref (ctx->new_ip_config);
+    } else {
+        /* IPv6 reconfig: new config is ipv6, keep current ipv4 */
+        final_ipv6_config = g_object_ref (ctx->new_ip_config);
+    }
+
+    if (final_ipv4_config)
+        mm_obj_dbg(self, "New IPv4 config: address %s/%u, gateway %s, mtu %u",
+                   mm_bearer_ip_config_get_address(final_ipv4_config) ? mm_bearer_ip_config_get_address(final_ipv4_config) : "n/a",
+                   mm_bearer_ip_config_get_prefix(final_ipv4_config),
+                   mm_bearer_ip_config_get_gateway(final_ipv4_config) ? mm_bearer_ip_config_get_gateway(final_ipv4_config) : "n/a",
+                   mm_bearer_ip_config_get_mtu(final_ipv4_config));
+    if (final_ipv6_config)
+        mm_obj_dbg(self, "New IPv6 config: address %s/%u, gateway %s, mtu %u",
+                   mm_bearer_ip_config_get_address(final_ipv6_config) ? mm_bearer_ip_config_get_address(final_ipv6_config) : "n/a",
+                   mm_bearer_ip_config_get_prefix(final_ipv6_config),
+                   mm_bearer_ip_config_get_gateway(final_ipv6_config) ? mm_bearer_ip_config_get_gateway(final_ipv6_config) : "n/a",
+                   mm_bearer_ip_config_get_mtu(final_ipv6_config));
+
+    /* Use the new function to only update IP configuration */
+    mm_obj_dbg(MM_BASE_BEARER(self), " mm_base_bearer_update_ip_config");
+    mm_base_bearer_update_ip_config(MM_BASE_BEARER(self),
+                                         final_ipv4_config,
+                                         final_ipv6_config);
+
+    mm_obj_info(self, "%s bearer configuration updated successfully",
+               ctx->is_ipv4 ? "IPv4" : "IPv6");
+
+    ctx->step++;
+
+    if(final_ipv4_config)
+        g_object_unref(final_ipv4_config);
+    if(final_ipv6_config)
+        g_object_unref(final_ipv6_config);
+
+    reconfiguration_step(task);
+}
