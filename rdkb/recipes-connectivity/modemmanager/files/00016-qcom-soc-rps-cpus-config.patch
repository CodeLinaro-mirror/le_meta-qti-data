     }
 
+    /* Notify the modem that a new link is up */
+    notify_modem_link_up (ctx);
+
     /* Keep on */
     ctx->step++;
     connect_context_step (task);
@@ -2088,6 +2111,9 @@ bind_mux_data_port_ready (QmiClientWds *client,
         return;
     }
 
+    /* Notify the modem that a new multiplexed link is up */
+    notify_modem_link_up (ctx);
+
     /* Keep on */
     ctx->step++;
     connect_context_step (task);
