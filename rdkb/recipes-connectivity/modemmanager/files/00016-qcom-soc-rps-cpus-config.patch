+/*****************************************************************************/
+/* RPS CPU mask configuration for data interfaces */
+
+static void
+load_rps_cpus_config (MMBroadbandModemQmiQcomSoc *self)
+{
+    GError *error = NULL;
+
+    if (self->priv->rps_cpus_config_loaded)
+        return;
+
+    self->priv->rps_cpus_config_loaded = TRUE;
+    self->priv->rps_cpus_config = g_key_file_new ();
+
+    if (g_key_file_load_from_file (self->priv->rps_cpus_config,
+                                   MM_QCOM_SOC_RPS_CPUS_CONFIG_FILE,
+                                   G_KEY_FILE_NONE,
+                                   &error))
+        return;
+
+    if (error && (error->domain != G_FILE_ERROR || error->code != G_FILE_ERROR_NOENT))
+        mm_obj_warn (self, "couldn't load RPS configuration '%s': %s",
+                     MM_QCOM_SOC_RPS_CPUS_CONFIG_FILE,
+                     error->message);
+    g_clear_error (&error);
+
+    if (g_strcmp0 (MM_QCOM_SOC_RPS_CPUS_CONFIG_FILE,
+                   MM_QCOM_SOC_RPS_CPUS_CONFIG_FALLBACK_FILE) != 0 &&
+        g_key_file_load_from_file (self->priv->rps_cpus_config,
+                                   MM_QCOM_SOC_RPS_CPUS_CONFIG_FALLBACK_FILE,
+                                   G_KEY_FILE_NONE,
+                                   &error))
+        return;
+
+    if (error && (error->domain != G_FILE_ERROR || error->code != G_FILE_ERROR_NOENT))
+        mm_obj_warn (self, "couldn't load fallback RPS configuration '%s': %s",
+                     MM_QCOM_SOC_RPS_CPUS_CONFIG_FALLBACK_FILE,
+                     error->message);
+    g_clear_error (&error);
+    g_clear_pointer (&self->priv->rps_cpus_config, g_key_file_unref);
+}
+
+static gboolean
+rps_cpus_config_matches (const gchar *interface_name,
+                         const gchar *configured_name)
+{
+    gsize configured_name_len;
+
+    configured_name_len = strlen (configured_name);
+    if (configured_name_len > 0 && configured_name[configured_name_len - 1] == '*')
+        return strncmp (interface_name, configured_name, configured_name_len - 1) == 0;
+
+    return g_strcmp0 (interface_name, configured_name) == 0;
+}
+
+static gboolean
+get_rps_cpus_config (MMBroadbandModemQmiQcomSoc *self,
+                     const gchar                *interface_name,
+                     gchar                     **out_path,
+                     gchar                     **out_mask)
+{
+    gchar **groups;
+    gsize   n_groups;
+    gsize   i;
+
+    *out_path = NULL;
+    *out_mask = NULL;
+
+    load_rps_cpus_config (self);
+    if (!self->priv->rps_cpus_config || !interface_name)
+        return FALSE;
+
+    groups = g_key_file_get_groups (self->priv->rps_cpus_config, &n_groups);
+    for (i = 0; i < n_groups; i++) {
+        g_autofree gchar *configured_name = NULL;
+        g_autofree gchar *path_template = NULL;
+        g_autofree gchar *mask = NULL;
+        GError *error = NULL;
+
+        configured_name = g_key_file_get_string (self->priv->rps_cpus_config,
+                                                 groups[i],
+                                                 "interface_name",
+                                                 &error);
+        if (error) {
+            mm_obj_warn (self, "invalid RPS configuration group '%s': %s",
+                         groups[i], error->message);
+            g_clear_error (&error);
+            continue;
+        }
+
+        if (!rps_cpus_config_matches (interface_name, configured_name))
+            continue;
+
+        path_template = g_key_file_get_string (self->priv->rps_cpus_config,
+                                               groups[i],
+                                               "rps_cpus_file",
+                                               &error);
+        if (!error)
+            mask = g_key_file_get_string (self->priv->rps_cpus_config,
+                                           groups[i],
+                                           "mask",
+                                           &error);
+        if (error || !path_template || !mask || !path_template[0] || !mask[0]) {
+            mm_obj_warn (self, "invalid RPS configuration group '%s'%s%s",
+                         groups[i],
+                         error ? ": " : "",
+                         error ? error->message : "missing value");
+            g_clear_error (&error);
+            break;
+        }
+
+        if (strstr (path_template, "%s"))
+            *out_path = g_strdup_printf (path_template, interface_name);
+        else
+            *out_path = g_strdup (path_template);
+        *out_mask = g_steal_pointer (&mask);
+        break;
+    }
+    g_strfreev (groups);
+
+    return *out_path && *out_mask;
+}
+
+static gboolean
+write_rps_cpus (MMBroadbandModemQmiQcomSoc *self,
+                const gchar                *ifname,
+                const gchar                *path,
+                const gchar                *mask)
+{
+    g_autofree gchar *value = NULL;
+    FILE             *f;
+    gsize             len;
+    gsize             written;
+
+    value = g_strdup_printf ("%s\n", mask);
+    f = fopen (path, "we");
+    if (!f) {
+        mm_obj_dbg (self, "rps_cpus not available for %s: %s",
+                    ifname, g_strerror (errno));
+        return FALSE;
+    }
+    len = strlen (value);
+    written = fwrite (value, 1, len, f);
+    if (written != len)
+        mm_obj_warn (self, "partial write to %s (%lu of %lu)",
+                     path, (gulong)written, (gulong)len);
+    fclose (f);
+    mm_obj_dbg (self, "set rps_cpus for %s to %s", ifname, mask);
+    return TRUE;
+}
+
+static void
+notify_link_up (MMBroadbandModemQmi *self,
+                const gchar         *link_name,
+                MMPort              *data)
+{
+    MMKernelDevice *lower;
+    const gchar    *lower_name;
+    gchar          *path = NULL;
+    gchar          *mask = NULL;
+
+    if (get_rps_cpus_config (MM_BROADBAND_MODEM_QMI_QCOM_SOC (self),
+                             link_name,
+                             &path,
+                             &mask)) {
+        write_rps_cpus (MM_BROADBAND_MODEM_QMI_QCOM_SOC (self),
+                        link_name,
+                        path,
+                        mask);
+        g_clear_pointer (&path, g_free);
+        g_clear_pointer (&mask, g_free);
+    }
+
+    lower = mm_kernel_device_peek_lower_device (mm_port_peek_kernel_device (data));
+    lower_name = lower ? mm_kernel_device_get_name (lower) : NULL;
+    if (lower_name && g_strcmp0 (lower_name, link_name) != 0 &&
+        get_rps_cpus_config (MM_BROADBAND_MODEM_QMI_QCOM_SOC (self),
+                             lower_name,
+                             &path,
+                             &mask)) {
+        write_rps_cpus (MM_BROADBAND_MODEM_QMI_QCOM_SOC (self),
+                        lower_name,
+                        path,
+                        mask);
+        g_clear_pointer (&path, g_free);
+        g_clear_pointer (&mask, g_free);
+    }
+}
+
 /*****************************************************************************/
 
 MMBroadbandModemQmiQcomSoc *
@@ -165,12 +364,29 @@ mm_broadband_modem_qmi_qcom_soc_new (const gchar  *device,
 static void
 mm_broadband_modem_qmi_qcom_soc_init (MMBroadbandModemQmiQcomSoc *self)
 {
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self,
+                                              MM_TYPE_BROADBAND_MODEM_QMI_QCOM_SOC,
+                                              MMBroadbandModemQmiQcomSocPrivate);
+}
+
+static void
+finalize (GObject *object)
+{
+    MMBroadbandModemQmiQcomSoc *self = MM_BROADBAND_MODEM_QMI_QCOM_SOC (object);
+
+    g_clear_pointer (&self->priv->rps_cpus_config, g_key_file_unref);
+    G_OBJECT_CLASS (mm_broadband_modem_qmi_qcom_soc_parent_class)->finalize (object);
 }
 
 static void
 mm_broadband_modem_qmi_qcom_soc_class_init (MMBroadbandModemQmiQcomSocClass *klass)
 {
+    GObjectClass              *object_class = G_OBJECT_CLASS (klass);
     MMBroadbandModemQmiClass *broadband_modem_qmi_class = MM_BROADBAND_MODEM_QMI_CLASS (klass);
 
+    g_type_class_add_private (object_class, sizeof (MMBroadbandModemQmiQcomSocPrivate));
+
+    object_class->finalize = finalize;
     broadband_modem_qmi_class->peek_port_qmi_for_data = peek_port_qmi_for_data;
+    broadband_modem_qmi_class->notify_link_up = notify_link_up;
 }
