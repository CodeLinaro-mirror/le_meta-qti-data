+static void
+notify_modem_link_up (ConnectContext *ctx)
+{
+    MMBroadbandModemQmiClass *qmi_klass;
+
+    if (!MM_IS_BROADBAND_MODEM_QMI (ctx->modem))
+        return;
+
+    qmi_klass = MM_BROADBAND_MODEM_QMI_GET_CLASS (ctx->modem);
+    if (qmi_klass->notify_link_up) {
+        g_autofree gchar *ctx_link_name = NULL;
+
+        ctx_link_name = g_strdup (ctx->link_name);
+        qmi_klass->notify_link_up (MM_BROADBAND_MODEM_QMI (ctx->modem),
+                                   ctx_link_name,
+                                   ctx->link);
+    }
+}
