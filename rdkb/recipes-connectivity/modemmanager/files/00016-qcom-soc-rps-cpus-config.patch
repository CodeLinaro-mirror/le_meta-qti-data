index 00000000..b40688eb
--- /dev/null
+++ b/plugins/qcom-soc/mm-qcom-soc-rps-cpus.conf
@@ -0,0 +1,14 @@
+# RPS CPU masks for Qualcomm SoC data interfaces.
+#
+# interface_name accepts an exact interface name or a trailing '*' prefix
+# match. In rps_cpus_file, '%s' is replaced with the matched interface name.
+
+[qmapmux]
+interface_name=qmapmux*
+rps_cpus_file=/sys/class/net/%s/queues/rx-0/rps_cpus
+mask=c
+
+[rmnet_ipa0]
+interface_name=rmnet_ipa0
+rps_cpus_file=/sys/class/net/%s/queues/rx-0/rps_cpus
+mask=8
