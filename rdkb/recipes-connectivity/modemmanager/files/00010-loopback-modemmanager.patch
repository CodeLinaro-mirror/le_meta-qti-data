+                if (sim_slots_loaded_without_cards (self))
+                    mm_obj_info (self, "not creating SIM object: no SIM in loaded slots");
+                else {
+                    MM_IFACE_MODEM_GET_INTERFACE (self)->create_sim (
+                        MM_IFACE_MODEM (self),
+                        (GAsyncReadyCallback)sim_new_ready,
+                        task);
+                    return;
+                }
