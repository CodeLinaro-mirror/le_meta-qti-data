From 607e695f7688903fbc54dd0dd772f97ff11a9918 Mon Sep 17 00:00:00 2001
From: B Saravanan <saravb@qti.qualcomm.com>
Date: Thu, 6 Aug 2026 15:10:10 +0530
Subject: [PATCH] Changes to ignore RDNS config when RA O bit is set and dont start the dibbler-client

Signed-off-by: Saravanan B <saravb@qti.qualcomm.com>
---
 source/scripts/init/system/utopia_init.sh | 3 +++
 source/service_routed/service_routed.c    | 2 +-
 2 files changed, 4 insertions(+), 1 deletion(-)

Index: git/source/scripts/init/system/utopia_init.sh
===================================================================
--- git.orig/source/scripts/init/system/utopia_init.sh
+++ git/source/scripts/init/system/utopia_init.sh
@@ -884,3 +884,6 @@ fi
 if [ "$BOX_TYPE" = "SCER11BEL" ] || [ "$MODEL_NUM" = "SCXF11BFL" ]; then
        /etc/reset_reason_log.sh &
 fi
+
+ln -s /etc/dibbler /tmp
+rm -f /etc/dibbler/server.pid
Index: git/source/service_routed/service_routed.c
===================================================================
--- git.orig/source/service_routed/service_routed.c
+++ git/source/service_routed/service_routed.c
@@ -1546,7 +1546,7 @@ STATIC int gen_zebra_conf(int sefd, toke
                 sysevent_get(sefd, setok,"cellular_wan_v6_dns1", wan_dns, sizeof(wan_dns));
                 sysevent_get(sefd, setok,"cellular_wan_v6_dns2", wan_dns1, sizeof(wan_dns1));
 
-                if (strlen(lan_addr))
+                if (strlen(lan_addr) && (strcmp(o_flag, "1") != 0))
                 {
 #else
                 if (strlen(lan_addr) && ula_enable)
@@ -1724,7 +1724,9 @@ STATIC int gen_zebra_conf(int sefd, toke
                         }
 #endif /** _SCER11BEL_PRODUCT_REQ_ */
 #else
-                        fprintf(fp, "   ipv6 nd rdnss %s %d\n", tok, rdnsslft);
+                        if (strcmp(o_flag, "1") != 0) {
+                           fprintf(fp, "   ipv6 nd rdnss %s %d\n", tok, rdnsslft);
+                        }
 #endif
                 }
 
Index: git/source/scripts/init/service.d/service_dhcpv6_client_arm.sh
===================================================================
--- git.orig/source/scripts/init/service.d/service_dhcpv6_client_arm.sh
+++ git/source/scripts/init/service.d/service_dhcpv6_client_arm.sh
@@ -128,9 +128,13 @@ service_start()
         			ti_dhcp6c -i "$WAN_INTERFACE_NAME" -p $DHCPV6_PID_FILE -plugin /fss/gw/lib/libgw_dhcp6plg.so
 				echo_t "SERVICE_DHCP6C : dhcp6c PID is `cat $DHCPV6_PID_FILE`"
 			else
-				echo_t "SERVICE_DHCP6C : Starting dibbler client"
-				sh /lib/rdk/dibbler-init.sh
-				$DHCPV6_BINARY start
+				if [ "$BOX_TYPE" != "echo" ]; then
+					echo_t "SERVICE_DHCP6C : Starting dibbler client"
+					sh /lib/rdk/dibbler-init.sh
+					$DHCPV6_BINARY start
+				else
+					echo_t "SERVICE_DHCP6C : boxtype is echo, dont start dibbler process here..."
+				fi
 			fi
 			rm -f $DHCP6C_PROGRESS_FILE
 
