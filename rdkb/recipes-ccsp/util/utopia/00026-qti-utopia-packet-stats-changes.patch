+int writeIpv4StatsFile()
+{
+    FILE *fp= NULL;
+    FILE *new_fp = NULL;
+    int ret = -1;
+    unsigned long tx_value_new =0, rx_value_new=0, total_tx_value=0, total_rx_value=0;
+    char tmp_reset[MAX_QUERY] = {0};
+    int ret_reset = -1;
+
+    fp = fopen(IPV4_STATS_FILE, "r+");
+
+    if (!fp)
+    {
+         return -1; // Return non-zero error code
+    }
+
+    // Read the entire file into memory
+    fseek(fp, 0, SEEK_END);
+    long file_size = ftell(fp);
+    rewind(fp);
+    char *file_contents = malloc(file_size + 1);
+
+    if (file_contents == NULL)
+    {
+        fclose(fp);
+        fp = NULL;
+        return -1;
+    }
+    ret_reset = sysevent_get(sysevent_fd, sysevent_token, "reset_packet_stats", tmp_reset, sizeof(tmp_reset));
+    if (0 != ret_reset)
+    {
+        FIREWALL_DEBUG("[%s:%d] sysevent for reset_packet_stats failed!!!!\n" COMMA __FUNCTION__ COMMA __LINE__);
+    }
+    fread(file_contents, sizeof(char), file_size, fp);
+    file_contents[file_size] = '\0';
+    fclose(fp);
+    fp = NULL;
+    // Split the file contents into individual lines
+    char *lines[1000] = {NULL};
+    unsigned char line_owned[1000] = {0};
+    int num_lines = 0;
+    char *saveptr;
+    char *token = strtok_r(file_contents, "\n", &saveptr);
+    while (token != NULL)
+    {
+        lines[num_lines++] = token;
+        token = strtok_r(NULL, "\n", &saveptr);
+    }
+
+    // Modify the lines as needed
+    for (int i = 0; i < num_lines; i++)
+    {
+        // Extract the IP address and other fields manually
+        char *ifname_start = strstr(lines[i], "ifname=");
+        if (ifname_start == NULL)
+        {
+            FIREWALL_DEBUG("missing ifname");
+            continue;
+        }
+        char *ip_start = strstr(ifname_start, "ip=");
+        if (ip_start == NULL)
+        {
+            FIREWALL_DEBUG("missing ip after ifname");
+            continue;
+        }
+        char *mac_start = strstr(ip_start, "mac=");
+        if (mac_start == NULL)
+        {
+            FIREWALL_DEBUG("missing mac after ip");
+            continue;
+        }
+        char temp_line_copy[1024]; // Create a copy of the line
+        strlcpy(temp_line_copy, lines[i], sizeof(temp_line_copy));
+
+        char *ip_end = strstr(ip_start, " ");
+        char ip[20] = {0};
+        strlcpy(ip, ip_start + 3, ip_end - ip_start - 2);
+        ip[ip_end - ip_start - 3] = '\0';
+
+        if (ifname_start && ip_start && mac_start)
+        {
+            // Find the positions of the TX and RX fields
+            FIREWALL_DEBUG("Parsing stats fields");
+            char *tx_pos = strstr(temp_line_copy, "TX=");
+            char *rx_pos = strstr(temp_line_copy, "RX=");
+
+            if (tx_pos && rx_pos)
+            {
+                // Get the current TX and RX values
+                char *equals_tx = strchr(tx_pos, '=');
+                char *equals_rx = strchr(rx_pos, '=');
+                char tx_str[20] = {0};
+                char rx_str[20] = {0};
+                strlcpy(tx_str, equals_tx + 1, sizeof(tx_str));
+                strlcpy(rx_str, equals_rx + 1, sizeof(rx_str));
+                unsigned long tx_value_old = strtoul(tx_str, NULL, 10);
+                unsigned long rx_value_old = strtoul(rx_str, NULL, 10);
+                // Update the existing TX and RX fields
+                FIREWALL_DEBUG("Updating TX/RX fields");
+                char *end_tx = strchr(tx_pos, '=');
+                char *end_rx = strchr(rx_pos, '=');
+
+                *end_tx = '\0'; // Null-terminate the TX field
+                *end_rx = '\0'; // Null-terminate the RX field
+                tx_value_new = getIPv4StatBytes(ip, 1);
+                rx_value_new = getIPv4StatBytes(ip, 0); // Assuming both TX and RX are IPv4 stats
+                FIREWALL_DEBUG("Fetched IPv4 stats: new_tx and new_rx");
+                if (1 != atoi(tmp_reset))
+                {
+                    total_tx_value = tx_value_old + tx_value_new;
+                    total_rx_value = rx_value_old + rx_value_new;
+                }
+                else
+                {
+                    total_tx_value = 0;
+                    total_rx_value = 0;
+                }
+                char temp_buf[256] = {0};
+                snprintf(temp_buf, sizeof(temp_buf), "=%lu RX=%lu", total_tx_value, total_rx_value);
+                strlcpy(end_tx, temp_buf, strlen(temp_buf) + 1);
+                // Replace the old line with the new line
+                FIREWALL_DEBUG("Updated totals: total_tx and total_rx");
+                char *new_line = strdup(temp_line_copy);
+                if (new_line != NULL)
+                {
+                    lines[i] = new_line;
+                    line_owned[i] = 1;
+                }
+            }
+            else
+            {
+                uint64_t tx_new = getIPv4StatBytes(ip, true);
+                uint64_t rx_new = getIPv4StatBytes(ip, false);
+                char temp_buf[256] = {0};
+                snprintf(temp_buf, sizeof(temp_buf),"%s TX=%lu RX=%lu", lines[i], tx_new, rx_new);
+                char *new_line = strdup(temp_buf);
+                if (new_line != NULL)
+                {
+                    lines[i] = new_line;
+                    line_owned[i] = 1;
+                }
+                //continue;
+            }
+        }
+    }
+    // Write the modified lines back to the file
+    new_fp = fopen(IPV4_STATS_FILE, "w");
+    if (new_fp == NULL)
+    {
+        for (int i = 0; i < num_lines; i++)
+        {
+            if (line_owned[i] && lines[i] != NULL)
+            {
+                free(lines[i]);
+                lines[i] = NULL;
+            }
+       }
+
+       if (file_contents != NULL)
+       {
+           free(file_contents);
+           file_contents = NULL;
+       }
