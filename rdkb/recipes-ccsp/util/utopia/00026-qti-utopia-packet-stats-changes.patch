+uint64_t getIPv4StatBytes(char *ipv4addr, bool is_tx_stat)
+{
+    uint64_t stat_bytes = 0;
+    ssize_t nread;
+    size_t length = 0;
+    unsigned int mark_val = 0;
+    char *stringline = NULL;
+    char cmd[COMMAND_SIZE]= {0};
+    char tmp[COMMAND_SIZE]={0};
+    char *bytes=NULL, *mark=NULL,*ptr;
+    FILE *fp = NULL;
+
+    if (NULL == ipv4addr)
+    {
+        FIREWALL_DEBUG("[%s:%d] input param NULL\n" COMMA __FUNCTION__ COMMA __LINE__);
+        return 0;
+    }
+
+    snprintf(cmd, COMMAND_SIZE,"iptables -t mangle -L TRAFFIC_ACCT -n -v -x  --line-numbers -w 2");
+    strlcat(cmd, IPTABLES_AWK_STATS, COMMAND_SIZE);
+    snprintf(tmp, COMMAND_SIZE, " | grep -w %s", ipv4addr);
+    strlcat(cmd, tmp, COMMAND_SIZE);
+    fp = popen(cmd,"r");
+    if (NULL == fp)
+    {
+        FIREWALL_DEBUG("[%s:%d] popen failed\n" COMMA __FUNCTION__ COMMA __LINE__);
+        return 0;
+    }
+    stringline = (char *)malloc(BUFFER_SIZE * sizeof(char));
+    if (NULL == stringline)
+    {
+        FIREWALL_DEBUG("[%s:%d] malloc failed\n" COMMA __FUNCTION__ COMMA __LINE__);
+        pclose(fp);
+        return 0;
+    }
+    while ((nread = getline(&stringline, &length, fp)) != -1)
+    {
+        stringline[strlen(stringline) - 1] = '\0';
+        strtok_r(stringline, ",", &ptr);
+        bytes = strtok_r(NULL, ",", &ptr);
+        strtok_r(NULL, ",", &ptr);
+        strtok_r(NULL, ",", &ptr);
+        mark = strtok_r(NULL, ",", &ptr);
+
+        if ((NULL == mark) || (NULL == bytes))
+        {
+            FIREWALL_DEBUG("[%s:%d] mark or bytes are NULL\n" COMMA __FUNCTION__ COMMA __LINE__);
+            pclose(fp);
+            if (NULL != stringline)
+            {
+                free(stringline);
+                stringline = NULL;
+            }
+            return 0;
+        }
+        mark_val = strtoull(mark,&ptr,16);
+        if (false == is_tx_stat)
+        {
+            /*receive bytes will be marked with 0x02*/
+            if (mark_val%2 == 0)
+            {
+                stat_bytes = strtoull(bytes,&ptr,10);
+                break;
+            }
+        }
+        else
+        {
+            /*transmit bytes will be marked with 0x01*/
+            if (mark_val%2 != 0)
+            {
+                stat_bytes = strtoull(bytes,&ptr,10);
+                break;
+            }
+        }
+    }
+    pclose(fp);
+    fp = NULL;
+    if (NULL != stringline)
+    {
+        free(stringline);
+        stringline = NULL;
+    }
+    return stat_bytes;
+}
