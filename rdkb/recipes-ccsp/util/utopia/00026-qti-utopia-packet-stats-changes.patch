+/*
+ * ip6tables rule addition for packet statistics
+ */
+int AddIPv6Rules(FILE *mangle_fp)
+{
+    ssize_t nread;
+    size_t len = 0;
+    char *line = NULL;
+    FILE *fp = NULL;
+    char *ip_temp = NULL;
+    char *ip = NULL;
+    char *saveptr;
+    int err_ret = 0;
+    int ret;
+    fp = fopen(IPV6_STATS_FILE, "r");
+    if (NULL == fp)
+    {
+        FIREWALL_DEBUG("[%s:%d] fopen failed\n" COMMA __FUNCTION__ COMMA __LINE__);
+        return -1;
+    }
+    while ((nread = getline(&line, &len, fp)) != -1)
+    {
+        line[strlen(line) - 1] = '\0';
+        strtok_r(line, " ", &saveptr);
+        ip_temp = strtok_r(NULL, " ", &saveptr);
+        if (NULL == ip_temp)
+        {
+            FIREWALL_DEBUG("[%s:%d] strtok_r failed\n" COMMA __FUNCTION__ COMMA __LINE__);
+            err_ret = -1;
+            break;
+        }
+        ip = strstr(ip_temp, "=");
+        if (NULL == ip)
+        {
+            FIREWALL_DEBUG("[%s:%d] strstr failed ,no matching substring found\n" COMMA __FUNCTION__ COMMA __LINE__);
+            err_ret = -1;
+            break;
+        }
+        ret = IsRuleAdded(ip, IP_TYPE_IPV6);
+        if (-1 == ret)
+        {
+            FIREWALL_DEBUG("[%s:%d] IsIp6tablesRuleAdded failed\n" COMMA __FUNCTION__ COMMA __LINE__);
+        }
+        fprintf(mangle_fp, "-A FORWARD -s %s -o %s -j MARK --set-xmark 0x10000/0xf0000\n",ip+1,current_wan_ifname);
+        fprintf(mangle_fp, "-A FORWARD -d %s -i %s -j MARK --set-xmark 0x20000/0xf0000\n",ip+1,current_wan_ifname);
+        fprintf(mangle_fp, "-A TRAFFIC_ACCT -m mark --mark 0x10000/0xf0000 -s %s -j ACCEPT\n",ip+1);
+        fprintf(mangle_fp, "-A TRAFFIC_ACCT -m mark --mark 0x20000/0xf0000 -d %s -j ACCEPT\n",ip+1);
+    }
+    fclose(fp);
+    fp = NULL;
+    if (line)
+    {
+        free(line);
+        line = NULL;
+    }
+    if (-1 == err_ret)
+        return -1;
+
+    return 0;
+}
