+uint64_t getIPv6StatBytes(char *mac, bool is_tx_stat)
+{
+    uint64_t total_stat_bytes = 0, ipv6_stat_bytes = 0;
+    ssize_t nread;
+    size_t length = 0;
+    char *line = NULL;
+    char ipv6Addr[BUFFER_SIZE] = {0};
+    char cmd[COMMAND_SIZE]= {0};
+    char tmp[COMMAND_SIZE]={0};
+    char stringline[COMMAND_SIZE]={0};
+    char *ipaddr = NULL, *macaddr = NULL, *ptr;
+    char *ipaddr_temp = NULL, *macaddr_temp = NULL;
+    char *bytes=NULL, *saveptr;
+    FILE *stat_fp = NULL;
+    FILE *cmd_fp = NULL;
+    if (NULL == mac)
+    {
+        return 0;
+    }
+    stat_fp = fopen("/tmp/ipv6_stats.txt","r");
+    if (NULL == stat_fp)
+    {
+        return 0;
+    }
+    line = (char *) malloc(COMMAND_SIZE * sizeof(char));
+    if (NULL == line)
+    {
+        fclose(stat_fp);
+        stat_fp = NULL;
+        return 0;
+    }
+    while ((nread = getline(&line, &length, stat_fp)) != -1)
+    {
+        line[strlen(line) - 1] = '\0';
+        ipv6_stat_bytes = 0;
+        strtok_r(line, " ", &ptr);
+        ipaddr_temp = strtok_r(NULL, " ", &ptr);
+        macaddr_temp = strtok_r(NULL, " ", &ptr);
+        if (NULL == ipaddr_temp || NULL == macaddr_temp)
+        {
+            continue;
+        }
+        ipaddr = strstr(ipaddr_temp,"=");
+        macaddr = strstr(macaddr_temp,"=");
+        if (NULL == ipaddr || NULL == macaddr)
+        {
+            continue;
+        }
+        if (strlen(ipaddr+1) <= 0)
+        {
+            continue;
+        }
+        if (0 == strcasecmp(mac,macaddr+1))
+        {
+            strlcpy(ipv6Addr,ipaddr+1,sizeof(ipv6Addr));
+        }
+        else
+        {
+            continue;
+        }
+        snprintf(cmd, COMMAND_SIZE,"ip6tables -t mangle -L TRAFFIC_ACCT -n -v -x  --line-numbers -w 2");
+        strlcat(cmd, IP6TABLES_AWK_STATS, COMMAND_SIZE);
+        if (false == is_tx_stat)
+        {
+            /*receive bytes will be marked with 0x02*/
+            snprintf(tmp, COMMAND_SIZE, " | grep -w %s |grep -i 0x2", ipv6Addr);
+        }
+        else
+        {
+            /*transmit bytes will be marked with 0x01*/
+            snprintf(tmp, COMMAND_SIZE, " | grep -w %s |grep -i 0x1", ipv6Addr);
+        }
+        strlcat(cmd, tmp, COMMAND_SIZE);
+        cmd_fp = popen(cmd,"r");
+        if (cmd_fp == NULL)
+        {
+            //CcspTraceError(("[%s:%d] popen failed\n",__FUNCTION__,__LINE__));
+            continue;
+        }
+        if(NULL != fgets(stringline,sizeof(stringline)-1,cmd_fp))
+        {
+            if (strlen(stringline) > 0)
+            {
+                stringline[strlen(stringline) - 1] = '\0';
+            }
+            else
+            {
+                pclose(cmd_fp);
+                cmd_fp = NULL;
+                continue;
+            }
+            strtok_r(stringline, ",", &saveptr);
+            bytes = strtok_r(NULL, ",", &saveptr);
+            if (NULL == bytes)
+            {
+                pclose(cmd_fp);
+                cmd_fp = NULL;
+                continue;
+            }
+            ipv6_stat_bytes = strtoull(bytes,&ptr,10);
+        }
+        pclose(cmd_fp);
+        cmd_fp = NULL;
+        total_stat_bytes += ipv6_stat_bytes;
+    }
+    fclose(stat_fp);
+    stat_fp = NULL;
+    if (line)
+    {
+        free(line);
+        line = NULL;
+    }
+    return total_stat_bytes;
+}
