+ /*
+  * Check if iptables/ip6tables rules already added
+  * ipType: IP_TYPE_IPV4 or IP_TYPE_IPV6
+  *
+  */
+int IsRuleAdded(char *addr, int ipType)
+{
+    char cmd[COMMAND_SIZE] = {0};
+    char tmp[COMMAND_SIZE] = {0};
+    FILE *fp = NULL;
+    int addr_found = 0;
+    if (NULL == addr)
+    {
+        FIREWALL_DEBUG("[%s:%d] input param NULL\n" COMMA __FUNCTION__ COMMA __LINE__);
+        return -1;
+    }
+    if (ipType == IP_TYPE_IPV4)
+    {
+        snprintf(cmd, COMMAND_SIZE, "iptables -t mangle -L FORWARD -n -v -x --line-numbers -w 2");
+        strlcat(cmd, IPTABLES_AWK_STATS, COMMAND_SIZE);
+    }
+    else if (ipType == IP_TYPE_IPV6)
+    {
+        snprintf(cmd, COMMAND_SIZE, "ip6tables -t mangle -L FORWARD -n -v -x --line-numbers -w 2");
+        strlcat(cmd, IP6TABLES_AWK_STATS, COMMAND_SIZE);
+    }
+    else
+    {
+        FIREWALL_DEBUG("[%s:%d] Invalid IP type\n" COMMA __FUNCTION__ COMMA __LINE__);
+        return -1;
+    }
+    snprintf(tmp, COMMAND_SIZE, " | grep -w %s", addr);
+    strlcat(cmd, tmp, COMMAND_SIZE);
+    fp = popen(cmd, "r");
+    if (NULL == fp)
+    {
+        FIREWALL_DEBUG("[%s:%d] popen failed\n" COMMA __FUNCTION__ COMMA __LINE__);
+        return -1;
+    }
+    if (fgetc(fp) != EOF)
+    {
+        addr_found = 1;
+    }
+    pclose(fp);
+    fp = NULL;
+    return addr_found;
+}
+
+int AddIPv4Rules(FILE *mangle_fp)
+{
+
+    ssize_t nread;
+    size_t len = 0;
+    char *line = NULL;
+    FILE *fp = NULL;
+    char *ip_temp = NULL;
+    char *ip = NULL;
+    char *saveptr;
+    int ret;
+    fp = fopen(IPV4_STATS_FILE, "r");
+    if (NULL == fp)
+    {
+        FIREWALL_DEBUG("[%s:%d] fopen failed\n" COMMA __FUNCTION__ COMMA __LINE__);
+        return -1;
+    }
+    while ((nread = getline(&line, &len, fp)) != -1)
+    {
+        if (line != NULL && strlen(line) > 0)
+        {
+            line[strlen(line) - 1] = '\0';
+            strtok_r(line, " ", &saveptr);
+            ip_temp = strtok_r(NULL, " ", &saveptr);
+        }
+        if (ip_temp == NULL)
+        {
+            FIREWALL_DEBUG("[%s:%d] ip_temp is NULL \n" COMMA __FUNCTION__ COMMA __LINE__);
+            fclose(fp);
+            fp = NULL;
+            if (line)
+            {
+                free(line);
+                line = NULL;
+            }
+            return -1;
+        }
+        ip = strstr(ip_temp, "=");
+        ret = IsRuleAdded(ip, IP_TYPE_IPV4);
+        if (-1 == ret)
+        {
+           FIREWALL_DEBUG("[%s:%d] IsIp4tablesRuleAdded failed\n" COMMA __FUNCTION__ COMMA __LINE__);
+        }
+        fprintf(mangle_fp, "-A FORWARD -s %s -o %s -j MARK --set-xmark 0x1\n",ip+1,current_wan_ifname);
+        fprintf(mangle_fp, "-A FORWARD -d %s -i %s -j MARK --set-xmark 0x2\n",ip+1,current_wan_ifname);
+        fprintf(mangle_fp, "-A TRAFFIC_ACCT -m mark --mark 0x1 -s %s -j ACCEPT\n",ip+1);
+        fprintf(mangle_fp, "-A TRAFFIC_ACCT -m mark --mark 0x2 -d %s -j ACCEPT\n",ip+1);
+    }
+    fclose(fp);
+    fp = NULL;
+    if (line)
+    {
+       free(line);
+       line = NULL;
+    }
+    return 0;
+}
