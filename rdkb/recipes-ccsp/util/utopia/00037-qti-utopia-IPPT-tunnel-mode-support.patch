+# ippt_add_dhcp_pkt_mark
+# Brief  : Configures policy-based routing to steer fwmark-tagged DHCP packets
+#          through a custom routing table when IP Passthrough (IPPT) is enabled.
+# Details: - Enables proxy ARP on the LAN interface.
+#          - Assigns a firewall mark (fwmark) and a custom routing table ID via syscfg.
+#          - Installs an ip rule so that packets carrying the fwmark are looked up
+#            in the custom routing table instead of the main table.
+#          - Moves the cellular WAN gateway route from the kernel local table to the
+#            custom table, ensuring only fwmark-tagged DHCP packets can reach the
+#            bridge gateway.
+# Params : None
+# Return : None  (returns early if IPPT is not enabled or gateway route is absent)
+ippt_add_dhcp_pkt_mark()
+{
+   lan_iface=$(syscfg get lan_ifname)
+   echo 1 > /proc/sys/net/ipv4/conf/$lan_iface/proxy_arp
+
+   wan_ipaddr=$(sysevent get cellular_wan_v4_gw)
+   IPPT_fwmark="0x100"
+   custom_rt="100"
+
+   syscfg set IPPT_fwmark $IPPT_fwmark
+   syscfg set custom_rt $custom_rt
+
+   local is_rule_present=$(ip rule show | grep $custom_rt)
+   if [ -z "$is_rule_present" ]; then
+      # Adds a policy routing rule — any packet with fwmark will be looked up in the custom_rt routing table instead of the main table
+      ip rule add fwmark $IPPT_fwmark table $custom_rt
+   fi
+
+   #Get the public gateway based route of ippt_bridge
+   local gw_route=$(ip route show table local | grep "local $wan_ipaddr")
+   if [ -z "$gw_route" ]; then
+      echo_t "ippt_add_dhcp_mark_pkts: Gateway route for bridge in main routing table not found"
+      return
+   fi
+
+   # Shift bridge gateway IP from the kernel's local table to the custom table, so only fwmark-tagged DHCP packets can reach the bridge gateway
+   ip route del $gw_route table local
+   ip route add $gw_route table $custom_rt
+}
+
+# ippt_del_dhcp_pkt_mark
+# Brief  : Tears down the policy-based routing configuration installed by
+#          ippt_add_dhcp_pkt_mark when IP Passthrough (IPPT) is disabled.
+# Details: - Disables proxy ARP on the LAN interface.
+#          - Restores the cellular WAN gateway route from the custom routing table
+#            back to the kernel local table.
+#          - Removes the ip rule that directed fwmark-tagged packets to the custom
+#            routing table.
+#          - Clears the persisted fwmark and custom routing table ID from syscfg.
+# Params : None
+# Return : None  (returns early if fwmark or custom_rt are not set in syscfg)
+ippt_del_dhcp_pkt_mark()
+{
+   lan_iface=$(syscfg get lan_ifname)
+   echo 0 > /proc/sys/net/ipv4/conf/$lan_iface/proxy_arp
+
+   wan_ipaddr=$(sysevent get cellular_wan_v4_gw)
+   IPPT_fwmark=$(syscfg get IPPT_fwmark)
+   custom_rt=$(syscfg get custom_rt)
+
+   if [ -z "$IPPT_fwmark" ] || [ -z "$custom_rt" ]; then
+      echo_t "ippt_del_dhcp_pkt_mark: fwmark or custom_rt not set, nothing to clean up"
+      return
+   fi
+
+   local gw_route=$(ip route show table $custom_rt | grep "local $wan_ipaddr")
+   if [ -n "$gw_route" ]; then
+      ip route del $gw_route table $custom_rt
+      ip route add $gw_route table local
+   else
+      echo_t "ippt_del_dhcp_pkt_mark: Gateway route not found in $custom_rt table, skipping route restore"
+   fi
+
+   local is_rule_present=$(ip rule show | grep $custom_rt)
+   if [ -n "$is_rule_present" ]; then
+      ip rule del fwmark $IPPT_fwmark table $custom_rt
+   fi
+
+   syscfg set IPPT_fwmark ""
+   syscfg set custom_rt ""
+}
