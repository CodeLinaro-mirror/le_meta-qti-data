    return ;
 }
 
+/*
+ *  Procedure     : ippt_mark_dhcp_pkts
+ *  Purpose       : to mark DHCP packets for IP Passthrough routing via mangle rules
+ *  Parameters    :
+ *    mangle_fp          : An open file for mangle subtables
+ *    ippt_enable        : IPPT enable flag
+ *    current_wan_ifname : current WAN interface name
+ *    wanStatus          : current WAN status
+ *    lan_ifname         : LAN interface name
+ */
+void ippt_mark_dhcp_pkts(FILE *mangle_fp, char* ippt_enable, char* current_wan_ifname, char* wanStatus, char* lan_ifname){
+    char ippt_fwmark_str[16] = {0};
+    syscfg_get(NULL, "IPPT_fwmark",  ippt_fwmark_str,  sizeof(ippt_fwmark_str));
+    if ((strcmp(ippt_enable, "true") == 0) &&
+        (strstr(current_wan_ifname, "qmapmux") != NULL) &&
+        (strcmp(wanStatus, "started") == 0) &&
+        (ippt_fwmark_str[0] != '\0'))
+    {
+        // Mark DHCP Discover/Request from LAN client, route via custom_rt
+        fprintf(mangle_fp,
+            "-A PREROUTING -i %s -p udp --dport 67 -j MARK --set-mark %s\n",
+            lan_ifname, ippt_fwmark_str);
+
+        // Mark DHCP Release from router toward LAN client, route via custom_rt
+        fprintf(mangle_fp,
+            "-A OUTPUT -o %s -p udp --dport 67 -j MARK --set-mark %s\n",
+            lan_ifname, ippt_fwmark_str);
+    }
+}
+
 #endif
