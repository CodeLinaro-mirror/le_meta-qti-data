Index: git/source/service_routed/service_routed_extn_qti.c
===================================================================
--- /dev/null
+++ git/source/service_routed/service_routed_extn_qti.c
@@ -0,0 +1,261 @@
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include "service_routed_extn_qti.h"
+#include "syscfg/syscfg.h"
+#include "sysevent/sysevent.h"
+#include "secure_wrapper.h"
+
+/*
+ * ipv6_to_str - Converts raw IPv6 bytes to prefix string
+ * Moved from service_routed.c
+ */
+static void ipv6_to_str(char *str, char *addr)
+{
+    snprintf(str, MAX_LAN_PREFIX_LEN,
+             "%02x%02x:%02x%02x:%02x%02x:%02x%02x::",
+             (int)addr[0], (int)addr[1],
+             (int)addr[2], (int)addr[3],
+             (int)addr[4], (int)addr[5],
+             (int)addr[6], (int)addr[7]);
+}
+
+/*
+ * fun_power - Calculates x^y
+ * Moved from service_routed.c
+ */
+static int fun_power(int x, int y)
+{
+    int power = 1;
+    int i;
+    for (i = 1; i <= y; i++)
+        power = power * x;
+    return power;
+}
+
+/*
+ * gen_pd_zebra_conf - PD prefix derivation logic
+ * Moved from gen_zebra_conf() in service_routed.c
+ */
+int gen_pd_zebra_conf(FILE *fp, int sefd, token_t setok,
+                       char *wan_st, char *valid_lft,
+                       char *preferred_lft,
+                       char *default_wan_interface,
+                       char *wan_interface)
+{
+    char pd_enable[8]              = {0};
+    char lan_prefixes[64]          = {0};
+    char lan_prefix_update[8]      = {0};
+    char prev_lan_prefixes[64]     = {0};
+    char prev_lan_prefix_update[8] = {0};
+    char prefix[64]                = {0};
+    struct in6_addr buffer;
+    unsigned int lan_prefixes_length_value = 0;
+    int NoOfBitsPrefixes, TotalPrefix;
+    int hex = 0;
+    int start_bit_index = 0;
+    int clearbits = 0xF0;
+
+    /* PD_enable is only applicable in cellular mode */
+    syscfg_get(NULL, "PD_enable", pd_enable, sizeof(pd_enable));
+
+    memset(lan_prefixes, 0, sizeof(lan_prefixes));
+    memset(lan_prefix_update, 0, sizeof(lan_prefix_update));
+    sysevent_get(sefd, setok, "lan-prefixes",
+                 lan_prefixes, sizeof(lan_prefixes));
+    sysevent_get(sefd, setok, "lan-prefix-update",
+                 lan_prefix_update, sizeof(lan_prefix_update));
+
+    /* syscfg fallback - survives zebra-restart event */
+    if (!strlen(lan_prefixes))
+        syscfg_get(NULL, "lan-prefixes",
+                   lan_prefixes, sizeof(lan_prefixes));
+    if (!strlen(lan_prefix_update))
+        syscfg_get(NULL, "lan-prefix-update",
+                   lan_prefix_update, sizeof(lan_prefix_update));
+    /* Also restore ipv6_prefix sysevent if empty */
+    if (!strlen(lan_prefixes)) {
+    syscfg_get(NULL, "lan-prefixes", lan_prefixes, sizeof(lan_prefixes));
+        if (strlen(lan_prefixes)) {
+            char prefixlen_str[8] = {0};
+            syscfg_get(NULL, "lan-prefix-update", prefixlen_str, sizeof(prefixlen_str));
+            char ipv6_pref[72] = {0};
+            snprintf(ipv6_pref, sizeof(ipv6_pref), "%s/%s", lan_prefixes, prefixlen_str);
+            sysevent_set(sefd, setok, "ipv6_prefix", ipv6_pref, 0);
+            sysevent_set(sefd, setok, "lan-prefixes", lan_prefixes, 0);
+            sysevent_set(sefd, setok, "lan-prefix-update", prefixlen_str, 0);
+        }
+    }
+
+    lan_prefixes_length_value = atoi(lan_prefix_update);
+
+    if ((strcmp(pd_enable, "1") == 0) && strlen(lan_prefixes) &&
+        (lan_prefixes_length_value > 0) &&
+        (lan_prefixes_length_value <= MAX_LAN_PREFIX_LEN))
+    {
+        NoOfBitsPrefixes = MAX_LAN_PREFIX_LEN - lan_prefixes_length_value;
+        TotalPrefix = fun_power(2, NoOfBitsPrefixes);
+
+        inet_pton(AF_INET6, lan_prefixes, &buffer);
+        unsigned char *ip = buffer.s6_addr;
+
+        start_bit_index = lan_prefixes_length_value / 8;
+
+        if ((lan_prefixes_length_value > 0) &&
+            (lan_prefixes_length_value < MAX_LAN_PREFIX_LEN))
+        {
+            fprintf(stderr,
+                    "prefix length is %d, total prefixes possible is %d\n",
+                    lan_prefixes_length_value, TotalPrefix);
+
+            if (lan_prefixes_length_value < MIN_LAN_PREFIX_LEN ||
+                lan_prefixes_length_value % 4 == 0)
+            {
+                clearbits = 0xF0;
+                if (lan_prefixes_length_value < MIN_LAN_PREFIX_LEN)
+                    start_bit_index = 7;
+            }
+            else if (lan_prefixes_length_value % 4 == 1)
+            {
+                clearbits = 0xF8;
+            }
+            else if (lan_prefixes_length_value % 4 == 2)
+            {
+                clearbits = 0xFC;
+            }
+            else if (lan_prefixes_length_value % 4 == 3)
+            {
+                clearbits = 0xFE;
+            }
+
+            ip[start_bit_index] &= clearbits;
+            hex = ip[start_bit_index];
+            for (int i = 0, j = hex;
+                 i < MAX_PREFIXES && i < TotalPrefix; j++, i++)
+            {
+                ip[start_bit_index] |= j;
+                memset(prefix, 0, sizeof(prefix));
+                ipv6_to_str(prefix, (char *)ip);
+
+                if (strlen(prefix))
+                {
+#ifdef WAN_FAILOVER_SUPPORTED
+                    if (strcmp(default_wan_interface,
+                               wan_interface) != 0)
+                    {
+                        fprintf(fp,
+                            "   ipv6 nd prefix %s/64 %s %s\n",
+                            prefix, valid_lft, preferred_lft);
+                    }
+                    else
+#endif
+                    {
+                        if (strcmp(wan_st, "stopped") == 0)
+                        {
+                            fprintf(fp,
+                                "   ipv6 nd prefix %s/64 0 0\n",
+                                prefix);
+                        }
+                        else
+                        {
+                            fprintf(fp,
+                                "   ipv6 nd prefix %s/64 %s %s\n",
+                                prefix, valid_lft, preferred_lft);
+                        }
+                    }
+                }
+                ip[start_bit_index] &= clearbits;
+            }
+
+            memset(prev_lan_prefixes, 0, sizeof(prev_lan_prefixes));
+            memset(prev_lan_prefix_update, 0,
+                   sizeof(prev_lan_prefix_update));
+            syscfg_get(NULL, "prev-wan6-prefix",
+                       prev_lan_prefixes, sizeof(prev_lan_prefixes));
+            syscfg_get(NULL, "prev-wan6-prefixlen",
+                       prev_lan_prefix_update,
+                       sizeof(prev_lan_prefix_update));
+
+            if ((strcmp(prev_lan_prefixes, lan_prefixes) != 0) ||
+                (strcmp(prev_lan_prefix_update,
+                        lan_prefix_update) != 0))
+            {
+                v_secure_system(
+                    "ip -6 addr del %s/%d dev brlan0",
+                    prev_lan_prefixes,
+                    atoi(prev_lan_prefix_update));
+            }
+
+            v_secure_system("ip -6 addr add %s/%d dev brlan0",
+                            lan_prefixes, lan_prefixes_length_value);
+
+            /* Save to syscfg for persistence */
+            syscfg_set_commit(NULL, "lan-prefixes", lan_prefixes);
+            syscfg_set_commit(NULL, "lan-prefix-update",
+                              lan_prefix_update);
+            syscfg_set_commit(NULL, "prev-wan6-prefix",
+                              lan_prefixes);
+            syscfg_set_commit(NULL, "prev-wan6-prefixlen",
+                              lan_prefix_update);
+
+            v_secure_system("ethtool -r eth0");
+            v_secure_system("ethtool -r eth1");
+            v_secure_system(
+                "nohup /sbin/start_usb restart "
+                "</dev/null >/dev/null 2>&1");
+        }
+        else if (lan_prefixes_length_value == MAX_LAN_PREFIX_LEN)
+        {
+            fprintf(fp, "   ipv6 nd prefix %s %s %s\n",
+                    prefix, valid_lft, preferred_lft);
+        }
+        else
+        {
+            fprintf(stderr,
+                    "Unknown error prefix length is %d \n",
+                    lan_prefixes_length_value);
+        }
+    }
+    else
+    {
+        memset(prev_lan_prefixes, 0, sizeof(prev_lan_prefixes));
+        memset(prev_lan_prefix_update, 0,
+               sizeof(prev_lan_prefix_update));
+        syscfg_get(NULL, "prev-wan6-prefix",
+                   prev_lan_prefixes, sizeof(prev_lan_prefixes));
+        syscfg_get(NULL, "prev-wan6-prefixlen",
+                   prev_lan_prefix_update,
+                   sizeof(prev_lan_prefix_update));
+
+        if ((strlen(prev_lan_prefixes) != 0) ||
+            (strlen(prev_lan_prefix_update) != 0))
+        {
+            v_secure_system(
+                "ip -6 addr del %s/%d dev brlan0",
+                prev_lan_prefixes,
+                atoi(prev_lan_prefix_update));
+            syscfg_set_commit(NULL, "prev-wan6-prefix", "");
+            syscfg_set_commit(NULL, "prev-wan6-prefixlen", "");
+            /* Clear saved wan6 values on PD disable */
+            syscfg_set_commit(NULL, "lan-prefixes", "");
+            syscfg_set_commit(NULL, "lan-prefix-update", "");
+        }
+        if (strcmp(pd_enable, "1") == 0)
+        {
+            fprintf(stderr,
+                    "PD enable however unknown prefix {%s} "
+                    "prefix length {%d} hence fallback to "
+                    "prefix sharing\n",
+                    lan_prefixes, lan_prefixes_length_value);
+        }
+        return 1;
+    }
+    return 0;
+}
