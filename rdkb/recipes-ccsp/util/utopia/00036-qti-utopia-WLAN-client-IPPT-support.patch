From a2076f78b9fd0dd6b27bf24e140f1aef75961ce8 Mon Sep 17 00:00:00 2001
From: Nandakishore S <nans@qti.qualcomm.com>
Date: Wed, 2 Sep 2026 04:28:09 +0000
Subject: [PATCH] Added WLAN client support for IPPT

Signed-off-by: Nandakishore S <nans@qti.qualcomm.com>
---
 source/scripts/init/service.d/service_lan.sh | 38 ++++++++++++++------
 1 file changed, 28 insertions(+), 10 deletions(-)

Index: git/source/scripts/init/service.d/service_lan.sh
===================================================================
--- git.orig/source/scripts/init/service.d/service_lan.sh
+++ git/source/scripts/init/service.d/service_lan.sh
@@ -280,16 +280,33 @@ toggling_wifi_clients() {
     for token in "${wifiInterfaces[@]}"; do
         isDisabled=$(syscfg get wireless.$token.disabled)
         if [ "$isDisabled" != "1" ]; then  # Check if interface is enabled
-           interfaces=$(grep -rl "$token" /sys/class/net/ath*/parent | awk -F/ '{print $(NF-1)}')
-           if [ -n "$interfaces" ]; then
-              for ath in $interfaces; do
-                  status=$(ifconfig "$ath" | grep RUNNING | tr -s ' ' | cut -d ' ' -f4)
-                  if [ "$status" == "RUNNING" ]; then
-                     ip link set "$ath" down    # Bring interface down
-                     my_array+=("$ath")
-                  fi
-              done
-           fi  # end of ath interfaces check
+           if [ "$IPPT_Enable" == "true" ] && [ "$IPPT_ClientType" == "4" ]; then
+                interface_found=0
+                for path in /sys/class/net/ath*/parent; do
+                    [ -e "$path" ] || continue
+                    if grep -q "$token" "$path"; then
+                        ath_iface=$(basename "$(dirname "$path")")
+                        hostapd_cli -i "$ath_iface" -p /var/run/hostapd-${token}/ disassociate "$IPPT_MAC"
+                        interface_found=1
+                    fi
+                done
+                if [ $interface_found -eq 0 ]; then
+                    echo "Warning [service_lan.sh:toggling_wifi_clients]: No matching interface found for token $token"
+                fi
+            else
+                interfaces=()
+                for path in /sys/class/net/ath*/parent; do
+                    [ -e "$path" ] || continue
+                    if grep -q "$token" "$path"; then
+                        iface=$(basename "$(dirname "$path")")
+                        status=$(syscfg get "wireless.${iface}.Enable")
+                        if [[ "$status" == "1" ]]; then
+                           ip link set "$iface" down
+                           my_array+=("$iface")
+                        fi
+                    fi
+                 done
+            fi # end of IPPT check
         fi  # end of isDisabled check
     done
     for ath in "${my_array[@]}"; do
@@ -941,6 +958,8 @@ case "$1" in
                  ifconfig ecm0 169.254.1.40
               fi
            fi
+       elif [ "$IPPT_Enable" = "true" ] && [ "$IPPT_Mode" = "$IPPT_WITH_NAT" ] && [ "$IPPT_ClientType" = "$IPPT_CLIENTTYPE_WLAN" ]; then
+           toggling_wifi_clients    
        else
          if ([ "$CMD1" = "1" ]); then
             ethtool -r eth0
