Index: git/source/scripts/init/service.d/service_lan_extn_qti.sh
===================================================================
--- /dev/null
+++ git/source/scripts/init/service.d/service_lan_extn_qti.sh
@@ -0,0 +1,104 @@
+#!/bin/sh
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+qti_vconfig_set()
+{
+   if [ -n "$SYSCFG_lan_ethernet_virtual_ifnums" ] ; then
+
+   IFS=','
+   base_ip="169.254.1.50"
+   REPLACEMENT=`ip link show "$1" | grep link | awk '{print $2}'`
+   for loop in $SYSCFG_lan_ethernet_virtual_ifnums
+   do
+      echo "[utopia] [interface] loop: $loop" > /dev/console
+      if [ "1" != "$loop" ] ; then
+         vconfig set_name_type DEV_PLUS_VID_NO_PAD
+
+         vconfig add "$1" "$loop"
+         vconfig set_ingress_map "$1"".""$loop" 0 0
+         vconfig set_ingress_map "$1"".""$loop" 1 1
+         vconfig set_ingress_map "$1"".""$loop" 2 2
+         vconfig set_ingress_map "$1"".""$loop" 3 3
+         vconfig set_ingress_map "$1"".""$loop" 4 4
+         vconfig set_ingress_map "$1"".""$loop" 5 5
+         vconfig set_ingress_map "$1"".""$loop" 6 6
+         vconfig set_ingress_map "$1"".""$loop" 7 7
+         ip link set "$1"".""$loop" mtu 1500
+
+         # vconfig is not ensuring that a vlan's mac address is unique
+         # so we need to do it
+         # if the vlan mac has already been specified
+         # then we will use that value, otherwise
+         # our approach is to consider vlan1 the normal mac
+         # and to increment each subsequent vlan mac by 1
+         ip link set "$1"".""$loop" up
+         INCR_AMOUNT=`expr "$loop" - 1`
+         OUR_MAC=`get_mac "$1"".""$loop"`
+         REPLACEMENT=`incr_mac "$OUR_MAC" "$INCR_AMOUNT"`
+         ip link set "$1"".""$loop" addr "$REPLACEMENT"
+         echo "[utopia] [interface] Changing hw address to $REPLACEMENT" > /dev/console
+         ifconfig "$1"".""$loop" $base_ip
+         ip link set dev "$1"".""$loop" master brlan0
+         brctl delif brlan0 "$1" 2>/dev/null
+         base_ip=$(echo "$base_ip" | awk -F. '{print $1"."$2"."$3"."$4+1}')
+      fi
+     done
+   fi
+}
+
+qti_unconfig_vlan_set()
+{
+   SYSCFG_lan_ethernet_prev_virtual_ifnums=`syscfg get lan_ethernet_prev_virtual_ifnums`
+   SYSCFG_lan_ethernet_virtual_ifnums=`syscfg get lan_ethernet_virtual_ifnums`
+   # To bring down VLAN interfaces by checking syscfg lan_ethernet_prev_virtual_ifnums
+   for loop in $SYSCFG_lan_ethernet_prev_virtual_ifnums
+   do
+      if [ "1" != "$loop" ] ; then
+         ip link set "$1"".""$loop" down
+         vconfig rem "$1"".""$loop"
+      fi
+   done
+   # To bring down VLAN interfaces by checking syscfg lan_ethernet_virtual_ifnums
+   for loop in $SYSCFG_lan_ethernet_virtual_ifnums
+   do
+      if [ "1" != "$loop" ] ; then
+         ip link set "$1"".""$loop" down
+         vconfig rem "$1"".""$loop"
+      fi
+   done
+   unset IFS
+   syscfg set lan_ethernet_prev_virtual_ifnums $SYSCFG_lan_ethernet_virtual_ifnums
+}
+
+qti_enslaving_to_bridge()
+{
+   val=`syscfg get lan_vlan_enable`
+   if [ "$val" -eq 1 ]; then
+       if [ "$1" != "eth1" ]; then
+           brctl addif "$2" "$1"
+       fi
+   else
+       brctl addif "$2" "$1"
+fi
+}
+
+qti_interface_teardown()
+{
+      SYSCFG_lan_vlan_enable=`syscfg get lan_vlan_enable`
+      IFS=,
+      for loop in $SYSCFG_lan_ethernet_physical_ifnames
+      do
+         if [ "eth0" != "$loop" ]; then
+             echo "[lan] calling unconfig_vlan with $loop " >> /dev/console
+             unconfig_vlan "$loop"
+         fi
+         ip link set $loop down
+      done
+      val=`syscfg get lan_ethernet_virtual_ifnums`
+      if [ "1" != "$SYSCFG_lan_vlan_enable" ] && [ "1" != val ]; then
+          syscfg set lan_ethernet_prev_virtual_ifnums 1
+          syscfg set lan_ethernet_virtual_ifnums 1
+          syscfg commit
+      fi
+}
