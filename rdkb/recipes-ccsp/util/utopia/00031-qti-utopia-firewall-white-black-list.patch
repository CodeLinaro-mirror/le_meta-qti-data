+ *  Purpose       : Delete the IPv4 conntrack entry which is not part
+                    of the rule
+ *  Parameters    :
+ *   protocol_num : protocol
+ *   idx          : rule index
+ *  Return Values :
+ *     TRUE       : SUCCESS
+ *     FALSE      : FAILURE
+ *********************************************************/
+bool DeleteConntrackEntryForAcceptIPv4FirewallEntries(int protocol_num, int idx)
+{
+    char command[MAX_COMMAND_STR_LEN]={0};
+    char source_port[16]={0};
+    char destination_port[16]={0};
+    char source_ip[16]={0};
+    char dest_ip[16]={0};
+    char prot[12]={0};
+    char tmp[MAX_COMMAND_STR_LEN]={0};
+    char namespace[MAX_NAMESPACE]={0};
+    char *ptr;
+    char query[MAX_QUERY]={0};
+    char lan_ip[64]={0};
+    char *line = NULL;
+    size_t len = 0;
+    ssize_t read;
+    snprintf(query, sizeof(query), "X_QCOMRule_%d", idx);
+    syscfg_get(NULL, query, namespace, sizeof(namespace));
+    syscfg_get(namespace, "Protocol", prot, sizeof(prot));
+    syscfg_get(namespace, "SourcePort", source_port, sizeof(source_port));
+    syscfg_get(namespace, "DestinationPort", destination_port, sizeof(destination_port));
+    syscfg_get(namespace, "SourceIPAddr", source_ip, sizeof(source_ip));
+    syscfg_get(namespace, "DestinationIPAddr", dest_ip,sizeof(dest_ip));
+    syscfg_get(NULL, "lan_ipaddr", lan_ip, sizeof(lan_ip));
+
+    switch (protocol_num) {
+        case PROTOCOL_TCP:
+            //Adding grep -v gateway IPv4 as  source IPv4 and tcp to the conntrack searching rule and saving to CONNTRACK_ENTRIES
+            snprintf(command, MAX_COMMAND_STR_LEN, "conntrack -L | cut -f1,10,11,12,13 -d ' ' | grep -v -w src=%s | grep tcp > %s", lan_ip, CONNTRACK_ENTRIES);
+            break;
+
+        case PROTOCOL_UDP:
+            //Adding grep -v gateway IPv4 as source IPv4 and udp to the conntrack searching rule and saving to CONNTRACK_ENTRIES
+            snprintf(command, MAX_COMMAND_STR_LEN, "conntrack -L | cut -f1,9,10,11,12 -d ' ' | grep -v -w src=%s | grep udp > %s", lan_ip, CONNTRACK_ENTRIES);
+            break;
+
+        default:
+            return FALSE;
+    }
+
+    system(command);
+    FILE *fp = fopen(CONNTRACK_ENTRIES, "r");
+    if (fp == NULL) {
+        return FALSE;
+    }
+    //Reading line by line from CONNTRACK_ENTRIES
+    while (((read = getline(&line, &len, fp)) != -1)) {
+        char *protocol=NULL, *saddr=NULL, *daddr=NULL, *sport=NULL, *dport=NULL;
+
+        protocol = strtok_r(line, " ", &ptr);
+        saddr = strtok_r(NULL, " ", &ptr);
+        if(saddr)
+            *(saddr + 3) = ' ';
+        daddr = strtok_r(NULL, " ", &ptr);
+        if(daddr)
+            *(daddr + 3) = ' ';
+        sport = strtok_r(NULL, " ", &ptr);
+        if(sport)
+            *(sport + 5) = ' ';
+        dport = strtok_r(NULL, "\n", &ptr);
+        if(dport)
+            *(dport + 5) = ' ';
+        //To get source address from current conntrack line
+        if (saddr)
+            saddr = saddr+4;
+        //To get destination address from current conntrack line
+        if (daddr)
+            daddr = daddr+4;
+        //To get source port from current conntrack line
+        if (sport)
+            sport = sport+6;
+        //To get destination port from current conntrack line
+        if(dport)
+            dport =dport+6;
+
+      	if (!saddr || !daddr || !sport || !dport)
+            continue;   // skip malformed line
+
+	//goto delete entry if prot doesnot match with current conntrack line protocol
+        if (strcmp("tcp", prot) == 0 || strcmp("udp", prot) == 0){
+            if (strcmp(protocol,prot)!=0 && '\0' != prot[0])
+                goto delete_entry;
+        }
+        if (strcmp("tcp_udp", prot) == 0){ // for tcp and udp
+            if (strcmp(protocol, "tcp")!=0 && '\0' != prot[0])
+                goto delete_entry;
+            else if (strcmp(protocol, "udp")!=0 && '\0' != prot[0])
+                goto delete_entry;
+        }
+        //goto delete entry if source_port doesnot match with current conntrack line sport
+        if (strcmp(sport,source_port)!=0 && '\0' != source_port[0] && '0'!=source_port[0] )
+            goto delete_entry;
+        //goto delete entry if destination_port doesnot match with current conntrack line dport
+        if (strcmp(dport,destination_port)!=0 && '\0' != destination_port[0] && '0'!=destination_port[0])
+            goto delete_entry;
+        //continue if source ip and destination ip or WAN IPv4 matches with current conntrack line
+        //or if source IP and destination IP both 0.0.0.0
+        //or if source IP matches and destination IP 0.0.0.0
+        //or if source Ip 0.0.0.0 and destination IP matches
+        if (strcmp(saddr, source_ip) == 0 || strcmp("0.0.0.0",source_ip) == 0) {
+            if (strcmp(daddr,dest_ip) == 0 || strcmp("0.0.0.0",dest_ip) == 0 || (strcmp(daddr,current_wan_ipaddr) == 0 ))
+                continue;
+        }
+
+        delete_entry:
+        memset(tmp,0,MAX_COMMAND_STR_LEN);
+        //Creating conntrack deletion command based on protocol saddr sport and dport
+        snprintf(command, MAX_COMMAND_STR_LEN, "conntrack -D");
+        if (protocol) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " -p %s", protocol);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (saddr) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, "  --orig-src %s", saddr);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (sport) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " --sport %s", sport);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (dport) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " --dport %s", dport);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        //To delete conntrack entry
+        system(command);
+    }
+
+    if(fp)
+    {
+        fclose(fp);
+        fp=NULL;
+    }
+    if(line)
+    {
+        free(line);
+        line=NULL;
+    }
+    //To remove CONNTRACK_ENTRIES
+    snprintf(command, MAX_COMMAND_STR_LEN, "rm -rf %s", CONNTRACK_ENTRIES);
+    system(command);
+    return TRUE;
+}
