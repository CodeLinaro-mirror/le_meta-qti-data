+    //Reading line by line from CONNTRACK_ENTRIES
+    while (((read = getline(&line, &len, fp)) != -1)) {
+        char *protocol=NULL, *saddr=NULL, *daddr=NULL, *sport=NULL, *dport=NULL;
+        protocol = strtok_r(line, " ", &ptr);
+        saddr = strtok_r(NULL, " ", &ptr);
+        if(saddr)
+            *(saddr + 3) = ' ';
+        daddr = strtok_r(NULL, " ", &ptr);
+        if(daddr)
+            *(daddr + 3) = ' ';
+        sport = strtok_r(NULL, " ", &ptr);
+        if(sport)
+            *(sport + 5) = ' ';
+        dport = strtok_r(NULL, "\n", &ptr);
+        if(dport)
+            *(dport + 5) = ' ';
+        //To get source IPv6 address from current conntrack line
+        if (saddr)
+            saddr = saddr + 4;
+        //To get destination IPv6 address from current conntrack line
+        if (daddr)
+            daddr = daddr+4;
+        //To get source port from current conntrack line
+        if (sport)
+            sport = sport+6;
+        //To get destination port from current conntrack line
+        if(dport)
+            dport =dport+6;
+
+        if (!saddr || !daddr || !sport || !dport)
+            continue;  // skip malformed line
+
+        //goto delete entry if prot doesnot match with current conntrack line protocol
+        if (strcmp("tcp", prot) == 0 || strcmp("udp", prot) == 0){
+            if (strcmp(protocol,prot)!=0 && '\0' != prot[0])
+                goto delete_entry;
+        }
+        if (strcmp("tcp_udp",prot) == 0){
+            if (strcmp(protocol, "tcp")!=0 && '\0' != prot[0])
+                goto delete_entry;
+            else if (strcmp(protocol, "udp")!=0 && '\0' != prot[0])
+                goto delete_entry;
+        }
+	//goto delete entry if source_port doesnot match with current conntrack line sport
+        if (strcmp(sport,source_port)!=0 && '\0' != source_port[0] && '0'!=source_port[0] )
+            goto delete_entry;
+        //goto delete entry if destination_port doesnot match with current conntrack line dport
+        if (strcmp(dport,destination_port)!=0 && '\0' != destination_port[0] && '0'!=destination_port[0])
+            goto delete_entry;
+        //continue if source IPv6 and destination IPv6 matches with current conntrack line
+        //or if source IPv6 not set and destination IPv6 matches with current conntrack line
+        //or if source IPv6 and destination IPv6 not set
+        if (strcmp(saddr, source_ipv6) == 0 || '\0' == source_ipv6[0]) {
+            if (strcmp(daddr,destination_ipv6) == 0 || '\0' == destination_ipv6[0])
+                continue;
+        }
+        delete_entry:
+        //Creating conntrack deletion command based on protocol saddr sport and dport
+        memset(tmp,0,MAX_COMMAND_STR_LEN);
+        snprintf(command, MAX_COMMAND_STR_LEN, "conntrack -D -f ipv6");
+        if (protocol) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " -p %s", protocol);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (saddr) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, "  --orig-src %s", saddr);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (sport) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " --sport %s", sport);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (dport) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " --dport %s", dport);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        system(command);
+        memset(command, 0, MAX_COMMAND_STR_LEN);
+    }
+
+    if(fp)
+    {
+        fclose(fp);
+        fp=NULL;
+    }
+    if(line)
+    {
+        free(line);
+        line=NULL;
+    }
+    //To remove CONNTRACK_ENTRIES
+    snprintf(command, MAX_COMMAND_STR_LEN, "rm -rf %s", CONNTRACK_ENTRIES_V6);
+    system(command);
+
+    return TRUE;
+}
