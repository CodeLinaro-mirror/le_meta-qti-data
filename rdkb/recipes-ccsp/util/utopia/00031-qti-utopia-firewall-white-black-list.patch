+/*********************************************************
+ *  Procedure     : do_x_qcomrule_firewall_v6
+ *  Purpose       : prepare the ip6tables-restore statements for
+                    whitelist & blacklist
+ *  Parameters    :
+ *     fp         : An open file that will be used for ip6tables-restore
+ *  Return Values :
+ *     0          : done
+ *********************************************************/
+
+int do_x_qcomrule_firewall_v6(FILE* mangle_fp)
+{
+    /*
+     * syscfg tuple X_QCOMRule_x, where x is a digit
+     * keeps track of the syscfg namespace of a defined firewall X_QCOMRule.
+     * We iterate through these tuples until we dont find another instance in syscfg.
+     */
+
+    int idx=0;
+    char namespace[MAX_NAMESPACE]={0}; //This variable holds the namespace for the current rule being processed using query variable.
+    char query[MAX_QUERY]={0};  //store the name of the configuration parameter being queried from the system configuration (syscfg_get).
+    int  rc=0;
+    int  count=0;
+    FIREWALL_DEBUG("Entering do_x_qcomrule_firewall_v6\n");
+
+    /**Rule_Enable**/
+    rc = syscfg_get(NULL, "firewall_rule_type", query, sizeof(query));
+    // Adding the DROP rule for marked packet in case of Blacklist in PREROUTING to handle DL and POSTROUTING to handle UL
+    if  (strncasecmp(query, "Blacklist", strlen("Blacklist")) == 0)
+    {
+        fprintf(mangle_fp,"-I PREROUTING -m connmark --mark 53 -j DROP\n");
+        fprintf(mangle_fp,"-I POSTROUTING -m connmark --mark 53 -j DROP\n");
+    }
+    // Adding the ACCEPT rule for marked packet and default DROP rule for rest in case of Whitelist in PREROUTING to handle DL and POSTROUTING to handle UL
+    else if(strncasecmp(query, "Whitelist", strlen("Whitelist")) == 0)
+    {
+        fprintf(mangle_fp,"-A PREROUTING -i %s -j DROP\n",current_wan_ifname);
+        fprintf(mangle_fp,"-I POSTROUTING -o %s -j DROP\n",current_wan_ifname);
+        fprintf(mangle_fp,"-I POSTROUTING -m connmark --mark 53 -j ACCEPT\n");
+        fprintf(mangle_fp,"-I PREROUTING -m connmark --mark 53 -j ACCEPT\n");
+    }
+    else
+    {
+        FIREWALL_DEBUG("Exiting do_x_qcomrule_firewall_v6 as firewall type not Blacklist or Whitelist\n");
+        return -1;
+    }
+
+    // Finding X_QCOMRule_Count
+    query[0] = '\0';
+    rc = syscfg_get(NULL, "X_QCOMRule_Count", query, sizeof(query));
+    if (0 != rc || '\0' == query[0]) {
+        FIREWALL_DEBUG("Exiting do_x_qcomrule_firewall_v6 as syscfg X_QCOMRule_Count not available\n");
+        return -1;
+    }
+    else {
+        count = atoi(query);
+        if (0 == count) {
+            FIREWALL_DEBUG("Exiting do_x_qcomrule_firewall_v6 as X_QCOMRule_Count 0\n");
+            return -1;
+        }
+        if (MAX_SYSCFG_ENTRIES < count) {
+            count = MAX_SYSCFG_ENTRIES;
+        }
+    }
+    for (idx=1 ; idx<=count ; idx++)
+    {
+        char rule_udp[256]={0}; // For storing rule for udp if both tcp and udp.
+        int rule_form = 0;
+        char rule[256]={0};
+        char iptables_cmd[512]={0};  // For storing complete ip6tables command
+
+        namespace[0] = '\0';
+        snprintf(query, sizeof(query), "X_QCOMRule_%d", idx);
+        rc = syscfg_get(NULL, query, namespace, sizeof(namespace));
+        if (0 != rc || '\0' == namespace[0]) {
+            continue;
+        }
+
+        // Check Enable status first
+        query[0] = '\0';
+        rc = syscfg_get(namespace, "Enable", query, sizeof(query));
+        if (0 != rc || '\0' == query[0]) {
+            continue;
+        }
+
+        // Forming rule based on current firewall entry
+        char source_ipv6[64]={0};
+        rc = syscfg_get(namespace, "SourceIPv6Addr", source_ipv6, sizeof(source_ipv6));
+        if (0 == rc && '\0' != source_ipv6[0]) {
+            // Adding source IPv6 to rule
+            strlcat(rule, " -s ", sizeof(rule));
+            strlcat(rule, source_ipv6, sizeof(rule));
+            rule_form = 1;
+        }
+        char destination_ipv6[64]={0};
+        rc = syscfg_get(namespace, "DestinationIPv6Addr", destination_ipv6, sizeof(destination_ipv6));
+        if (0 == rc && '\0' != destination_ipv6[0]) {
+            // Adding Destination IPv6 to rule
+            strlcat(rule, " -d ", sizeof(rule));
+            strlcat(rule, destination_ipv6, sizeof(rule));
+            rule_form = 1;
+        }
+        char protocol[10]={0};
+        rc = syscfg_get(namespace, "Protocol", protocol, sizeof(protocol));
+        if (0 == rc && '\0' != protocol[0] ) {
+            // Adding protocol to rule
+            if (strcmp(protocol, "tcp") == 0 || strcmp(protocol, "udp") == 0){ //for tcp or udp
+                strlcat(rule, " -p ",sizeof(rule));
+                strlcat(rule, protocol, sizeof(rule));
+                rule_form = 1;
+            }
+            else if(strcmp(protocol, "tcp_udp") == 0){ //for tcp and udp
+                strlcpy(rule_udp, rule, sizeof(rule_udp));
+                strlcat(rule, " -p tcp",sizeof(rule));
+                strlcat(rule_udp, " -p udp",sizeof(rule_udp));
+            }
+            char source_port[15]={0};
+            rc = syscfg_get(namespace, "SourcePort", source_port, sizeof(source_port));
+            if (0 == rc && '\0' != source_port[0] && '0'!=source_port[0]) {
+                // Adding source port to rule
+                strlcat(rule, " --sport ", sizeof(rule));
+                strlcat(rule, source_port, sizeof(rule));
+                rule_form = 1;
+                if(strcmp(protocol, "tcp_udp") == 0){
+                    strlcat(rule_udp, " --sport ", sizeof(rule_udp));
+                    strlcat(rule_udp, source_port, sizeof(rule_udp));
+                    rule_form = 1;
+                }
+             }
+             char destination_port[15]={0};
+             rc = syscfg_get(namespace, "DestinationPort", destination_port, sizeof(destination_port));
+             if (0 == rc && '\0' != destination_port[0] && '0'!=destination_port[0]) {
+                 // Adding destination port to rule
+                 strlcat(rule, " --dport ", sizeof(rule));
+                 strlcat(rule, destination_port, sizeof(rule));
+                 if(strcmp(protocol, "tcp_udp") == 0){
+                     strlcat(rule_udp, " --dport ", sizeof(rule_udp));
+                     strlcat(rule_udp, destination_port, sizeof(rule_udp));
+                 }
+                 rule_form = 1;
+             }
+        }
+        char direction[15]={0};
+        rc = syscfg_get(namespace, "Direction", direction, sizeof(direction));
+
+        if (rule_form == 1) {
+            char firewall_rule_type[MAX_QUERY]={0};
+            rc = syscfg_get(NULL, "firewall_rule_type", firewall_rule_type, sizeof(firewall_rule_type));
+            v_secure_system("echo 0 > /proc/sys/net/netfilter/nf_conntrack_tcp_loose");
+            // Adding connmark 53 to rule
+            strlcat(rule, " -j CONNMARK --set-mark 53", sizeof(rule));
+            // Adding connmark 53 to rule for tcp_udp
+            if(strcmp(protocol, "tcp_udp") == 0)
+                strlcat(rule_udp, " -j CONNMARK --set-mark 53", sizeof(rule_udp));
+            if (0 == strcmp("0", query)) {
+                // Delete rule using ip6tables command
+                if (direction[0] != '\0' && strncasecmp(direction, "Uplink", strlen("Uplink")) == 0)
+                {
+                    snprintf(iptables_cmd, sizeof(iptables_cmd),"ip6tables -t mangle -D FORWARD -o %s %s",current_wan_ifname, rule);
+                }
+                else if (direction[0] != '\0' && strncasecmp(direction, "Downlink", strlen("Downlink")) == 0)
+                {
+                    snprintf(iptables_cmd, sizeof(iptables_cmd),"ip6tables -t mangle -D PREROUTING -i %s %s",current_wan_ifname, rule);
+                }
+                system(iptables_cmd);  // Execute the delete command
+                if(strcmp(protocol, "tcp_udp") == 0){
+                    strlcpy(iptables_cmd, "", sizeof(iptables_cmd));  // deleting the contents of iptables_cmd array for executing it for udp rule.
+                    if (direction[0] != '\0' && strncasecmp(direction, "Uplink", strlen("Uplink")) == 0)
+                    {
+                        snprintf(iptables_cmd, sizeof(iptables_cmd),"ip6tables -t mangle -D FORWARD -o %s %s",current_wan_ifname, rule_udp);
+                    }
+                    else if (direction[0] != '\0' && strncasecmp(direction, "Downlink", strlen("Downlink")) == 0)
+                    {
+                        snprintf(iptables_cmd, sizeof(iptables_cmd),"ip6tables -t mangle -D PREROUTING -i %s %s",current_wan_ifname, rule_udp);
+                    }
+                    system(iptables_cmd);  // Execute the delete command for udp
+                }
+                //To remove the existing conntrack entry rule if its whitelist
+                //as enable for the current rule is false
+                if (0 == rc && strncasecmp(firewall_rule_type, "Whitelist", strlen("Whitelist")) == 0)
+                {
+                    if (strcmp(protocol, "tcp") == 0)
+                        DeleteConntrackEntryForDropIPv6FirewallEntries(PROTOCOL_TCP, idx);
+                    else if (strcmp(protocol, "udp") == 0)
+                        DeleteConntrackEntryForDropIPv6FirewallEntries(PROTOCOL_UDP, idx);
+                    else
+                    {
+                        DeleteConntrackEntryForDropIPv6FirewallEntries(PROTOCOL_TCP, idx);
+                        DeleteConntrackEntryForDropIPv6FirewallEntries(PROTOCOL_UDP, idx);
+                    }
+                }
+            }
+            else {
+                // Add FORWARD marking rule to mangle file to handle UL and PREROUTING marking rule to handle DL
+                if (direction[0] != '\0' && strncasecmp(direction, "Uplink", strlen("Uplink")) == 0)
+                    fprintf(mangle_fp, "-I FORWARD -o %s %s\n", current_wan_ifname, rule);
+                else if (direction[0] != '\0' && strncasecmp(direction, "Downlink", strlen("Downlink")) == 0)
+                    fprintf(mangle_fp, "-I PREROUTING -i %s %s\n", current_wan_ifname, rule);
+                if(strcmp(protocol, "tcp_udp") == 0){
+                    if (direction[0] != '\0' && strncasecmp(direction, "Uplink", strlen("Uplink")) == 0)
+                        fprintf(mangle_fp, "-I FORWARD -o %s %s\n", current_wan_ifname, rule_udp);
+                    else if (direction[0] != '\0' && strncasecmp(direction, "Downlink", strlen("Downlink")) == 0)
+                        fprintf(mangle_fp, "-I PREROUTING -i %s %s\n", current_wan_ifname, rule_udp);
+	         }
+                //Deleting conntrack entries Blacklist
+                if (0 == rc && strncasecmp(firewall_rule_type, "Blacklist", strlen("Blacklist")) == 0)
+                {
+                    if (strcmp(protocol, "tcp") == 0)
+                        DeleteConntrackEntryForDropIPv6FirewallEntries(PROTOCOL_TCP, idx);
+                    else if (strcmp(protocol, "udp") == 0)
+                        DeleteConntrackEntryForDropIPv6FirewallEntries(PROTOCOL_UDP, idx);
+                    else
+                    {
+                        DeleteConntrackEntryForDropIPv6FirewallEntries(PROTOCOL_TCP, idx);
+                        DeleteConntrackEntryForDropIPv6FirewallEntries(PROTOCOL_UDP, idx);
+                    }
+                }
+                //Deleting conntrack entries Whitelist
+                else if (0 == rc && strncasecmp(firewall_rule_type, "Whitelist", strlen("Whitelist")) == 0)
+                {
+                    DeleteConntrackEntryForAcceptIPv6FirewallEntries(PROTOCOL_TCP, idx);
+                    DeleteConntrackEntryForAcceptIPv6FirewallEntries(PROTOCOL_UDP, idx);
+                }
+            }
+            v_secure_system("echo 1 > /proc/sys/net/netfilter/nf_conntrack_tcp_loose");
+        }
+    }
+    FIREWALL_DEBUG("Exiting do_x_qcomrule_firewall_v6\n");
+    return 0;
+}
