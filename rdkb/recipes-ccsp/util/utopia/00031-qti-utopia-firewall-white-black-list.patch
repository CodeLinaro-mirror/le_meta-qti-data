+/*********************************************************
+ *  Procedure     : DeleteConntrackEntryForDropIPv4FirewallEntries
+ *  Purpose       : Delete the IPV4 conntrack entry which is part
+                    of the rule
+ *  Parameters    :
+ *   protocol_num : protocol
+ *   idx          : rule index
+ *  Return Values :
+ *     TRUE       : SUCCESS
+ *     FALSE      : FAILURE
+ *********************************************************/
+bool DeleteConntrackEntryForDropIPv4FirewallEntries(int protocol_num, int idx)
+{
+    char command[MAX_COMMAND_STR_LEN]={0};
+    char source_port[16]={0};
+    char destination_port[16]={0};
+    char source_ip[16]={0};
+    char dest_ip[16]={0};
+    char tmp[MAX_COMMAND_STR_LEN]={0};
+    char namespace[MAX_NAMESPACE]={0};
+    char *ptr;
+    char query[MAX_QUERY]={0};
+    char *line = NULL;
+    size_t len = 0;
+    ssize_t read;
+
+    snprintf(query, sizeof(query), "X_QCOMRule_%d", idx);
+    syscfg_get(NULL, query, namespace, sizeof(namespace));
+    syscfg_get(namespace, "SourcePort", source_port, sizeof(source_port));
+    syscfg_get(namespace, "DestinationPort", destination_port, sizeof(destination_port));
+    syscfg_get(namespace, "SourceIPAddr", source_ip, sizeof(source_ip));
+    syscfg_get(namespace, "DestinationIPAddr",dest_ip,sizeof(dest_ip));
+    //Adding source IP to the conntrack searching rule
+    if('\0' != source_ip[0] && strcmp("0.0.0.0",source_ip))
+        snprintf(command, MAX_COMMAND_STR_LEN, "conntrack -L | grep src=%s ",source_ip);
+    else
+        snprintf(command, MAX_COMMAND_STR_LEN , "conntrack -L ");
+
+    switch (protocol_num) {
+        case PROTOCOL_TCP:
+            //Adding tcp to the conntrack searching rule
+            strlcat(command, " | cut -f1,10,11,12,13 -d ' ' | grep tcp ", MAX_COMMAND_STR_LEN);
+            break;
+
+        case PROTOCOL_UDP:
+            //Adding udp to the conntrack searching rule
+            strlcat(command, " | cut -f1,9,10,11,12 -d ' ' | grep udp ", MAX_COMMAND_STR_LEN);
+            break;
+
+        default:
+            return FALSE;
+    }
+    //Adding source port to the conntrack searching rule
+    if (source_port[0] != '\0' && '0'!=source_port[0] ) {
+        strlcat(command, "| grep sport=",MAX_COMMAND_STR_LEN);
+        strlcat(command, source_port,MAX_COMMAND_STR_LEN);
+    }
+    //Adding destination port to the conntrack searching rule
+    if (destination_port[0] != '\0' && '0'!=destination_port[0] ) {
+        strlcat(command, " | grep dport=",MAX_COMMAND_STR_LEN);
+        strlcat(command, destination_port,MAX_COMMAND_STR_LEN);
+    }
+    //Adding CONNTRACK_ENTRIES as destination to the conntrack searching rule
+    snprintf(tmp, MAX_COMMAND_STR_LEN, "> %s", CONNTRACK_ENTRIES);
+    strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+    system(command);
+
+    FILE *fp = fopen(CONNTRACK_ENTRIES, "r");
+    if (fp == NULL) {
+        return FALSE;
+    }
+    //Reading line by line from CONNTRACK_ENTRIES
+    while (((read = getline(&line, &len, fp)) != -1))
+    {
+        char *protocol=NULL, *saddr=NULL, *daddr=NULL, *sport=NULL, *dport=NULL;
+        protocol = strtok_r(line, " ", &ptr);
+        saddr = strtok_r(NULL, " ", &ptr);
+        if(saddr)
+            *(saddr + 3) = ' ';
+        daddr = strtok_r(NULL, " ", &ptr);
+        if(daddr)
+            *(daddr + 3) = ' ';
+        sport = strtok_r(NULL, " ", &ptr);
+        if(sport)
+            *(sport + 5) = ' ';
+        dport = strtok_r(NULL, "\n", &ptr);
+        if(dport)
+            *(dport + 5) = ' ';
+
+        //To get source address from current conntrack line
+        if (saddr)
+            saddr = saddr + 4;
+        //To get destination address from current conntrack line
+        if (daddr)
+            daddr = daddr + 4;
+        //To get source port from current conntrack line
+        if (sport)
+            sport = sport +6;
+        //To get destination port from current conntrack line
+        if (dport)
+            dport =dport+6;
+
+        if (!saddr || !daddr || !sport || !dport)
+            continue;   // skip malformed line
+
+        //continue if source IPv4 is not 0.0.0.0 and doesnot match with current conntrack line saddr
+        if (strcmp(saddr, source_ip) != 0 && strcmp("0.0.0.0",source_ip) != 0)
+            continue;
+        //continue if destination IPv4 is not 0.0.0.0 and doesnot match with current conntrack line daddr and doesnot match with WAN IP
+        if (strcmp(daddr,dest_ip) != 0 && strcmp(daddr,current_wan_ipaddr) != 0  && strcmp("0.0.0.0",dest_ip) != 0 )
+            continue;
+        //continue if source port is valid and doesnot match with current conntrack line sport
+        if (strcmp(sport,source_port)!=0 && '\0' != source_port[0] && '0'!=source_port[0] )
+            continue;
+        //continue if destination port is valid and doesnot match with current conntrack line dport
+        if (strcmp(dport,destination_port)!=0 && '\0' != destination_port[0] && '0'!=destination_port[0])
+            continue;
+
+        //Delete conntrack entry
+        memset(tmp,0,MAX_COMMAND_STR_LEN);
+        //Creating conntrack deletion command based on protocol saddr sport and dport
+        snprintf(command, MAX_COMMAND_STR_LEN, "conntrack -D");
+        if (protocol) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " -p %s", protocol);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (saddr) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, "  --orig-src %s", saddr);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (sport) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " --sport %s", sport);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        if (dport) {
+            snprintf(tmp, MAX_COMMAND_STR_LEN, " --dport %s", dport);
+            strlcat(command, tmp, MAX_COMMAND_STR_LEN);
+            memset(tmp, 0, MAX_COMMAND_STR_LEN);
+        }
+        //To delete conntrack entry
+        system(command);
+        memset(command, 0, MAX_COMMAND_STR_LEN);
+    }
+
+    if(fp)
+    {
+        fclose(fp);
+        fp=NULL;
+    }
+    if(line)
+    {
+        free(line);
+        line=NULL;
+    }
+    //To remove the CONNTRACK_ENTRIES file
+    snprintf(command, MAX_COMMAND_STR_LEN, "rm -rf %s", CONNTRACK_ENTRIES);
+    system(command);
+    return TRUE;
+}
