+/*************** X_QCOMRule API ****************/
+
+int Utopia_GetFirewall_XQCOMRuleInsNumByIndex(UtopiaContext *ctx, unsigned long uIndex, int *ins)
+{
+    Utopia_GetIndexedInt(ctx, UtopiaValue_Firewall_X_QCOMRule_InsNum, uIndex+1, ins);
+    return 0;
+}
+static int g_Firewall_X_QCOMRule_Count = 0;
+
+int Utopia_GetNumberOfFirewall_XQCOMRule(UtopiaContext *ctx, int *num)
+{
+    Utopia_GetInt(ctx, UtopiaValue_Firewall_X_QCOMRule_Count, &g_Firewall_X_QCOMRule_Count);
+    *num = g_Firewall_X_QCOMRule_Count;
+    return 0;
+}
+
+int Utopia_SetFirewall_XQCOMRuleInsAndAliasByIndex(UtopiaContext *ctx, unsigned long ulIndex, unsigned long ins, const char *alias)
+{
+    int index = ulIndex+1;
+    Utopia_SetIndexedInt(ctx, UtopiaValue_Firewall_X_QCOMRule_InsNum, index, ins);
+    Utopia_SetIndexed(ctx, UtopiaValue_Firewall_X_QCOMRule_Alias, index, (char*)alias);
+    return 0;
+}
+
+int Utopia_GetFirewall_XQCOMRuleByIndex(UtopiaContext *ctx, unsigned long ulIndex, firewall_x_qcomrule_t *x_qcomrule_t)
+{
+    int ins_num=0,s_port=0,des_port=0;
+    int index = ulIndex+1;
+    char ip_address_str[INET_ADDRSTRLEN] = {0};
+    Utopia_GetIndexedInt(ctx, UtopiaValue_Firewall_X_QCOMRule_InsNum , index, &ins_num);
+    x_qcomrule_t->ins_num = ins_num;
+    if (Utopia_GetIndexed(ctx, UtopiaValue_Firewall_X_QCOMRule_DestinationIPAddr, index, ip_address_str, INET_ADDRSTRLEN))
+    {
+        uint32_t dest_ip = inet_addr(ip_address_str);
+        memcpy(x_qcomrule_t->destination_ipaddress.Dot, &dest_ip, sizeof(x_qcomrule_t->destination_ipaddress.Dot));
+    }
+    memset(ip_address_str, 0, INET_ADDRSTRLEN);
+    if (Utopia_GetIndexed(ctx, UtopiaValue_Firewall_X_QCOMRule_SourceIPAddr, index, ip_address_str, INET_ADDRSTRLEN))
+    {
+        uint32_t src_ip = inet_addr(ip_address_str);
+        memcpy(x_qcomrule_t->source_ipaddress.Dot, &src_ip, sizeof(x_qcomrule_t->source_ipaddress.Dot));
+    }
+    Utopia_GetIndexed(ctx, UtopiaValue_Firewall_X_QCOMRule_Alias , index, x_qcomrule_t->alias, sizeof(x_qcomrule_t->alias));
+    Utopia_GetIndexedBool(ctx, UtopiaValue_Firewall_X_QCOMRule_Enable, index, &x_qcomrule_t->enable);
+    Utopia_GetIndexedInt(ctx, UtopiaValue_Firewall_X_QCOMRule_SourcePort , index,&s_port);
+    x_qcomrule_t->source_port=s_port;
+    Utopia_GetIndexedInt(ctx, UtopiaValue_Firewall_X_QCOMRule_DestinationPort , index,&des_port);
+    x_qcomrule_t->destination_port=des_port;
+    Utopia_GetIndexed(ctx, UtopiaValue_Firewall_X_QCOMRule_Protocol , index,x_qcomrule_t->protocol, sizeof(x_qcomrule_t->protocol));
+    Utopia_GetIndexed(ctx, UtopiaValue_Firewall_X_QCOMRule_Direction , index,x_qcomrule_t->direction, sizeof(x_qcomrule_t->direction));
+    Utopia_GetIndexed(ctx, UtopiaValue_Firewall_X_QCOMRule_DestinationIPv6Addr , index,x_qcomrule_t->destination_ipv6address, sizeof(x_qcomrule_t->destination_ipv6address));
+    Utopia_GetIndexed(ctx, UtopiaValue_Firewall_X_QCOMRule_SourceIPv6Addr , index,x_qcomrule_t->source_ipv6address, sizeof(x_qcomrule_t->source_ipv6address));
+
+    return 0;
+}
+
+int Utopia_SetFirewall_XQCOMRuleByIndex(UtopiaContext *ctx, unsigned long ulIndex, const firewall_x_qcomrule_t *x_qcomrule_t)
+{
+    char s_tokenbuf[256];
+    int index = ulIndex+1;
+    snprintf(s_tokenbuf, sizeof(s_tokenbuf), "QCOMRule_%d", index);
+    UTOPIA_SETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule, index, s_tokenbuf);
+    UTOPIA_SETINDEXEDINT(ctx, UtopiaValue_Firewall_X_QCOMRule_InsNum , index, x_qcomrule_t->ins_num);
+    unsigned long val_di = (unsigned long)x_qcomrule_t->destination_ipaddress.Value;
+    struct in_addr d_addr = {(val_di)};
+    UTOPIA_SETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_DestinationIPAddr ,index,(char*) inet_ntoa( d_addr ));
+    unsigned long val_si = (unsigned long)x_qcomrule_t->source_ipaddress.Value;
+    struct in_addr s_addr = {(val_si)};
+    UTOPIA_SETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_SourceIPAddr , index, (char*)inet_ntoa( s_addr ));
+    UTOPIA_SETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_Alias , index,(char*)x_qcomrule_t->alias);
+    UTOPIA_SETINDEXEDBOOL(ctx, UtopiaValue_Firewall_X_QCOMRule_Enable , index, x_qcomrule_t->enable);
+    UTOPIA_SETINDEXEDINT(ctx, UtopiaValue_Firewall_X_QCOMRule_SourcePort , index, x_qcomrule_t->source_port);
+    UTOPIA_SETINDEXEDINT(ctx, UtopiaValue_Firewall_X_QCOMRule_DestinationPort ,index, x_qcomrule_t->destination_port);
+    UTOPIA_SETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_Protocol , index,(char*)x_qcomrule_t->protocol);
+    UTOPIA_SETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_Direction , index,(char*)x_qcomrule_t->direction);
+    UTOPIA_SETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_DestinationIPv6Addr , index,(char*)x_qcomrule_t->destination_ipv6address);
+    UTOPIA_SETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_SourceIPv6Addr , index,(char*)x_qcomrule_t->source_ipv6address);
+    return 0;
+}
+
+int Utopia_AddFirewall_XQCOMRule(UtopiaContext *ctx, const firewall_x_qcomrule_t *x_qcomrule_t)
+{
+    int index=0;
+    Utopia_GetNumberOfFirewall_XQCOMRule(ctx, &index);
+    g_Firewall_X_QCOMRule_Count++;
+    Utopia_SetInt(ctx, UtopiaValue_Firewall_X_QCOMRule_Count , g_Firewall_X_QCOMRule_Count);
+    Utopia_SetFirewall_XQCOMRuleByIndex(ctx, index, x_qcomrule_t);
+    return 0;
+}
+
+int Utopia_DelFirewall_XQCOMRule(UtopiaContext *ctx, unsigned long ins)
+{
+    int count=0, index=0;
+
+    Utopia_GetNumberOfFirewall_XQCOMRule(ctx, &count);
+    for (index = 0; index < count; index++)
+    {
+        int ins_num;
+        Utopia_GetFirewall_XQCOMRuleInsNumByIndex(ctx, index, &ins_num);
+        if (ins_num == (int)ins)
+        {
+            break;
+        }
+    }
+
+    if (index >= count)
+    {
+        return -1;
+    }
+
+    if (index < count-1)
+    {
+        for (;index < count-1; index++)
+        {
+            firewall_x_qcomrule_t x_qcomrule_t;
+            Utopia_GetFirewall_XQCOMRuleByIndex(ctx, index+1, &x_qcomrule_t);
+            Utopia_SetFirewall_XQCOMRuleByIndex(ctx, index, &x_qcomrule_t);
+        }
+    }
+
+    UTOPIA_UNSETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_InsNum , count);
+    UTOPIA_UNSETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_DestinationIPAddr , count);
+    UTOPIA_UNSETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_SourceIPAddr , count);
+    UTOPIA_UNSETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_Enable , count);
+    UTOPIA_UNSETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_Alias , count);
+    UTOPIA_UNSETINDEXED(ctx, UtopiaValue_Firewall_X_QCOMRule_SourcePort , count);
