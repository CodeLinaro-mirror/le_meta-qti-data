Index: git/source/scripts/init/service.d/service_lan.sh
===================================================================
--- git.orig/source/scripts/init/service.d/service_lan.sh
+++ git/source/scripts/init/service.d/service_lan.sh
@@ -1,4 +1,4 @@
-#!/bin/sh
+#!/bin/bash
 ##########################################################################
 # If not stated otherwise in this file or this component's Licenses.txt
 # file the following copyright and licenses apply:
@@ -145,13 +145,21 @@ bringup_ethernet_interfaces() {
          config_vlan "$loop" "$SYSCFG_lan_ethernet_virtual_ifnums"
        done
    fi
-
-   for loop in $SYSCFG_lan_ethernet_physical_ifnames
+   ethernetcount=0
+   IFS=, read -r -a a <<< "$SYSCFG_lan_ethernet_physical_ifnames"
+   for loop in "${a[@]}"
    do
       #Prevents clearing Ethernet interface IPs on the echo
       if [ "$BOX_TYPE" != "echo" ];then
          ifconfig "$loop" 0.0.0.0
       fi
+      if [ "$ethernetcount" -eq "1" ] ; then
+         ifconfig "$loop" 169.254.1.20
+         ethernetcount=0
+      else
+         ifconfig "$loop" 169.254.1.10
+         ethernetcount=1
+      fi
       ip link set "$loop" allmulticast on
    done
 }
@@ -614,9 +622,9 @@ lan_create () {
     brctl addbr "$SYSCFG_lan_ifname"
     brctl setfd "$SYSCFG_lan_ifname" 0
     brctl stp "$SYSCFG_lan_ifname" off
-
+    IFS=, read -r -a a <<< "$LAN_IFNAMES"
     # enslave interfaces to the bridge
-    for loop in $LAN_IFNAMES
+    for loop in "${a[@]}"
     do
       # disable IPv6 for bridge port so it won't interfere bridge interface's DAD procedure
       echo 1 > /proc/sys/net/ipv6/conf/"$loop"/disable_ipv6
