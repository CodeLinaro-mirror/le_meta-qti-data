 #ifdef HYBRID_SUPPORT
 static PCELLULAR_DML_INFO             g_pstDmlCellular =  NULL;
 #endif
@@ -533,6 +538,53 @@ ANSC_STATUS DmlCellularInitialize ( ANSC_HANDLE  hDml )
     stStateMachineInput.pstDmlCellular = pstDmlCellular;
     memcpy(&(stStateMachineInput.stContextProfile), &(stCtxInputStruct.stIfInput), sizeof(CellularProfileStruct));
     CellularMgr_Start_State_Machine( &stStateMachineInput );
+#ifdef CM_EXTN_SUPPORTED
+    /* Take SM semaphore */
+    sem_wait(&state_chg_sem);
+    bool bGetRoamVal = 0;
+#ifdef CM_PROP_SUPPORTED
+    set_sm_roaming_init_value(pstDmlCellular->RoamingEnabled);
+    /* Always set to TRUE first
+     * Initial set to TRUE found to be working ok */
+    if(RETURN_OK == cellular_hal_prop_extn_set_roaming(TRUE))
+    {
+        CcspTraceInfo(("%s %d - Roaming first set on init to TRUE\n",__FUNCTION__,__LINE__));
+    }
+    else
+    {
+        CcspTraceError(("%s-%d : Failed to set roaming to TRUE on init\n", __FUNCTION__, __LINE__));
+    }
+    /* Must do a get after set.Otherwise, the next set is not effective */
+    if(RETURN_OK == cellular_hal_prop_extn_get_roaming(&bGetRoamVal))
+    {
+        CcspTraceInfo(("%s %d - Roaming get on init = %d\n",__FUNCTION__,__LINE__, bGetRoamVal));
+    }
+    else
+    {
+        CcspTraceError(("%s-%d : Failed to get roaming on init\n", __FUNCTION__, __LINE__));
+    }
+    /* On bootup set modem roaming to RoamingEnabled value */
+    if(RETURN_OK == cellular_hal_prop_extn_set_roaming(pstDmlCellular->RoamingEnabled))
+    {
+        CcspTraceInfo(("%s %d - Roaming set on init to %d\n",__FUNCTION__,__LINE__, pstDmlCellular->RoamingEnabled));
+    }
+    else
+    {
+        CcspTraceError(("%s-%d : Failed to set roaming on init to %d \n", __FUNCTION__, __LINE__, pstDmlCellular->RoamingEnabled));
+    }
+    /* Must do a get after set.Otherwise, the next set is not effective */
+    if(RETURN_OK == cellular_hal_prop_extn_get_roaming(&bGetRoamVal))
+    {
+        CcspTraceInfo(("%s %d - Roaming get on init = %d\n",__FUNCTION__,__LINE__, bGetRoamVal));
+    }
+    else
+    {
+        CcspTraceError(("%s-%d : Failed to get roaming on init\n", __FUNCTION__, __LINE__));
+    }
+
+#endif //CM_PROP_SUPPORTED
+    sem_post(&state_chg_sem);
+#endif //CM_EXTN_SUPPORTED
 
