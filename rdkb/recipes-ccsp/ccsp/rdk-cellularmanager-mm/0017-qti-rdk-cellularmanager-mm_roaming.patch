+/* set_sm_roaming_init_value function */
+/**
+* @description - This API sets roaming state variable during initialization from state machine
+*
+* @param[in] val - Boolean value
+* @param[out] None
+*
+* @retval None
+*
+*/
+void set_sm_roaming_init_value(bool val)
+{
+    if (val == TRUE)
+    {
+        gpstCellularPolicyCtrl->enRoamingEnabled = ENABLED_AT_INIT;
+    }
+    else
+    {
+        gpstCellularPolicyCtrl->enRoamingEnabled = DISABLED_AT_INIT;
+    }
+
+}
+
+/* set_sm_roaming_dynamic_value function */
+/**
+* @description - This API dynamically updates roaming state variable
+*
+* @param[in] val - Boolean value
+* @param[out] None
+*
+* @retval None
+*
+*/
+void set_sm_roaming_dynamic_value(bool val)
+{
+    if (val == TRUE)
+    {
+        gpstCellularPolicyCtrl->enRoamingEnabled = DISABLE_TO_ENABLE_TRANSITION;
+    }
+    else
+    {
+        gpstCellularPolicyCtrl->enRoamingEnabled = ENABLE_TO_DISABLE_TRANSITION;
+    }
+
+}
+
+/* IsRoamingStatusConverged function */
+/**
+* @description - This API checks for roaming state convergence
+*
+* @param[in] None
+* @param[out] None
+*
+* @retval True/False
+*
+*/
+bool IsRoamingStatusConverged()
+{
+    /* The device is now enabled at CM. Check for roaming state convergence
+     * Move SM forward only if modem state has moved to target state given the roaming state variable value.
+     * Enabled at init or transition to enabled -> wait till modem is online.
+     * Disabled at init -> wait until modem is enabled
+     * */
+    bool bGetRoamVal = 0;
+    if ((gpstCellularPolicyCtrl->enRoamingEnabled == ENABLED_AT_INIT) ||
+        (gpstCellularPolicyCtrl->enRoamingEnabled == DISABLE_TO_ENABLE_TRANSITION))
+    {
+        CcspTraceInfo(("%s %d - Enabling Roaming, mmState = %d \n", __FUNCTION__, __LINE__, mmState));
+        if (!(mmState >= MODEM_STATE_REGISTERED))
+        {
+            return FALSE;
+        }
+        if (gpstCellularPolicyCtrl->enRoamingEnabled == ENABLED_AT_INIT)
+        {
+#ifdef CM_PROP_SUPPORTED
+            /* Must do a get after set.Otherwise, the next set is not effective */
+            cellular_hal_prop_extn_get_roaming(&bGetRoamVal);
+#endif //CM_PROP_SUPPORTED
+            CcspTraceInfo((" %s %d - Roaming get on ENABLED_INIT completion = %d\n",__FUNCTION__,__LINE__, bGetRoamVal));
+        }
+        gpstCellularPolicyCtrl->enRoamingEnabled = ENABLED;
+    }
+    else if ( (gpstCellularPolicyCtrl->enRoamingEnabled == DISABLED_AT_INIT))
+    {
+        CcspTraceInfo((" %s %d - Disabling Roaming, mmState = %d \n", __FUNCTION__, __LINE__, mmState));
+        if (!(mmState >= MODEM_STATE_ENABLED))
+        {
+            return FALSE;
+        }
+        if (gpstCellularPolicyCtrl->enRoamingEnabled == DISABLED_AT_INIT)
+        {
+#ifdef CM_PROP_SUPPORTED
+            /* Must do a get after set. Otherwise, the next set is not effective */
+            cellular_hal_prop_extn_get_roaming(&bGetRoamVal);
+#endif //CM_PROP_SUPPORTED
+            CcspTraceInfo(("%s %d - Roaming get on DISABLED_INIT completion = %d\n",__FUNCTION__,__LINE__, bGetRoamVal));
+        }
+        gpstCellularPolicyCtrl->enRoamingEnabled = DISABLED;
+    }
+    else if ( (gpstCellularPolicyCtrl->enRoamingEnabled == ENABLE_TO_DISABLE_TRANSITION))
+    {
+        CellularCurrentPlmnInfoStruct plmn_info;
+        CcspTraceInfo((" %s %d - Disabling Roaming dynamic, mmState = %d \n", __FUNCTION__, __LINE__, mmState));
+        cellular_hal_get_current_plmn_information(&plmn_info);
+        if (!(mmState < MODEM_STATE_REGISTERED) && (plmn_info.roaming_enabled == TRUE))
+        {
+            return FALSE;
+        }
+        gpstCellularPolicyCtrl->enRoamingEnabled = DISABLED;
+    }
+    return TRUE;
+
+}
 
