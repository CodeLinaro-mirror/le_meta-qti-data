 #ifdef QMI_SUPPORT
     //Get Current PLMN Network Information
     cellular_hal_qmi_get_current_plmn_information( plmn_info );
+#elif defined (MM_SUPPORT) && defined (CM_EXTN_SUPPORTED)
+    if( RETURN_OK != cellular_hal_extn_mm_get_plmn (NULL, plmn_info))
+    {
+        return RETURN_ERROR;
+    }
