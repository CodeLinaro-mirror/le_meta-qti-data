+    if (RETURN_OK != cellular_hal_mm_extn_get_available_networks(NULL, network_info, total_network_count))
+    {
+        return RETURN_ERROR;
+    }
 #elif defined HYBRID_SUPPORT
     cellular_hal_device_get_available_networks_information( network_info, total_network_count );
 #endif
