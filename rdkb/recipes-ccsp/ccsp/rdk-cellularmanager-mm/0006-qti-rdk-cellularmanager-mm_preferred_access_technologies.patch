@@ -222,3 +222,31 @@ int CellularMgr_RdkBus_SetParamValuesToDB( char *pParamName, char *pParamVal )
 
     return retPsmSet;
 }
+/* CellularMgr_RdkBus_DelParamValuesFromDB */
+/**
+* @description - This API Delete Accesspoint param values from DB.
+*
+* @param[in] -  pParamName : parameters name
+* @param[out] - None
+*
+* @retval status of the operation
+* return  CCSP_SUCCESS - if operation is success.
+*/
+int CellularMgr_RdkBus_DelParamValuesFromDB( char *pParamName )
+{
+    int     retPsmSet  = CCSP_SUCCESS;
+
+    /* Input Validation */
+    if( ( NULL == pParamName) )
+    {
+        CcspTraceError(("%s Invalid Input Parameters\n",__FUNCTION__));
+        return CCSP_FAILURE;
+    }
+
+    retPsmSet = PSM_Del_Record(bus_handle, g_Subsystem, pParamName);
+    if (retPsmSet != CCSP_SUCCESS)
+    {
+        CcspTraceError(("%s Failed to Delete %s psm record\n", __FUNCTION__, pParamName));
+    }
+    return retPsmSet;
+}
