     return RBUS_ERROR_SUCCESS;
 }
 
+#ifdef CM_EXTN_SUPPORTED
+/* CellularMgr_WanMgr_IPMode_EventCallback function */
+/**
+* @description - Callback API registered for WanManager Data Model -
+*                Device.X_RDK_WanManager.Interface.2.VirtualInterface.1.IP.Mode
+*
+* @param[in] handle - Rbus handle.
+* @param[in] event - Rbus event details.
+* @param[in] subscription - Rbus subscription.
+*
+* @return None
+*/
+void CellularMgr_WanMgr_IPMode_EventCallback( rbusHandle_t handle,
+                                               rbusEvent_t const *event,
+                                               rbusEventSubscription_t *subscription )
+{
+    (void)handle;
+    (void)subscription;
+    WANMGR_IP_MODE newMode;
+
+    if( event == NULL || event->data == NULL )
+    {
+        CcspTraceError(("%s-%d: Received NULL event or event data\n", __FUNCTION__, __LINE__));
+        return;
+    }
+
+    rbusValue_t newVal = rbusObject_GetValue(event->data, "value");
+    if( newVal == NULL )
+    {
+        CcspTraceError(("%s-%d: value property missing in event data for [%s] type=%d\n", __FUNCTION__, __LINE__, event->name, event->type));
+        return;
+    }
+
+    rbusValueType_t valType = rbusValue_GetType(newVal);
+    if( valType == RBUS_STRING )
+    {
+        const char *str = rbusValue_GetString(newVal, NULL);
+        if( str == NULL )
+            str = "";
+        if( strstr(str, "IPv4 Only") != NULL )
+            newMode = WANMGR_IP_MODE_IPV4_ONLY;
+        else if( strstr(str, "IPv6 Only") != NULL )
+            newMode = WANMGR_IP_MODE_IPV6_ONLY;
+        else if( strstr(str, "Dual Stack") != NULL )
+            newMode = WANMGR_IP_MODE_DUAL_STACK;
+        else if( strstr(str, "No IP") != NULL )
+            newMode = WANMGR_IP_MODE_NO_IP;
+        else
+        {
+            CcspTraceWarning(("%s-%d: Unrecognised IP.Mode string [%s] for [%s], skipping\n",__FUNCTION__, __LINE__, str, event->name));
+            return;
+        }
+    }
+    else
+    {
+        CcspTraceWarning(("%s-%d: Unexpected value type %d for [%s], skipping\n", __FUNCTION__, __LINE__, valType, event->name));
+        return;
+    }
+
+    /* Deleted when CellularMgr_extn_ProcessIPModeEventThread() completes IP mode event processing. */
+    FILE *tmpFile = fopen(FILE_PROCESS_IPMODE, "w");
+    if (tmpFile)
+    {
+        fclose(tmpFile);
+        tmpFile = NULL;
+    }
+    else
+    {
+        CcspTraceError(("%s-%d: Failed to create file\n",__FUNCTION__,__LINE__));
+    }
+
+    pthread_t ipModeThreadID;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
 
+    if(0 != pthread_create(&ipModeThreadID, &attr,
+        &CellularMgr_extn_ProcessIPModeEventThread, (void*)(uintptr_t)newMode))
+    {
+        CcspTraceError(("%s:%d Failed to create thread\n", __FUNCTION__,__LINE__));
+        remove(FILE_PROCESS_IPMODE);
+    }
+    pthread_attr_destroy(&attr);
+    return;
+}
+#endif /* CM_EXTN_SUPPORTED */
 #endif /*RBUS_BUILD_FLAG_ENABLE*/
