                 res = RETURN_OK;
-                g_list_free_full (bearers, g_object_unref);
             }
         }
     }
+
+cleanup:
+    if (properties)
+        g_clear_object (&properties);
+
+    if (profiles)
+    {
+        g_list_free_full(profiles, g_object_unref);
+        profiles = NULL;
+    }
+
+    if (bearers)
+    {
+        g_list_free_full (bearers, g_object_unref);
+        bearers = NULL;
+    }
+
+#ifdef CM_EXTN_SUPPORTED
+    if (modem_3gpp_profile_manager)
+    {
+        g_object_unref(modem_3gpp_profile_manager);
+        modem_3gpp_profile_manager = NULL;
+    }
+#endif
+
+    if ((RETURN_OK != res) && (NULL != pfStruct))
+    {
+        free(pfStruct);
+        pfStruct = NULL;
+    }
     context_free(ctx);
     return res;
 }
