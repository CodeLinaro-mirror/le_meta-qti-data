                 totalCount = g_list_length(bearers);
                 pfStruct = (CellularProfileStruct*)malloc(sizeof(CellularProfileStruct)*totalCount);
                 if(NULL == pfStruct)
-                    return RETURN_ERROR;
+                    goto cleanup;
 
                 memset(pfStruct, 0, sizeof(CellularProfileStruct)*totalCount);
                 for (list = bearers, i = 0; list, i < totalCount; list = g_list_next (list), i++)
@@ -1810,14 +1815,17 @@ INT cellular_hal_mm_get_bearer_properties_list (CHAR *modemIndex, CellularProfil
                                         }
 
                                         if(profiles)
+                                        {
                                             g_list_free_full(profiles , g_object_unref);
+                                            profiles = NULL;
+                                        }
                                     }
 #else
                                     strlcpy(bearerIndex, bearPath+strlen(BEARER_PATH_PREFIX), IDX_SIZE);
                                     pfStruct[i].ProfileID = atoi(bearerIndex);
 #endif
-                                    g_clear_object (&properties);
                                 }
+                                g_clear_object (&properties);
                             }
                         }
                     }
@@ -1825,10 +1833,39 @@ INT cellular_hal_mm_get_bearer_properties_list (CHAR *modemIndex, CellularProfil
