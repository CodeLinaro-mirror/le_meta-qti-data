+/* CellularMgr_RBUS_Events_Publish_X_RDK_Status */
+/**
+* @description - This wrapper function used to publish X_RDK_Event indication.
+*
+* @param[in] None.
+* @param[out] None
+*
+* @return The status of the operation
+* @retval RETURN_OK if successful
+*/
+int CellularMgr_RBUS_Events_Publish_X_RDK_Status()
+{
+    static CELLULAR_RDK_STATUS enPrevRdkStatusValue = RDK_STATUS_DOWN;
+    static pthread_mutex_t rdkStatusMutex = PTHREAD_MUTEX_INITIALIZER;
+
+    char acTmpPrevValue[32] =  {0};
+    char acTmpCurValue[32]  =  {0};
+    char acTmpParamName[256] = {0};
+    int bShouldPublish = 0;
+
+    CELLULAR_RDK_STATUS  currStatus = (CELLULAR_RDK_STATUS)CellularMgrSMGetCurrentState();
+
+    // using mutex because this can be called from different threads
+    pthread_mutex_lock(&rdkStatusMutex);
+    if( gRBUSSubListSt.X_RDK_StatusSubFlag )
+    {
+        if ( enPrevRdkStatusValue != currStatus )
+        {
+            CellularMgr_ConvertEnumToString((void*)&enPrevRdkStatusValue,ENUM_X_RDK_STATUS,acTmpPrevValue);
+            CellularMgr_ConvertEnumToString((void*)&currStatus,ENUM_X_RDK_STATUS,acTmpCurValue);
+            snprintf(acTmpParamName, sizeof(acTmpParamName),"%s", CELLULARMGR_X_RDK_STATUS);
+            bShouldPublish = 1;
+            enPrevRdkStatusValue = currStatus;
+        }
+    }
+    else
+    {
+        enPrevRdkStatusValue = currStatus;
+    }
+    pthread_mutex_unlock(&rdkStatusMutex);
+
+    if(bShouldPublish)
+    {
+        CcspTraceInfo(("%s-%d: Publish DM(%s) Prev(%s) Current(%s) Value(%d)\n",__FUNCTION__, __LINE__, acTmpParamName,acTmpPrevValue,acTmpCurValue,currStatus));
+        if( ANSC_STATUS_SUCCESS != CellularMgr_Rbus_String_EventPublish_OnValueChange(acTmpParamName, acTmpPrevValue, acTmpCurValue, RBUS_STRING))
+        {
+            CcspTraceError(("%s-%d: Failed to publish X_RDK_Event\n",__FUNCTION__,__LINE__));
+            return RETURN_ERROR;
+        }
+    }
+    return RETURN_OK;
+}
