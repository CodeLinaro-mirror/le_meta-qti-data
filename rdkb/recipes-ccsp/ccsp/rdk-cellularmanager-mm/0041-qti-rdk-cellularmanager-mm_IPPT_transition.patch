Date: Tue, 22 Sep 2026 09:45:16 +0000
Subject: Added fix to set ippt_transition back to 0 after reboot/LPM/SSR while IPPT is still enabled

Signed-off-by: Nandakishore S <nans@qti.qualcomm.com>
---
 source/TR-181/middle_layer_src/cellularmgr_utils.c | 4 ++++
 1 file changed, 4 insertions(+)

Index: git/source/TR-181/middle_layer_src/cellularmgr_utils.c
===================================================================
--- git.orig/source/TR-181/middle_layer_src/cellularmgr_utils.c
+++ git/source/TR-181/middle_layer_src/cellularmgr_utils.c
@@ -51,6 +51,10 @@ int CellularMgr_Util_SendIPToWanMgr( Cel
         CcspTraceInfo(("%s - Invalid params received \n", __FUNCTION__));
         return RETURN_ERROR;
     }
+  #ifdef CM_EXTN_SUPPORTED
+    //The 'ippt_transition' sysevent will be set to 1 when IPPT is enabled, and reset to 0 after reboot/LPM/SSR while IPPT is still enabled.
+    sysevent_set(sysevent_fd, sysevent_token, "ippt_transition", "0", 0);
+  #endif
 
     if( CELLULAR_NETWORK_IP_FAMILY_IPV4 == pstIPStruct->IPType )
     {
