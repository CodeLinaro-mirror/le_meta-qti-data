+        {"Device.Cellular.Interface.{i}.X_QCOM.PresentMonthDataUsage", RBUS_ELEMENT_TYPE_PROPERTY, {X_QCOM_Data_Usage_Quota_GetParamUlongValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.MonthlyQuotaExceeded", RBUS_ELEMENT_TYPE_PROPERTY, {X_QCOM_GetParamBoolValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.DailyDataUsageQuota", RBUS_ELEMENT_TYPE_PROPERTY, {X_QCOM_Data_Usage_Quota_GetParamUlongValue_rbus, X_QCOM_Data_Usage_Quota_SetParamUlongValue_rbus, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.PresentDayDataUsage", RBUS_ELEMENT_TYPE_PROPERTY, {X_QCOM_Data_Usage_Quota_GetParamUlongValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.DailyQuotaExceeded", RBUS_ELEMENT_TYPE_PROPERTY, {X_QCOM_GetParamBoolValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+#endif
         {"Device.Cellular.X_RDK_UiccNumberOfEntries", RBUS_ELEMENT_TYPE_PROPERTY, {UiccSlot_GetEntryCount_rbus, NULL, NULL, NULL, NULL, NULL}},
         {"Device.Cellular.X_RDK_Uicc.{i}.", RBUS_ELEMENT_TYPE_TABLE, {NULL, NULL, NULL, NULL, NULL, NULL}},
         {"Device.Cellular.X_RDK_Uicc.{i}.Enable", RBUS_ELEMENT_TYPE_PROPERTY, {UiccSlot_GetParamBoolValue_rbus, UiccSlot_SetParamBoolValue_rbus, NULL, NULL, NULL, NULL}},
