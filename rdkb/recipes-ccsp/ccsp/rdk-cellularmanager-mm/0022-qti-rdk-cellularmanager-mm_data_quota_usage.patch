+
+#ifdef CM_EXTN_SUPPORTED
+            if (policy_sm_state == CELLULAR_STATE_CONNECTED)
+            {
+                if (linkFailureDetected == TRUE)
+                {
+                    CellularMgr_extn_FetchSavedDataFromDB();
+                    linkFailureDetected = FALSE;
+                }
+            }
+            else if (policy_sm_state_old == CELLULAR_STATE_CONNECTED)
+            {
+                linkFailureDetected = TRUE;
+            }
+#endif
             policy_sm_state_old = policy_sm_state;
             CellularMgrSMCheckAndSetWWANConnectionStatus( policy_sm_state );
 #ifdef CM_EXTN_SUPPORTED
@@ -1631,6 +1649,9 @@ static void* CellularMgr_StateMachine_Thread( void *arg )

     if(gpstCellularPolicyCtrl)
     {
+#ifdef CM_EXTN_SUPPORTED
+        CellularMgr_extn_DataQuotaMetaInfoManageMutexInitDeInit(FALSE);
+#endif
         free( gpstCellularPolicyCtrl );
         gpstCellularPolicyCtrl = NULL;
     }
