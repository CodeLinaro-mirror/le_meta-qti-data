Date: Tue, 28 Jul 2026 00:00:00 +0000
Subject: DM implementation for X_QCOM DataUsageQuota: struct field, PSM param definitions, DM registration, and periodic refresh
Signed-off-by: Alan Wong <alanwong@qti.qualcomm.com>
---
 source/CellularManager/cellularmgr_cellular_apis.h        |  3 +++
 source/CellularManager/cellularmgr_sm.c                   | 11 +++++++++-
 source/TR-181/include/dmsb_tr181_psm_definitions.h        |  8 ++++++++
 source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c     |  8 ++++++++
 4 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/source/CellularManager/cellularmgr_sm.c b/source/CellularManager/cellularmgr_sm.c
index 2094308..b1d1fb8 100755
--- a/source/CellularManager/cellularmgr_sm.c
+++ b/source/CellularManager/cellularmgr_sm.c
@@ -58,6 +58,10 @@ extern ModemState mmState;
                 CONSTANT DEFINITIONS
 **********************************************************************/

+#ifdef CM_EXTN_SUPPORTED
+#define DATA_USAGE_REFRESH_PERIOD 120000000 //2 min delay specified in microsec
+#endif
+
 #define LOOP_TIMEOUT            500000 // timeout in milliseconds. This is the state machine loop interval

 #define SYSEVENT_CM_WAN_V4_IPADDR   "cellular_wan_v4_ip"
@@ -1465,7 +1469,12 @@ static void* CellularMgr_StateMachine_Thread( void *arg )
         tv.tv_nsec +=  1000*LOOP_TIMEOUT;
         tv.tv_sec += tv.tv_nsec / 1000000000;
         tv.tv_nsec %= 1000000000;
         elapsedNanosec += (1000 * (uint64_t)LOOP_TIMEOUT);
+        if ( elapsedNanosec >= (1000 * (uint64_t)DATA_USAGE_REFRESH_PERIOD))
+        {
+            CellularMgr_extn_X_QCOM_GetDataUsageQuotaInfo(&(gpstCellularPolicyCtrl->pstDmlCellular->pstInterfaceInfo->stCellularInterfaceInfoExtn.stDataUsageQuota));
+            elapsedNanosec = 0;
+        }
         //Wait upto 500 ms for any MM signalling
         sem_timedwait(&mm_sm_sync_sem, &tv);
 #else
diff --git a/source/TR-181/include/dmsb_tr181_psm_definitions.h b/source/TR-181/include/dmsb_tr181_psm_definitions.h
index 1abb265..da0c44b 100644
