+/* CellularMgr_fetchRecoveryStateBasedOnModemState fuction */
+/**
+* @description - This function used get the target state for recovery.
+*
+* @param[in] None
+* @param[out] - None
+* @retval target statemechine state
+*/
+static CellularPolicySmState_t CellularMgr_fetchRecoveryStateBasedOnModemState(void)
+{
+    CellularPolicySmState_t enRecoveryTargetState = CELLULAR_STATE_DOWN;
+#ifdef IP_CONTINUITY_ENABLED
+    PCELLULAR_DML_INFO pstDmlCellular = NULL;
+    int currentModemState = 0;
+
+    if(gpstCellularPolicyCtrl == NULL)
+    {
+        CcspTraceError(("%s %d - Invalid policy structure\n",
+            __FUNCTION__,__LINE__));
+        return enRecoveryTargetState;
+    }
+
+    pstDmlCellular = gpstCellularPolicyCtrl->pstDmlCellular;
+    if(pstDmlCellular == NULL)
+    {
+        CcspTraceError(("%s %d - Invalid structure pointer !!\n",
+            __FUNCTION__,__LINE__));
+        return enRecoveryTargetState;
+    }
+
+    /*Fetch current modem state*/
+    if(RETURN_OK == cellular_hal_extn_get_current_modem_state(&currentModemState))
+    {
+        if(currentModemState == MODEM_STATE_CONNECTED)
+        {
+            /*If autoconnect is true, Verify if the modem is connected with default APN.*/
+            if((TRUE == pstDmlCellular->stCellularDmlInfoExtn.stCellular.AutoConnect) &&
+               (TRUE == CellularMgr_isDefaultAPNActive()))
+            {
+                /*Modem is connected using the default APN.
+                *Recovery target state set to 'Connected'*/
+                enRecoveryTargetState = CELLULAR_STATE_CONNECTED;
+            }
+            else
+            {
+                /*Modem connected with non-default APN.
+                *Disabled modem to ensure proper sync with CM.*/
+                if(RETURN_OK != cellular_hal_mm_modem_disable_sync(NULL))
+                {
+                    CcspTraceInfo(("%s %d - Failed to disable the modem!!\n",
+                        __FUNCTION__,__LINE__));
+                }
+                else
+                {
+                    CcspTraceInfo(("%s %d - Successfully Disabled the Modem\n",
+                        __FUNCTION__,__LINE__));
+                }
+            }
+        }
+        else if((currentModemState == MODEM_STATE_REGISTERED) ||
+            (currentModemState == MODEM_STATE_CONNECTING))
+        {
+            enRecoveryTargetState = CELLULAR_STATE_REGISTERED;
+        }
+    }
+    else
+    {
+        CcspTraceError(("%s %d - Failed to fetch current modem state "
+            "for enRecoveryTargetState\n",__FUNCTION__,__LINE__));
+    }
+#endif //IP_CONTINUITY_ENABLED
+    return enRecoveryTargetState;
+}
+
+/* CellularMgr_getPolicyStructureRecoveryState fuction */
+/**
+* @description - This Api used to fetch recovery state from SM.
+*
+* @param[in] None
+* @param[out] - None
+* @retval Recovery target statemechine state
+*/
+static CellularPolicySmState_t CellularMgr_getPolicyStructureRecoveryState(void)
+{
+    CellularPolicySmState_t enRecoveryTargetState = CELLULAR_STATE_DOWN;
+    if(gpstCellularPolicyCtrl == NULL)
+    {
+        return enRecoveryTargetState;
+    }
+
+    if (pthread_mutex_lock(&(gpstCellularPolicyCtrl->stRecoverySMState.recoveryMutex)) != 0)
+    {
+        CcspTraceError(("%s %d - Failed to lock recovery mutex\n", __FUNCTION__, __LINE__));
+        return enRecoveryTargetState;
+    }
+
+    enRecoveryTargetState = gpstCellularPolicyCtrl->stRecoverySMState.enRecoveryTargetState;
+
+    if (pthread_mutex_unlock(&(gpstCellularPolicyCtrl->stRecoverySMState.recoveryMutex)) != 0)
+    {
+        CcspTraceError(("%s %d - Failed to unlock recovery mutex\n", __FUNCTION__, __LINE__));
+    }
+
+    return enRecoveryTargetState;
+}
+
+/* CellularMgr_setPolicyStructureRecoveryState fuction */
+/**
+* @description - This Api used to set target recovery state to the SM structure.
+*
+* @param[in] None
+* @param[out] - enRecoveryTargetState
+* @retval None
+*/
+static void CellularMgr_setPolicyStructureRecoveryState(CellularPolicySmState_t enRecoveryTargetState)
+{
+    if(gpstCellularPolicyCtrl == NULL)
+    {
+        return;
+    }
+
+    if (pthread_mutex_lock(&(gpstCellularPolicyCtrl->stRecoverySMState.recoveryMutex)) != 0)
+    {
+        CcspTraceError(("%s %d - Failed to lock recovery mutex\n", __FUNCTION__, __LINE__));
+        return;
+    }
+
+    gpstCellularPolicyCtrl->stRecoverySMState.enRecoveryTargetState = enRecoveryTargetState;
+
+    if (pthread_mutex_unlock(&(gpstCellularPolicyCtrl->stRecoverySMState.recoveryMutex)) != 0)
+    {
+        CcspTraceError(("%s %d - Failed to unlock recovery mutex\n", __FUNCTION__, __LINE__));
+    }
+}
+
