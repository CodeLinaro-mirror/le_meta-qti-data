+/* cellular_hal_mm_modem_disable_sync() function */
+/**
+* @description - This function will disable the modem synchronously.
+*
+* @param[in] index
+* @param[out] none
+* @return RETURN_OK on success, error code otherwise
+*
+*/
+int cellular_hal_mm_modem_disable_sync (CHAR *index)
+{
+    Context *ctx = NULL;
+    int res = RETURN_ERROR;
+    ModemState modemState = MODEM_STATE_UNKNOWN;
+    GError *error = NULL;
+
+    ctx = g_new0 (Context, 1);
+    if (!ctx)
+    {
+        CELLULAR_HAL_DBG_PRINT ("%s - Memory allocation failed\n", __FUNCTION__);
+        return RETURN_ERROR;
+    }
+
+    ctx->object = get_modem_context (index);
+    if(ctx->object)
+    {
+        ctx->modem = mm_object_get_modem (ctx->object);
+        if(ctx->modem)
+        {
+            mm_modem_disable_sync(ctx->modem,NULL,&error);
+            if(error)
+            {
+                CELLULAR_HAL_DBG_PRINT ("%s - Failed to disable modem %s: error '%s'\n",
+                        __FUNCTION__,
+                        ctx->modem ? mm_modem_get_path(ctx->modem) : "unknown",
+                        error->message);
+                g_clear_error (&error);
+            }
+            else
+            {
+                /* Update modem state */
+                modemState = mm_modem_get_state(ctx->modem);
+                res = RETURN_OK;
+            }
+
+            mmState = modemState;
+            cellular_hal_mm_get_modem_port(ctx->modem);
+        }
+        else
+        {
+            CELLULAR_HAL_DBG_PRINT ("%s - Unable to fetch modem object\n", __FUNCTION__);
+        }
+    }
+    else
+    {
+        CELLULAR_HAL_DBG_PRINT ("%s - Unable to fetch modem context\n", __FUNCTION__);
+    }
+
+    if(ctx)
+    {
+        context_free(ctx);
+    }
+    return res;
+}
