+/* CellularMgr_isDefaultAPNActive fuction */
+/**
+* @description - This API is used to verify whether the modem is
+* connected using the default APN configuration.
+*
+* @param[in] None
+* @param[out] - None
+* @retval status of the operation
+* TRUE Modem is connected using the default APN configuration
+* FALSE Modem is connected using a non-default APN
+*/
+static bool CellularMgr_isDefaultAPNActive(void)
+{
+    int profileCount = 0;
+    CellularProfileStruct *pstProfileOutput = NULL;
+    bool res = FALSE;
+
+    if (gpstCellularPolicyCtrl == NULL)
+    {
+        CcspTraceError(("%s %d - Invalid policy structure\n",
+            __FUNCTION__,__LINE__));
+        return res;
+    }
+
+    /*Default APN is active only when connect backhaul is TRUE*/
+    if( gpstCellularPolicyCtrl->stContextProfile.stPrflCtxExtn.bConnectBackHaul != TRUE )
+    {
+        CcspTraceError(("%s %d - Default APN is inactive as ConnectBackHaul is false\n",
+            __FUNCTION__,__LINE__));
+        return res;
+    }
+
+    /*Retrieving bearer information from modem.*/
+    if( RETURN_OK == cellular_hal_mm_get_bearer_properties_list (
+        NULL, &pstProfileOutput, &profileCount) )
+    {
+        if((pstProfileOutput != NULL) && (profileCount  > 0))
+        {
+            for(int i = 0; i < profileCount; i++)
+            {
+                /*Matching connected bearer info against default APN settings.*/
+                if( (strcmp(gpstCellularPolicyCtrl->stContextProfile.APN,
+                      pstProfileOutput[i].APN) == 0) &&
+                    ( gpstCellularPolicyCtrl->stContextProfile.PDPType ==
+                      pstProfileOutput[i].PDPType) &&
+                    (pstProfileOutput[i].bIsAPNDisabled == FALSE)
+                )
+                {
+                    CcspTraceInfo(("%s %d Default APN [%s] used for modem connection\n",
+                        __FUNCTION__,__LINE__,
+                        gpstCellularPolicyCtrl->stContextProfile.APN));
+                    res = TRUE;
+                    break;
+                }
+                else
+                {
+                    CcspTraceInfo(("%s %d Non-Default APN [%s] used for modem connection\n",
+                        __FUNCTION__,__LINE__,
+                        pstProfileOutput[i].APN));
+                }
+            }
+        }
+        else
+        {
+            CcspTraceError(("%s %d - Invalid profile output or count\n",
+                __FUNCTION__,__LINE__));
+        }
+    }
+    else
+    {
+        CcspTraceError(("%s %d - Failed to fetch Bearer Info\n",
+            __FUNCTION__,__LINE__));
+    }
+
+    if(pstProfileOutput != NULL)
+    {
+        free(pstProfileOutput);
+        pstProfileOutput = NULL;
+    }
+    return res;
+}
