--- a/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
+++ b/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
@@ -3788,6 +3788,14 @@ rbusError_t registerGeneratedDataElements(rbusHandle_t handle)
         {"Device.Cellular.Interface.{i}.Stats.ErrorsReceived", RBUS_ELEMENT_TYPE_PROPERTY, {Stats_extn_GetParamUlongValue_rbus, NULL, NULL, NULL, NULL, NULL}},
         {"Device.Cellular.Interface.{i}.Stats.DiscardPacketsSent", RBUS_ELEMENT_TYPE_PROPERTY, {Stats_extn_GetParamUlongValue_rbus, NULL, NULL, NULL, NULL, NULL}},
         {"Device.Cellular.Interface.{i}.Stats.DiscardPacketsReceived", RBUS_ELEMENT_TYPE_PROPERTY, {Stats_extn_GetParamUlongValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.USIM.Status", RBUS_ELEMENT_TYPE_PROPERTY, {USIM_extn_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.USIM.IMSI", RBUS_ELEMENT_TYPE_PROPERTY, {USIM_extn_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.USIM.ICCID", RBUS_ELEMENT_TYPE_PROPERTY, {USIM_extn_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.USIM.MSISDN", RBUS_ELEMENT_TYPE_PROPERTY, {USIM_extn_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.USIM.PINCHECK", RBUS_ELEMENT_TYPE_PROPERTY, {USIM_extn_GetParamStringValue_rbus, USIM_extn_SetParamStringValue_rbus, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.USIM.NEWPIN", RBUS_ELEMENT_TYPE_PROPERTY, {USIM_extn_GetParamStringValue_rbus, USIM_extn_SetParamStringValue_rbus, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.USIM.CURRENTPIN", RBUS_ELEMENT_TYPE_PROPERTY, {USIM_extn_GetParamStringValue_rbus, USIM_extn_SetParamStringValue_rbus, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.USIM.PUK", RBUS_ELEMENT_TYPE_PROPERTY, {USIM_extn_GetParamStringValue_rbus, USIM_extn_SetParamStringValue_rbus, NULL, NULL, NULL, NULL}},
 #ifdef CM_PROP_SUPPORTED
         {"Device.Cellular.Interface.{i}.X_QCOM.DataUsage.RefreshTime", RBUS_ELEMENT_TYPE_PROPERTY, {Data_Usage_extn_GetParamUlongValue_rbus, Data_Usage_extn_SetParamUlongValue_rbus, NULL, NULL, NULL, NULL}},
 #endif //CM_PROP_SUPPORTED
