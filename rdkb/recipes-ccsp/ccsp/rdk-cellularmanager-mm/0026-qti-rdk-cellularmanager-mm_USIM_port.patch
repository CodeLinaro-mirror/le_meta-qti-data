Date: Thu, 20 Aug 2026 04:04:35 +0000
Subject: Cellular Manager DM support for USIM
Signed-off-by: Ananyasreya P P <ananyasr@qti.qualcomm.com>
---
 source/CellularManager/cellular_hal_mm_apis.c |  8 ++++++++
 .../cellularmgr_cellular_apis.h               |  8 --------
 source/CellularManager/cellularmgr_sm.c       | 19 ++++++++++++++++++-
 .../include/dmsb_tr181_psm_definitions.h      |  1 +
 .../middle_layer_src/cellularmgr_rbus_dml.c   |  8 ++++++++
 5 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/source/CellularManager/cellular_hal_mm_apis.c b/source/CellularManager/cellular_hal_mm_apis.c
index 3827950..8781f5e 100755
--- a/source/CellularManager/cellular_hal_mm_apis.c
+++ b/source/CellularManager/cellular_hal_mm_apis.c
@@ -1395,6 +1395,14 @@ INT cellular_hal_mm_get_sim_data (CHAR *index, INT type, CHAR *data)
                     strlcpy (data, value, CELLULAR_OPERATOR_NAME_MAX_LENGTH);
                 break;
             }
+#ifdef CM_EXTN_SUPPORTED
+            case SIM_IMSI:
+            {
+                if( (value = mm_sim_get_imsi (ctx->sim)) != NULL )
+                    strlcpy (data, value, CELLULAR_IMSI_MAX_LENGTH);
+                break;
+            }
+#endif
             default:
                 res = RETURN_ERROR;
         }
diff --git a/source/CellularManager/cellularmgr_cellular_apis.h b/source/CellularManager/cellularmgr_cellular_apis.h
index 59bc476..8abbf8c 100755
--- a/source/CellularManager/cellularmgr_cellular_apis.h
+++ b/source/CellularManager/cellularmgr_cellular_apis.h
@@ -149,14 +149,6 @@ typedef enum _CELLULAR_INTERFACE_SIM_APPLICATION
 } 
 CELLULAR_INTERFACE_SIM_APPLICATION;
 
-typedef enum _CELLULAR_INTERFACE_USIM_PINCHECK
-{
-   USIM_PINCHECK_ON_NETWORK_ACCESS = 1,
-   USIM_PINCHECK_AFTER_REBOOT,
-   USIM_PINCHECK_DISABLE
-} 
-CELLULAR_INTERFACE_USIM_PINCHECK;
-
 typedef enum _CELLULAR_INTERFACE_PROFILE_FAMILY
 {
    INTERFACE_PROFILE_FAMILY_IPV4 = 1,
diff --git a/source/CellularManager/cellularmgr_sm.c b/source/CellularManager/cellularmgr_sm.c
index 332b758..403608a 100755
--- a/source/CellularManager/cellularmgr_sm.c
+++ b/source/CellularManager/cellularmgr_sm.c
@@ -1179,7 +1179,24 @@ static CellularPolicySmState_t StateDown( void )
         return(TransitionDeactivated( ));
 #endif //CM_EXTN_SUPPORTED
     }
-
+#ifdef CM_EXTN_SUPPORTED
+    /* Sync pinCheck with actual SIM lock status
+     * once on first modem detection */
+    if( (NULL != gpstCellularPolicyCtrl->pstDmlCellular) &&
+        (NULL != gpstCellularPolicyCtrl->
+        pstDmlCellular->pstInterfaceInfo) &&
+        (stUsimPinPinCheckInfo.pinCheckInitUpdate != TRUE ))
+    {
+        if(RETURN_OK ==
+            CellularMgr_extn_SyncPinCheckFromActiveCard(
+            &gpstCellularPolicyCtrl->pstDmlCellular->
+            pstInterfaceInfo->stUSIMSlotInfo)
+        )
+        {
+            stUsimPinPinCheckInfo.pinCheckInitUpdate = TRUE;
+        }
+    }
+#endif
     return CELLULAR_STATE_DOWN;
 }
 
diff --git a/source/TR-181/include/dmsb_tr181_psm_definitions.h b/source/TR-181/include/dmsb_tr181_psm_definitions.h
index 81c062a..5f3fdb3 100644
--- a/source/TR-181/include/dmsb_tr181_psm_definitions.h
+++ b/source/TR-181/include/dmsb_tr181_psm_definitions.h
@@ -57,6 +57,7 @@
 #define PSM_CELLULARMANAGER_ACCESSPOINT_ROAMING                    "dmsb.cellularmanager.accesspoint.%d.roaming"
 #define PSM_CELLULARMANAGER_ACCESSPOINT_PROFILE_TYPE               "dmsb.cellularmanager.accesspoint.%d.profiletype"
 #define PSM_CELLULARMANAGER_INTERFACE_ALIAS                                       "dmsb.cellularmanager.interface.%d.alias"
+#define PSM_CELLULARMANAGER_INTERFACE_USIM_PINCHECK                "dmsb.cellularmanager.interface.%d.usim.pincheck"
 #ifdef CM_PROP_SUPPORTED
 #define PSM_CELLULARMANAGER_INTERFACE_DATA_USAGE_REFRESH_TIMER      "dmsb.cellularmanager.interface.%d.x_qcom.dataUsage.refreshtimer"
 #endif //CM_PROP_SUPPORTED
diff --git a/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c b/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
