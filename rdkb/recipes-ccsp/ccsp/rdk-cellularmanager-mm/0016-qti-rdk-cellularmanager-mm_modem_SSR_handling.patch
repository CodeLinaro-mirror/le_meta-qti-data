+/* cellular_hal_mm_trigger_state_change_on_ssr function */
+/**
+* @description - This API triggers a state change on modem SSR
+*
+* @param[in] None
+* @param[out] None
+*
+* @return None
+*
+*/
+void cellular_hal_mm_trigger_state_change_on_ssr()
+{
+    /*State change triggered on modem restart event*/
+    state_changed(NULL,MODEM_STATE_UNKNOWN,MODEM_STATE_UNKNOWN);
+    return;
+}
+
+/* cellular_hal_mm_extn_trigger_state_change_from_sm function */
+/**
+* @description - This API triggers a state change on CM when MM fails to indicate the state change event to CM
+*
+* @param[in] old_state - Modem previous state
+* @param[in] new_state - Modem current state
+* @param[out] None
+*
+* @return None
+*
+*/
+void cellular_hal_mm_extn_trigger_state_change_from_sm(ModemState old_state, ModemState new_state)
+{
+    /*State change triggered on CM*/
+    sem_post(&state_chg_sem);
+    state_changed(NULL, old_state, new_state);
+    return;
+}
+
+/* cellular_hal_mm_extn_re_register_g_signal function */
+/**
+* @description - This API re-registers the modem object and state_changed callback function
+*
+* @param[in] index - Modem Index
+* @param[out] None
+*
+* @return None
+*
+*/
+INT cellular_hal_mm_extn_re_register_g_signal(CHAR *index)
+{
+    Context *ctx;
+    INT res = RETURN_ERROR;
+    gulong stateId = 0;
+    CHAR *modemPath = NULL;
+
+    ctx = g_new0 (Context, 1);
+    ctx->object = get_modem_context (index);
+    if (ctx->object)
+    {
+        ctx->modem = mm_object_get_modem (ctx->object);
+        if( ctx->modem )
+        {
+            modemPath = mm_modem_get_path (ctx->modem);
+            if((NULL != modemPath))
+            {
+                pthread_mutex_lock(&hashTableMutex);
+                if(g_hash_table_lookup(hashTable, modemPath) != NULL)
+                {
+                    stateId = (gulong)GPOINTER_TO_SIZE(g_hash_table_lookup(hashTable, modemPath));
+                    g_clear_signal_handler(&stateId, ctx->modem);
+                    if( g_hash_table_remove(hashTable, modemPath) )
+                    {
+                        stateId = g_signal_connect (ctx->modem, "state-changed", G_CALLBACK (state_changed), NULL);
+                        g_hash_table_insert(hashTable, (gpointer)g_strdup(modemPath), GSIZE_TO_POINTER(stateId));
+                    }
+                    res = RETURN_OK;
+                }
+                else
+                {
+                     CELLULAR_HAL_DBG_PRINT ("%s - %d modem path not found in hashtable\n",__FUNCTION__,__LINE__);
+                }
+                pthread_mutex_unlock(&hashTableMutex);
+            }
+            else
+            {
+                CELLULAR_HAL_DBG_PRINT ("%s - %d Failed to get modem path\n",__FUNCTION__,__LINE__);
+            }
+        }
+        else
+        {
+            CELLULAR_HAL_DBG_PRINT ("%s - %d Failed to get modem\n",__FUNCTION__,__LINE__);
+        }
+    }
+    else
+    {
+        CELLULAR_HAL_DBG_PRINT ("%s - %d Failed to get modem context\n",__FUNCTION__,__LINE__);
+    }
+
+    context_free(ctx);
+    return res;
+}
+#endif //CM_PROP_SUPPORTED
