+#ifdef CM_EXTN_SUPPORTED
+#ifdef CM_PROP_SUPPORTED
+int cellular_hal_prop_event_update_cb( hal_qmi_event_payload_t qmi_event_info )
+{
+    if((HAL_QMI_SSR_EV == qmi_event_info.event) && (HAL_QMI_IS_EV == qmi_event_info.data.ssr_event_info.event_type))
+    {
+        CELLULAR_HAL_DBG_PRINT("%s:%d - Received IS Event from modem! \n", __FUNCTION__, __LINE__);
+        cellular_hal_extn_prop_handle_modem_ssr(HAL_MODEM_IS_EV);
+    }
+    else if((HAL_QMI_SSR_EV == qmi_event_info.event) && (HAL_QMI_OOS_EV == qmi_event_info.data.ssr_event_info.event_type))
+    {
+        CELLULAR_HAL_DBG_PRINT("%s:%d - Received OOS Event from modem! \n", __FUNCTION__, __LINE__);
+        cellular_hal_extn_prop_handle_modem_ssr(HAL_MODEM_OOS_EV);
+    }
+    else
+    {
+        if(NULL != cm_prop_indication_callback)
+            cm_prop_indication_callback(&qmi_event_info);
+        else
+            CELLULAR_HAL_DBG_PRINT("%s:%d - No callback registered for sending event\n", __FUNCTION__, __LINE__);
+    }
+    return RETURN_OK;
+}
+#endif //CM_PROP_SUPPORTED
+#endif //CM_EXTN_SUPPORTED
