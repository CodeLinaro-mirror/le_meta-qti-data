+
+void on_modem_manager_vanished(GDBusConnection *connection, const gchar *name, gpointer user_data)
+{
+    char wanIfName[BUFLEN_32]={0};
+    char cmd[BUFLEN_256]={0};
+    bool ghash_remove = FALSE;
+    gulong stateId = 0;
+
+    g_bus_unwatch_name(mm_watch_id);
+
+#ifdef CM_EXTN_SUPPORTED
+    pthread_mutex_lock(&hashTableMutex);
+#endif
+    stateId = (gulong)GPOINTER_TO_SIZE(g_hash_table_lookup(hashTable, savedModemPath));
+    if(stateId)
+    {
+        /*clearing and removing old MM resources*/
+        if(NULL != savedModem)
+        {
+            g_clear_signal_handler(&stateId, savedModem);
+        }
+        ghash_remove = g_hash_table_remove(hashTable, savedModemPath);
+        CELLULAR_HAL_DBG_PRINT ("%s:%d is modempath removed from hashtable by CM on MM down:%s \n",
+                                     __func__, __LINE__, ghash_remove ? "Yes" : "No");
+    }
+    else
+    {
+        CELLULAR_HAL_DBG_PRINT ("%s:%d Did not find any entry for modemPath %s\n",
+                        __func__, __LINE__, savedModemPath);
+        CELLULAR_HAL_DBG_PRINT ("%s:%d Input values for connection %p and busname %s\n",
+                        __func__, __LINE__, connection, name);
+    }
+
+#ifdef CM_EXTN_SUPPORTED
+    pthread_mutex_unlock(&hashTableMutex);
+#endif
+    /*getting old wan interface name*/
+    cellumanager_get_wanifname(wanIfName,sizeof(wanIfName));
+
+    /*deleting old wan interface*/
+    snprintf( cmd, sizeof(cmd), "ip link del %s", wanIfName);
+    if(0 != system(cmd))
+    {
+       CELLULAR_HAL_DBG_PRINT("%s:%d - failed to execute the command: %s\n", __FUNCTION__, __LINE__,cmd);
+    }
+
+    state_changed(NULL,MODEM_STATE_UNKNOWN,MODEM_STATE_UNKNOWN);
+
+}
 
