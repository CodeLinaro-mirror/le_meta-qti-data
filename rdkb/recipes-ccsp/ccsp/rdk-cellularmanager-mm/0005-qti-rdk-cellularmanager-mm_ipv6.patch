     time(&timer);
     tm_info = localtime(&timer);
     strftime(time_value, length, "%Y-%m-%d %H:%M:%S ", tm_info);
-}
\ No newline at end of file
+}
+
+#ifdef CM_EXTN_SUPPORTED
+/*===========================================================================
+  FUNCTION:  get_populate_ipv6_prefix
+===========================================================================*/
+/*!
+    @brief
+     To populate IPv6 prefix
+    @param
+     ipv6_addr - String containing IPv6 address
+     size - size of preix_ip
+    @return
+     prefix_ip - String containing IPv6 prefix
+*/
+/*=========================================================================*/
+int get_populate_ipv6_prefix(char *ipv6_addr, char *prefix_ip, size_t size)
+{
+        if ((ipv6_addr == NULL) || (prefix_ip == NULL) || (strlen(ipv6_addr)==0))
+        {
+            return -1;
+        }
+        char substring[100];
+        int index=0;
+        int count=0;
+        while (count < 4) {
+                substring[index] = ipv6_addr[index];
+                if(ipv6_addr[index] == ':')
+                {
+                        count++;
+                }
+                index++;
+        }
+        substring[index++] = ':';
+        substring[index] = '\0';
+        strlcpy (prefix_ip, substring, size);
+        CELLULAR_HAL_DBG_PRINT ("%s substring, %s prefix_ip=%s \n", __FUNCTION__, substring, prefix_ip);
+        return 0;
+}
+#endif
\ No newline at end of file
