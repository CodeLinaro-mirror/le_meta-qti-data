+/* modem_discovery_timeout_handler function */
+/**
+* @description - This used to restart and MM and trigger state change
+*
+* @param[in] None
+* @param[out] - None
+* @return void
+*/
+static void modem_discovery_timeout_handler(int signum)
+{
+    (void)signum;
+    mmTimerStatus = FALSE;
+    bool isMMRestartOnly = FALSE;
+
+    if(TRUE == is_modem_restart_required())
+    {
+        CcspTraceInfo(("%s - %d Restarting MM for modem Re-discovery \n", __FUNCTION__,__LINE__));
+        /* if isMMRestartOnly = TRUE it will perform MM restart only,
+        *  but if isMMRestartOnly = FALSE it will trigger CM State Change After MM restart */
+        cellular_hal_extn_restart_modem_manager(isMMRestartOnly);
+    }
+}
+
+static bool is_modem_restart_required()
+{
+    int currentModemState = MODEM_STATE_UNKNOWN;
+    bool res = FALSE;
+    PCELLULAR_USIM_SLOT_INFO pstUSIMSlotInfo = NULL;
+
+    if((NULL == gpstCellularPolicyCtrl) || (NULL == gpstCellularPolicyCtrl->pstDmlCellular) ||
+       (NULL == gpstCellularPolicyCtrl->pstDmlCellular->pstInterfaceInfo))
+    {
+        CcspTraceWarning(("%s %d: Interface info not available\n", __FUNCTION__, __LINE__));
+        goto end;
+    }
+
+    pstUSIMSlotInfo = &(gpstCellularPolicyCtrl->pstDmlCellular->pstInterfaceInfo->stUSIMSlotInfo);
+
+    CellularMgr_extn_GetUSIMCardStatus(pstUSIMSlotInfo);
+
+    if(pstUSIMSlotInfo->Status == SIM_STATUS_UNKNOWN)
+    {
+        res = TRUE;
+        goto end;
+    }
+
+    if(RETURN_ERROR == cellular_hal_extn_get_current_modem_state(&currentModemState))
+    {
+        goto end;
+    }
+
+    if((pstUSIMSlotInfo->Status == SIM_STATUS_EMPTY) && (currentModemState == MODEM_STATE_FAILED))
+    {
+        goto end;
+    }
+
+    if(currentModemState == MODEM_STATE_LOCKED)
+    {
+        if(pstUSIMSlotInfo->Status == SIM_STATUS_AVAILABLE)
+        {
+            goto end;
+        }
+        else if(pstUSIMSlotInfo->Status == SIM_STATUS_BLOCKED)
+        {
+            goto end;
+        }
+    }
+    res = TRUE;
+end:
+    return res;
+}
