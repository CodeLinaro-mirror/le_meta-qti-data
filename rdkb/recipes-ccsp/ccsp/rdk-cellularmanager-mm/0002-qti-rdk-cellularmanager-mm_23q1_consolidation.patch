 {
     return( cellular_hal_get_data_interface( pDataInterface ) );
 }
+
+void set_wan_ifname(char* wan_ifname,int index)
+{
+    char param_name[64];
+
+    snprintf(param_name,sizeof(param_name),"dmsb.wanmanager.if.%d.Name",index);
+    if ( cellular_hal_get_data_interface( wan_ifname ) == RETURN_OK)    // Updating correct wan_ifname once connection is established by using MM APIs
+    {
+        int set_wan_to_psm = CellularMgr_RdkBus_SetParamValuesToDB(param_name,wan_ifname);
+        if (set_wan_to_psm != PSM_WRITE_SUCCESS) {
+            CcspTraceInfo(("%s ERROR: WAN INTERFACE NOT UPDATED TO PSM\n",__FUNCTION__));
+        }
+    }
+    else
+    {
+	    CcspTraceInfo(("%s COULDN'T QUERY PROPER WAN INTERFACE NAME\n", __FUNCTION__));
+    }
+}
