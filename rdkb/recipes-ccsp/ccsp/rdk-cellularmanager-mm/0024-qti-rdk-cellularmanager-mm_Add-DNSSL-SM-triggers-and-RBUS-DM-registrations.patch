From d6c0d0580bd11f73ae04c11e7dcc2cfb6620f7a4 Mon Sep 17 00:00:00 2001
From: Guru Siva Karthik Mekala <gurusiva@qti.qualcomm.com>
Date: Wed, 12 Aug 2026 16:43:10 +0530
Subject: Add DNSSL SM triggers and RBUS DM registrations
Signed-off-by: Guru Siva Karthik Mekala <gurusiva@qti.qualcomm.com>
---
 source/CellularManager/cellularmgr_sm.c       | 26 +++++++++++++++++++++
 .../middle_layer_src/cellularmgr_rbus_dml.c   | 20 +++++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/source/CellularManager/cellularmgr_sm.c b/source/CellularManager/cellularmgr_sm.c
index 6e4fc87..de60fa9 100755
--- a/source/CellularManager/cellularmgr_sm.c
+++ b/source/CellularManager/cellularmgr_sm.c
@@ -1557,6 +1557,32 @@ static void* CellularMgr_StateMachine_Thread( void *arg )
         {
             CcspTraceInfo(("%s %d - New state: %d ,Previous state :%d  \n", __FUNCTION__, __LINE__,policy_sm_state,policy_sm_state_old));

+#ifdef CM_PROP_SUPPORTED
+            /* Register HAL callback and manage WWAN_STATUS_IND subscription */
+            if (gpstCellularPolicyCtrl != NULL)
+            {
+                CellularMgr_extn_SM_OnStateChange(
+                    policy_sm_state, policy_sm_state_old,
+                    (void *)gpstCellularPolicyCtrl->pstDmlCellular, 0);
+            }
+            /* Direct DNSSL fetch/clear using policy_sm_state — avoids
+             * CellularMgrSMGetCurrentState() timing issue */
+            if (policy_sm_state == CELLULAR_STATE_CONNECTED &&
+                gpstCellularPolicyCtrl != NULL &&
+                gpstCellularPolicyCtrl->pstDmlCellular != NULL &&
+                gpstCellularPolicyCtrl->pstDmlCellular->pstAPInfo != NULL)
+            {
+                CellularMgr_extn_GetDNSSL(
+                    &(gpstCellularPolicyCtrl->pstDmlCellular->pstAPInfo->stCellularAccessPointInfoExtn.stDnsslInfo.pstDNSSLInfo),
+                    &(gpstCellularPolicyCtrl->pstDmlCellular->pstAPInfo->stCellularAccessPointInfoExtn.stDnsslInfo.ulDNSSLNoOfEntries));
+            }
+            else if (policy_sm_state_old == CELLULAR_STATE_CONNECTED &&
+                     policy_sm_state != CELLULAR_STATE_CONNECTED)
+            {
+                CellularMgr_extn_Update_DNSSL_event();
+            }
+#endif /* CM_PROP_SUPPORTED */
+
 #if defined(CM_EXTN_SUPPORTED) && defined(CM_PROP_SUPPORTED)
             if (policy_sm_state == CELLULAR_STATE_CONNECTED)
             {
diff --git a/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c b/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
index 9672772..433bacd 100755
--- a/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
+++ b/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
@@ -223,6 +223,15 @@ rbusError_t cellularmgr_Init()
     if (Sample_RegisterRow(CELLULARMGR_ACCESSPOINT_TABLE, apindex[0], NULL, NULL) != RBUS_ERROR_SUCCESS) //starting with row index as read from PSM
     {
         CcspTraceError(("%s-%d : Failed to Add AccessPoint Inst(%d) Table(%s) \n", __FUNCTION__, __LINE__, (apindex[0]), CELLULARMGR_ACCESSPOINT_TABLE));
+#ifdef CM_PROP_SUPPORTED
+    {
+        pstDmlCellular->pstAPInfo->stCellularAccessPointInfoExtn.stDnsslInfo.ulDNSSLNoOfEntries = 1;
+        char dnssl_param[256] = {0};
+        snprintf(dnssl_param, sizeof(dnssl_param), "Device.Cellular.AccessPoint.%d.X_QCOM.IPv6.DNSSL.", apindex[0]);
+        if (Sample_RegisterRow(dnssl_param, 1, NULL, NULL) != RBUS_ERROR_SUCCESS)
+            CcspTraceError(("%s-%d : Failed to Add DNSSL Inst Table(%s) \n", __FUNCTION__, __LINE__, dnssl_param));
+    }
+#endif /* CM_PROP_SUPPORTED */
     }

     if (apindex != NULL)
@@ -330,6 +339,14 @@ rbusError_t cellularmgr_Unload()
         if (Sample_UnregisterRow(CELLULARMGR_ACCESSPOINT_TABLE, (k+1)) != RBUS_ERROR_SUCCESS)
         {
              CcspTraceError(("%s-%d : Failed to Del AccessPoint Inst(%d) Table(%s) \n", __FUNCTION__, __LINE__, (k+1), paramName));
+#ifdef CM_PROP_SUPPORTED
+        {
+            char dnssl_param[256] = {0};
+            snprintf(dnssl_param, sizeof(dnssl_param), "Device.Cellular.AccessPoint.%d.X_QCOM.IPv6.DNSSL.", 1);
+            if (Sample_UnregisterRow(dnssl_param, 1) != RBUS_ERROR_SUCCESS)
+                CcspTraceError(("%s-%d : Failed to Del DNSSL Inst Table(%s) \n", __FUNCTION__, __LINE__, dnssl_param));
+        }
+#endif /* CM_PROP_SUPPORTED */
         }
     }
 #endif
@@ -3688,6 +3705,9 @@ rbusError_t registerGeneratedDataElements(rbusHandle_t handle)
 #ifdef CM_PROP_SUPPORTED
         {"Device.Cellular.AccessPoint.{i}.X_QCOM.IPv6.EnablePrefixDelegation", RBUS_ELEMENT_TYPE_PROPERTY, {IPv6_GetParamBoolValue_rbus, IPv6_SetParamBoolValue_rbus, NULL, NULL, NULL, NULL}},
         {"Device.Cellular.AccessPoint.{i}.X_QCOM.IPv6.Ipv6Prefix", RBUS_ELEMENT_TYPE_PROPERTY, {IPv6_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.AccessPoint.{i}.X_QCOM.IPv6.DNSSLNumberOfEntries", RBUS_ELEMENT_TYPE_PROPERTY, {X_QCOM_IPv6_DNSSL_GetEntryCount_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.AccessPoint.{i}.X_QCOM.IPv6.DNSSL.{i}.", RBUS_ELEMENT_TYPE_TABLE, {NULL, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.AccessPoint.{i}.X_QCOM.IPv6.DNSSL.{i}.DomainName", RBUS_ELEMENT_TYPE_PROPERTY, {X_QCOM_IPv6_DNSSL_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
 #endif
     };
     rc = rbus_regDataElements(handle, ARRAY_SZ(dataElements), dataElements);
--
2.34.1

