+/* cellular_hal_mm_disable_modem() function */
+/**
+* @description - This function performs modem disable.
+*
+* @param[in] None
+*
+* @return None
+*
+*/
+void cellular_hal_mm_disable_modem (void)
+{
+    Context *ctx;
+
+    ctx = g_new0 (Context, 1);
+    ctx->object = get_modem_context (NULL);
+    if (ctx->object)
+    {
+        ctx->modem = mm_object_get_modem (ctx->object);
+        if( ctx->modem )
+        {
+            CELLULAR_HAL_DBG_PRINT("%s:%d - Disabling modem\n", __FUNCTION__, __LINE__);
+            mm_modem_disable(ctx->modem, NULL, NULL, NULL);
+        }
+        else
+        {
+            CELLULAR_HAL_DBG_PRINT("%s:%d - Failed to disable modem!\n", __FUNCTION__, __LINE__);
+        }
+    }
+    else
+    {
+        CELLULAR_HAL_DBG_PRINT("%s:%d - Failed to get modem object!\n", __FUNCTION__, __LINE__);
+    }
+
+    context_free(ctx);
+}
