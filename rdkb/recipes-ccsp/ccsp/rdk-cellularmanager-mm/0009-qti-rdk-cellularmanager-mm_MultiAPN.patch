+void cellular_hal_mm_resource_release()
+{
+    if(NULL != loop)
+    {
+        g_main_loop_quit(loop);
+        CELLULAR_HAL_DBG_PRINT("%s:%d - g_main_loop hal thread stopped successfully\n", __FUNCTION__, __LINE__);
+    }
+    else
+    {
+        CELLULAR_HAL_DBG_PRINT("%s:%d - No hal thread running.\n", __FUNCTION__, __LINE__);
+    }
+}
