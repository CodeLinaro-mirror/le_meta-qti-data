+/* CellularMgr_SignalHandlerCleanup() function */
+/**
+* @description - This function performs deletion of current interface, disable modem and hal resource clean up
+*
+* @param[in] None
+*
+* @return None
+*
+*/
+void CellularMgr_SignalHandlerCleanup(void)
+{
+#ifndef IP_CONTINUITY_ENABLED
+    char wanIfName[BUFLEN_32] = {0};
+    char cmd[BUFLEN_256] = {0};
+    char modemStatus[BUFFER_SIZE_10] = {0};
+
+    /* Getting wan interface name */
+    cellumanager_get_wanifname(wanIfName,sizeof(wanIfName));
+
+    /* Deleting old wan interface */
+    memset(cmd, 0, sizeof(cmd));
+    snprintf( cmd, sizeof(cmd), "ip link del %s", wanIfName);
+    if(0 != system(cmd))
+    {
+        CcspTraceError(("%s:%d - Failed to delete interface \n", __FUNCTION__, __LINE__));
+    }
+#endif //!IP_CONTINUITY_ENABLED
+
+    /* Unwatch the MM dbus interface */
+    cellular_hal_unwatch_modem_interface();
+
+#ifndef IP_CONTINUITY_ENABLED
+    if (RETURN_OK == CellularMgr_extn_Get_Modem_Status(modemStatus, BUFFER_SIZE_10))
+    {
+        /* Disable modem if modemStatus is online [Registered/Connecting/Connected] */
+        if(strcmp(modemStatus, "Online") == 0)
+        {
