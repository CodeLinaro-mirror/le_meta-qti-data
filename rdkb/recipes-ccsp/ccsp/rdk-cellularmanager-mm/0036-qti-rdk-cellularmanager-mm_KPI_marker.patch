+/* cellular_hal_mm_get_bearer_data_profileId function */
+/**
+* @description - This function used to get profileId.
+*
+* @param[in]  None
+* @param[out] ProfileId - profile id, ipType - ip family.
+*
+* @return status of the operation.
+*  RETURN_OK for sucess.
+*  RETURN_ERROR for failure.
+*/
+INT cellular_hal_mm_get_bearer_data_profileId(int *ProfileId, int *ipType)
+{
+    int ret = RETURN_ERROR;
+    Context *ctx;
+    MMBearerProperties *properties = NULL;
+    CHAR bearerIndex[IDX_SIZE], *bearPath;
+    char *index = NULL;
+
+    if((NULL == ProfileId) || (NULL == ipType))
+    {
+        CELLULAR_HAL_DBG_PRINT("%s Error - Bad pointer\n",__FUNCTION__);
+        return ret;
+    }
+
+    ctx = g_new0 (Context, 1);
+    ctx->bearer = get_bearer_context(index);
+    if (ctx->bearer)
+    {
+        properties  = mm_bearer_get_properties (ctx->bearer);
+        if( properties )
+        {
+            *ProfileId = mm_bearer_properties_get_profile_id(properties);
+            *ipType = mm_bearer_properties_get_ip_type (properties);
+            g_clear_object (&properties);
+            ret = RETURN_OK;
+        }
+    }
+
+    context_free(ctx);
+
+    return ret;
+}
 #endif //CM_EXTN_SUPPORTED
 
