+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.RxChannel", RBUS_ELEMENT_TYPE_PROPERTY, {extn_Cell_Tower_GetParamLongValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.TxChannel", RBUS_ELEMENT_TYPE_PROPERTY, {extn_Cell_Tower_GetParamLongValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+#endif
+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.ECI", RBUS_ELEMENT_TYPE_PROPERTY, {extn_Cell_Tower_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.eNB", RBUS_ELEMENT_TYPE_PROPERTY, {extn_Cell_Tower_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.CID", RBUS_ELEMENT_TYPE_PROPERTY, {extn_Cell_Tower_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
     };
     rc = rbus_regDataElements(handle, ARRAY_SZ(dataElements), dataElements);
     if(rc != RBUS_ERROR_SUCCESS)
