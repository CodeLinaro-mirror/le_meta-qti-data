+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.SINR", RBUS_ELEMENT_TYPE_PROPERTY, {CellTower_extn_GetParamIntValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.EARFCN", RBUS_ELEMENT_TYPE_PROPERTY, {CellTower_extn_GetParamIntValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.ServingTime", RBUS_ELEMENT_TYPE_PROPERTY, {CellTower_extn_GetParamIntValue_rbus, NULL, NULL, NULL, NULL, NULL}},
+#ifdef CM_PROP_SUPPORTED
+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.Band", RBUS_ELEMENT_TYPE_PROPERTY, {extn_Cell_Tower_GetParamStringValue_rbus, NULL, NULL, NULL, NULL, NULL}},
