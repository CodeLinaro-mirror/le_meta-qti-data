 .../middle_layer_src/cellularmgr_rbus_dml.c   | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c b/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
index bffd40e..a84ad6b 100755
--- a/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
+++ b/source/TR-181/middle_layer_src/cellularmgr_rbus_dml.c
@@ -211,6 +211,15 @@ rbusError_t cellularmgr_Init()
             }
         }
 
+        pstInterfaceInfo->stCellularInterfaceInfoExtn.ulCellTowerNoOfEntries  = 1;
+
+#ifdef CM_EXTN_SUPPORTED
+        CELLULAR_TABLE_TYPE celltower_tableType = CELLTOWER_TABLE_TYPE;
+        if (RBUS_ERROR_SUCCESS != Cellular_Row_Registration(celltower_tableType, i, &(pstDmlCellular->pstInterfaceInfo[i].stCellularInterfaceInfoExtn)))
+        {
+            CcspTraceError(("%s-%d : Failed to Add X_QCOM CellTower Inst \n", __FUNCTION__, __LINE__));
+        }
+#endif
     }
 
 #ifdef CM_EXTN_SUPPORTED
@@ -1413,6 +1422,9 @@ bool AvailableNetworks_IsUpdated_rbus(void* ctx)
     PCELLULAR_DML_INFO          pstDmlCellular =  (PCELLULAR_DML_INFO) pMyObject->pstDmlCellular;
     PCELLULAR_INTERFACE_INFO   pstInterfaceInfo = NULL;
     INT index = 0;
+#ifdef CM_EXTN_SUPPORTED
+    char scanStatusBuf[BUFFER_SIZE_32] = {0};
+#endif
 
     if (pstDmlCellular == NULL)
     {
@@ -1437,6 +1449,16 @@ bool AvailableNetworks_IsUpdated_rbus(void* ctx)
         return false;
     }
 
+#ifdef CM_EXTN_SUPPORTED
+    if(sysevent_fd >= 0)
+    {
+        sysevent_get(sysevent_fd, sysevent_token, "celltower_scan_status", scanStatusBuf, sizeof(scanStatusBuf));
+        if (strcmp(scanStatusBuf, "scan_in_progress") == 0)
+        {
+            return false; // Blocking available network scan while celltower DM scan is running
+        }
+    }
+#endif
     if ( ( AnscGetTickInSeconds() - pstPlmnInfo->ulAvailableNetworkListLastUpdatedTime ) < CELLULAR_AVAILABLE_NETWORK_LIST_REFRESH_THRESHOLD )
     {
         return false;
@@ -3918,6 +3940,36 @@ rbusError_t registerGeneratedDataElements(rbusHandle_t handle)
