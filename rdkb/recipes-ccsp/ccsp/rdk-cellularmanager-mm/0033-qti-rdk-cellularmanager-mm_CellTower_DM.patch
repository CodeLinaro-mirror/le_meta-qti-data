+#endif
+        {"Device.Cellular.Interface.{i}.X_QCOM.CellTower.{i}.RSRP", RBUS_ELEMENT_TYPE_PROPERTY, {CellTower_extn_GetParamIntValue_rbus, NULL, NULL, NULL, NULL, NULL}},
