+    {
+        AnscTraceFlow(("<$HL> %s cannot find brInst =%lu, bVlanPort inst=%lu\n",__FUNCTION__,
+            pBridge->l2InstanceNumber,pCfg->InstanceNumber));
+        return ANSC_STATUS_CANT_FIND;
+    }
+    rc = strcpy_s(curVlanPort->alias,sizeof(curVlanPort->alias), pCfg->Alias);
+    ERR_CHK(rc);
+    curVlanPort->enable = pCfg->bEnabled;
+    curVlanPort->untag = pCfg->bUntagged;
+    curVlanPort->instanceNumber = pCfg->InstanceNumber;
+    curVlanPort->vlaninsnum = pCfg->VLANInsNum;
+    curVlanPort->portinsnum = pCfg->PortInsNum;
+    _Psm_SetBVlanPort(ulBrgInstanceNumber, curVlanPort->instanceNumber, curVlanPort);
+
+    return ANSC_STATUS_SUCCESS;
+}
