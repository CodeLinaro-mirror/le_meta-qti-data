+ANSC_STATUS CosaDmlBrgVlanPortGetEntry
+    (
+        ANSC_HANDLE                 hContext,
+        ULONG                       ulBrgInstanceNumber,
+        ULONG                       ulIndex,
+        PCOSA_DML_BRG_VLANPORT_FULL pEntry
+    )
+{
+    UNREFERENCED_PARAMETER(hContext);
+#if _COSA_INTEL_USG_ARM_ || _COSA_BCM_MIPS_
+    PBRIDGE pBridge = getBridge(ulBrgInstanceNumber);
+    if (pBridge == NULL) {
+        AnscTraceFlow(("<HL> %s Bridge not found ulBrgInstanceNumber=%lu, ulIndex=%lu\n",__FUNCTION__,
+            ulBrgInstanceNumber,ulIndex));
+        return ANSC_STATUS_CANT_FIND;
+    }
+    PBRIDGE_VLANPORT pBVlanPort = (PBRIDGE_VLANPORT) AnscSListGetEntryByIndex(&pBridge->vlanPortList, ulIndex);
+    if (pBVlanPort == NULL) {
+        AnscTraceFlow(("<HL> %s vlanPort not found ulBrgInstanceNumber=%lu, ulIndex=%lu\n",__FUNCTION__,
+            ulBrgInstanceNumber,ulIndex));
+        return ANSC_STATUS_CANT_FIND;
+    }
+    CcspTraceInfo(("------CosaDmlBrgVlanPortGetEntry,instancenum:%lu,alias:%s\n", pBVlanPort->instanceNumber, pBVlanPort->alias));
+    AnscCopyString(pEntry->Cfg.Alias, pBVlanPort->alias);
+    pEntry->Cfg.InstanceNumber = pBVlanPort->instanceNumber;
+    pEntry->Cfg.bEnabled = pBVlanPort->enable;
+    pEntry->Cfg.VLANInsNum = pBVlanPort->vlaninsnum;
+    pEntry->Cfg.PortInsNum = pBVlanPort->portinsnum;
+    pEntry->Cfg.bUntagged = pBVlanPort->untag;
+
+    return ANSC_STATUS_SUCCESS;
+#endif
+}
