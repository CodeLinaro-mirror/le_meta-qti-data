+    if( AnscEqualString(ParamName, "Alias", TRUE))
+    {
+        AnscCopyString(pValue, pXQCOMRule->Alias);
+        return 0;
+    }
+
+    if( AnscEqualString(ParamName, "Direction", TRUE))
+    {
+        AnscCopyString(pValue, pXQCOMRule->Direction);
+        return 0;
+    }
+
+    if( AnscEqualString(ParamName, "Protocol", TRUE))
+    {
+       // If Protocol is not set or empty, return default "udp"
+       if (!pXQCOMRule->Protocol || pXQCOMRule->Protocol[0] == '\0')
+       {
+           AnscCopyString(pValue, "udp");
+       }
+       else
+       {
+           AnscCopyString(pValue, pXQCOMRule->Protocol);
+       }
+       return 0;
+    }
+
+    if( AnscEqualString(ParamName, "SourceIPv6Address", TRUE))
+    {
+        AnscCopyString(pValue, pXQCOMRule->SourceIPv6Address);
+        return 0;
+    }
+
+    if( AnscEqualString(ParamName, "DestIPv6Address", TRUE))
+    {
+        AnscCopyString(pValue, pXQCOMRule->DestinationIPv6Address);
+        return 0;
+    }
+
+    return -1;
+}
