+/**********************************************************************
+
+    caller:     owner of this object
+
+    prototype:
+
+        BOOL
+        X_QCOMRule_SetParamStringValue
+            (
+                ANSC_HANDLE                 hInsContext,
+                char*                       ParamName,
+                char*                       pString
+            );
+
+    description:
+
+        This function is called to set string parameter value;
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+                char*                       ParamName,
+                The parameter name;
+
+                char*                       pString
+                The updated string value;
+
+    return:     TRUE if succeeded.
+
+**********************************************************************/
+BOOL
+X_QCOMRule_SetParamStringValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        char*                       pString
+    )
+{
+    PCOSA_CONTEXT_LINK_OBJECT          pLinkObj       = (PCOSA_CONTEXT_LINK_OBJECT)hInsContext;
+    PCOSA_DML_FIREWALL_QCOMRULE      pXQCOMRule    = (PCOSA_DML_FIREWALL_QCOMRULE)pLinkObj->hContext;
+
+    if( AnscEqualString(ParamName, "Alias", TRUE))
+    {
+        AnscCopyString(pXQCOMRule->Alias,pString);
+        return TRUE;
+    }
+
+    if( AnscEqualString(ParamName, "Protocol", TRUE))
+    {
+        if(strcmp(pString, "tcp") == 0)
+        {
+            AnscCopyString(pXQCOMRule->Protocol, "tcp");
+            return TRUE;
+        }
+        else if(strcmp(pString, "udp") == 0) {
+            AnscCopyString(pXQCOMRule->Protocol, "udp");
+            return TRUE;
+        }
+        // Checking if the protocol is both tcp and udp
+        else if(strcmp(pString, "tcp_udp") == 0) {
+            AnscCopyString(pXQCOMRule->Protocol, "tcp_udp");
+             return TRUE;
+        }
+        else
+        {
+            return FALSE;
+        }
+    }
+
+    if( AnscEqualString(ParamName, "Direction", TRUE))
+    {
+        if(strcmp(pString, "Uplink") == 0)
+        {
+            AnscCopyString(pXQCOMRule->Direction, "Uplink");
+            return TRUE;
+        }
+        else if(strcmp(pString, "Downlink") == 0)
+        {
+            AnscCopyString(pXQCOMRule->Direction, "Downlink");
+            return TRUE;
+        }
+        else
+        {
+            return FALSE;
+        }
+    }
+
+
+    if( AnscEqualString(ParamName, "SourceIPv6Address", TRUE))
+    {
+        // Clear existing source IPv6 address if new value is empty or "0:0:0:0"
+        if (pString == NULL || *pString == '\0' || strcmp(pString, "::0") == 0 || strcmp(pString, "0:0:0:0:0:0:0:0") == 0 ||
+            strcmp(pString, "::") == 0)
+        {
+            memset(pXQCOMRule->SourceIPv6Address, 0, sizeof(pXQCOMRule->SourceIPv6Address));
+            return TRUE;
+        }
+        // Validate and copy the IPv6 address if not empty
+        if (strlen(pString) < sizeof(pXQCOMRule->SourceIPv6Address))
+        {
+            AnscCopyString(pXQCOMRule->SourceIPv6Address,pString);
+            return TRUE;
+        }
+        return FALSE;
+    }
+    if( AnscEqualString(ParamName, "DestIPv6Address", TRUE))
+    {
+        // Clear existing Destination IPv6 address if new value is empty, NULL, or "::0"
+        if (pString == NULL || *pString == '\0' || strcmp(pString, "::0") == 0 || strcmp(pString, "0:0:0:0:0:0:0:0") == 0 ||
+            strcmp(pString, "::") == 0)
+        {
+            memset(pXQCOMRule->DestinationIPv6Address, 0, sizeof(pXQCOMRule->DestinationIPv6Address));
+            return TRUE;
+        }
+        // Validate and copy the IPv6 address if not empty
+        if (strlen(pString) < sizeof(pXQCOMRule->DestinationIPv6Address))
+        {
+            AnscCopyString(pXQCOMRule->DestinationIPv6Address,pString);
+            return TRUE;
+        }
+        return FALSE;
+    }
+    return FALSE;
+}
