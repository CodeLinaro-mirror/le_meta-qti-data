+/***********************************************************************
+ APIs for Object:
+
+    Firewall.X_QCOM.Rule.{i}.
+
+    *  CosaDmlQcomRuleGetNumberOfEntries
+    *  CosaDmlQcomRuleGetEntryByIndex
+    *  CosaDmlQcomRuleSetValues
+    *  CosaDmlQcomRuleAddEntry
+    *  CosaDmlQcomRuleDelEntry
+    *  CosaDmlQcomRuleGetConf
+    *  CosaDmlQcomRuleSetConf
+***********************************************************************/
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        int
+        X_QCOMRule_InsGetIndex
+            (
+                ULONG ins
+            );
+
+    Description:
+        The API retrieves the index of a QCOM rule entry based on its instance number.
+    Arguments:
+        ins         The instance number to search for.
+    Return:
+        Returns the index if found, -1 otherwise.
+
+**********************************************************************/
+
+static int totalxqcomRule   = 0;
+static int X_QCOMRule_InsGetIndex(ULONG ins)
+{
+    int i=0, ins_num=0, ret = -1;
+    UtopiaContext ctx;
+    CosaDmlQcomRuleGetNumberOfEntries();
+    if (!Utopia_Init(&ctx))
+    {
+        return -1;
+    }
+
+    for (i = 0; i < totalxqcomRule; i++)
+    {
+        Utopia_GetFirewall_XQCOMRuleInsNumByIndex(&ctx, i, &ins_num);
+        if (ins_num == ins) {
+            ret = i;
+            break;
+        }
+    }
+    Utopia_Free(&ctx, 0);
+    return ret;
+}
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ULONG
+        CosaDmlQcomRuleGetNumberOfEntries
+            (
+                void
+            );
+
+    Description:
+        The API retrieves the total number of QCOM rule entries in the Firewall.
+    Arguments:
+        None
+    Return:
+        Returns the total number of entries or ANSC_STATUS_FAILURE on error.
+
+**********************************************************************/
+ULONG
+CosaDmlQcomRuleGetNumberOfEntries(void)
+{
+    UtopiaContext ctx;
+
+    if(!Utopia_Init(&ctx))
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+
+    Utopia_GetNumberOfFirewall_XQCOMRule(&ctx, &totalxqcomRule);
+    Utopia_Free(&ctx, 0);
+    return totalxqcomRule;
+}
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlQcomRuleGetEntryByIndex
+            (
+                ULONG index,
+                PCOSA_DML_FIREWALL_QCOMRULE pEntry
+            );
+
+    Description:
+        The API retrieves a QCOM rule entry from Firewall by its index.
+    Arguments:
+        index       The index of the entry to retrieve.
+        pEntry      Pointer to store the retrieved entry information.
+    Return:
+        Status of the operation.
+
+**********************************************************************/
+
+ANSC_STATUS
+CosaDmlQcomRuleGetEntryByIndex(ULONG index, PCOSA_DML_FIREWALL_QCOMRULE pEntry)
+{
+    UtopiaContext ctx;
+    firewall_x_qcomrule_t firewall_x_qcomrule;
+
+    if (index >= totalxqcomRule || !Utopia_Init(&ctx))
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+
+    Utopia_GetFirewall_XQCOMRuleByIndex(&ctx, index, &firewall_x_qcomrule);
+
+    pEntry->InstanceNumber = firewall_x_qcomrule.ins_num ;
+    pEntry->bEnabled = firewall_x_qcomrule.enable;
+    pEntry->DestinationPort = firewall_x_qcomrule.destination_port;
+    pEntry->SourcePort = firewall_x_qcomrule.source_port;
+    _ansc_strncpy(pEntry->Protocol, firewall_x_qcomrule.protocol,sizeof(pEntry->Protocol));
+    _ansc_strncpy(pEntry->Direction, firewall_x_qcomrule.direction,sizeof(pEntry->Direction));
+    pEntry->DestinationIPAddress.Value = firewall_x_qcomrule.destination_ipaddress.Value;
+    pEntry->SourceIPAddress.Value= firewall_x_qcomrule.source_ipaddress.Value;
+    _ansc_strncpy(pEntry->DestinationIPv6Address, firewall_x_qcomrule.destination_ipv6address,sizeof(pEntry->DestinationIPv6Address));
+    _ansc_strncpy(pEntry->SourceIPv6Address, firewall_x_qcomrule.source_ipv6address,sizeof(pEntry->SourceIPv6Address));
+    _ansc_strncpy(pEntry->Alias,firewall_x_qcomrule.alias, sizeof(pEntry->Alias));
+    Utopia_Free(&ctx, 0);
+
+    return ANSC_STATUS_SUCCESS;
+}
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlQcomRuleDelEntry
+            (
+                ULONG      ins
+            );
+
+    Description:
+        The API removes the designated rule entry from Firewall.
+    Arguments:
+        pAlias      The entry is identified through Alias.
+    Return:
+        Status of the operation.
+
+**********************************************************************/
+ANSC_STATUS
+CosaDmlQcomRuleDelEntry(ULONG ins)
+{
+    int rc = -1;
+    UtopiaContext ctx;
+
+    if (!Utopia_Init(&ctx))
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+
+    rc = Utopia_DelFirewall_XQCOMRule(&ctx, ins);
+    Utopia_GetNumberOfFirewall_XQCOMRule(&ctx, &totalxqcomRule);
+    Utopia_Free(&ctx, !rc);
+
+    if (rc != 0)
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+    else
+    {
+        commonSyseventSet("pp_flush", "1");
+        commonSyseventSet("firewall-restart", "");
+        return ANSC_STATUS_SUCCESS;
+    }
+}
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlQcomRuleAddEntry
+            (
+                PCOSA_DML_FIREWALL_QCOMRULE pEntry
+            );
+
+    Description:
+        The API adds a new rule entry to the Firewall.
+    Arguments:
+        pEntry      Contains the configuration for the new entry.
+    Return:
+        Status of the operation.
+
+**********************************************************************/
+
+ANSC_STATUS
+CosaDmlQcomRuleAddEntry(PCOSA_DML_FIREWALL_QCOMRULE pEntry)
+{
+    int rc = -1;
+    UtopiaContext ctx;
+    firewall_x_qcomrule_t firewall_x_qcomrule;
+
+    if (!Utopia_Init(&ctx))
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+
+    firewall_x_qcomrule.ins_num = pEntry->InstanceNumber;
+    firewall_x_qcomrule.enable = pEntry->bEnabled;
+    firewall_x_qcomrule.destination_port = pEntry->DestinationPort;
+    firewall_x_qcomrule.source_port = pEntry->SourcePort;
+    _ansc_strncpy(firewall_x_qcomrule.protocol , pEntry->Protocol, sizeof(firewall_x_qcomrule.protocol));
+    _ansc_strncpy(firewall_x_qcomrule.direction , pEntry->Direction, sizeof(firewall_x_qcomrule.direction));
+    firewall_x_qcomrule.destination_ipaddress.Value= pEntry->DestinationIPAddress.Value;
+    firewall_x_qcomrule.source_ipaddress.Value =  pEntry->SourceIPAddress.Value;
+    _ansc_strncpy(firewall_x_qcomrule.alias, pEntry->Alias, sizeof(firewall_x_qcomrule.alias));
+    _ansc_strncpy(firewall_x_qcomrule.source_ipv6address , pEntry->SourceIPv6Address, sizeof(firewall_x_qcomrule.source_ipv6address));
+    _ansc_strncpy(firewall_x_qcomrule.destination_ipv6address , pEntry->DestinationIPv6Address, sizeof(firewall_x_qcomrule.destination_ipv6address));
+    rc = Utopia_AddFirewall_XQCOMRule(&ctx, &firewall_x_qcomrule);
+    Utopia_GetNumberOfFirewall_XQCOMRule(&ctx, &totalxqcomRule);
+    Utopia_Free(&ctx, !rc);
+
+    if (rc != 0)
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+    else
+    {
+        commonSyseventSet("pp_flush", "1");
+        commonSyseventSet("firewall-restart", "");
+        return ANSC_STATUS_SUCCESS;
+    }
+
+}
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlQcomRuleSetConf
+            (
+             ULONG                           ins,
+             PCOSA_DML_FIREWALL_QCOMRULE      pEntry
+            );
+
+    Description:
+        The API re-configures the designated firewall xqcom rule entry.
+    Arguments:
+        pAlias      The entry is identified through Alias.
+        pEntry      The new configuration is passed through this argument, even Alias field can be changed.
+
+    Return:
+        Status of the operation
+
+**********************************************************************/
+ANSC_STATUS
+CosaDmlQcomRuleSetConf(ULONG ins, PCOSA_DML_FIREWALL_QCOMRULE pEntry)
+{
+    int index;
+    UtopiaContext ctx;
+    int rc = -1;
+    firewall_x_qcomrule_t firewall_x_qcomrule;
+
+    if ((index = X_QCOMRule_InsGetIndex(ins)) == -1 || !Utopia_Init(&ctx))
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+
+    firewall_x_qcomrule.ins_num = pEntry->InstanceNumber;
+    firewall_x_qcomrule.enable = pEntry->bEnabled;
+    firewall_x_qcomrule.destination_port = pEntry->DestinationPort;
+    firewall_x_qcomrule.source_port = pEntry->SourcePort;
+    _ansc_strncpy(firewall_x_qcomrule.protocol , pEntry->Protocol, sizeof(firewall_x_qcomrule.protocol));
+    _ansc_strncpy(firewall_x_qcomrule.direction , pEntry->Direction, sizeof(firewall_x_qcomrule.direction));
+    firewall_x_qcomrule.destination_ipaddress.Value= pEntry->DestinationIPAddress.Value;
+    firewall_x_qcomrule.source_ipaddress.Value =  pEntry->SourceIPAddress.Value;
+    _ansc_strncpy(firewall_x_qcomrule.alias, pEntry->Alias, sizeof(firewall_x_qcomrule.alias));
+    _ansc_strncpy(firewall_x_qcomrule.destination_ipv6address, pEntry->DestinationIPv6Address, sizeof(firewall_x_qcomrule.destination_ipv6address));
+    _ansc_strncpy(firewall_x_qcomrule.source_ipv6address, pEntry->SourceIPv6Address, sizeof(firewall_x_qcomrule.source_ipv6address));
+    rc = Utopia_SetFirewall_XQCOMRuleByIndex(&ctx, index, &firewall_x_qcomrule);
+    Utopia_Free(&ctx, !rc);
+
+    if (rc != 0)
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+    else
+    {
+        commonSyseventSet("pp_flush", "1");
+        commonSyseventSet("firewall-restart", "");
+        return ANSC_STATUS_SUCCESS;
+    }
+}
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlQcomRuleGetConf
+            (
+                ULONG ins,
+                PCOSA_DML_FIREWALL_QCOMRULE pEntry
+            );
+
+    Description:
+        The API retrieves the configuration of a designated QCOM rule entry.
+    Arguments:
+        ins         The instance number of the entry to retrieve.
+        pEntry      Pointer to store the retrieved configuration.
+    Return:
+        Status of the operation.
+
+**********************************************************************/
+
+ANSC_STATUS
+CosaDmlQcomRuleGetConf(ULONG ins, PCOSA_DML_FIREWALL_QCOMRULE pEntry)
+{
+    int index;
+
+    if ((index = X_QCOMRule_InsGetIndex(ins)) == -1)
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+    return CosaDmlQcomRuleGetEntryByIndex(index, pEntry);
+}
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlQcomRuleSetValues
+            (
+                ULONG index,
+                ULONG ins,
+                const char *alias
+            );
+
+    Description:
+        The API sets the instance number and alias for a QCOM rule entry.
+    Arguments:
+        index       The index of the entry to modify.
+        ins         The new instance number to set.
+        alias       The new alias to set.
+    Return:
+        Status of the operation.
+
+**********************************************************************/
+
+ANSC_STATUS
+CosaDmlQcomRuleSetValues(ULONG index, ULONG ins, const char *alias)
+{
+    int rc = -1;
+    UtopiaContext ctx;
+
+    if (index >= totalxqcomRule || !Utopia_Init(&ctx))
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+
+    rc = Utopia_SetFirewall_XQCOMRuleInsAndAliasByIndex(&ctx, index, ins, alias);
+    Utopia_Free(&ctx, !rc);
+
+    if (rc != 0)
+        return ANSC_STATUS_FAILURE;
+    else
+    {
+        return ANSC_STATUS_SUCCESS;
+    }
+}
