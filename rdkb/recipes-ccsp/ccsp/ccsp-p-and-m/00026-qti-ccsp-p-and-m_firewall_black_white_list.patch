+
+ APIs for Object:
+
+    Firewall.X_QCOM.
+    *  X_QCOM_GetParamUlongValue
+    *  X_QCOM_SetParamUlongValue
+***********************************************************************/
+/**********************************************************************
+
+    caller:     owner of this object
+
+    prototype:
+
+        BOOL
+        X_QCOM_GetParamUlongValue
+            (
+                ANSC_HANDLE                 hInsContext,
+                char*                       ParamName,
+                ULONG*                      puLong
+            );
+
+    description:
+
+        This function is called to retrieve ULONG parameter value;
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+                char*                       ParamName,
+                The parameter name;
+
+                ULONG*                      puLong
+                The buffer of returned ULONG value;
+
+    return:     TRUE if succeeded.
+
+**********************************************************************/
+ULONG
+X_QCOM_GetParamUlongValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        ULONG*                      puLong
+
+
+    )
+{
+     /* check the parameter name and set the corresponding value */
+     if (strcmp(ParamName, "RuleType") == 0)
+     {
+         char buf[16]={0};
+        //Updating RuleType with syscfg firewall_rule_type
+         if(!syscfg_get( NULL, "firewall_rule_type", buf, sizeof(buf)))
+         {
+             if (strncasecmp(buf, "Whitelist", strlen("Whitelist")) == 0)
+                 *puLong = 1;
+             else if (strncasecmp(buf, "Blacklist", strlen("Blacklist")) == 0)
+                 *puLong = 2;
+             else if(strncasecmp(buf, "None", strlen("None")) == 0)
+                *puLong = 3;
+             return TRUE;
+         }
+     }
+     CcspTraceWarning(("Unsupported parameter '%s'\n", ParamName));
+     return FALSE;
+}
