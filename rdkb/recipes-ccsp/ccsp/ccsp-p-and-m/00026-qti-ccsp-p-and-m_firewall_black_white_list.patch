+typedef  enum
+_COSA_DML_QCOM_RULE
+{
+    COSA_DML_QCOM_RULE_Whitelist   = 1,
+    COSA_DML_QCOM_RULE_Blacklist,
+    COSA_DML_QCOM_RULE_None,
+}
+COSA_DML_QCOM_RULE, *PCOSA_DML_QCOM_RULE;
+
 
 typedef  struct
 _COSA_DML_FIREWALL_CFG
@@ -91,9 +100,27 @@ _COSA_DML_FIREWALL_CFG
     COSA_DML_FIREWALL_LEVEL         FirewallLevel;
     char                            Version[8];
     char                            LastChange[32];
+    COSA_DML_QCOM_RULE              RuleType;
 }
 COSA_DML_FIREWALL_CFG,  *PCOSA_DML_FIREWALL_CFG;
 
+typedef struct
+_COSA_DML_FIREWALL_QCOMRULE
+{
+    ULONG                           InstanceNumber;
+    BOOLEAN                         bEnabled;
+    ULONG                           DestinationPort;
