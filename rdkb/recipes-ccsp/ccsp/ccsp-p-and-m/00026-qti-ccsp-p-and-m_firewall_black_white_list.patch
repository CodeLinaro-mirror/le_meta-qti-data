+/**********************************************************************
+
+    caller:     owner of this object
+
+    prototype:
+
+        ULONG
+        X_QCOMRule_Commit
+            (
+                ANSC_HANDLE                 hInsContext
+            );
+
+    description:
+
+        This function is called to finally commit all the update.
+
+    argument:   ANSC_HANDLE                 hInsContext,
+                The instance handle;
+
+    return:     The status of the operation.
+
+**********************************************************************/
+ULONG
+X_QCOMRule_Commit
+    (
+        ANSC_HANDLE                 hInsContext
+    )
+{
+    PCOSA_DATAMODEL_FIREWALL        pCosaDMFirewall   = (PCOSA_DATAMODEL_FIREWALL )g_pCosaBEManager->hFirewall;
+    PCOSA_CONTEXT_LINK_OBJECT       pLinkObj          = (PCOSA_CONTEXT_LINK_OBJECT)hInsContext;
+    PCOSA_DML_FIREWALL_QCOMRULE   pXQCOMRule       = (PCOSA_DML_FIREWALL_QCOMRULE)pLinkObj->hContext;
+    if (pLinkObj->bNew)
+    {
+        if (CosaDmlQcomRuleAddEntry(pXQCOMRule) != ANSC_STATUS_SUCCESS)
+        {
+            return -1;
+        }
+        CosaPcReg_X_QCOMRuleDelInfo((ANSC_HANDLE)pCosaDMFirewall, (ANSC_HANDLE)pLinkObj);
+        pLinkObj->bNew = FALSE;
+    }
+    else
+    {
+        if (CosaDmlQcomRuleSetConf(pXQCOMRule->InstanceNumber, pXQCOMRule) != ANSC_STATUS_SUCCESS)
+        {
+            CosaDmlQcomRuleGetConf(pXQCOMRule->InstanceNumber, pXQCOMRule);
+            return -1;
+        }
+    }
+
+    return 0;
+}
