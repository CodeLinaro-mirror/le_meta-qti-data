+ANSC_STATUS
+CosaPcReg_X_QCOMRuleAddInfo
+   (
+       ANSC_HANDLE                 hThisObject,
+       ANSC_HANDLE                 hCosaContext
+   )
+{
+
+   ANSC_STATUS                     returnStatus            = ANSC_STATUS_SUCCESS;
+   PCOSA_DATAMODEL_FIREWALL        pMyObject    = (PCOSA_DATAMODEL_FIREWALL)hThisObject;
+   PPOAM_IREP_FOLDER_OBJECT        pPoamIrepFoX_QCOMRule      = (PPOAM_IREP_FOLDER_OBJECT )pMyObject->hIrepFolderQComRule;
+   PPOAM_IREP_FOLDER_OBJECT        pPoamIrepFoX_QCOMRuleSp    = (PPOAM_IREP_FOLDER_OBJECT )NULL;
+   PCOSA_CONTEXT_LINK_OBJECT       pCosaContext            = (PCOSA_CONTEXT_LINK_OBJECT)hCosaContext;
+   COSA_DML_FIREWALL_QCOMRULE       *pEntry                 = (COSA_DML_FIREWALL_QCOMRULE*)pCosaContext->hContext;
+   PSLAP_VARIABLE                  pSlapVariable           = (PSLAP_VARIABLE )NULL;
+
+   if ( !pPoamIrepFoX_QCOMRule )
+   {
+       return ANSC_STATUS_FAILURE;
+   }
+   else
+   {
+       pPoamIrepFoX_QCOMRule->EnableFileSync((ANSC_HANDLE)pPoamIrepFoX_QCOMRule, FALSE);
+   }
+   if ( TRUE )
+   {
+       SlapAllocVariable(pSlapVariable);
+
+       if ( !pSlapVariable )
+       {
+           returnStatus = ANSC_STATUS_RESOURCES;
+           goto  EXIT1;
+       }
+   }
+
+   if ( TRUE )
+   {
+       returnStatus =
+           pPoamIrepFoX_QCOMRule->DelRecord
+               (
+                   (ANSC_HANDLE)pPoamIrepFoX_QCOMRule,
+                   COSA_DML_RR_NAME_X_QCOMRULE_NextInsNumber
+               );
+
+      pSlapVariable->Syntax            = SLAP_VAR_SYNTAX_uint32;
+       pSlapVariable->Variant.varUint32 = pMyObject->x_qcomRuleNextInsNum;
+
+       returnStatus =
+           pPoamIrepFoX_QCOMRule->AddRecord
+               (
+                   (ANSC_HANDLE)pPoamIrepFoX_QCOMRule,
+                   COSA_DML_RR_NAME_X_QCOMRULE_NextInsNumber,
+                   SYS_REP_RECORD_TYPE_UINT,
+                   SYS_RECORD_CONTENT_DEFAULT,
+                   pSlapVariable,
+                   0
+               );
+
+       SlapCleanVariable(pSlapVariable);
+       SlapInitVariable (pSlapVariable);
+   }
+
+   if ( TRUE )
+   {
+        pPoamIrepFoX_QCOMRuleSp =
+           pPoamIrepFoX_QCOMRule->AddFolder
+               (
+                   (ANSC_HANDLE)pPoamIrepFoX_QCOMRule,
+                   pEntry->Alias,
+                   0
+               );
+
+       if ( !pPoamIrepFoX_QCOMRuleSp )
+       {
+           returnStatus = ANSC_STATUS_FAILURE;
+           goto  EXIT1;
+       }
+
+       if ( TRUE )
+       {
+           pSlapVariable->Syntax            = SLAP_VAR_SYNTAX_uint32;
+           pSlapVariable->Variant.varUint32 = pEntry->InstanceNumber;
+
+           returnStatus =
+               pPoamIrepFoX_QCOMRuleSp->AddRecord
+                   (
+                       (ANSC_HANDLE)pPoamIrepFoX_QCOMRuleSp,
+                       COSA_DML_RR_NAME_X_QCOMRULE_InsNum,
+                       SYS_REP_RECORD_TYPE_UINT,
+                       SYS_RECORD_CONTENT_DEFAULT,
+                       pSlapVariable,
+                       0
+                   );
+
+           SlapCleanVariable(pSlapVariable);
+           SlapInitVariable (pSlapVariable);
+       }
+
+       if ( TRUE )
+       {
+           pSlapVariable->Syntax            = SLAP_VAR_SYNTAX_string;
+           pSlapVariable->Variant.varString = AnscCloneString(pEntry->Alias);
+
+           returnStatus =
+               pPoamIrepFoX_QCOMRuleSp->AddRecord
+                   (
+                       (ANSC_HANDLE)pPoamIrepFoX_QCOMRuleSp,
+                       COSA_DML_RR_NAME_X_QCOMRULE_Alias,
+                       SYS_REP_RECORD_TYPE_ASTR,
+                       SYS_RECORD_CONTENT_DEFAULT,
+                       pSlapVariable,
+                       0
+                   );
+
+           SlapCleanVariable(pSlapVariable);
+           SlapInitVariable (pSlapVariable);
+       }
+
+       pCosaContext->hPoamIrepUpperFo = (ANSC_HANDLE)pPoamIrepFoX_QCOMRule;
+       pCosaContext->hPoamIrepFo      = (ANSC_HANDLE)pPoamIrepFoX_QCOMRuleSp;
+   }
+
+EXIT1:
+
+   if ( pSlapVariable )
+   {
+       SlapFreeVariable(pSlapVariable);
+   }
+
+   pPoamIrepFoX_QCOMRule->EnableFileSync((ANSC_HANDLE)pPoamIrepFoX_QCOMRule, TRUE);
+
+   return returnStatus;
+
+}
