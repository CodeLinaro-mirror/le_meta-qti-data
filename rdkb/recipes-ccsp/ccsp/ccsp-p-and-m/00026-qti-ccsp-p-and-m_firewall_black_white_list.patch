+   PCOSA_DATAMODEL_FIREWALL        pMyObject               = (PCOSA_DATAMODEL_FIREWALL  )hThisObject;
+   PSLIST_HEADER                   pListHead               = (PSLIST_HEADER             )&pMyObject->FirewallX_QCOMRuleList;
+   PPOAM_IREP_FOLDER_OBJECT        pPoamIrepFoX_QCOMRule      = (PPOAM_IREP_FOLDER_OBJECT  )pMyObject->hIrepFolderQComRule;
+   PPOAM_IREP_FOLDER_OBJECT        pPoamIrepFoX_QCOMRuleSp    = (PPOAM_IREP_FOLDER_OBJECT  )NULL;
+   PCOSA_DML_FIREWALL_QCOMRULE      pEntry                  = (PCOSA_DML_FIREWALL_QCOMRULE)NULL;
+   PCOSA_CONTEXT_LINK_OBJECT       pCosaContext            = (PCOSA_CONTEXT_LINK_OBJECT )NULL;
+   PSLAP_VARIABLE                  pSlapVariable           = (PSLAP_VARIABLE            )NULL;
+   ULONG                           ulEntryCount            = 0;
+   ULONG                           ulIndex                 = 0;
+   ULONG                           ulInstanceNumber        = 0;
+   char*                           pFolderName             = NULL;
+
+   char*                           pAlias                  = NULL;
+   if ( !pPoamIrepFoX_QCOMRule )
+   {
+       return ANSC_STATUS_FAILURE;
+   }
+   ulEntryCount = pPoamIrepFoX_QCOMRule->GetFolderCount((ANSC_HANDLE)pPoamIrepFoX_QCOMRule);
+
+   for ( ulIndex = 0; ulIndex < ulEntryCount; ulIndex++)
+   {
+       pFolderName =
+           pPoamIrepFoX_QCOMRule->EnumFolder
+               (
+                   (ANSC_HANDLE)pPoamIrepFoX_QCOMRule,
+                   ulIndex
+               );
+
+       if ( !pFolderName )
+       {
+           continue;
+       }
+
+       pPoamIrepFoX_QCOMRuleSp = pPoamIrepFoX_QCOMRule->GetFolder((ANSC_HANDLE)pPoamIrepFoX_QCOMRule, pFolderName);
+
+       AnscFreeMemory(pFolderName);
+
+       if ( !pPoamIrepFoX_QCOMRuleSp )
+       {
+           continue;
+       }
+
+       if ( TRUE )
+       {
+           pSlapVariable =
+               (PSLAP_VARIABLE)pPoamIrepFoX_QCOMRuleSp->GetRecord
+                   (
+                       (ANSC_HANDLE)pPoamIrepFoX_QCOMRuleSp,
+                       COSA_DML_RR_NAME_X_QCOMRULE_InsNum,
+                       NULL
+                   );
+
+           if ( pSlapVariable )
+           {
+               ulInstanceNumber = pSlapVariable->Variant.varUint32;
+
+               SlapFreeVariable(pSlapVariable);
+           }
+       }
+
+       if ( TRUE )
+       {
+           pSlapVariable =
+               (PSLAP_VARIABLE)pPoamIrepFoX_QCOMRuleSp->GetRecord
+                   (
+                       (ANSC_HANDLE)pPoamIrepFoX_QCOMRuleSp,
+                       COSA_DML_RR_NAME_X_QCOMRULE_Alias,
+                       NULL
+                   );
+
+           if ( pSlapVariable )
+           {
+               pAlias = AnscCloneString(pSlapVariable->Variant.varString);
+
+               SlapFreeVariable(pSlapVariable);
+           }
+       }
+
+       pCosaContext = (PCOSA_CONTEXT_LINK_OBJECT)AnscAllocateMemory(sizeof(COSA_CONTEXT_LINK_OBJECT));
+
+       if ( !pCosaContext )
+       {
+           AnscFreeMemory(pAlias);
+           return ANSC_STATUS_RESOURCES;
+       }
+
+       pEntry = (PCOSA_DML_FIREWALL_QCOMRULE)AnscAllocateMemory(sizeof(COSA_DML_FIREWALL_QCOMRULE));
+
+       if ( !pEntry )
+       {
+           AnscFreeMemory(pAlias);
+           AnscFreeMemory(pCosaContext);
+           return ANSC_STATUS_RESOURCES;
+       }
+
+       AnscCopyString(pEntry->Alias, pAlias);
+
+       pEntry->InstanceNumber = ulInstanceNumber;
+
+       pCosaContext->InstanceNumber        = ulInstanceNumber;
+       pCosaContext->bNew                  = TRUE;
+       pCosaContext->hContext              = (ANSC_HANDLE)pEntry;
+       pCosaContext->hParentTable          = NULL;
+       pCosaContext->hPoamIrepUpperFo      = (ANSC_HANDLE)pPoamIrepFoX_QCOMRule;
+       pCosaContext->hPoamIrepFo           = (ANSC_HANDLE)pPoamIrepFoX_QCOMRuleSp;
+
+       CosaSListPushEntryByInsNum(pListHead, pCosaContext);
+
+       if ( pAlias )
+       {
+           AnscFreeMemory(pAlias);
+
+           pAlias = NULL;
+       }
+   }
+
+   return ANSC_STATUS_SUCCESS;
+}
