Index: git/source-arm/TR-181/board_sbapi/cosa_dhcpv6_apis_ext.c
===================================================================
--- git.orig/source-arm/TR-181/board_sbapi/cosa_dhcpv6_apis_ext.c
+++ git/source-arm/TR-181/board_sbapi/cosa_dhcpv6_apis_ext.c
@@ -15,7 +15,15 @@
 #include "ipc_msg.h"
 extern token_t sysevent_token_global;
 extern int sysevent_fd_global;
-extern int send_dhcp_data_to_wanmanager (ipc_dhcpv6_data_t *dhcpv6_data);
+extern int send_dhcp_data_to_wanmanager (ipc_dhcpv6_data_t *dhcpv6_data, int msgtype);
