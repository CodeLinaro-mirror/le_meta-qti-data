From ea0d2c205e9d6354b9b026a1ac2012bbb055a80a Mon Sep 17 00:00:00 2001
From: HuaWen CHEN <huawenc@qti.qualcomm.com>
Date: Sun, 28 Jun 2026 18:39:23 +0800
Subject: [PATCH] address-reconf: apply patch 00011 and fix wanmanager
 notification on _PLATFORM_SDX_

Apply recipe patch 00011-qti-CcspPandM_address_reconf and extend it with
two SDX95-specific fixes:

- Use wan_ifname_val (qmapmux0.0) instead of hardcoded erouter0 in the
  !CONFIGURABLE_WAN branch so wanmanager receives a matching VIF name for
  DHCP6C_STATE_CHANGED.

- In the compiled FEATURE_RDKB_WAN_MANAGER fallback path, read DNS from
  cellular_wan_v6_dns1/2 and gate DHCP6C_STATE_CHANGED notifications with
  a static prefix/DNS cache so unchanged data does not trigger reconf loops.

Change-Id: I9ec025bc8650217e99a1bda88fb30fc7c8e58c80
Signed-off-by: HuaWen CHEN <huawenc@qti.qualcomm.com>
---
 .../TR-181/board_sbapi/cosa_dhcpv6_apis.c     | 95 +++++++++++++++----
 1 file changed, 76 insertions(+), 19 deletions(-)

diff --git a/source-arm/TR-181/board_sbapi/cosa_dhcpv6_apis.c b/source-arm/TR-181/board_sbapi/cosa_dhcpv6_apis.c
index 593417a..88ed038 100644
--- a/source-arm/TR-181/board_sbapi/cosa_dhcpv6_apis.c
+++ b/source-arm/TR-181/board_sbapi/cosa_dhcpv6_apis.c
@@ -1128,6 +1128,12 @@ static void * dhcpv6c_dbg_thrd(void * in);
 static void * dhcpv6s_dbg_thrd(void * in);
 
 extern COSARepopulateTableProc            g_COSARepopulateTable;
+typedef struct {
+    char sitePrefix[256];
+    bool Ipv6Changed;
+    char nameserver[64];
+    char nameserver1[64];
+} TempDhcpData;
 
 #define UTOPIA_SIMULATOR                0
 
@@ -9598,6 +9604,23 @@ void DelIpv6Addr(char* ifname , char* ipv6Addr)
 
 void SetV6Route(char* ifname , char* route_addr,int metric_val)
 {
+    char mtu6_val[8];
+    int iMtu6Val=0;
+    memset(mtu6_val,0,sizeof(mtu6_val));
+    sysevent_get(sysevent_fd_global, sysevent_token_global, SYSEVENT_IPV6_MTU_SIZE, mtu6_val, sizeof(mtu6_val));
+    if(mtu6_val[0] != '\0' && strlen(mtu6_val) != 0)
+    {
+        iMtu6Val = atoi(mtu6_val);
+        if(iMtu6Val > 0)
+        {
+            CcspTraceInfo(("%s : interface name=%s ,route_addr=%s, metric_val=%d, ipv6_mtu_value %d\n", __FUNCTION__, ifname,route_addr,metric_val,iMtu6Val));
+            if ( 0 == metric_val )
+                v_secure_system("ip -6 route add default via %s dev %s mtu %d", route_addr,ifname,iMtu6Val);
+            else
+                v_secure_system("ip -6 route add default via %s dev %s metric %d mtu %d", route_addr,ifname,metric_val,iMtu6Val);
+            return;
+        }
+    }
     CcspTraceInfo(("%s : interface name=%s ,route_addr=%s, metric_val=%d\n", __FUNCTION__, ifname,route_addr,metric_val));
     if ( 0 == metric_val )
 #ifdef CORE_NET_LIB
@@ -9614,6 +9637,23 @@ void SetV6Route(char* ifname , char* route_addr,int metric_val)
 }
 void UnSetV6Route(char* ifname , char* route_addr,int metric_val)
 {
+    char mtu6_val[8];
+    int iMtu6Val=0;
+    memset(mtu6_val,0,sizeof(mtu6_val));
+    sysevent_get(sysevent_fd_global, sysevent_token_global, SYSEVENT_IPV6_MTU_SIZE, mtu6_val, sizeof(mtu6_val));
+    if(mtu6_val[0] != '\0' && strlen(mtu6_val) != 0)
+    {
+        iMtu6Val = atoi(mtu6_val);
+        if(iMtu6Val > 0)
+        {
+            CcspTraceInfo(("%s : interface name=%s ,route_addr=%s, metric_val=%d, ipv6_mtu_value %d\n", __FUNCTION__, ifname,route_addr,metric_val,iMtu6Val));
+            if ( 0 == metric_val )
+                v_secure_system("ip -6 route del default via %s dev %s mtu %d", route_addr,ifname,iMtu6Val);
+            else
+                v_secure_system("ip -6 route del default via %s dev %s metric %d mtu %d", route_addr,ifname,metric_val,iMtu6Val);
+            return;
+        }
+    }
     CcspTraceInfo(("%s : interface name=%s ,route_addr=%s, metric_val=%d\n", __FUNCTION__, ifname,route_addr,metric_val));
     if ( 0 == metric_val )
 #ifdef CORE_NET_LIB
@@ -11019,17 +11059,21 @@ dhcpv6c_dbg_thrd(void * in)
                         * Send data to wanmanager.
                         */
 
-                        char dns_server[256] = {'\0'};
+                        char wan_v6_dns1[64] = {'\0'};
+                        char wan_v6_dns2[64] = {'\0'};
                         char ipv6_lan_prefix[256] = {'\0'};
                         int prefix_unset_timeout = 100;
+                        static TempDhcpData tempDhcpData = {0};
                         sscanf(iapd_pretm, "%d", &hub4_preferred_lft);
                         sscanf(iapd_vldtm, "%d", &hub4_valid_lft);
                         ipc_dhcpv6_data_t dhcpv6_data;
                         memset(&dhcpv6_data, 0, sizeof(ipc_dhcpv6_data_t));
 
 #if defined(FEATURE_RDKB_CONFIGURABLE_WAN_INTERFACE)
                         strlcpy(dhcpv6_data.ifname, IfaceName, sizeof(dhcpv6_data.ifname));
 #elif defined(_PLATFORM_SDX_)
+                        char wan_ifname_val[32] = {'\0'};
+                        commonSyseventGet("current_wan_ifname", wan_ifname_val, sizeof(wan_ifname_val));
                         strlcpy(dhcpv6_data.ifname, wan_ifname_val, sizeof(dhcpv6_data.ifname));
 #else
                         strlcpy(dhcpv6_data.ifname, CFG_TR181_DHCPv6_CLIENT_IfName, sizeof(dhcpv6_data.ifname));
@@ -11051,13 +11096,11 @@ dhcpv6c_dbg_thrd(void * in)
                                 dhcpv6_data.addrCmd   = 0;
                             }
                             /** DNS servers. **/
-                            commonSyseventGet(SYSEVENT_FIELD_IPV6_DNS_SERVER, dns_server, sizeof(dns_server));
-                            if (strlen(dns_server) != 0)
-                            {
-                                dhcpv6_data.dnsAssigned = TRUE;
-                                /*CID 52882 Fix*/
-                                sscanf (dns_server, "%127s %127s", dhcpv6_data.nameserver, dhcpv6_data.nameserver1);
-                            }
+                            commonSyseventGet("cellular_wan_v6_dns1", wan_v6_dns1, sizeof(wan_v6_dns1));
+                            commonSyseventGet("cellular_wan_v6_dns2", wan_v6_dns2, sizeof(wan_v6_dns2));
+                            strlcpy(dhcpv6_data.nameserver, wan_v6_dns1, sizeof(dhcpv6_data.nameserver));
+                            strlcpy(dhcpv6_data.nameserver1, wan_v6_dns2, sizeof(dhcpv6_data.nameserver1));
+                            dhcpv6_data.dnsAssigned = TRUE;
                             dhcpv6_data.prefixPltime = hub4_preferred_lft;
                             dhcpv6_data.prefixVltime = hub4_valid_lft;
                             dhcpv6_data.maptAssigned = FALSE;
@@ -11111,8 +11154,22 @@ dhcpv6c_dbg_thrd(void * in)
                         }
 
 #endif //FEATURE_MAPT
-                        if (send_dhcp_data_to_wanmanager(&dhcpv6_data, DHCP6C_STATE_CHANGED) != ANSC_STATUS_SUCCESS) {
-                            CcspTraceError(("[%s-%d] Failed to send dhcpv6 data to wanmanager!!! \n", __FUNCTION__, __LINE__));
+                        tempDhcpData.Ipv6Changed = TRUE;
+                        if (dhcpv6_data.isExpired != TRUE) {
+                            tempDhcpData.Ipv6Changed = FALSE;
+                            if ((strcmp(dhcpv6_data.nameserver, tempDhcpData.nameserver) != 0) ||
+                                (strcmp(dhcpv6_data.nameserver1, tempDhcpData.nameserver1) != 0) ||
+                                (strcmp(dhcpv6_data.sitePrefix, tempDhcpData.sitePrefix) != 0)) {
+                                tempDhcpData.Ipv6Changed = TRUE;
+                                strlcpy(tempDhcpData.sitePrefix, dhcpv6_data.sitePrefix, sizeof(tempDhcpData.sitePrefix));
+                                strlcpy(tempDhcpData.nameserver, dhcpv6_data.nameserver, sizeof(tempDhcpData.nameserver));
+                                strlcpy(tempDhcpData.nameserver1, dhcpv6_data.nameserver1, sizeof(tempDhcpData.nameserver1));
+                            }
+                        }
+                        if (tempDhcpData.Ipv6Changed == TRUE) {
+                            if (send_dhcp_data_to_wanmanager(&dhcpv6_data, DHCP6C_STATE_CHANGED) != ANSC_STATUS_SUCCESS) {
+                                CcspTraceError(("[%s-%d] Failed to send dhcpv6 data to wanmanager!!! \n", __FUNCTION__, __LINE__));
+                            }
                         }
 
                         /* Wait till interface state machine to unconfigure previous IPv6 configuration */
-- 
