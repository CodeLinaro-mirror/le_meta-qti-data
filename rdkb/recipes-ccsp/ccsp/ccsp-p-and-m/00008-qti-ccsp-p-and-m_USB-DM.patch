+ANSC_STATUS CosaDmlGetUsbName ( ANSC_HANDLE hContext, CHAR *pUsbName );
+
+ANSC_STATUS CosaDmlGetMACAddress ( ANSC_HANDLE hContext, CHAR *pMacAddress );
+
+ANSC_STATUS CosaDmlGetStatus ( ANSC_HANDLE hContext, ULONG *pStatus );
+
+ANSC_STATUS CosaDmlGetMaxBitRate ( ANSC_HANDLE hContext, int *pMaxBitRate );
+
+#endif
