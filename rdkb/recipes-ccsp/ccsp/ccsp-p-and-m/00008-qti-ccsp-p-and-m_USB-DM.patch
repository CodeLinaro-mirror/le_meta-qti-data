Index: git/source-arm/TR-181/board_sbapi/cosa_usb_apis.c
===================================================================
--- /dev/null
+++ git/source-arm/TR-181/board_sbapi/cosa_usb_apis.c
@@ -0,0 +1,513 @@
+/*
+*
+* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.  
+* SPDX-License-Identifier: BSD-3-Clause-Clear
+*/
+
+/**************************************************************************
+
+    module: cosa_usb_apis.c
+
+        For COSA Data Model Library Development
+
+    description:
+
+        This file implementes back-end apis for the COSA Data Model Library
+
+        *  CosaDmlUsbInit
+        *  CosaDmlUsbGetNumberOfEntries
+**************************************************************************/
+
+#include "cosa_usb_apis.h"
+#include "cosa_usb_internal.h"
+#include "secure_wrapper.h"
+#include "safec_lib_common.h"
+#include "ansc_string_util.h"
+
+/**********************************************************************
+
+    prototype:
+
+        static ANSC_STATUS getUsbInterface(char *command,char *result);
+
+    description:
+
+        To check if usb tethered interface available in ifconfig
+
+    argument:   char *command,
+                ifconfig command to get the interface
+
+                char *result,
+                The output parameter which holds the interface name
+
+    return:     ANSC_STATUS_SUCCESS if usb interface available
+                ANSC_STATUS_FAILURE for failure
+
+**********************************************************************/
+static ANSC_STATUS getUsbInterface(char *command,char *result)
+{
+    FILE *fp = NULL;
+    char output[CMD_SIZE];
+    char *pos = NULL, *retval = NULL;
+    if((NULL == command) || (NULL == result))
+    {
+        CcspTraceInfo(("%s %d - param NULL \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+    memset(output,0,sizeof(output));
+    fp = popen(command, "r");
+    if(NULL == fp)
+    {
+        CcspTraceInfo(("%s %d - popen failed \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+    retval = fgets(output, sizeof(output)-1, fp);
+    pclose(fp);
+    if (NULL == retval)
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+    if (NULL != (pos=strchr(output, '\n')) )
+    {
+        *pos = '\0';
+    }
+    strlcpy(result,output,strlen(output)+1);
+    return ANSC_STATUS_SUCCESS;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        static BOOL isRndisInterface();
+
+    description:
+
+        To check rndis0 inerface availability.
+
+    argument:   None
+
+    return:     TRUE If rndis0 interface available
+                FALSE if rndis0 not available
+
+**********************************************************************/
+static BOOL isRndisInterface()
+{
+    ANSC_STATUS ret = ANSC_STATUS_FAILURE;
+    char rndis_iface[USB_SIZE];
+
+    memset(rndis_iface, 0, sizeof(rndis_iface));
+
+    ret = getUsbInterface(" ifconfig |grep rndis0 |awk '{print $1}' ",rndis_iface);
+    if (ANSC_STATUS_SUCCESS == ret)
+    {
+        if (strcmp(rndis_iface,"rndis0") == 0)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        static BOOL isEcmInterface();
+
+    description:
+
+        To check ecm0 inerface availability.
+
+    argument:   None
+
+    return:     TRUE If ecm0 interface available
+                FALSE if ecm0 not available
+
+**********************************************************************/
+static BOOL isEcmInterface()
+{
+    ANSC_STATUS ret = ANSC_STATUS_FAILURE;
+    char ecm_iface[USB_SIZE];
+
+    memset(ecm_iface, 0, sizeof(ecm_iface));
+
+    ret = getUsbInterface(" ifconfig |grep ecm0 |awk '{print $1}' ",ecm_iface);
+    if (ANSC_STATUS_SUCCESS == ret)
+    {
+        if (strcmp(ecm_iface,"ecm0") == 0)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        static ANSC_STATUS isInterfacePathExist(const char *fname);
+
+    description:
+
+        To check entry under /sys/class/net/.
+
+    argument:   const char *fname
+                Path of usb tethered interface
+
+    return:     ANSC_STATUS_SUCCESS if path present
+                ANSC_STATUS_FAILURE if not present
+
+**********************************************************************/
+static ANSC_STATUS isInterfacePathExist(const char *fname)
+{
+    FILE *file;
+    if ((file = fopen(fname, "r")))
+    {
+        fclose(file);
+        return ANSC_STATUS_SUCCESS;
+    }
+    return ANSC_STATUS_FAILURE;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        ANSC_STATUS CosaDmlUsbInit ( ANSC_HANDLE hDml,
+                   PANSC_HANDLE phContext );
+
+    description:
+
+        usb initialize.
+
+    argument:   ANSC_HANDLE hDml,
+                The instance handle
+
+                PANSC_HANDLE phContext,
+                The context
+
+    return:     ANSC_STATUS_SUCCESS
+
+**********************************************************************/
+ANSC_STATUS CosaDmlUsbInit ( ANSC_HANDLE hDml, PANSC_HANDLE phContext )
+{
+    UNREFERENCED_PARAMETER(hDml);
+    PCOSA_DATAMODEL_USB pMyObject = (PCOSA_DATAMODEL_USB)phContext;
+
+    return ANSC_STATUS_SUCCESS;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        ULONG CosaDmlUsbGetNumberOfEntries ( ANSC_HANDLE hContext );
+
+    description:
+
+        Number of usb interface entries
+
+    argument:   ANSC_HANDLE hInsContext,
+                The instance handle
+
+    return:     Number of entries
+
+**********************************************************************/
+ULONG CosaDmlUsbGetNumberOfEntries ( ANSC_HANDLE hContext )
+{
+    UNREFERENCED_PARAMETER(hContext);
+    ULONG ulNumEntry = 0;
+    PCOSA_DATAMODEL_USB pMyObject = (PCOSA_DATAMODEL_USB)hContext;
+
+    if (isRndisInterface())
+    {
+        ulNumEntry++;
+    }
+    CcspTraceInfo(("%s %d - ulNumEntry %lu \n", __FUNCTION__,__LINE__,ulNumEntry));
+
+    return ulNumEntry;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        ANSC_STATUS CosaDmlGetUsbName ( ANSC_HANDLE hContext,
+                                   CHAR *pUsbName );
+
+    description:
+
+        Get usb interface name.
+
+    argument:   ANSC_HANDLE hInsContext,
+                The instance handle
+
+                CHAR *pUsbName,
+                The output parameter which holds the name
+
+    return:     ANSC_STATUS_SUCCESS if usb interface available
+                ANSC_STATUS_FAILURE for failure
+
+**********************************************************************/
+ANSC_STATUS CosaDmlGetUsbName ( ANSC_HANDLE hContext, CHAR *pUsbName )
+{
+    if (NULL == pUsbName)
+    {
+        CcspTraceInfo(("%s %d - param NULL \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    if(isRndisInterface())
+    {
+        AnscCopyString(pUsbName, "rndis0");
+    }
+    else if(isEcmInterface())
+    {
+        AnscCopyString(pUsbName, "ecm0");
+    }
+    else
+    {
+        CcspTraceInfo(("%s %d - no usb interface available \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    return ANSC_STATUS_SUCCESS;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        ANSC_STATUS CosaDmlGetMACAddress ( ANSC_HANDLE hContext,
+                                    CHAR *pMacAddress );
+
+    description:
+
+        Get MAC address.
+
+    argument:   ANSC_HANDLE hInsContext,
+                The instance handle
+
+                CHAR *pMacAddress,
+                The output parameter which holds interface mac address
+
+    return:     ANSC_STATUS_SUCCESS for success
+                ANSC_STATUS_FAILURE for failure
+
+**********************************************************************/
+ANSC_STATUS CosaDmlGetMACAddress ( ANSC_HANDLE hContext, CHAR *pMacAddress )
+{
+    FILE *fp = NULL;
+    char basemac[BUFF_SIZE];
+    char cmd[CMD_SIZE];
+    char *retVal;
+
+    if (NULL == pMacAddress)
+    {
+        CcspTraceInfo(("%s %d - param NULL \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    memset(basemac, 0, sizeof(basemac));
+    if(isRndisInterface())
+    {
+        snprintf(cmd ,sizeof(cmd), "ifconfig rndis0 | grep HWaddr | awk '{print $5}'");
+    }
+    else if(isEcmInterface())
+    {
+        snprintf(cmd ,sizeof(cmd), "ifconfig ecm0 | grep HWaddr | awk '{print $5}'");
+    }
+    else
+    {
+        CcspTraceInfo(("%s %d - no usb interface available \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    fp=popen(cmd,"r");
+    if (fp == NULL)
+    {
+        CcspTraceInfo(("%s %d - popen FAILED \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+    retVal = fgets(basemac, sizeof(basemac),fp);
+    pclose(fp);
+    if (NULL != retVal)
+        strlcpy(pMacAddress,basemac,strlen(basemac)+1);
+    else
+    {
+        CcspTraceInfo(("%s %d - fgets FAILED \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    return ANSC_STATUS_SUCCESS;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        ANSC_STATUS CosaDmlGetStatus ( ANSC_HANDLE hContext,
+                                    ULONG *pStatus );
+
+    description:
+
+        Get interface status.
+
+    argument:   ANSC_HANDLE hInsContext,
+                The instance handle
+
+                ULONG *pStatus,
+                The output parameter which holds interface status
+
+    return:     ANSC_STATUS_SUCCESS for success
+                ANSC_STATUS_FAILURE for failure
+
+**********************************************************************/
+ANSC_STATUS CosaDmlGetStatus ( ANSC_HANDLE hContext, ULONG *pStatus )
+{
+    char path[BUFF_SIZE];
+    ANSC_STATUS ret = ANSC_STATUS_FAILURE;
+
+    if (NULL == pStatus)
+    {
+        CcspTraceInfo(("%s %d - param NULL \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    memset(path, 0, sizeof(path));
+
+    if(isRndisInterface())
+    {
+        strlcpy(path,"/sys/class/net/rndis0",sizeof(path));
+    }
+    else if(isEcmInterface())
+    {
+        strlcpy(path,"/sys/class/net/ecm0",sizeof(path));
+    }
+    else
+        return ANSC_STATUS_FAILURE;
+
+    ret = isInterfacePathExist(path);
+    if(ANSC_STATUS_SUCCESS == ret)
+        *pStatus = COSA_DML_IF_STATUS_Up;
+    else
+        *pStatus = COSA_DML_IF_STATUS_Down;
+
+    return ANSC_STATUS_SUCCESS;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        ANSC_STATUS CosaDmlGetUsbEnable ( ANSC_HANDLE hContext,
+                                    BOOLEAN *bEnabled );
+
+    description:
+
+        USB tethering enabled.
+
+    argument:   ANSC_HANDLE hInsContext,
+                The instance handle
+
+                BOOLEAN *bEnabled,
+                The output parameter which holds if enable
+
+    return:     ANSC_STATUS_SUCCESS for success
+                ANSC_STATUS_FAILURE for failure
+
+**********************************************************************/
+ANSC_STATUS CosaDmlGetUsbEnable ( ANSC_HANDLE hContext, BOOLEAN *bEnabled )
+{
+    if (NULL == bEnabled)
+    {
+        CcspTraceInfo(("%s %d - param NULL \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    if(isRndisInterface())
+    {
+        *bEnabled = 1;
+    }
+    else if(isEcmInterface())
+    {
+        *bEnabled = 1;
+    }
+    else
+        *bEnabled = 0;
+
+    return ANSC_STATUS_SUCCESS;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        ANSC_STATUS CosaDmlGetMaxBitRate ( ANSC_HANDLE hContext,
+                                    int *pMaxBitRate );
+
+    description:
+
+        USB tethering enabled.
+
+    argument:   ANSC_HANDLE hInsContext,
+                The instance handle
+
+                int *pMaxBitRate,
+                The output parameter which holds max bitrate(in MBPS)
+
+    return:     ANSC_STATUS_SUCCESS for success
+                ANSC_STATUS_FAILURE for failure
+
+**********************************************************************/
+ANSC_STATUS CosaDmlGetMaxBitRate ( ANSC_HANDLE hContext, int *pMaxBitRate )
+{
+    FILE *fp = NULL;
+    char cmd[CMD_SIZE];
+    char maxbitrate[BUFF_SIZE];
+    char *retVal;
+
+    if (NULL == pMaxBitRate)
+    {
+        CcspTraceInfo(("%s %d - param NULL \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    memset(maxbitrate, 0, sizeof(maxbitrate));
+    if(isRndisInterface() || isEcmInterface())
+    {
+        snprintf(cmd ,sizeof(cmd), "cat /sys/bus/platform/devices/a600000.ssusb/speed");
+    }
+    else
+    {
+        CcspTraceInfo(("%s %d - no usb interface available \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    fp=popen(cmd,"r");
+    if (fp == NULL)
+    {
+        CcspTraceInfo(("%s %d - popen FAILED \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    retVal = fgets(maxbitrate, sizeof(maxbitrate),fp);
+    pclose(fp);
+    if (NULL != retVal)
+    {
+        maxbitrate[strlen(maxbitrate) - 1] = '\0';
+        if(0 == strcmp(maxbitrate,"super-speed-plus"))
+            *pMaxBitRate = BITRATE_10GBPS;
+        else if(0 == strcmp(maxbitrate,"super-speed"))
+            *pMaxBitRate = BITRATE_5GBPS;
+        else if(0 == strcmp(maxbitrate,"high-speed"))
+            *pMaxBitRate = BITRATE_480MBPS;
+        else
+            *pMaxBitRate = BITRATE_NULL;
+    }
+    else
+    {
+        CcspTraceInfo(("%s %d - fgets FAILED \n", __FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    return ANSC_STATUS_SUCCESS;
+}
