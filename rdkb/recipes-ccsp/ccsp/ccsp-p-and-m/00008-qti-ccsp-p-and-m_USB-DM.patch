+*/
+
+/**************************************************************************
+
+    module: cosa_usb_internal.c
+
+        For COSA Data Model Library Development
+
+    description:
+
+        This file implementes back-end apis for the COSA Data Model Library
+
+        *  CosaUsbCreate
+        *  CosaUsbInitialize
+        *  CosaUsbRemove
+**************************************************************************/
+
+#include "cosa_usb_internal.h"
+#include "safec_lib_common.h"
+
+extern void * g_pDslhDmlAgent;
+
+/**********************************************************************
+
+    caller:     owner of the object
+
+    prototype:
+
+        ANSC_HANDLE CosaUsbInterfaceCreate ( );
+
+    description:
+
+        This function constructs cosa usb object and return handle.
+
+    argument:
+
+    return:     newly created usb object.
+
+**********************************************************************/
+ANSC_HANDLE CosaUsbInterfaceCreate ( VOID )
+{
+    PCOSA_DATAMODEL_USB    pMyObject    = (PCOSA_DATAMODEL_USB)NULL;
+
+    pMyObject = (PCOSA_DATAMODEL_USB)AnscAllocateMemory(sizeof(COSA_DATAMODEL_USB));
+    if ( !pMyObject )
+    {
+        return  (ANSC_HANDLE)NULL;
+    }
+
+    pMyObject->Oid = COSA_DATAMODEL_USB_OID;
+    pMyObject->Create = CosaUsbInterfaceCreate;
+    pMyObject->Remove = CosaUsbInterfaceRemove;
+    pMyObject->Initialize = CosaUsbInterfaceInitialize;
+
+    pMyObject->Initialize ((ANSC_HANDLE)pMyObject);
+
+    return  (ANSC_HANDLE)pMyObject;
+}
+
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS CosaUsbInterfaceInitialize ( ANSC_HANDLE hThisObject );
+
+    description:
+
+        This function initiate  cosa usb object and return handle.
+
+    argument:   ANSC_HANDLE hThisObject
+            This handle is actually the pointer of this object
+            itself.
+
+    return:     operation status.
+
+**********************************************************************/
+ANSC_STATUS CosaUsbInterfaceInitialize ( ANSC_HANDLE hThisObject )
+{
+    ANSC_STATUS returnStatus = ANSC_STATUS_SUCCESS;
+    PCOSA_DATAMODEL_USB pMyObject = (PCOSA_DATAMODEL_USB)hThisObject;
+
+    _ansc_memset(&pMyObject->UsbInterfaceInfo, 0, sizeof(USB_INTERFACE_INFO));
+
+    return returnStatus;
+}
+
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS
+        CosaUsbInterfaceRemove ( ANSC_HANDLE hThisObject );
+
+    description:
+
+        This function initiate  cosa usb object and return handle.
+
+    argument:   ANSC_HANDLE hThisObject
+            This handle is actually the pointer of this object
+            itself.
+
+    return:     operation status.
+
+**********************************************************************/
+ANSC_STATUS CosaUsbInterfaceRemove ( ANSC_HANDLE hThisObject )
+{
+    ANSC_STATUS returnStatus = ANSC_STATUS_SUCCESS;
+    PCOSA_DATAMODEL_USB pMyObject = (PCOSA_DATAMODEL_USB)hThisObject;
+
+    if (NULL != pMyObject)
+        AnscFreeMemory((ANSC_HANDLE)pMyObject);
+
+    return returnStatus;
+}
+
+/**********************************************************************
+
+    caller:     owner of the object
+
+    prototype:
+
+        ANSC_HANDLE CosaUsbCreate ();
+
+    description:
+
+        This function constructs cosa USB object and return handle.
+
+    argument:
+
+    return:     newly created USB object.
+
+**********************************************************************/
+
+ANSC_HANDLE CosaUsbCreate ( VOID )
+{
+    PCOSA_DATAMODEL_USB pMyObject = (PCOSA_DATAMODEL_USB)NULL;
+
+    pMyObject = (PCOSA_DATAMODEL_USB)AnscAllocateMemory(sizeof(COSA_DATAMODEL_USB));
+    if ( !pMyObject )
+    {
+        return  (ANSC_HANDLE)NULL;
+    }
+
+    pMyObject->Oid = COSA_DATAMODEL_USB_OID;
+    pMyObject->Create = CosaUsbCreate;
+    pMyObject->Remove = CosaUsbRemove;
+    pMyObject->Initialize = CosaUsbInitialize;
+
+    pMyObject->Initialize ((ANSC_HANDLE)pMyObject);
+
+    return  (ANSC_HANDLE)pMyObject;
+}
+
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS CosaUsbInitialize(ANSC_HANDLE hThisObject);
+
+    description:
+
+        This function initiate  cosa USB object and return handle.
+
+    argument:   ANSC_HANDLE                 hThisObject
+            This handle is actually the pointer of this object
+            itself.
+
+    return:     operation status.
+
+**********************************************************************/
+ANSC_STATUS CosaUsbInitialize ( ANSC_HANDLE hThisObject )
+{
+    ANSC_STATUS returnStatus = ANSC_STATUS_SUCCESS;
+    PCOSA_DATAMODEL_USB pMyObject = (PCOSA_DATAMODEL_USB)hThisObject;
+    PPOAM_IREP_FOLDER_OBJECT pPoamIrepFoCOSA = (PPOAM_IREP_FOLDER_OBJECT)NULL;
+
+    CosaDmlUsbInit(NULL, (PANSC_HANDLE)pMyObject);
+    pMyObject->hIrepFolderCOSA = g_GetRegistryRootFolder(g_pDslhDmlAgent);
+    pPoamIrepFoCOSA = (PPOAM_IREP_FOLDER_OBJECT)pMyObject->hIrepFolderCOSA;
+    if ( !pPoamIrepFoCOSA )
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+
+    return returnStatus;
+}
+
+/**********************************************************************
+
+    caller:     self
+
+    prototype:
+
+        ANSC_STATUS CosaUsbRemove(ANSC_HANDLE hThisObject);
+
+    description:
+
+        This function initiate  cosa USB object and return handle.
+
+    argument:   ANSC_HANDLE hThisObject
+            This handle is actually the pointer of this object
+            itself.
+
+    return:     operation status.
+
+**********************************************************************/
+ANSC_STATUS CosaUsbRemove ( ANSC_HANDLE hThisObject )
+{
+    ANSC_STATUS returnStatus = ANSC_STATUS_SUCCESS;
+    PCOSA_DATAMODEL_USB pMyObject = (PCOSA_DATAMODEL_USB)hThisObject;
+
+    if (NULL != pMyObject)
+        AnscFreeMemory((ANSC_HANDLE)pMyObject);
+
+    return returnStatus;
+}
