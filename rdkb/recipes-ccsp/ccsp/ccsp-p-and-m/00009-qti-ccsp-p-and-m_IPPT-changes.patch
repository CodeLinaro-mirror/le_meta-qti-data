+ANSC_STATUS
+CosaDmlIPPTSetEnable(bool bValue)
+{
+   int ret = ANSC_STATUS_SUCCESS;
+   char wan_ifname_val[32]={0};
+   commonSyseventGet("current_wan_ifname", wan_ifname_val, sizeof(wan_ifname_val));
+   if( bValue == TRUE)
+   {
+       char gw_ip[32]={0};
+       char wan_ip[32]={0};
+       IPPT_CLIENTTYPE client_type;
+       char buf1[8] = {0};
+       char buf2[8]={0};
+       int mode;
+       int nat_mode;
+       char mac[50]={0};
+       char dev_type[8]={0};
+
+       syscfg_get( NULL, "IPPT_ClientType", buf1, sizeof(buf1));
+       syscfg_get( NULL, "IPPT_HostMac", mac, sizeof(mac));
+       client_type = _ansc_atoi(buf1);
+       syscfg_get( NULL, "IPPT_Mode", buf2, sizeof(buf2));
+       mode = _ansc_atoi(buf2);
+
+       if (mode == IPPT_MODE_WITHOUT_NAT)
+       {
+           syscfg_set(NULL, "nat_enabled", "0");
+       }
+       if (syscfg_set(NULL, "IPPT_Enable", "true") != 0)
+       {
+           CcspTraceWarning(("%s %d - Failed to set IPPT_Enable to true\n", __FUNCTION__, __LINE__));
+           ret = ANSC_STATUS_FAILURE;
+        }
+       if (syscfg_commit() != 0)
+       {
+           CcspTraceWarning(("%s %d - Failed to commit syscfg changes\n", __FUNCTION__, __LINE__));
+           ret = ANSC_STATUS_FAILURE;
+       }
+       if(strstr(wan_ifname_val, "qmapmux") != NULL)
+       {
+           if(ANSC_STATUS_SUCCESS != execute_ipa(mode, client_type, mac, wan_ifname_val))
+           {
+               ret = ANSC_STATUS_FAILURE;
+           }
+       v_secure_system("sysevent set ippt_transition 1");
+       }
+   }
+   else if( bValue == FALSE)
+   {
+       char wan_ip[32]={0};
+       char buf[8]={0};
+       int client_type;
+       char dev_type[8]={0};
+       char dev_mode[2]={0};
+       int  device_mode=0;
+       int apn_index = 0;
+       char query[MAX_QUERY] = {0};
+       char *index = NULL;
+       char *ipAddrFamily = NULL;
+       if (syscfg_set(NULL, "IPPT_Enable", "false") != 0)
+       {
+           CcspTraceWarning(("%s %d - Failed to set IPPT_Enable to false\n", __FUNCTION__, __LINE__));
+           ret = ANSC_STATUS_FAILURE;
+       }
+       if (syscfg_commit() != 0)
+       {
+           CcspTraceWarning(("%s %d - Failed to commit syscfg changes\n", __FUNCTION__, __LINE__));
+           ret = ANSC_STATUS_FAILURE;
+       }
+       if(strstr(wan_ifname_val, "qmapmux") != NULL)
+       {
+           commonSyseventGet("cellular_wan_v4_ip", wan_ip, sizeof(wan_ip));
+           syscfg_get( NULL, "IPPT_ClientType", buf, sizeof(buf));
+           client_type = _ansc_atoi(buf);
+           syscfg_get(NULL, "last_erouter_mode",dev_mode,sizeof(dev_mode));
+           device_mode=atoi(dev_mode);
+           PSM_VALUE_GET_STRING(PSM_CURRENT_APN,index);
+           if (index)
+           {
+               apn_index = atoi(index);
+               snprintf(query, MAX_QUERY, "dmsb.cellularmanager.accesspoint.%d.ipAddressFamily",apn_index);
+               PSM_VALUE_GET_STRING(query,ipAddrFamily);
+           }
+           v_secure_system("rm -rf /var/volatile/dhcp_static_hosts");
+           syscfg_unset(NULL, "ippt_dhcp_static_host_1");
+           if (v_secure_system("rm -rf /etc/dhcp_static_hosts") !=0)
+           {
+               CcspTraceWarning(("%s %d - failed to del etc/dhcp_static_hosts \n", __FUNCTION__, __LINE__));
+           }
+           else
+           {
+               CcspTraceWarning(("%s %d - deleted etc/dhcp_static_hosts \n", __FUNCTION__, __LINE__));
+           }
+           syscfg_set(NULL, "nat_enabled", "1");
+           syscfg_commit();
+           if (client_type == IPPT_CLIENTTYPE_USB)
+               strlcpy(dev_type, "usb", sizeof(dev_type));
+           else if (client_type == IPPT_CLIENTTYPE_ETH0)
+               strlcpy(dev_type, "eth0", sizeof(dev_type));
+           else if (client_type == IPPT_CLIENTTYPE_ETH1)
+               strlcpy(dev_type, "eth1", sizeof(dev_type));
+           else if (client_type == IPPT_CLIENTTYPE_WLAN)
+               strlcpy(dev_type, "wifi", sizeof(dev_type));
+           else if (client_type == IPPT_CLIENTTYPE_ANY)
+               strlcpy(dev_type, "any", sizeof(dev_type));
+           CcspTraceWarning(("%s %d - ippt-client-type- %d %s \n", __FUNCTION__, __LINE__, client_type, dev_type));
+           if (v_secure_system("ipa ippass disable dev_type %s vlan 0 dev_name %s", dev_type, wan_ifname_val) ==0)
+           {
+               CcspTraceWarning(("%s %d - executed ipa command- ipa ippass disable dev_type %s vlan 0 dev_name %s \n", __FUNCTION__, __LINE__, dev_type, wan_ifname_val));
+           }
+           CcspTraceWarning(("%s %d - ippt-client-type- %d %s \n", __FUNCTION__, __LINE__, client_type, dev_type));
+           if (device_mode != IPV6_ONLY_MODE || (ipAddrFamily && strncmp(ipAddrFamily, "IPv6", 4) != 0))
+           {
+               v_secure_system("/etc/utopia/service.d/service_lan.sh lan-restart");
+               CcspTraceWarning(("%s %d - lan-restart \n", __FUNCTION__, __LINE__));
+           }
+           else
+           {
+               CcspTraceWarning(("%s %d -Since Device is in ipv6 mode, skipping lan-restart \n", __FUNCTION__, __LINE__));
+           }
+           ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(ipAddrFamily);
+           ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+       }
+   }
+   if(strstr(wan_ifname_val, "qmapmux") != NULL)
+   {
+       PandM_SendIPToWanMgr(bValue);
+   }
+   return ret;
+}
