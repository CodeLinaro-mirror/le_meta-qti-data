+static ANSC_STATUS
+extractMacAddress(char* pString)
+{
+    int ret = ANSC_STATUS_SUCCESS;
+    char macAddress[18];
+    int macIndex = 0;
+    char tmpBuf[50] ={0};
+    memset(tmpBuf,0,sizeof(tmpBuf));
+
+    // Extract the MAC address
+    for (int i = 0; pString[i]; i++)
+    {
+        if (pString[i] != ':')
+        {
+            macAddress[macIndex++] = pString[i];
+            if ((macIndex + 1) % 3 == 0 && macIndex < 17)
+            {
+               macAddress[macIndex++] = ':';
+            }
+         }
+     }
+     macAddress[macIndex] = '\0';  // Add null terminator to the macAddress
+    // Validate the extracted MAC address format
+     if (macIndex == MACINDEX)
+     {
+         CcspTraceWarning(("%s %d - valid MAC Address Format %s \n", __FUNCTION__, __LINE__, macAddress));
+         if(syscfg_set_commit(NULL, "IPPT_HostMac", macAddress)!=0)
+         {
+             CcspTraceWarning(("%s %d syscfg_set_commit failed \n", __FUNCTION__, __LINE__));
+            ret = ANSC_STATUS_FAILURE;
+          }
+      }
+      else
+      {
+         CcspTraceWarning(("%s %d - Invalid MAC Address Format %s \n", __FUNCTION__, __LINE__, macAddress));
+      }
+
+      return ret;
+}
+
+/*===========================================================================
+  FUNCTION:  PandM_SendIPToWanMgr
+===========================================================================*/
+/*!
+     @brief
+    Function to send Ip from Pandm to Wanamanger
+    @param
+     ipptEnabled
+    @return
+     int - The status of the operation
+         ANSC_STATUS_SUCCESS if successful
+         ANSC_STATUS_INTERNAL_ERROR if any error is detected
+*/
+/*=========================================================================*/
+
+static int PandM_SendIPToWanMgr(bool ipptEnabled)
+{
+    int sock   = -1;
+    int bytes  = -1;
+    int ret = ANSC_STATUS_SUCCESS;
+
+    int conn   = -1;
+    ipc_msg_payload_t msg;
+
+    memset(&msg, 0, sizeof(ipc_msg_payload_t));
+
+        // message header
+    msg.data.dhcpv4.addressAssigned = TRUE;
+    msg.msg_type = DHCPC_STATE_CHANGED;
+        //check for ippt
+        // message body
+    if( ipptEnabled == TRUE )
+    {
+        char ippt_auto_ip[] = "169.254.1.50";
+        strlcpy(msg.data.dhcpv4.ip, ippt_auto_ip, sizeof(msg.data.dhcpv4.ip) - 1);
+        CcspTraceInfo(("%s %d: IPPT Auto ip assignment \n", __FUNCTION__, __LINE__));
+     }
+     else if( ipptEnabled == FALSE )
+     {
+        char wan_ip[32]={0};
+        commonSyseventGet("cellular_wan_v4_ip", wan_ip, sizeof(wan_ip));
+        strlcpy(msg.data.dhcpv4.ip, wan_ip, sizeof(msg.data.dhcpv4.ip) - 1);
+        CcspTraceInfo(("%s %d: wan ip assignment \n", __FUNCTION__, __LINE__));
+     }
+     char subnet_mask[32]={0};
+     char gw_ip[32]={0};
+     char dns1[32]={0};
+     char dns2[32]={0};
+     char wan_ifname_val[32]={0};
+     char mtu_val[32]={0};
+     int mtu_size;
+
+     commonSyseventGet("cellular_wan_v4_subnet", subnet_mask, sizeof(subnet_mask));
+     commonSyseventGet("cellular_wan_v4_gw", gw_ip, sizeof(gw_ip));
+     commonSyseventGet("cellular_wan_v4_dns1", dns1, sizeof(dns1));
+     commonSyseventGet("cellular_wan_v4_dns2", dns2, sizeof(dns2));
+     commonSyseventGet("current_wan_ifname", wan_ifname_val, sizeof(wan_ifname_val));
+     commonSyseventGet("cellular_wan_v4_mtu", mtu_val, sizeof(mtu_val));
+
+     strlcpy(msg.data.dhcpv4.mask, subnet_mask, sizeof(msg.data.dhcpv4.mask) - 1);
+     strlcpy(msg.data.dhcpv4.gateway, gw_ip, sizeof(msg.data.dhcpv4.gateway) - 1);
+     strlcpy(msg.data.dhcpv4.dnsServer, dns1, sizeof(msg.data.dhcpv4.dnsServer) - 1);
+     strlcpy(msg.data.dhcpv4.dnsServer1, dns2, sizeof(msg.data.dhcpv4.dnsServer1) - 1);
+     strlcpy(msg.data.dhcpv4.dhcpcInterface, wan_ifname_val, sizeof(msg.data.dhcpv4.dhcpcInterface) - 1);
+     mtu_size = atoi(mtu_val);
+     msg.data.dhcpv4.mtuAssigned = (mtu_size != 0) ? TRUE : FALSE;
+     msg.data.dhcpv4.mtuSize = mtu_size;
+     CcspTraceInfo(("%s %d: dhcpv4- %s %s %s %s %s %s %d %d  \n", __FUNCTION__, __LINE__, msg.data.dhcpv4.ip, msg.data.dhcpv4.mask, msg.data.dhcpv4.gateway, msg.data.dhcpv4.dnsServer, msg.data.dhcpv4.dnsServer1, msg.data.dhcpv4.dhcpcInterface, msg.data.dhcpv4.mtuAssigned, msg.data.dhcpv4.mtuSize));
+
+     sock = nn_socket(AF_SP, NN_PUSH);
+     if (sock < ANSC_STATUS_SUCCESS)
+     {
+         CcspTraceError(("[%s-%d] Failed to create the nanomsg socket \n", __FUNCTION__, __LINE__));
+         return ANSC_STATUS_INTERNAL_ERROR;
+     }
+     conn = nn_connect(sock, WAN_MANAGER_ADDR);
+
+     if (conn < ANSC_STATUS_SUCCESS)
+     {
+         CcspTraceError(("[%s-%d] Failed to connect to the wanmanager socket \n", __FUNCTION__, __LINE__));
+         nn_close (sock);
+         return ANSC_STATUS_INTERNAL_ERROR;
+     }
+
+     CcspTraceInfo(("%s %d: Connected to server socket [%s] \n", __FUNCTION__, __LINE__,WAN_MANAGER_ADDR));
+
+     bytes = nn_send(sock, (char *) &msg, sizeof(ipc_msg_payload_t), 0);
+     if (bytes < 0)
+     {
+         CcspTraceInfo(("%s %d: Failed to send data to the wanmanager error=[%d][%s] \n", __FUNCTION__, __LINE__,errno, strerror(errno)));
+         nn_close(sock);
+         return ANSC_STATUS_INTERNAL_ERROR;
+     }
+
+     CcspTraceInfo(("%s %d: Successfully send %d bytes to wanmanager \n", __FUNCTION__, __LINE__, bytes));
+     nn_close(sock);
+
+    return ret;
+}
+
+static ANSC_STATUS execute_ipa(int mode, IPPT_CLIENTTYPE client_type, char* mac, char* wan_ifname_val)
+{
+    int nat_mode = 0;
+    char dev_type[8]={0};
+    if (wan_ifname_val == NULL)
+    {
+        return ANSC_STATUS_FAILURE;
+    }
+
+    if (mode == IPPT_MODE_WITHOUT_NAT)
+        nat_mode = 1;
+
+    switch (client_type)
+    {
+        case IPPT_CLIENTTYPE_USB:
+        {
+            strlcpy(dev_type, "usb", sizeof(dev_type));
+            break;
+        }
+        case IPPT_CLIENTTYPE_ETH0:
+        {
+           strlcpy(dev_type, "eth0", sizeof(dev_type));
+           break;
+        }
+        case IPPT_CLIENTTYPE_ETH1:
+        {
+           strlcpy(dev_type, "eth1", sizeof(dev_type));
+           break;
+        }
+        case IPPT_CLIENTTYPE_WLAN:
+        {
+           strlcpy(dev_type, "wifi", sizeof(dev_type));
+           break;
+        }
+        case IPPT_CLIENTTYPE_ANY:
+        {
+           strlcpy(dev_type, "any", sizeof(dev_type));
+           break;
+        }
+        default:
+           return ANSC_STATUS_FAILURE;
+    }
+
+    if (((client_type == IPPT_CLIENTTYPE_ETH0) || (client_type == IPPT_CLIENTTYPE_ETH1) || (client_type == IPPT_CLIENTTYPE_WLAN)) && (mac != NULL))
+    {
+        if (v_secure_system("ipa ippass enable dev_type %s vlan 0 mac %s skip_nat %d default_pdn 1 dev_name %s", dev_type, mac, nat_mode, wan_ifname_val) == 0)
+        {
+               CcspTraceWarning(("%s %d - executed ipa command ipa ippass enable dev_type %s vlan 0 mac %s skip_nat %d default_pdn 1 dev_name %s \n", __FUNCTION__, __LINE__, dev_type, mac, nat_mode, wan_ifname_val));
+               return ANSC_STATUS_FAILURE;
+        }
+    }
+    else
+    {
+        if (v_secure_system("ipa ippass enable dev_type %s vlan 0 mac 00:00:00:00:00:00 skip_nat %d default_pdn 1 dev_name %s", dev_type, nat_mode, wan_ifname_val) == 0)
+        {
+               CcspTraceWarning(("%s %d - executed ipa command ipa ippass enable dev_type %s vlan 0 mac 00:00:00:00:00:00 skip_nat %d default_pdn 1 dev_name %s \n", __FUNCTION__, __LINE__, dev_type, nat_mode, wan_ifname_val));
+               return ANSC_STATUS_FAILURE;
+        }
+    }
+
+    return ANSC_STATUS_SUCCESS;
+}
+
 #endif
