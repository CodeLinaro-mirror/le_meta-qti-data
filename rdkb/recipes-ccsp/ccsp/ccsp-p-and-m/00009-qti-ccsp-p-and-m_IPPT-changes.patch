+ANSC_STATUS
+CosaDmlIPPTGetMode(ULONG* puLong)
+{
+    int ret = ANSC_STATUS_SUCCESS;
+    char buf[8];
+    int ippt_mode;
+    if(!syscfg_get( NULL, "IPPT_Mode", buf, sizeof(buf)))
+    {
+        ippt_mode = _ansc_atoi(buf);
+        if (ippt_mode == IPPT_MODE_WITH_NAT)
+            *puLong = 1;
+        else if (ippt_mode == IPPT_MODE_WITHOUT_NAT)
+            *puLong = 2;
+    }
+    else
+    {
+        CcspTraceWarning(("%s %d syscfg_get failed \n", __FUNCTION__, __LINE__));
+        ret = ANSC_STATUS_FAILURE;
+    }
+    return ret;
+}
+
+ANSC_STATUS
+CosaDmlIPPTSetMode(ULONG uValue)
+{
+    int ret = ANSC_STATUS_SUCCESS;
+    if( uValue == IPPT_MODE_WITH_NAT)
+    {
+        if(syscfg_set_commit(NULL, "IPPT_Mode", "1")!=0)
+        {
+            CcspTraceWarning(("%s %d syscfg_set failed \n", __FUNCTION__, __LINE__));
+            ret = ANSC_STATUS_FAILURE;
+        }
+    }
+    else if( uValue == IPPT_MODE_WITHOUT_NAT)
+    {
+        if(syscfg_set_commit(NULL, "IPPT_Mode", "2")!=0)
+        {
+            CcspTraceWarning(("%s %d syscfg_set failed \n", __FUNCTION__, __LINE__));
+            ret = ANSC_STATUS_FAILURE;
+        }
+    }
+    else
+    {
+        ret = ANSC_STATUS_FAILURE;
+    }
+
+    return ret;
+}
+
+ANSC_STATUS
+CosaDmlIPPTGetClientType(ULONG* puLong)
+{
+    int ret = ANSC_STATUS_SUCCESS;
+    char buf[8];
+    int ippt_client_type;
+    if(!syscfg_get( NULL, "IPPT_ClientType", buf, sizeof(buf)))
+    {
+        ippt_client_type = _ansc_atoi(buf);
+        if (ippt_client_type == IPPT_CLIENTTYPE_USB)
+            *puLong = 1;
+        else if (ippt_client_type == IPPT_CLIENTTYPE_ETH0)
+            *puLong = 2;
+        else if (ippt_client_type == IPPT_CLIENTTYPE_ETH1)
+            *puLong = 3;
+        else if (ippt_client_type == IPPT_CLIENTTYPE_WLAN)
+            *puLong = 4;
+        else if (ippt_client_type == IPPT_CLIENTTYPE_ANY)
+            *puLong = 5;
+    }
+    else
+    {
+        CcspTraceWarning(("%s %d syscfg_get failed \n", __FUNCTION__, __LINE__));
+        ret = ANSC_STATUS_FAILURE;
+    }
+
+    return ret;
+}
+
+ANSC_STATUS
+CosaDmlIPPTSetClientType(ULONG uValue)
+{
+    int ret = ANSC_STATUS_SUCCESS;
+    if(uValue == IPPT_CLIENTTYPE_USB)
+    {
+        syscfg_unset(NULL, "IPPT_HostMac");
+        if(syscfg_set_commit(NULL, "IPPT_ClientType", "1")!=0)
+        {
+            CcspTraceWarning(("%s %d syscfg_set failed \n", __FUNCTION__, __LINE__));
+            ret = ANSC_STATUS_FAILURE;
+        }
+    }
+    else if(uValue == IPPT_CLIENTTYPE_ETH0)
+    {
+        syscfg_unset(NULL, "IPPT_Hostname");
+        if(syscfg_set_commit(NULL, "IPPT_ClientType", "2")!=0)
+        {
+            CcspTraceWarning(("%s %d syscfg_set failed \n", __FUNCTION__, __LINE__));
+            ret = ANSC_STATUS_FAILURE;
+         }
+    }
+    else if(uValue == IPPT_CLIENTTYPE_ETH1)
+    {
+        syscfg_unset(NULL, "IPPT_Hostname");
+        if(syscfg_set_commit(NULL, "IPPT_ClientType", "3")!=0)
+        {
+           CcspTraceWarning(("%s %d syscfg_set failed \n", __FUNCTION__, __LINE__));
+           ret = ANSC_STATUS_FAILURE;
+        }
+    }
+    else if(uValue == IPPT_CLIENTTYPE_WLAN)
+    {
+        syscfg_unset(NULL, "IPPT_Hostname");
+        if(syscfg_set_commit(NULL, "IPPT_ClientType", "4")!=0)
+        {
+            CcspTraceWarning(("%s %d syscfg_set failed \n", __FUNCTION__, __LINE__));
+            ret = ANSC_STATUS_FAILURE;
+        }
+    }
+    else if(uValue == IPPT_CLIENTTYPE_ANY)
+    {
+        syscfg_unset(NULL, "IPPT_HostMac");
+        syscfg_unset(NULL, "IPPT_Hostname");
+        if(syscfg_set_commit(NULL, "IPPT_ClientType", "5")!=0)
+        {
+            CcspTraceWarning(("%s %d syscfg_set failed \n", __FUNCTION__, __LINE__));
+            ret = ANSC_STATUS_FAILURE;
+        }
+    }
+    return ret;
+}
