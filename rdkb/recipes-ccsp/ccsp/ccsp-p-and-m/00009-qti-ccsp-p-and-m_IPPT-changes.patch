+BOOL
+IPPT_GetParamBoolValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        BOOL*                       pBool
+    )
+{
+
+    UNREFERENCED_PARAMETER(hInsContext);
+    UNREFERENCED_PARAMETER(ParamName);
+    UNREFERENCED_PARAMETER(pBool);
+    if (strcmp(ParamName, "Enable") == 0)
+    {
+        /* collect value */
+       char buf[8];
+       if(!syscfg_get( NULL, "IPPT_Enable", buf, sizeof(buf)))
+       {
+           if (strcmp(buf, "true") == 0)
+               *pBool = TRUE;
+           else
+               *pBool = FALSE;
+       }
+       return TRUE;
+    }
+
+    return FALSE;
+}
+
+BOOL
+IPPT_SetParamBoolValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        BOOL                        bValue
+    )
+{
+
+    UNREFERENCED_PARAMETER(hInsContext);
+    UNREFERENCED_PARAMETER(ParamName);
+    UNREFERENCED_PARAMETER(bValue);
+    char wan_ifname_val[32]={0};
+    commonSyseventGet("current_wan_ifname", wan_ifname_val, sizeof(wan_ifname_val));
+    char dev_mode[2]={0};
+    int  device_mode=0;
+    int apn_index = 0;
+    char query[MAX_QUERY] = {0};
+    char *index = NULL;
+    char *ipAddrFamily = NULL;
+    if((AnscEqualString(ParamName, "Enable", TRUE)) && (strstr(wan_ifname_val, "eth") != NULL))
+    {
+        return FALSE;
+    }
+
+    if((AnscEqualString(ParamName, "Enable", TRUE)) && (strlen(wan_ifname_val) == 0))
+    {
+        if(ANSC_STATUS_FAILURE == CosaDmlIPPTSetEnable(bValue))
+        {
+            return FALSE;
+        }
+        return TRUE;
+    }
+    if(strstr(wan_ifname_val, "qmapmux") != NULL)
+    {
+        syscfg_get(NULL, "last_erouter_mode",dev_mode,sizeof(dev_mode));
+        device_mode=atoi(dev_mode);
+        PSM_VALUE_GET_STRING(PSM_CURRENT_APN,index);
+        if (index == NULL)
+        {
+        CcspTraceError(("%s:%d PSM current APN is NULL\n", __FUNCTION__, __LINE__));
+        return FALSE;
+        }
+        apn_index = atoi(index);
+        snprintf(query, MAX_QUERY, "dmsb.cellularmanager.accesspoint.%d.ipAddressFamily",apn_index);
+        PSM_VALUE_GET_STRING(query,ipAddrFamily);
+        if (IsBoolSame(hInsContext, ParamName, bValue, IPPT_GetParamBoolValue) && device_mode != IPV6_ONLY_MODE)
+        {
+            if ((ipAddrFamily != NULL) && (strcmp(ipAddrFamily,"IPv6") != 0))
+            {
+                ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(ipAddrFamily);
+                return TRUE;
+            }
+       }
+
+        if( AnscEqualString(ParamName, "Enable", TRUE) && (ipAddrFamily != NULL))
+        {
+            /* collect value */
+            if (device_mode == IPV6_ONLY_MODE || (strcmp(ipAddrFamily,"IPv6") == 0))
+            {
+                CosaDmlIPPTSetEnable(FALSE);
+                CcspTraceWarning(("%s %d - setting IPPT enable to false as it is v6 only mode \n", __FUNCTION__, __LINE__));
+                ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(ipAddrFamily);
+                return FALSE;
+            }
+            if(ANSC_STATUS_FAILURE == CosaDmlIPPTSetEnable(bValue))
+            {
+                    ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(ipAddrFamily);
+                    return FALSE;
+            }
+            ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(ipAddrFamily);
+            return TRUE;
+        }
+        ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(ipAddrFamily);
+        return FALSE;
+    }
+
+    return FALSE;
+}
