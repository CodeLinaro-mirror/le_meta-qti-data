+ANSC_STATUS
+CosaDmlIPPTSetHostMAC(char* pString)
+{
+    int ret = ANSC_STATUS_SUCCESS;
+    char buf[64] = {0};
+    int client_type;
+    syscfg_get( NULL, "IPPT_ClientType", buf, sizeof(buf));
+    client_type = _ansc_atoi(buf);
+    //check whether client is eth0/eth1/ wlan
+    if ((pString != NULL) && ((client_type == IPPT_CLIENTTYPE_ETH0) || (client_type == IPPT_CLIENTTYPE_ETH1) || (client_type == IPPT_CLIENTTYPE_WLAN)))
