+/**********************************************************************
+
+    caller:     COSA DML
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlGetPacketStatsEnable
+            (
+                BOOL                        *pValue
+            );
+
+    Description:
+
+        Get packet statistics enable/disable
+
+    Arguments:    BOOL                        *pValue
+                  Pointer of the value to be retrieved.
+
+    Return:       The status of the operation.
+
+**********************************************************************/
+ANSC_STATUS
+CosaDmlGetPacketStatsEnable
+(
+    BOOL                        *pValue
+)
+{
+    char buf[8];
+
+    syscfg_get( NULL, PACKETSTATS_ENABLE, buf, sizeof(buf));
+    *pValue = (0 == strcmp(buf, "1"));
+    return ANSC_STATUS_SUCCESS;
+}
+/**********************************************************************
+
+    caller:     COSA DML
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlSetPacketStatsEnable
+            (
+                BOOL                        bValue
+            );
+
+    Description:
+
+        Set packet statistics enable/disable
+
+    Arguments:    BOOL                        bValue
+                  Value to be set.
+
+    Return:       The status of the operation.
+
+**********************************************************************/
+ANSC_STATUS
+CosaDmlSetPacketStatsEnable
+(
+    BOOL                        bValue
+)
+{
+    char wan_ifname[32]={0};
+    char enable_packet_stats[32]={0};
+    syscfg_get(NULL, "enable_packet_stats", enable_packet_stats, sizeof(enable_packet_stats));
+
+    syscfg_set_commit(NULL, PACKETSTATS_ENABLE, bValue ? "1" : "0");
+    return ANSC_STATUS_SUCCESS;
+}
+/**********************************************************************
+
+    caller:     COSA DML
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlGetPacketStatsReset
+            (
+                BOOL                        *pValue
+            );
+
+    Description:
+
+        Get packet statistics reset
+
+    Arguments:    BOOL                        *pValue
+                  Pointer of the value to be retrieved.
+
+    Return:       The status of the operation.
+
+**********************************************************************/
+ANSC_STATUS
+CosaDmlGetPacketStatsReset
+(
+    BOOL                        *pValue
+)
+{
+    char buf[8] = {0};
+    commonSyseventGet(PACKETSTATS_RESET, buf, sizeof(buf));
+    *pValue = (0 == strcmp(buf, "1"));
+    return ANSC_STATUS_SUCCESS;
+}
+
+/**********************************************************************
+
+    caller:     COSA DML
+
+    prototype:
+
+        ANSC_STATUS
+        CosaDmlSetPacketStatsReset
+            (
+                BOOL                        bValue
+            );
+
+    Description:
+
+        Set packet statistics reset
+
+    Arguments:    BOOL                        bValue
+                  Value to be set.
+
+    Return:       The status of the operation.
+
+**********************************************************************/
+ANSC_STATUS
+CosaDmlSetPacketStatsReset
+(
+    BOOL                        bValue
+)
+{
+    char buf[8];
+    syscfg_get( NULL, PACKETSTATS_ENABLE, buf, sizeof(buf));
+    if(0 == strcmp(buf, "1"))
+    {
+        commonSyseventSet(PACKETSTATS_RESET, ((true == bValue) ? "1" : "0"));
+        if (true == bValue)
+        {
+            if (0 != v_secure_system("sysevent set firewall-restart"))
+            {
+                CcspTraceError(("[%s:%d] failed to restart firewall \n", __FUNCTION__, __LINE__));
+            }
+        }
+    }
+    else
+    {
+        CcspTraceError(("[%s:%d] packet stats (%s) is NOT enabled\n", __FUNCTION__, __LINE__,buf));
+        return ANSC_STATUS_FAILURE;
+    }
+    return ANSC_STATUS_SUCCESS;
+}
+
 /*===========================================================================
   FUNCTION:  PandM_SendIPToWanMgr
 ===========================================================================*/
