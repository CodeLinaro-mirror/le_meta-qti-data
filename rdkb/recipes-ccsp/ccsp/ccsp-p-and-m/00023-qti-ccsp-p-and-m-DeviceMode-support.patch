@@ -3139,9 +3506,24 @@ ANSC_STATUS CosaDmlDcSetDeviceMode
     }
 #endif
     value--;
-    snprintf(buf,sizeof(buf),"%lu",value);
-//  syscfg_set_commit(NULL, "last_erouter_mode", buf);
