+/*===========================================================================
+  FUNCTION:  CellularMgr_is_valid_index
+===========================================================================*/
+/*!
+     @brief
+    Function to check valid AP index in PSM
+    @param i,apindex,entryCount,instNum
+    @return
+     ANSC_STATUS - The status of the operation
+         ANSC_STATUS_SUCCESS if successful
+         ANSC_STATUS_FAILURE if any error is detected
+*/
+/*=========================================================================*/
+ANSC_STATUS CellularMgr_is_valid_index(int i,int *apindex,int entryCount,int *instNum)
+{
+    if ((apindex == NULL) || (instNum == NULL))
+    {
+        CcspTraceError(("%s:%d - Invalid NULL input parameter\n", __func__, __LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    for (int j=0;j<entryCount;j++)
+    {
+        if (i == apindex[j])
+        {
+            *instNum = j;
+            return ANSC_STATUS_SUCCESS;
+        }
+    }
+    CcspTraceError(("%s:%d - APN index %d not found\n", __func__, __LINE__, i));
+    return ANSC_STATUS_FAILURE;
+}
+
+/*===========================================================================
+  FUNCTION:  CellularMgr_GetApnIndex_list
+===========================================================================*/
+/**
+* @description - This API used to get list of available APN index.
+*
+* @param[in] None
+* @param[out] apindex-which store list of apn indexes
+*             pEntryCount-which hold total apn table count
+* @return The status of the operation
+* @retval ANSC_STATUS_SUCCES if successful
+* @retval ANSC_STATUS_FAILURE if any error is detected
+*/
+/*=========================================================================*/
+ANSC_STATUS CellularMgr_GetApnIndex_list(int *apindex)
+{
+    char *param_value = NULL;
+    int retPsm = ANSC_STATUS_FAILURE;
+
+    if(apindex == NULL)
+    {
+        CcspTraceError(("%s:%d - APN index list is NULL\n", __func__, __LINE__));
+        return retPsm;
+    }
+
+    if(CCSP_SUCCESS == PSM_Get_Record_Value2(bus_handle, g_GetSubsystemPrefix(g_pDslhDmlAgent), PSM_CELLULARMANAGER_ACCESSPOINT_INDEX, NULL, &param_value))
+    {
+        int i = 0;
+        char *token;
+        char *saveptr = NULL;
+        char *ptr = param_value;
+        //index stored in psm in a string format "0,1,2,3,4" is copied to integer array
+        while ((token = strtok_r(ptr, ",", &saveptr)))
+        {
+            ptr = NULL;
+            sscanf(token, "%d",  apindex + i);
+            i++;
+        }
+        retPsm = ANSC_STATUS_SUCCESS;
+    }
+    if (param_value != NULL)
+    {
+        ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(param_value);
+        param_value = NULL;
+    }
+    return retPsm;
+}
+
+/*===========================================================================
+  FUNCTION:  CellularMgr_SetDeviceMode_to_PSM
+===========================================================================*/
+/*!
+     @brief
+    Function to set devicemode value to cellular PSM
+    @param value
+    @return
+     int - The status of the operation
+         ANSC_STATUS_SUCCESS if successful
+         ANSC_STATUS_FAILURE if any error is detected
+*/
+/*=========================================================================*/
+ANSC_STATUS
+CellularMgr_SetDeviceMode_to_PSM
+    (
+        ULONG                       value
+    )
+{
+    int ret = ANSC_STATUS_FAILURE;
+    int *apindex = NULL;
+    int entryCount = 0;
+    int retPsmSet = CCSP_SUCCESS;
+    int instNum = 0;
+    char *index = NULL;
+    char indexStr[32] = {0};
+    char paramName[128] = {0};
+
+    //Get Number of APNs stored in PSM
+    if(CCSP_SUCCESS != PSM_Get_Record_Value2(bus_handle, g_GetSubsystemPrefix(g_pDslhDmlAgent), PSM_CELLULARMANAGER_ACCESSPOINT_ENTRYCOUNT, NULL, &index))
+    {
+        CcspTraceError(("%s:%d - Failed to get APN entry count from PSM\n", __func__, __LINE__));
+        return ret;
+    }
+
+    entryCount = atoi(index);
+    if (entryCount <= 0) {
+        CcspTraceError(("%s:%d - Invalid entryCount %d\n", __func__, __LINE__, entryCount));
+        if (NULL != index)
+        {
+            ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+            index = NULL;
+        }
+        return ret;
+    }
+    apindex = malloc(entryCount * sizeof(int));
+    if (apindex == NULL)
+    {
+        ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+        CcspTraceError(("%s:%d - malloc failed\n", __func__, __LINE__));
+        return ret;
+    }
+
+    memset(apindex, 0, entryCount * sizeof(int));
+    if(ANSC_STATUS_SUCCESS != CellularMgr_GetApnIndex_list(apindex))
+    {
+        if(NULL!=apindex)
+        {
+            free(apindex);
+            apindex = NULL;
+        }
+        CcspTraceError(("%s:%d - Failed to get APN index list\n",__func__,__LINE__));
+        ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+        return ret;
+    }
+
+    //Setting IPAddressFamily in all APN tables as per DeviceMode
+    for(int i= 1; i <= apindex[entryCount - 1]; i++)
+    {
+        if (ANSC_STATUS_SUCCESS != CellularMgr_is_valid_index(i,apindex,entryCount,&instNum))
+        {
+            continue; // index not found in the saved list of apn indices
+        }
+
+        int rc = snprintf(indexStr, sizeof(indexStr), "%d",apindex[instNum]);
+        snprintf(paramName,sizeof(paramName),PSM_CELLULARMANAGER_ACCESSPOINT_IPADDRESSFAMILY,indexStr);
+
+        switch(value)
+        {
+            case (COSA_DML_DEVICE_MODE_Ipv4):
+                retPsmSet = PSM_Set_Record_Value2(bus_handle, g_Subsystem, paramName, ccsp_string, "IPv4");
+                break;
+
+            case (COSA_DML_DEVICE_MODE_Ipv6):
+                retPsmSet = PSM_Set_Record_Value2(bus_handle, g_Subsystem, paramName, ccsp_string, "IPv6");
+                break;
+
+            case (COSA_DML_DEVICE_MODE_Dualstack):
+                retPsmSet = PSM_Set_Record_Value2(bus_handle, g_Subsystem, paramName, ccsp_string, "IPv4IPv6");
+                break;
+
+            default:
+                break;
+        }
+
+        if (retPsmSet != CCSP_SUCCESS)
+        {
+            CcspTraceError(("%s:%d - PSM write failed for index %d\n", __func__, __LINE__, apindex[instNum]));
+            if(NULL!=apindex)
+            {
+                free(apindex);
+                apindex = NULL;
+            }
+            ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+            return ret;
+        }
+    }
+
+    if(NULL!=apindex)
+    {
+        free(apindex);
+        apindex = NULL;
+    }
+    ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+    return ANSC_STATUS_SUCCESS;
+}
+
+/*===========================================================================
+  FUNCTION:  CellularMgr_CheckandSetDeviceMode_in_PSM
+===========================================================================*/
+/*!
+     @brief
+    Function to align overridden APN IPAddressFamily values with devicemode
+    @param value
+    @return
+     int - The status of the operation
+         ANSC_STATUS_SUCCESS if successful
+         ANSC_STATUS_FAILURE if any error is detected
+*/
+/*=========================================================================*/
+static ANSC_STATUS
+CellularMgr_CheckandSetDeviceMode_in_PSM
+    (
+        ULONG                       value
+    )
+{
+    int ret = ANSC_STATUS_FAILURE;
+    int *apindex = NULL;
+    int entryCount = 0;
+    int retPsmSet = CCSP_SUCCESS;
+    int instNum = 0;
+    char *index = NULL;
+    char indexStr[32] = {0};
+    char paramName[PARAMNAME_MAX_SIZE] = {0};
+    char devicemode[DEVICEMODE_MAX_SIZE] = {0};
+    char *psmStrValue = NULL;
+
+    switch(value)
+    {
+        case (COSA_DML_DEVICE_MODE_Ipv4):
+            strlcpy(devicemode, "IPv4", sizeof(devicemode));
+            break;
+
+        case (COSA_DML_DEVICE_MODE_Ipv6):
+            strlcpy(devicemode, "IPv6", sizeof(devicemode));
+            break;
+
+        case (COSA_DML_DEVICE_MODE_Dualstack):
+            strlcpy(devicemode, "IPv4IPv6", sizeof(devicemode));
+            break;
+
+        default:
+            CcspTraceError(("%s:%d - Invalid DeviceMode value detected\n",__func__,__LINE__));
+            return ret;
+    }
+
+    //Get Number of APNs stored in PSM
+    if(CCSP_SUCCESS != PSM_Get_Record_Value2(bus_handle, g_GetSubsystemPrefix(g_pDslhDmlAgent), PSM_CELLULARMANAGER_ACCESSPOINT_ENTRYCOUNT, NULL, &index))
+    {
+        CcspTraceError(("%s:%d - PSM Read for PSM_CELLULARMANAGER_ACCESSPOINT_ENTRYCOUNT failed!!\n",__func__,__LINE__));
+        return ret;
+    }
+
+    entryCount = atoi(index);
+    if (entryCount <= 0) {
+        CcspTraceError(("%s:%d - Invalid entryCount %d\n", __func__, __LINE__, entryCount));
+        if (NULL != index)
+        {
+            ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+            index = NULL;
+        }
+        return ret;
+    }
+    apindex = malloc(entryCount * sizeof(int));
+    if (apindex == NULL)
+    {
+        ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+        CcspTraceError(("%s:%d - Memory allocation error!!\n",__func__,__LINE__));
+        return ret;
+    }
+
+    memset(apindex, 0, entryCount * sizeof(int));
+    if(ANSC_STATUS_SUCCESS != CellularMgr_GetApnIndex_list(apindex))
+    {
+        if(NULL!=apindex)
+        {
+            free(apindex);
+            apindex = NULL;
+        }
+        CcspTraceError(("%s:%d - Failed to get APN index list\n",__func__,__LINE__));
+        ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+        return ret;
+    }
+
+    //Iterate through all APN tables and check which are not aligned with DeviceMode
+    for(int i= 1; i <= apindex[entryCount - 1]; i++)
+    {
+        if (ANSC_STATUS_SUCCESS != CellularMgr_is_valid_index(i,apindex,entryCount,&instNum))
+        {
+            continue; // index not found in the saved list of apn indices
+        }
+
+        int rc = snprintf(indexStr, sizeof(indexStr), "%d",apindex[instNum]);
+        snprintf(paramName,sizeof(paramName),PSM_CELLULARMANAGER_ACCESSPOINT_IPADDRESSFAMILY,indexStr);
+        if(CCSP_SUCCESS != PSM_Get_Record_Value2(bus_handle, g_GetSubsystemPrefix(g_pDslhDmlAgent), paramName, NULL, &psmStrValue))
+        {
+            CcspTraceError(("%s:%d - PSM get failed for index %d\n",__func__,__LINE__,apindex[instNum]));
+            if(NULL!=apindex)
+            {
+                free(apindex);
+                apindex = NULL;
+            }
+            ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+            return ret;
+        }
+
+        if(strcmp(psmStrValue,devicemode)!=0)
+        {
+            switch(value)
+            {
+                case (COSA_DML_DEVICE_MODE_Ipv4):
+                    retPsmSet = PSM_Set_Record_Value2(bus_handle, g_Subsystem, paramName, ccsp_string, "IPv4");
+                    break;
+
+                case (COSA_DML_DEVICE_MODE_Ipv6):
+                    retPsmSet = PSM_Set_Record_Value2(bus_handle, g_Subsystem, paramName, ccsp_string, "IPv6");
+                    break;
+
+                case (COSA_DML_DEVICE_MODE_Dualstack):
+                    retPsmSet = PSM_Set_Record_Value2(bus_handle, g_Subsystem, paramName, ccsp_string, "IPv4IPv6");
+                    break;
+
+                default:
+                    break;
+            }
+
+            if (retPsmSet != CCSP_SUCCESS)
+            {
+                CcspTraceError(("%s:%d - PSM write failed for index %d\n",__func__,__LINE__,apindex[instNum]));
+                if(NULL!=apindex)
+                {
+                    free(apindex);
+                    apindex = NULL;
+                }
+                ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+                ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(psmStrValue);
+                return ret;
+            }
+        }
+
+        ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(psmStrValue);
+    }
+
+    if(NULL!=apindex)
+    {
+        free(apindex);
+        apindex = NULL;
+    }
+    ((CCSP_MESSAGE_BUS_INFO *)bus_handle)->freefunc(index);
+    return ANSC_STATUS_SUCCESS;
+}
 ANSC_STATUS
 CosaDmlDcGetDeviceMode
