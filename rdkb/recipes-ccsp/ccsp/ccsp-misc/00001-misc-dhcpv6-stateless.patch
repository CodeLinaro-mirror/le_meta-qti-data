From b351090248110313b7f39f1b9d591b0c7afc22b6 Mon Sep 17 00:00:00 2001
From: B Saravanan <saravb@qti.qualcomm.com>
Date: Thu, 6 Aug 2026 14:05:16 +0530
Subject: [PATCH] misc dhcpv6 stateless changes for configuration initilization.

Signed-off-by: Saravanan B <saravb@qti.qualcomm.com>
---
 source/dhcp_client_utils/dhcpv6_client_utils.c | 2 ++
 1 file changed, 2 insertions(+)

Index: git/source/dhcp_client_utils/dhcpv6_client_utils.c
===================================================================
--- git.orig/source/dhcp_client_utils/dhcpv6_client_utils.c
+++ git/source/dhcp_client_utils/dhcpv6_client_utils.c
@@ -24,6 +24,7 @@
 #ifdef DHCPv6_CLIENT_TI_DHCP6C
 #include "ti_dhcp6c_client_utils.h"
 #endif
+#include "secure_wrapper.h"
 
 #define LOCALHOST         "127.0.0.1"
 #define DHCP_SYSEVENT_NAME "dhcp_evt_handler"
@@ -108,6 +109,8 @@ pid_t start_dhcpv6_client (dhcp_params *
         return 0;
     }
 
+    //To init the server.conf and client.conf
+    v_secure_system("/lib/rdk/dibbler-init.sh");
     //Check if default dibbler tmp path available or not. If not then create it
     create_dir_path(DIBBLER_TMP_DIR_PATH);
 
@@ -131,6 +134,8 @@ pid_t start_dhcpv6_client (dhcp_params *
     // check if interface is ipv6 ready with a link-local address
     unsigned int waitTime = INTF_V6LL_TIMEOUT_IN_MSEC;
     char cmd[BUFLEN_128] = {0};
+    //Make interface up before the starting the process.
+    v_secure_system(" ifconfig %s up ",params->ifname);
     snprintf(cmd, sizeof(cmd), "ip address show dev %s tentative", params->ifname);
     while (waitTime > 0)
     {
