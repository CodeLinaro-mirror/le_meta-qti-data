Signed-off-by: Venkata Pavan Karthikeya Koppala <vkoppala@qti.qualcomm.com>

diff --git a/source/RdkVlanManager/ssp_messagebus_interface.c b/source/RdkVlanManager/ssp_messagebus_interface.c
--- a/source/RdkVlanManager/ssp_messagebus_interface.c
+++ b/source/RdkVlanManager/ssp_messagebus_interface.c
@@ -94,7 +94,7 @@
         return returnStatus;
     }
 
-    CcspTraceInfo(("INFO: bus_handle: 0x%8p \n", bus_handle));
+    CcspTraceInfo(("INFO: bus_handle: 0x%p \n", bus_handle));
     g_MessageBusHandle_Irep = bus_handle;
     AnscCopyString(g_SubSysPrefix_Irep, g_Subsystem);
 
@@ -130,7 +130,7 @@
 
     if ( returnStatus != CCSP_Message_Bus_OK )
     {
-         CcspTraceError((" !!! CCSP_Message_Bus_Register_Event: CurrentSessionIDSignal ERROR returnStatus: %ld!!!\n", returnStatus));
+         CcspTraceError((" !!! CCSP_Message_Bus_Register_Event: CurrentSessionIDSignal ERROR returnStatus: %lu!!!\n", returnStatus));
 
         return returnStatus;
     }
