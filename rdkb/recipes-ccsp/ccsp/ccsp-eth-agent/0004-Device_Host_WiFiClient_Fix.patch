 	if(fgets(buf, sizeof(buf), fp1)!= NULL)
 	{
 #ifdef _PLATFORM_SDX_
-                // ATH0, ATH1, ATH2, ATH3, ATH14 ATH15 and ATH16 are the wifi clients in SDX
-                if(!(strstr(buf,"ath0") || strstr(buf,"ath1") || strstr(buf,"ath2") || strstr(buf,"ath3") || strstr(buf,"ath14") || strstr(buf,"ath15") || strstr(buf,"ath16")))
