From 1834fb33e73e41d0fb9843575edf85f6b766fe68 Mon Sep 17 00:00:00 2001
From: Sagar Kothawar <kothawar@qti.qualcomm.com>
Date: Wed, 13 May 2026 05:39:03 +0000
Subject: [PATCH] wan-failover

Signed-off-by: Sagar Kothawar <kothawar@qti.qualcomm.com>
---
 source/TR-181/board_sbapi/cosa_ethernet_apis.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/source/TR-181/board_sbapi/cosa_ethernet_apis.c b/source/TR-181/board_sbapi/cosa_ethernet_apis.c
index 20ff53f..eacb382 100755
--- a/source/TR-181/board_sbapi/cosa_ethernet_apis.c
+++ b/source/TR-181/board_sbapi/cosa_ethernet_apis.c
@@ -3448,18 +3448,19 @@ CosaDmlEthInit(
     #if defined(_PLATFORM_RASPBERRYPI_) || defined(_PLATFORM_TURRIS_) || defined(_PLATFORM_SDX_)
 
     char wanPhyName[20] = {0},out_value[20] = {0};
-
+    #ifdef WAN_FAILOVER_SUPPORTED
     sysevent_get(sysevent_fd, sysevent_token, "wan_ifname", out_value, sizeof(out_value));
     if (out_value[0] != '\0')
     {
-       strcpy(wanPhyName, out_value);
+       strlcpy(wanPhyName, out_value, sizeof(wanPhyName));
     }
     else
     {
        /* erouter0 interface should be available even WAN over LTE is active to make sure fallback to WANoE is working.
         * RDKBACCL-896 */
-       strcpy(wanPhyName, "erouter0");
+       strlcpy(wanPhyName, "erouter0", sizeof(wanPhyName));
     }
+    #endif
     #ifdef CORE_NET_LIB
     libnet_status status;
     status=interface_down(ETHWAN_DEF_INTF_NAME);
@@ -3479,7 +3480,9 @@ CosaDmlEthInit(
     }
     #else
     v_secure_system("ifconfig " ETHWAN_DEF_INTF_NAME" down");
+    #ifdef WAN_FAILOVER_SUPPORTED
     v_secure_system("ip link set "ETHWAN_DEF_INTF_NAME" name %s",wanPhyName);
+    #endif
     v_secure_system("ifconfig %s up",wanPhyName);
     #endif
     #endif
--
2.34.1

