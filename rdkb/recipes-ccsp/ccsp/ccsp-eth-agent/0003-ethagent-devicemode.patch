From d16af3e4e199ee9aa1a297b552f0e1a4af0848ad Mon Sep 17 00:00:00 2001
From: Sanketh Gopal <sankgopa@qti.qualcomm.com>
Date: Fri, 13 Dec 2024 11:26:28 +0000
Subject: [PATCH] IPv4_only mode fix for eth WAN

Signed-off-by: Sanketh Gopal <sankgopa@qti.qualcomm.com>
---
 source/TR-181/board_sbapi/cosa_ethernet_apis.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

Index: git/source/TR-181/board_sbapi/cosa_ethernet_apis.c
===================================================================
--- git.orig/source/TR-181/board_sbapi/cosa_ethernet_apis.c
+++ git/source/TR-181/board_sbapi/cosa_ethernet_apis.c
@@ -203,6 +203,8 @@ token_t sysevent_token;
 #define WFO_ENABLED     "/etc/WFO_enabled"
 #define BUF_SIZE 100
 
+#define IPV4_MODE "1"
+
 int Get_CommandOutput(char Command[],char *OutputValue)
 {
     char buf[BUF_SIZE] = {0};
@@ -4596,7 +4598,13 @@ ANSC_STATUS CosaDmlEthSetPhyStatusForWan
     }
 
     CcspTraceInfo(("%s %d WAN Instance:%d\n", __FUNCTION__, __LINE__, iWANInstance));
-
+    char deviceMode[64] = {0};
+    syscfg_get(NULL, "last_erouter_mode", deviceMode, sizeof(deviceMode));
+    if (strcmp(deviceMode, IPV4_MODE) == 0)
+    {
+      v_secure_system("echo 1 > /proc/sys/net/ipv6/conf/eth0/disable_ipv6");
+      CcspTraceWarning(("%s %d Switching to Ipv4 only mode \n", __FUNCTION__, __LINE__));
+    }
 // Phy path not needed to set in case of auto wan policy mode.
 // it will be set in part of boot inform msg.
 #if !defined(AUTOWAN_ENABLE) || defined(WAN_MANAGER_UNIFICATION_ENABLED)
Index: git/source/TR-181/board_sbapi/cosa_ethernet_manager.c
===================================================================
--- git.orig/source/TR-181/board_sbapi/cosa_ethernet_manager.c
+++ git/source/TR-181/board_sbapi/cosa_ethernet_manager.c
@@ -420,14 +420,6 @@ static ethSmState_t Transition_EthWanLin
     {
         CcspTraceError(("%s Failed to set LinkUp to WAN\n", __FUNCTION__));
     }
-    char out_value[64] = {0};
-    syscfg_get(NULL, "last_erouter_mode", out_value, sizeof(out_value));
-    CcspTraceInfo(("%s %d last_erouter_mode -%s wan-interface name- %s \n", __FUNCTION__, __LINE__, out_value, WAN_INTERFACE_NAME));
-    if (strcmp(out_value,"1") == 0)
-    {
-      v_secure_system("echo 1 > /proc/sys/net/ipv6/conf/eth0/disable_ipv6");
-      CcspTraceWarning(("%s %d Switching to Ipv4 only mode \n", __FUNCTION__, __LINE__));
-    }
     if (ANSC_STATUS_SUCCESS != CosaDmlEthSetWanLinkStatusForWanManager(pstInfo->Name, "Up"))
 #endif
     {
