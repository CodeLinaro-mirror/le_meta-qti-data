+                            v_secure_system("dhcp_release brlan0 %s %s",pHost->pStringParaValue[LM_HOST_IPAddressId], hosts[i].phyAddr);
+                        }
+                        pIP = LM_FindIPv4BaseFromLink( pHost, (char *)hosts[i].ipAddr );
+
+                        if( NULL != pIP )
