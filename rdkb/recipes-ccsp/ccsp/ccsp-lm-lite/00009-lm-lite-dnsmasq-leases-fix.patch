+/*===========================================================================
+  FUNCTION:  releaseIPOnDisconnect
+==========================================================================*/
+/*!
+    @brief
+     To retrieve number of entries from dnsmasq.leases, and check in ip nei
+     show whether it is present or not. If not present then remove from
+     dnsmasq.leases using dhcp_release command.
+*/
+/*=========================================================================*/
+static void releaseIPOnDisconnect()
+{
+    FILE *fp1=NULL;
+    FILE *fp2=NULL;
+    char tmpBuf[32] ={0};
+    char tmpBufval[32]={0};
+    char dnsmasqIP[32] = {0};
+    char dnsmasqMAC[32] = {0};
+    char IPNei[32] = {0};
+    char dnsmasqIPCommand[128] = {0};
+    char dnsmasqMACCommand[128] = {0};
+    char IPNeiCommand[128] = {0};
+    int dnsmasqCount=0;
+    int counter = 1;
+
+    // To find number of entries in dnsmasq leases
+    fp1 = popen("cat /nvram/dnsmasq.leases  | wc -l","r");
+    if(fp1 != NULL)
+    {
+        fgets(tmpBuf, sizeof(tmpBuf), fp1);
+        sscanf(tmpBuf,"%s",tmpBufval);
+        dnsmasqCount=atoi(tmpBufval);
+        pclose(fp1);
+    }
+    /*
+     * Sometimes LAN client when disconnected is removed from ip nei without changing state to STALE from REACHABLE.
+     * Logic To delete dnsmasq entry if it is not present in ip nei as REACHABLE by iterating through all the
+     * entries in dnsmasq leases
+     */
+    while(dnsmasqCount > 0)
+    {
+        snprintf(dnsmasqIPCommand, sizeof(dnsmasqIPCommand), "head -%d /nvram/dnsmasq.leases | tail -1 | awk '{print$3}'",counter);
+        snprintf(dnsmasqMACCommand, sizeof(dnsmasqMACCommand), "head -%d /nvram/dnsmasq.leases | tail -1 | awk '{print$2}'",counter);
+        counter++;
+        dnsmasqCount--;
+        // Extracting IP address from dnsmasq leases
+        fp1 = popen(dnsmasqIPCommand,"r");
+        if (fp1 == NULL)
+        {
+            continue;
+        }
+        else
+        {
+            fgets(tmpBuf, sizeof(tmpBuf), fp1);
+            sscanf(tmpBuf,"%s",dnsmasqIP);
+            pclose(fp1);
+        }
+        // Extracting MAC address from dnsmasq leases
+        fp2 = popen(dnsmasqMACCommand,"r");
+        if(fp2 == NULL)
+        {
+            continue;
+        }
+        else
+        {
+            fgets(tmpBuf, sizeof(tmpBuf), fp2);
+            sscanf(tmpBuf,"%s",dnsmasqMAC);
+            pclose(fp2);
+        }
+        snprintf(IPNeiCommand, sizeof(IPNeiCommand), "ip nei | grep %s | grep -E \"REACHABLE|PROBE|STALE|DELAY\" | awk '{print$1}'",dnsmasqIP);
+        strlcpy(tmpBuf,"",sizeof(tmpBuf));
+        strlcpy(IPNei,"",sizeof(IPNei));
+        fp1= popen(IPNeiCommand,"r");
+        // Extracting IP address from ip nei
+        if(fp1 != NULL)
+        {
+            fgets(tmpBuf, sizeof(tmpBuf), fp1);
+            sscanf(tmpBuf,"%s",IPNei);
+            pclose(fp1);
+        }
+        // Applying remove condition only when the dnsmasq leases entry is not in ip nei as REACHABLE/PROBE/STALE/DELAY
+        if((strlen(dnsmasqIP) != 0) && (strlen(dnsmasqMAC) != 0) && (strlen(IPNei) == 0))
+        {
+            CcspTraceWarning(("%s:%d DHCP release IP %s MAC %s \n", __FUNCTION__, __LINE__, dnsmasqIP,dnsmasqMAC));
+            v_secure_system("dhcp_release brlan0 %s %s",dnsmasqIP,dnsmasqMAC);
+            counter--;
+        }
+    }
+}
+
+static bool validateIpv4Safe(const char *ip)
+{
+    if (ip == NULL)
+    {
+        CcspTraceError(("%s:%d Invalid IPv4 address \n", __FUNCTION__, __LINE__));
+        return false;
+    }
+
+    size_t ipLen = strlen(ip);
+    if (ipLen == 0)
+    {
+        CcspTraceError(("%s:%d Invalid IPv4 address (Empty) \n", __FUNCTION__, __LINE__));
+        return false;
+    }
+    for (size_t i = 0; i < ipLen; i++)
+    {
+        if (!(isdigit((unsigned char)ip[i]) || ip[i] == '.'))
+        {
+            CcspTraceError(("%s:%d Invalid IPv4 address \n", __FUNCTION__, __LINE__));
+            return false;
+        }
+    }
+
+    struct in_addr addr;
+    // inet_pton returns 1 for valid IPv4, 0 for invalid, -1 for error
+    if (inet_pton(AF_INET, ip, &addr) != 1)
+    {
+        CcspTraceError(("%s:%d Invalid IPv4 address \n", __FUNCTION__, __LINE__));
+        return false;
+    }
+
+    return true;
+}
