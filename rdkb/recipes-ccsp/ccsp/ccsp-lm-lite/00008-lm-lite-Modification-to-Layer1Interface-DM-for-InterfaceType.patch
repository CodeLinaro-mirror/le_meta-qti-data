+static int get_interface_from_fdb(const char *mac_addr, char *iface_out, size_t out_size, int *vlan_id_out)
+{
+    FILE *fp = NULL;
+    char line[256] = {0};
+   char cmd[256] = {0};
+    char *dev_ptr = NULL;
+    char *end = NULL;
+    char iface_full[64] = {0};
+
+    snprintf(cmd, sizeof(cmd), "bridge fdb show | grep -v permanent | grep -i \"%s\" | grep -i \"master brlan0\"", mac_addr);
+    fp = popen(cmd, "r");
+    if (!fp) {
+        perror("popen failed");
+        return -1;
+    }
+
+    while (fgets(line, sizeof(line), fp)) {
+        dev_ptr = strstr(line, "dev ");
+        if (dev_ptr) {
+            dev_ptr += 4;
+            end = strchr(dev_ptr, ' ');
+            if (end) {
+                size_t len = end - dev_ptr;
+                if (len < sizeof(iface_full)) {
+                    strlcpy(iface_full, dev_ptr, len);
+                    iface_full[len] = '\0';
+
+                    char *dot = strchr(iface_full, '.');
+                    if (dot && vlan_id_out) {
+                        *vlan_id_out = atoi(dot + 1);
+                        *dot = '\0';
+                    }
+
+                    if (strlen(iface_full) < out_size) {
+                        strlcpy(iface_out, iface_full, out_size);
+                        pclose(fp);
+                        return 0;
+                    }
+                }
+            }
+        }
+    }
+
+    pclose(fp);
+    return -1;
+}
