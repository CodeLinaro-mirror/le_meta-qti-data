+ /*
+  * get client type from the mac to print in WANStats and dmesg
+  * input : mac - mac address of the client to be checked
+  * input : mac_found_ipv4 - if mac available if /tmp/ipv4_stats.txt
+  * input : mac_found_ipv6 - if mac available if /tmp/ipv6_stats.txt
+  * output : client_type - ethernet/usb/wlan
+  * return value : true if client type available otherwise false
+  */
+static bool getClientType(char *mac,bool mac_found_ipv4,bool mac_found_ipv6,char *client_type)
+{
+    ssize_t nread;
+    size_t len = 0;
+    char *line = NULL;
+    char *iface = NULL, *ptr;
+    char *ifname;
+    FILE *fp = NULL;
+
+    if (NULL == mac || NULL == client_type)
+    {
+        CcspTraceError(("[%s:%d] input params NULL\n ",__FUNCTION__,__LINE__));
+        return false;
+    }
+
+    if (true == mac_found_ipv4)
+    {
+        fp = fopen(PKT_STATS_V4_CLIENTS, "r");
+    }
+    else if (true == mac_found_ipv6)
+    {
+        fp = fopen(PKT_STATS_V6_CLIENTS, "r");
+    }
+    else
+    {
+        CcspTraceError(("[%s:%d] mac not available in stats files\n ",__FUNCTION__,__LINE__));
+        return false;
+     }
+    if (NULL == fp)
+    {
+        CcspTraceError(("[%s:%d] fopen failed, error (%d) (%s)\n ",__FUNCTION__,__LINE__,errno,strerror(errno)));
+        return false;
+    }
+
+    line = (char *) malloc(BFR_SIZE * sizeof(char));
+    if (NULL == line)
+    {
+        CcspTraceError(("[%s:%d] malloc failed\n ",__FUNCTION__,__LINE__));
+        fclose(fp);
+        fp = NULL;
+        return false;
+    }
+
+     while ((nread = getline(&line, &len, fp)) != -1)
+     {
+        if (strlen(line) <= 0)
+        {
+            CcspTraceError(("[%s:%d] getline failed\n ",__FUNCTION__,__LINE__));
+            fclose(fp);
+            fp = NULL;
+            if (line)
+            {
+                free(line);
+                line = NULL;
+            }
+            return false;
+        }
+        line[strlen(line) - 1] = '\0';
+        if (strcasestr(line, mac))
+        {
+            iface = strtok_r(line, " ", &ptr);
+            ifname = strstr(iface, "=");
+            if ((0 == strcmp(ifname+1,"eth0")) || (0 == strcmp(ifname+1,"eth1")) || (0 == strcmp(ifname+1,"eth1s1")))
+                strlcpy(client_type, "Ethernet", IFACE_SIZE);
+            else if ((0 == strcmp(ifname+1,"rndis0")) || (0 == strcmp(ifname+1,"ecm0")))
+                strlcpy(client_type, "USB", IFACE_SIZE);
+            else if ((0 == strcmp(ifname+1,"ath0")) || (0 == strcmp(ifname+1,"ath1")) || (0 == strcmp(ifname+1,"ath16")))
+                strlcpy(client_type, "WLAN", IFACE_SIZE);
+#ifdef GUEST_WIFI
+            else if ((0 == strcmp(ifname+1,"ath2")) || (0 == strcmp(ifname+1,"ath3")) || (0 == strcmp(ifname+1,"ath14")) || (0 == strcmp(ifname+1,"ath15")))
+                strlcpy(client_type, "WLAN", IFACE_SIZE);
+#endif
+            else
+            {
+                CcspTraceError(("[%s:%d] client_type not available for iface (%s)\n",__FUNCTION__,__LINE__,ifname+1));
+                fclose(fp);
+                fp = NULL;
+                if (line)
+                {
+                    free(line);
+                    line = NULL;
+                }
+                return false;
+            }
+            break;
+        }
+    }
+    fclose(fp);
+    fp = NULL;
+    if (line)
+    {
+       free(line);
+       line = NULL;
+    }
+return true;
+}
+/*
+  * Get interface name corresponding to mac address
+  * input : mac - mac addr of client
+  * output : ifname - corresponding interface
+  * return value : 0 - success, -1 - failure
+*/
+ANSC_STATUS getInterfaceFromMac(char *mac, char *ifname)
+{
+    ssize_t nread;
+    size_t length = 0;
+    bool found_mac = false;
+    char *line = NULL;
+    char cmd[BFR_SIZE]= {0};
+    char iface_name[BFR_SIZE] = {0};
+    char *ifname_temp, *mac_addr_temp, *saveptr;
+    FILE *bridge_fp = NULL;
+
+    if (NULL == mac || NULL == ifname)
+    {
+        CcspTraceError(("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+
+    snprintf(cmd ,sizeof(cmd), "bridge fdb show | grep -v permanent | grep -i 'master brlan0'");
+    bridge_fp = popen(cmd,"r");
+    if (NULL == bridge_fp)
+    {
+        CcspTraceError(("[%s:%d] popen failed\n",__FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+    line = (char *)malloc(BFR_SIZE * sizeof(char));
+    if (NULL == line)
+    {
+        CcspTraceError(("[%s:%d] malloc failed\n",__FUNCTION__,__LINE__));
+        pclose(bridge_fp);
+        bridge_fp = NULL;
+        return ANSC_STATUS_FAILURE;
