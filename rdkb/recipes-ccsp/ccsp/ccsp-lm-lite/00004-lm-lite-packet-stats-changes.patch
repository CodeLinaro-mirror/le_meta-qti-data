+/*
+  * Get total stat byte from iptables, IPA
+  * input : ip - ip of client
+  * mac - mac address of client
+  * is_tx_stat : true - TX stat, otherwise RX stat
+  * return value : total byte of a client
+  */
+uint64_t GetTotalStatBytes(char *ip, char *mac, bool is_tx_stat)
+{
+    //int ret = -1;
+    ANSC_STATUS ret = ANSC_STATUS_FAILURE;
+    int client_found = 0;
+    uint64_t total_stat_bytes = 0, ipv4_stat_bytes = 0, ipv6_stat_bytes = 0;
+    char client_type[IFACE_SIZE] = {0};
+    bool mac_found_ipv4 = false;
+    bool mac_found_ipv6 = false;
+    bool retval = false;
+
+    if (NULL == ip || NULL == mac)
+    {
+        CcspTraceError(("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__));
+        return 0;
+    }
+
+    mac_found_ipv6 = isMacAddrAvailable(PKT_STATS_V6_CLIENTS, mac);
+    mac_found_ipv4 = isMacAddrAvailable(PKT_STATS_V4_CLIENTS, mac);
+    ret = isIPv4ClientPresent(ip,&client_found);
+    if ((ANSC_STATUS_SUCCESS == ret) && (0 != client_found))
+    {
+        ipv4_stat_bytes = getIPv4StatBytes(ip, is_tx_stat) + readIpv4StatsFile(ip, is_tx_stat);
+    }
+    else
+    {
+        CcspTraceError(("[%s:%d] addr (%s) not available in ipv4 stats file\n",__FUNCTION__,__LINE__,ip));
+    }
+
+    if (true == mac_found_ipv6)
+    {
+         ipv6_stat_bytes = getIPv6StatBytes(mac, is_tx_stat) + readIpv6StatsFile(mac, is_tx_stat);
+    }
+    else
+    {
+        CcspTraceError(("[%s:%d] mac (%s) not available in ipv6 stats file\n",__FUNCTION__,__LINE__,mac));
+    }
+
+    retval = getClientType(mac,mac_found_ipv4,mac_found_ipv6,client_type);
+    if (true != retval)
+    {
+        CcspTraceError(("[%s:%d] client_type not available for mac (%s)\n",__FUNCTION__,__LINE__,mac));
+        return 0;
+    }
+
+    total_stat_bytes = ipv4_stat_bytes + ipv6_stat_bytes;
+    CcspTraceInfo(("[%s:%d] %s STATS OF %s with MAC:%s IPV4 (%lu) IPV6 (%lu) TOTAL (%lu)\n",__FUNCTION__,__LINE__,((1 == is_tx_stat)?"TX:":"RX:"),client_type,mac,ipv4_stat_bytes,ipv6_stat_bytes,total_stat_bytes));
+    v_secure_system("echo Connected %s client, MAC:%s %s iptables:%lu ipv6tables:%lu > /dev/kmsg ",client_type,mac,((1 == is_tx_stat)?"TX:":"RX:"),ipv4_stat_bytes,ipv6_stat_bytes);
+    return total_stat_bytes;
+}
+
+/*
+  * check if the client with mac is present in /tmp/ipv4_stats.txt
+  * or /tmp/ipv6_stats.txt
+  * input : file - file to be checked for mac address
+  * input : mac - mac address of the client to be checked
+  * output : client_type - ethernet/usb/wlan
+  * return value : true - if found, otherwise false
+  */
+static bool isMacAddrAvailable(char *file, char *mac)
+{
+    char cmd[COMMAND_SIZE]= {0};
+    FILE *fp = NULL;
+    bool mac_found = 0;
+
+    if ((NULL == file) || (NULL == mac))
+    {
+        CcspTraceError(("[%s:%d] input params NULL\n ",__FUNCTION__,__LINE__));
+        return false;
+    }
+
+    snprintf(cmd, COMMAND_SIZE, "cat %s | grep -iw %s", file, mac);
+    fp = popen(cmd,"r");
+    if (NULL == fp)
+    {
+        CcspTraceError(("[%s:%d] popen failed\n ",__FUNCTION__,__LINE__));
+        return false;
+    }
+
+    if(fgetc(fp) != EOF)
+    {
+        CcspTraceInfo(("[%s:%d] mac (%s) is present \n ",__FUNCTION__,__LINE__,mac));
+        mac_found = true;
+    }
+    else
+    {
+        mac_found = false;
+    }
+    pclose(fp);
+    fp = NULL;
+    return mac_found;
+}
+/*
+  * check if the client with ip is present in /tmp/ipv4_stats.txt
+  * input : addr - ip of the client to be checked
+  * output : if present 1, otherwise 0
+  * return value : 0 - success, -1 - failure
+  */
+static ANSC_STATUS isIPv4ClientPresent(char *addr, int *found)
+{
+    char cmd[COMMAND_SIZE]= {0};
+    FILE *fp = NULL;
+    if (NULL == addr || NULL == found)
+    {
+        CcspTraceError(("[%s:%d] input params NULL\n ",__FUNCTION__,__LINE__));
+        return ANSC_STATUS_FAILURE;
+    }
+    snprintf(cmd, COMMAND_SIZE, "cat %s | grep -w %s", PKT_STATS_V4_CLIENTS,addr);
+    fp = popen(cmd,"r");
+    if (NULL == fp)
+    {
+        CcspTraceError(("[%s:%d] popen failed, error (%d) (%s)\n ",__FUNCTION__,__LINE__,errno,strerror(errno)));
+        return ANSC_STATUS_FAILURE;
+    }
+    if(fgetc(fp) != EOF)
+    {
+        CcspTraceInfo(("[%s:%d] addr (%s) is present \n ",__FUNCTION__,__LINE__,addr));
+        *found = 1;
+    }
+    else
+    {
+        *found = 0;
+    }
+    pclose(fp);
+    fp = NULL;
+    return ANSC_STATUS_SUCCESS;
+}
+
+ /*
+  * Get stats byte from ip6tables for ipv6 address
+  * input : mac - mac of client
+  * is_tx_stat : true - TX stat, otherwise RX stat
+  * return value : stats byte from ip6tables
+  */
+uint64_t getIPv6StatBytes(char *mac, bool is_tx_stat)
+{
+    uint64_t total_stat_bytes = 0, ipv6_stat_bytes = 0;
+    ssize_t nread;
+    size_t length = 0;
+    char *line = NULL;
+    char ipv6Addr[BFR_SIZE] = {0};
+    char cmd[COMMAND_SIZE]= {0};
+    char tmp[COMMAND_SIZE]={0};
+    char stringline[COMMAND_SIZE]={0};
+    char *ipaddr = NULL, *macaddr = NULL, *ptr;
+    char *ipaddr_temp = NULL, *macaddr_temp = NULL;
+    char *bytes=NULL, *saveptr;
+    FILE *stat_fp = NULL;
+    FILE *cmd_fp = NULL;
+
+    if (NULL == mac)
+    {
+        CcspTraceError(("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__));
+        return 0;
+    }
+    stat_fp = fopen("/tmp/ipv6_stats.txt","r");
+    if (NULL == stat_fp)
+    {
+        CcspTraceError(("[%s:%d] fopen failed\n",__FUNCTION__,__LINE__));
+        return 0;
+    }
+    line = (char *) malloc(COMMAND_SIZE * sizeof(char));
+    if (NULL == line)
+    {
+        CcspTraceError(("[%s:%d] malloc failed\n",__FUNCTION__,__LINE__));
+        fclose(stat_fp);
+        stat_fp = NULL;
+        return 0;
+    }
+
+    while ((nread = getline(&line, &length, stat_fp)) != -1)
+    {
+        line[strlen(line) - 1] = '\0';
+        ipv6_stat_bytes = 0;
+        strtok_r(line, " ", &ptr);
+        ipaddr_temp = strtok_r(NULL, " ", &ptr);
+        macaddr_temp = strtok_r(NULL, " ", &ptr);
+        if (NULL == ipaddr_temp || NULL == macaddr_temp)
+        {
+            CcspTraceError(("[%s:%d] strtok_r failed\n",__FUNCTION__,__LINE__));
+   continue;
+        }
+        ipaddr = strstr(ipaddr_temp,"=");
+        macaddr = strstr(macaddr_temp,"=");
+        if (NULL == ipaddr || NULL == macaddr)
+        {
+            CcspTraceError(("[%s:%d] getline failed\n",__FUNCTION__,__LINE__));
+            continue;
+        }
+        if (strlen(ipaddr+1) <= 0)
+        {
+            CcspTraceError(("[%s:%d] ip address not available\n",__FUNCTION__,__LINE__));
+            continue;
+         }
+        if (0 == strcasecmp(mac,macaddr+1))
+        {
+            strlcpy(ipv6Addr,ipaddr+1,sizeof(ipv6Addr));
+        }
+        else
+        {
+            CcspTraceError(("[%s:%d] no matching mac found\n",__FUNCTION__,__LINE__));
+            break;
+        }
+        snprintf(cmd, COMMAND_SIZE,"ip6tables -t mangle -L TRAFFIC_ACCT -n -v -x  --line-numbers -w 2");
+        strlcat(cmd, IP6TABLES_AWK_STATS, COMMAND_SIZE);
+        if (false == is_tx_stat)
+        {
+            /*transmit bytes will be marked with 0x02*/
+            snprintf(tmp, COMMAND_SIZE, " | grep -w %s |grep -i 0x2", ipv6Addr);
+        }
+        else
+        {
+            /*receive bytes will be marked with 0x01*/
+            snprintf(tmp, COMMAND_SIZE, " | grep -w %s |grep -i 0x1", ipv6Addr);
+        }
+        strlcat(cmd, tmp, COMMAND_SIZE);
+        cmd_fp = popen(cmd,"r");
+        if (cmd_fp == NULL)
+        {
+            CcspTraceError(("[%s:%d] popen failed\n",__FUNCTION__,__LINE__));
+            continue;
+        }
+        if(NULL != fgets(stringline,sizeof(stringline)-1,cmd_fp))
+        {
+            if (strlen(stringline) > 0)
+            {
+                stringline[strlen(stringline) - 1] = '\0';
+            }
+            else
+            {
+                CcspTraceError(("[%s:%d] fgets failed\n",__FUNCTION__,__LINE__));
+                pclose(cmd_fp);
+                cmd_fp = NULL;
+                continue;
+            }
+            strtok_r(stringline, ",", &saveptr);
+            bytes = strtok_r(NULL, ",", &saveptr);
+            if (NULL == bytes)
+            {
+                pclose(cmd_fp);
+                cmd_fp = NULL;
+                continue;
+            }
+            ipv6_stat_bytes = strtoull(bytes,&ptr,10);
+        }
+        pclose(cmd_fp);
+        cmd_fp = NULL;
+        total_stat_bytes += ipv6_stat_bytes;
+    }
+    fclose(stat_fp);
+    stat_fp = NULL;
+    if (line)
+    {
+        free(line);
+        line = NULL;
+    }
+    return total_stat_bytes;
+}
