+ /*
+  * Get stats byte from iptables for ipv4 address
+  * input : ipv4addr - ip of client
+  * is_tx_stat : true - TX stat, otherwise RX stat
+  * return value : stats byte from iptables
+  */
+uint64_t getIPv4StatBytes(char *ipv4addr, bool is_tx_stat)
+{
+    uint64_t stat_bytes = 0;
+    ssize_t nread;
+    size_t length = 0;
+    unsigned int mark_val = 0;
+    char cmd[COMMAND_SIZE]= {0};
+    char tmp[COMMAND_SIZE]={0};
+    char *stringline = NULL;
+    char *bytes=NULL, *mark=NULL,*ptr;
+    FILE *fp = NULL;
+
+    if (NULL == ipv4addr)
+    {
+        CcspTraceError(("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__));
+        return 0;
+    }
+    snprintf(cmd, COMMAND_SIZE,"iptables -t mangle -L TRAFFIC_ACCT -n -v -x  --line-numbers -w 2");
+    strlcat(cmd, IPTABLES_AWK_STATS, COMMAND_SIZE);
+    snprintf(tmp, COMMAND_SIZE, " | grep -i %s", ipv4addr);
+    strlcat(cmd, tmp, COMMAND_SIZE);
+
+    fp = popen(cmd,"r");
+    if (NULL == fp)
+    {
+        CcspTraceError(("[%s:%d] popen failed\n",__FUNCTION__,__LINE__));
+        return 0;
+    }
+    stringline = (char *)malloc(BFR_SIZE * sizeof(char));
+    if (NULL == stringline)
+    {
+        CcspTraceError(("[%s:%d] malloc failed\n",__FUNCTION__,__LINE__));
+        pclose(fp);
+        fp = NULL;
+        return 0;
+    }
+    while ((nread = getline(&stringline, &length, fp)) != -1)
+    {
+        stringline[strlen(stringline) - 1] = '\0';
+        strtok_r(stringline, ",", &ptr);
+        bytes = strtok_r(NULL, ",", &ptr);
+        strtok_r(NULL, ",", &ptr);
+        strtok_r(NULL, ",", &ptr);
+        mark = strtok_r(NULL, ",", &ptr);
+
+        if ((NULL == mark) || (NULL == bytes))
+        {
+            CcspTraceError(("[%s:%d] mark or bytes are NULL\n",__FUNCTION__,__LINE__));
+            pclose(fp);
+            fp = NULL;
+            if (NULL != stringline)
+            {
+                free(stringline);
+	        stringline = NULL;
+            }
+            return 0;
+        }
+        mark_val = strtoull(mark,&ptr,16);
+        if (false == is_tx_stat)
+        {
+            if (mark_val%2 == 0)
+            {
+                stat_bytes = strtoull(bytes,&ptr,10);
+                break;
+            }
+        }
+        else
+        {
+            if (mark_val%2 != 0)
+            {
+                stat_bytes = strtoull(bytes,&ptr,10);
+                break;
+            }
+        }
+    }
+    pclose(fp);
+    fp = NULL;
+    if (NULL != stringline)
+    {
+        free(stringline);
+        stringline = NULL;
+    }
+    return stat_bytes;
+}
+
+uint64_t readIpv4StatsFile(char* ip, bool is_tx_stat)
+{
+    FILE* file = NULL;
+    uint64_t value = 0;
+    char command[COMMAND_SIZE] = {0};
+    char buffer[256] = {0};
+    CcspTraceError(("[%s:%d] Entered \n ",__FUNCTION__,__LINE__));
+    if (is_tx_stat)
+    {
+        snprintf(command, COMMAND_SIZE, "cat %s | grep %s | awk '{sub(/TX=/,\"\"); print $4}' | sort -nr | head -1", PKT_STATS_V4_CLIENTS, ip);
+        file = popen(command, "r");
+    }
+    else
+    {
+        snprintf(command, COMMAND_SIZE, "cat %s | grep %s | awk '{sub(/RX=/,\"\"); print $5}' | sort -nr | head -1", PKT_STATS_V4_CLIENTS, ip);
+        file = popen(command, "r");
+    }
+    if (file == NULL)
+    {
+        CcspTraceError(("[%s:%d] failed to open pipe \n",__FUNCTION__,__LINE__));
+        return 0;
+    }
+    fgets(buffer, sizeof(buffer), file);
+    pclose(file);
+    // Parse the value from the buffer
+    value = strtoull(buffer, NULL, 10);
+    if (value == 0)
+    {
+        CcspTraceError(("[%s:%d] Either Failed to parse value/ TX or RX will be zero\n ",__FUNCTION__,__LINE__));
+        return 0;
+    }
+    CcspTraceError(("[%s:%d] Value read from ipv4_stats file is %lu \n ",__FUNCTION__,__LINE__,value));
+    return value;
+}
