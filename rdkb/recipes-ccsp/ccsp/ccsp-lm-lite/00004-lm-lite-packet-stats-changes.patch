+ULONG
+Host_WANStats_GetParamStringValue
+    (
+        ANSC_HANDLE                 hInsContext,
+        char*                       ParamName,
+        char*                       pValue,
+        ULONG*                      pUlSize
+    )
+{
+    PLmObjectHost pHost = (PLmObjectHost)hInsContext;
+     bool is_tx_stat = false;
+     uint64_t total_bytes = 0;
+     char buf[64] = {0};
+     int len;
+
+    if (!pHost || !ParamName || !pValue || !pUlSize)
+    {
+        CcspTraceError(("[%s:%d] Invalid input parameters\n", __FUNCTION__, __LINE__));
+        return -1;
+    }
+    if (strcmp(ParamName, "BytesSent") == 0)
+    {
+       is_tx_stat = true;
+    }
+    else if (strcmp(ParamName, "BytesReceived") != 0)
+    {
+        return -1;
+    }
+
+    // Get the 64-bit stats
+    total_bytes = GetTotalStatBytes(
+                      pHost->pStringParaValue[LM_HOST_IPAddressId],
+                      pHost->pStringParaValue[LM_HOST_PhysAddressId],
+                      is_tx_stat);
+
+    // Convert 64-bit integer to decimal string
+    len = snprintf(buf, sizeof(buf), "%llu", (unsigned long long)total_bytes);
+    if (len < 0 || len >= (int)sizeof(buf))
+    {
+        CcspTraceError(("[%s:%d] snprintf failed for %s\n", __FUNCTION__, __LINE__, ParamName));
+        return -1;
+    }
+
+    // Check buffer size provided by caller
+    if (*pUlSize < (ULONG)(len + 1))
+    {
+        // Tell caller how much is needed (include null terminator)
+        *pUlSize = len + 1;
+        return 1;
+    }
+    // Copy to output buffer
+    AnscCopyString(pValue, buf);
+    return 0;
+}
