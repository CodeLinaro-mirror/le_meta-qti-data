@@ -2420,7 +2526,31 @@ static void *Event_HandlerThread(void *threadid)
             if(EthHost.Active)
             {
                 CcspTraceDebug(("%s-%d LM Ethernet client is active \n",__FUNCTION__,__LINE__));
-                LanManager_CheckCloneCopy(&(pHost->pStringParaValue[LM_HOST_Layer1InterfaceId]), "Ethernet");
+                /* Driver identifies USB device as ethernet
+                 * so updating the device type as USB by
+                 * checking <bridge fdb show> table  */
+                if(checkForUSBInterface(RNDIS0_USB_INTERFACE))
+                   snprintf(cmd ,sizeof(cmd), "bridge fdb show | grep -w 'rndis0 master brlan0'");
+                else if(checkForUSBInterface(ECM0_USB_INTERFACE))
+                   snprintf(cmd ,sizeof(cmd), "bridge fdb show | grep -w 'ecm0 master brlan0'");
+                memset(MacAddress, '0', MACADDR_SIZE*sizeof(char));
+                ret = checkForUSBClient(cmd, MacAddress);
+                if (0 == ret)
+                {
+                    if (TRUE == AnscEqualString(pHost->pStringParaValue[LM_HOST_PhysAddressId], MacAddress, FALSE))
+                    {
+                        CcspTraceDebug(("%s:%d Layer1Interface is set to USB \n",__FUNCTION__,__LINE__));
+                        LanManager_CheckCloneCopy(&(pHost->pStringParaValue[LM_HOST_Layer1InterfaceId]), "USB");
+                    }
+                    else
+                    {
+                        LanManager_CheckCloneCopy(&(pHost->pStringParaValue[LM_HOST_Layer1InterfaceId]), "Ethernet");
+                    }
+                }
+                else
+                {
+                    LanManager_CheckCloneCopy(&(pHost->pStringParaValue[LM_HOST_Layer1InterfaceId]), "Ethernet");
+                }
                 char vlan_id_list[5] = {0};
                 syscfg_get(NULL, "lan_ethernet_virtual_ifnums", vlan_id_list, sizeof(vlan_id_list));
                 if (vlan_id_list != NULL && vlan_id_list[0] != '\0') {
