Date: Tue, 21 Jul 2026 04:41:19 +0000
Subject: [PATCH] [Description]:Corrects wrong Layer1Interface reporting for USB-tethered clients seen as Ethernet in bridge/FDB paths.
Adds runtime USB-interface and USB-client checks before assigning final host interfacetype.

[RCA/Root Cause Analysis]:
Driver/FDB path exposed USB clients through Ethernet-like interface names (ecm0/rndis0 under bridge context).
LM-lite wrote Ethernet blindly, so DM values were incorrect for USB-connected hosts.

[Fix Description]:
Added checkForUSBInterface() and checkForUSBClient() helpers using ifconfig and bridge fdb show.
Event handler now sets Layer1Interface to USB when MAC matches USB client; otherwise keeps Ethernet.

Signed-off-by: Hanna Jose <hjose@qti.qualcomm.com>
---
 source/lm/lm_main.c | 134 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 132 insertions(+), 2 deletions(-)

diff --git a/source/lm/lm_main.c b/source/lm/lm_main.c
index 8dd1f46..f6a991e 100644
--- a/source/lm/lm_main.c
+++ b/source/lm/lm_main.c
@@ -113,6 +113,8 @@
 #define ARP_IPv6 0
 #define DIBBLER_IPv6 1
 #define BUFFER_SIZE 256
+#define ECM0_USB_INTERFACE "ecm0"
+#define RNDIS0_USB_INTERFACE "rndis0"
 #include <pthread.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -2323,6 +2325,110 @@ void XHosts_SyncWifi()
 	
 }
 #endif
+/**********************************************************************
+
+    prototype:
+
+        int checkForUSBInterface(const char *interface);
+
+    description:
+
+        To check whether the USB interface is present
+
+    argument:   const char *interface
+                The input parameter that holds the usb interface
+
+
+    return:     1 : for success
+                0 : for failure
+
+**********************************************************************/
+static int checkForUSBInterface(const char *interface)
+{
+    char ifconfig_buffer[MAX_SIZE]={0};
+    FILE *fp;
+
+    if (strcmp(interface,"rndis0") == 0)
+        fp = popen("ifconfig | grep rndis0 |awk '{print $1}'", "r");
+    else if (strcmp(interface,"ecm0") == 0)
+        fp = popen("ifconfig | grep ecm0 |awk '{print $1}'", "r");
+    else
+        fp = NULL;
+
+    if (fp == NULL)
+    {
+        perror("Error running the command\n");
+        return 0;
+    }
+
+    while (fgets(ifconfig_buffer, sizeof(ifconfig_buffer), fp) != NULL)
+    {
+        if (strstr(ifconfig_buffer, interface) != NULL)
+        {
+            pclose(fp);
+            return 1;
+        }
+    }
+
+    pclose(fp);
+    return 0;
+}
+
+/**********************************************************************
+
+    prototype:
+
+        int checkForUSBClient(char *fname, char *MacAddress);
+
+    description:
+
+        To check USB client availability.
+
+    argument:   char *fname
+                command to execute 'bridge fdb show'
+
+                char *MacAddress,
+                The output parameter which holds usb client mac address
+
+    return:     0 : for success
+                -1 : for failure
+
+**********************************************************************/
+static int checkForUSBClient(char *fname, char *MacAddress)
+{
+    FILE *fp = NULL;
+    char temp[MAX_SIZE_DNSMASQ_Q];
+    int find_result = 0;
+
+    if ((NULL == fname) || (NULL == MacAddress))
+    {
+        CcspTraceError(("%s:%d input param NULL \n",__FUNCTION__,__LINE__));
+        return -1;
+    }
+
+    fp=popen(fname,"r");
+    if (fp == NULL)
+    {
+        CcspTraceError(("%s:%d popen failed \n",__FUNCTION__,__LINE__));
+        return -1;
+   }
+    while (NULL != fgets(temp, MAX_SIZE_DNSMASQ_Q, fp))
+    {
+        /* Entries includes 'permanent' for interfaces not for clients */
+        if (NULL == strstr(temp, "permanent"))
+        {
+            strlcpy(MacAddress, temp, MACADDR_SIZE*sizeof(char));
+            CcspTraceError(("%s:%d usb client MacAddress is %s \n",__FUNCTION__,__LINE__,MacAddress));
+            find_result++;
+            break;
+        }
+    }
+    pclose(fp);
+    if (find_result == 0)
+        return -1;
+
+    return 0;
+}
 
 static void *Event_HandlerThread(void *threadid)
 {
