Date: Tue, 6 Oct 2026 05:47:52 +0000
Subject: Added NULL check in PSM_Get_Record_Value_rbus , to prevent coredump file from being generated.

Signed-off-by: Nandakishore S <nans@qti.qualcomm.com>
---
 source/util_api/ccsp_msg_bus/ccsp_base_api.c | 4 +++
 1 file changed, 4 insertions(+)

Index: git/source/util_api/ccsp_msg_bus/ccsp_base_api.c
===================================================================
--- git.orig/source/util_api/ccsp_msg_bus/ccsp_base_api.c
+++ git/source/util_api/ccsp_msg_bus/ccsp_base_api.c
@@ -355,6 +355,10 @@ int PSM_Get_Record_Value_rbus
     int i = 0;
     char* pTmp = NULL;
     CCSP_MESSAGE_BUS_INFO *bus_info = (CCSP_MESSAGE_BUS_INFO *)bus_handle;
+    if (bus_info == NULL){
+        CcspTraceError(("%s: bus_handle is NULL, cannot proceed with rbus call\n", __FUNCTION__));
+        return CCSP_ERR_INVALID_PARAMETER_VALUE;
+    }
     rbusObject_t inParams = NULL, outParams = NULL;
     rbusObject_Init(&inParams, NULL);
     rbusProperty_t list = NULL;
