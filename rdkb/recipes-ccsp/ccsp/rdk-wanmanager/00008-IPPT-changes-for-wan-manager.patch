From e900db16a491b7b15fec2ba775a689474c2c9307 Mon Sep 17 00:00:00 2001
From: Hanna Jose <hjose@qti.qualcomm.com>
Date: Tue, 23 Jun 2026 08:56:14 +0000
Subject: [PATCH] IPPT-changes-for-wanmanager

Signed-off-by: Hanna Jose <hjose@qti.qualcomm.com>
---
 source/WanManager/wanmgr_interface_sm.c | 146 +++++++++++++++++++++++-
 source/WanManager/wanmgr_net_utils.c    |   8 +-
 2 files changed, 150 insertions(+), 4 deletions(-)

diff --git a/source/WanManager/wanmgr_interface_sm.c b/source/WanManager/wanmgr_interface_sm.c
index fa1e286..66e5bff 100644
--- a/source/WanManager/wanmgr_interface_sm.c
+++ b/source/WanManager/wanmgr_interface_sm.c
@@ -49,6 +49,8 @@
 #define RESOLV_CONF_FILE "/etc/resolv.conf"
 #define LOOPBACK "127.0.0.1"
 
+#define IPPT_MODE_WITH_NAT         1
+#define IPPT_MODE_WITHOUT_NAT      2
 #ifdef FEATURE_IPOE_HEALTH_CHECK
 #define IPOE_HEALTH_CHECK_V4_STATUS "ipoe_health_check_ipv4_status"
 #define IPOE_HEALTH_CHECK_V6_STATUS "ipoe_health_check_ipv6_status"
@@ -72,7 +74,14 @@ typedef enum
 static XLAT_State_t xlat_state_get(void);
 #endif
 
-
+typedef enum _IPPT_CLIENTTYPE
+{
+    IPPT_CLIENTTYPE_USB = 1,
+    IPPT_CLIENTTYPE_ETH0,
+    IPPT_CLIENTTYPE_ETH1,
+    IPPT_CLIENTTYPE_WLAN,
+    IPPT_CLIENTTYPE_ANY
+} IPPT_CLIENTTYPE;
 /*WAN Manager States*/
 static eWanState_t wan_state_vlan_configuring(WanMgr_IfaceSM_Controller_t* pWanIfaceCtrl);
 static eWanState_t wan_state_ppp_configuring(WanMgr_IfaceSM_Controller_t* pWanIfaceCtrl);
@@ -665,6 +674,70 @@ static ANSC_STATUS WanManager_ConfigureMarking(WanMgr_IfaceSM_Controller_t* pWan
     return ANSC_STATUS_SUCCESS;
 }
 
+static int execute_ipa(int mode, IPPT_CLIENTTYPE client_type, char* mac, char* wan_ifname_val)
+{
+    int nat_mode = 0;
+    char dev_type[8]={0};
+
+    if (wan_ifname_val == NULL)
+    {
+        return RETURN_ERR;
+    }
+
+    if (mode == IPPT_MODE_WITHOUT_NAT)
+        nat_mode = 1;
+
+    switch (client_type)
+    {
+        case IPPT_CLIENTTYPE_USB:
+        {
+            strlcpy(dev_type, "usb", sizeof(dev_type));
+            break;
+        }
+        case IPPT_CLIENTTYPE_ETH0:
+        {
+           strlcpy(dev_type, "eth0", sizeof(dev_type));
+           break;
+        }
+        case IPPT_CLIENTTYPE_ETH1:
+        {
+           strlcpy(dev_type, "eth1", sizeof(dev_type));
+           break;
+        }
+        case IPPT_CLIENTTYPE_WLAN:
+        {
+           strlcpy(dev_type, "wifi", sizeof(dev_type));
+           break;
+        }
+        case IPPT_CLIENTTYPE_ANY:
+        {
+           strlcpy(dev_type, "any", sizeof(dev_type));
+           break;
+        }
+        default:
+           return RETURN_ERR;
+    }
+
+    if (((client_type == IPPT_CLIENTTYPE_ETH0) || (client_type == IPPT_CLIENTTYPE_ETH1) || (client_type == IPPT_CLIENTTYPE_WLAN)) && (mac != NULL))
+    {
+        if (v_secure_system("ipa ippass enable dev_type %s vlan 0 mac %s skip_nat %d default_pdn 1 dev_name %s", dev_type, mac, nat_mode, wan_ifname_val) == 0)
+        {
+               CcspTraceWarning(("%s %d - executed ipa command ipa ippass enable dev_type %s vlan 0 mac %s skip_nat %d default_pdn 1 dev_name %s \n", __FUNCTION__, __LINE__, dev_type, mac, nat_mode, wan_ifname_val));
+               return RETURN_OK;
+        }
+    }
+    else
+    {
+        if (v_secure_system("ipa ippass enable dev_type %s vlan 0 mac 00:00:00:00:00:00 skip_nat %d default_pdn 1 dev_name %s", dev_type, nat_mode, wan_ifname_val) == 0)
+        {
+               CcspTraceWarning(("%s %d - executed ipa command ipa ippass enable dev_type %s vlan 0 mac 00:00:00:00:00:00 skip_nat %d default_pdn 1 dev_name %s \n", __FUNCTION__, __LINE__, dev_type, nat_mode, wan_ifname_val));
+               return RETURN_OK;
+        }
+    }
+
+    return RETURN_ERR;
+}
+
 /*********************************************************************************/
 /**************************** ACTIONS ********************************************/
 /*********************************************************************************/
@@ -1317,7 +1390,14 @@ static int wan_setUpIPv4(WanMgr_IfaceSM_Controller_t * pWanIfaceCtrl)
     char cmdStr[BUFLEN_256] = {0};
     char bCastStr[IP_ADDR_LENGTH] = {0};
     char buf[BUFLEN_32] = {0};
-
+    char ippt_enable[8] = {0};
+    char tmpbuf[8] = {0};
+    int mode;
+    IPPT_CLIENTTYPE client_type;
+    char buf1[8] = {0};
+    char mac[50]={0};
+    char ippt_transition[4] = {0};
+    char ippt_auto_ip[32] = {0};
     DEVICE_NETWORKING_MODE DeviceNwMode = pWanIfaceCtrl->DeviceNwMode;
     DML_WAN_IFACE * pInterface = pWanIfaceCtrl->pIfaceData;
     DML_VIRTUAL_IFACE* p_VirtIf = WanMgr_getVirtualIfaceById(pInterface->VirtIfList, pWanIfaceCtrl->VirIfIdx);
@@ -1402,12 +1482,51 @@ static int wan_setUpIPv4(WanMgr_IfaceSM_Controller_t * pWanIfaceCtrl)
         CcspTraceError(("%s %d - Failed to set up default system gateway", __FUNCTION__, __LINE__));
         ret = RETURN_ERR;
     }
+    syscfg_get( NULL, "IPPT_Mode", tmpbuf, sizeof(tmpbuf));
+    mode = _ansc_atoi(tmpbuf);
+    syscfg_get( NULL, "IPPT_Enable", ippt_enable, sizeof(ippt_enable));
+    syscfg_get( NULL, "IPPT_ClientType", buf1, sizeof(buf1));
+    client_type = _ansc_atoi(buf1);
+    syscfg_get( NULL, "IPPT_HostMac", mac, sizeof(mac));
+    sysevent_get(sysevent_fd, sysevent_token, "ippt_transition", ippt_transition, sizeof(ippt_transition));
+
+    if ((strcmp(ippt_enable,"true") == 0) && (strstr(p_VirtIf->IP.Ipv4Data.ifname,"qmapmux")!=NULL) && (strcmp(ippt_transition,"1") != 0))
+    {
+       if(execute_ipa(mode, client_type, mac, p_VirtIf->IP.Ipv4Data.ifname) != RETURN_OK)
+       {
+           CcspTraceError(("%s %d - Failed to execute ipa command", __FUNCTION__, __LINE__));
+           ret = RETURN_ERR;
+       }
+       if(!syscfg_get( NULL, "ippt_auto_ip", ippt_auto_ip, sizeof(ippt_auto_ip)))
+       {
+           snprintf(cmdStr, sizeof(cmdStr), "ifconfig %s %s", p_VirtIf->IP.Ipv4Data.ifname, ippt_auto_ip);
+           CcspTraceInfo(("%s %d: IPPT Auto ip assignment - %s \n", __FUNCTION__, __LINE__, ippt_auto_ip));
+           strlcpy(p_VirtIf->IP.Ipv4Data.ip, ippt_auto_ip, sizeof(p_VirtIf->IP.Ipv4Data.ip));
+       }
+       CcspTraceInfo(("%s %d -  IP configuration = %s \n", __FUNCTION__, __LINE__, cmdStr));
+       WanManager_DoSystemAction("setupIPv4:", cmdStr);
+    }
 
     /** Update required sysevents. */
 
     sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_IPV4_CONNECTION_STATE, WAN_STATUS_UP, 0);
     sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_CURRENT_IPV4_LINK_STATE, WAN_STATUS_UP, 0);
-    sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_CURRENT_WAN_IPADDR, p_VirtIf->IP.Ipv4Data.ip, 0);
+    //check for IPPT
+    if ((strstr(pInterface->Name,"qmapmux")!=NULL) && (mode == IPPT_MODE_WITHOUT_NAT) && (strcmp(ippt_enable, "true") == 0))
+    {
+        sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_CURRENT_WAN_IPADDR, "0.0.0.0", 0);
+        CcspTraceWarning(("%s %d %d-mode-%s-interface \n", __FUNCTION__, __LINE__, mode, pInterface->Name));
+    }
+    else if((strstr(pInterface->Name,"qmapmux")!=NULL) && (mode == IPPT_MODE_WITH_NAT) && (strcmp(ippt_enable, "true") == 0))
+    {
+       char wanIP[32] = {0};
+       sysevent_get(sysevent_fd, sysevent_token, "cellular_wan_v4_ip",wanIP,sizeof(wanIP));
+       sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_CURRENT_WAN_IPADDR,wanIP,0);
+    }
+    else
+    {
+        sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_CURRENT_WAN_IPADDR, p_VirtIf->IP.Ipv4Data.ip, 0);
+    }
     sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_CURRENT_WAN_SUBNET, p_VirtIf->IP.Ipv4Data.mask, 0);
     sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_CURRENT_WAN_STATE, WAN_STATUS_UP, 0);
 
@@ -1462,6 +1581,11 @@ static int wan_setUpIPv4(WanMgr_IfaceSM_Controller_t * pWanIfaceCtrl)
 #endif
     /* Firewall restart. */
     sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_FIREWALL_RESTART, NULL, 0);
+    // lan restart for ippt
+    if (strcmp(ippt_enable,"true") == 0)
+    {
+       v_secure_system("/etc/utopia/service.d/service_lan.sh lan-restart");
+    }
     WanMgr_StartConnectivityCheck(pWanIfaceCtrl);
     return ret;
 }
@@ -1478,6 +1602,7 @@ static int wan_tearDownIPv4(WanMgr_IfaceSM_Controller_t * pWanIfaceCtrl)
     int ret = RETURN_OK;
     char cmdStr[BUFLEN_128] = {0};
     char buf[BUFLEN_32] = {0};
+    char ippt_enable[8] = {0};
 
     DEVICE_NETWORKING_MODE DeviceNwMode = pWanIfaceCtrl->DeviceNwMode;
     DML_WAN_IFACE * pInterface = pWanIfaceCtrl->pIfaceData;
@@ -1548,6 +1673,13 @@ static int wan_tearDownIPv4(WanMgr_IfaceSM_Controller_t * pWanIfaceCtrl)
         sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_WAN_STATUS, WAN_STATUS_STOPPED, 0);
         sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_WAN_SERVICE_STATUS, WAN_STATUS_STOPPED, 0);
         CcspTraceInfo(("%s %d - wan-status event set to stopped \n", __FUNCTION__, __LINE__));
+        syscfg_get( NULL, "IPPT_Enable", ippt_enable, sizeof(ippt_enable));
+        // LAN restart is done so that LAN clients get private IP when WAN goes down with IPPT enabled
+        if (strcmp(ippt_enable,"true") == 0)
+        {
+            v_secure_system("/etc/utopia/service.d/service_lan.sh lan-restart");
+            CcspTraceInfo(("%s %d - LAN restart done to handle IPPT \n",__FUNCTION__, __LINE__));
+        }
     }
 
     return ret;
@@ -1777,6 +1909,7 @@ static int wan_tearDownIPv6(WanMgr_IfaceSM_Controller_t * pWanIfaceCtrl)
     char previousPrefix[BUFLEN_48] = {0};
     char previousPrefix_vldtime[BUFLEN_48] = {0};
     char previousPrefix_prdtime[BUFLEN_48] = {0};
+    char ippt_enable[8]={0};
     /* set ipv6 down sysevent notification. */
     sysevent_get(sysevent_fd, sysevent_token, SYSEVENT_FIELD_IPV6_PREFIX, previousPrefix, sizeof(previousPrefix));
     sysevent_get(sysevent_fd, sysevent_token, SYSEVENT_FIELD_IPV6_PREFIXVLTIME, previousPrefix_vldtime, sizeof(previousPrefix_vldtime));
@@ -1827,6 +1960,13 @@ static int wan_tearDownIPv6(WanMgr_IfaceSM_Controller_t * pWanIfaceCtrl)
         sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_WAN_STATUS, WAN_STATUS_STOPPED, 0);
         sysevent_set(sysevent_fd, sysevent_token, SYSEVENT_WAN_SERVICE_STATUS, WAN_STATUS_STOPPED, 0);
         CcspTraceInfo(("%s %d - wan-status , wan_service-status event set to stopped \n", __FUNCTION__, __LINE__));
+        syscfg_get( NULL, "IPPT_Enable", ippt_enable, sizeof(ippt_enable));
+        // LAN restart is done so that LAN clients get private IP when WAN goes down with IPPT enabled
+        if (strcmp(ippt_enable,"true") == 0)
+        {
+            v_secure_system("/etc/utopia/service.d/service_lan.sh lan-restart");
+            CcspTraceInfo(("%s %d - LAN restart done to handle IPPT \n",__FUNCTION__, __LINE__));
+        }
     }
 
     return ret;
diff --git a/source/WanManager/wanmgr_net_utils.c b/source/WanManager/wanmgr_net_utils.c
index a06c9e5..2cb65d3 100644
--- a/source/WanManager/wanmgr_net_utils.c
+++ b/source/WanManager/wanmgr_net_utils.c
@@ -1873,7 +1873,13 @@ int WanManager_AddDefaultGatewayRoute(DEVICE_NETWORKING_MODE DeviceNwMode, const
         if (IsValidIpv4Address(pIpv4Info->gateway) && !(IsZeroIpvxAddress(AF_SELECT_IPV4, pIpv4Info->gateway)))
         {
             /*68 as that is the minimun packet size that can be transferred*/
-            if((pIpv4Info->mtuSize) >= MIN_IPv4_MTU)
+            char ippt_value[8] = {0};
+            syscfg_get(NULL, "IPPT_Enable", ippt_value, sizeof(ippt_value));
+            if ((strstr(pIpv4Info->ifname,"qmapmux")!=NULL) && (strcmp(ippt_value,"true") == 0))
+            {
+               snprintf(cmd, sizeof(cmd), "ip route add default dev %s proto static scope link mtu lock %d", pIpv4Info->ifname, pIpv4Info->mtuSize);
+            }
+            else if((pIpv4Info->mtuSize) >= MIN_IPv4_MTU)
             {
                 snprintf(cmd, sizeof(cmd), "ip route add default via %s dev %s mtu %d", pIpv4Info->gateway, pIpv4Info->ifname, pIpv4Info->mtuSize);
             }
-- 
