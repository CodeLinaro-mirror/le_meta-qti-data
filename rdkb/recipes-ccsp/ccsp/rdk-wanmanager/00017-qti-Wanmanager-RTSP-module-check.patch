+++ git/source/WanManager/wanmgr_net_utils.c
@@ -274,7 +274,7 @@ int xlat_reconfigure(void)
 }
 #endif
 
-#ifdef FEATURE_MAPT
+#if defined(FEATURE_MAPT) || defined(_PLATFORM_SDX_)
 /*************************************************************************************
  * @brief checks kernel module loaded.
  * This API calls the proc entry.
