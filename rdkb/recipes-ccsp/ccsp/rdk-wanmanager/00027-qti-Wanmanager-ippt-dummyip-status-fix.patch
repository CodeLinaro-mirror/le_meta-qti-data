From 6a1b3c5d7e9f0a2b4c6d8e0f1a3b5c7d9e1f3a5b Mon Sep 17 00:00:00 2001
From: Shiras Rahman U <shirasra@qti.qualcomm.com>
Date: Tue, 8 Sep 2026 00:00:00 +0000
Subject: [PATCH] Restore IP.Ipv4Status to UP after wan_setUpIPv4 to keep the IPPT dummy address from being torn down

Change-Id: I2f4a6b8c0d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0a
Signed-off-by: Shiras Rahman U <shirasra@qti.qualcomm.com>
---
 source/WanManager/wanmgr_interface_sm.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/source/WanManager/wanmgr_interface_sm.c b/source/WanManager/wanmgr_interface_sm.c
index c3d00b0..7f1e9a2 100644
--- a/source/WanManager/wanmgr_interface_sm.c
+++ b/source/WanManager/wanmgr_interface_sm.c
@@ -1587,6 +1587,10 @@ static int wan_setUpIPv4(WanMgr_IfaceSM_Controller_t * pWanIfaceCtrl)
     {
        v_secure_system("/etc/utopia/service.d/service_lan.sh lan-restart");
     }
+    if (ret == RETURN_OK)
+    {
+        p_VirtIf->IP.Ipv4Status = WAN_IFACE_IPV4_STATE_UP;
+    }
     WanMgr_StartConnectivityCheck(pWanIfaceCtrl);
     return ret;
 }
--
2.34.1
