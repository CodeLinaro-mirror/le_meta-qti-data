--- /dev/null
+++ git/source/WanManager/eth_lan_interface.h
@@ -0,0 +1,10 @@
+/*Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+*SPDX-License-Identifier: BSD-3-Clause-Clear
+*/
+#ifndef _ETH_LAN_INTERFACE_H_
+#define _ETH_LAN_INTERFACE_H_
+#include <linux/netlink.h>
+#include <linux/rtnetlink.h>
+void bringup_ethernet_interface(struct nlmsghdr *nlh);
+void teardown_ethernet_interface(struct nlmsghdr *nlh);
