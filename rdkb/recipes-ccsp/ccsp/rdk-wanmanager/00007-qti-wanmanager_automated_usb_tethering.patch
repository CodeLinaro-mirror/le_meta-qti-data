diff --git a/source/WanManager/usb_tether_interface.c b/source/WanManager/usb_tether_interface.c
new file mode 100644
index 0000000..b20003a
--- /dev/null
+++ b/source/WanManager/usb_tether_interface.c
@@ -0,0 +1,115 @@
+/*Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+*SPDX-License-Identifier: BSD-3-Clause-Clear
+*/
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include "usb_tether_interface.h"
+
+/* Get the USB tether interface (rndis0/ecm0) */
+int check_usb_interface(char *command, char *result)
+{
+    FILE *fp = NULL;
+    char output[128];
+    char *pos = NULL, *retval = NULL;
+    if((NULL == command) || (NULL == result))
+    {
+        fprintf(stderr, "[%s:%d] param NULL \n", __FUNCTION__,__LINE__);
+        return -1;
+    }
+    memset(output,0,sizeof(output));
+    fp = popen(command, "r");
+    if(NULL == fp)
+    {
+        fprintf(stderr, "[%s:%d] popen failed \n", __FUNCTION__,__LINE__);
+        return -1;
+    }
+    retval = fgets(output, sizeof(output)-1, fp);
+    pclose(fp);
+    if (NULL == retval)
+    {
+        return -1;
+    }
+    if (NULL != (pos=strchr(output, '\n')) )
+    {
+        *pos = '\0';
+    }
+    strlcpy(result,output,strlen(output)+1);
+    return 0;
+}
+
+/* Add USB tether interface to bridge and assign default ip */
+void bringup_usb_tether_interface()
+{
+    int ret = -1;
+    char rndis_iface[10];
+    char ecm_iface[10];
+
+    memset(rndis_iface, 0, sizeof(rndis_iface));
+    memset(ecm_iface, 0, sizeof(ecm_iface));
+
+    ret = check_usb_interface(" ifconfig -a |grep rndis0 |awk '{print $1}' ",rndis_iface);
+    if (0 != ret)
+    {
+        fprintf(stderr, "[%s:%d] check_usb_interface fails for rndis0\n", __FUNCTION__,__LINE__);
+    }
+    ret = check_usb_interface(" ifconfig -a |grep ecm0 |awk '{print $1}' ",ecm_iface);
+    if (0 != ret)
+    {
+        fprintf(stderr, "[%s:%d] check_usb_interface fails for ecm0\n", __FUNCTION__,__LINE__);
+    }
+
+    if ((strlen(rndis_iface) == 0) && (strlen(ecm_iface) == 0))
+    {
+        fprintf(stderr, "[%s:%d] not usb tethering interface\n", __FUNCTION__,__LINE__);
+        return;
+    }
+
+    if (strlen(rndis_iface) != 0)
+     {
+        system("brctl addif brlan0 rndis0");
+        system("ifconfig rndis0 169.254.1.30");
+    }
+
+    if (strlen(ecm_iface) != 0)
+    {
+        system("brctl addif brlan0 ecm0");
+        system("ifconfig ecm0 169.254.1.40");
+    }
+}
+
+/* Remove USB tether interface */
+void teardown_usb_tether_interface()
+{
+    int ret = -1;
+    char rndis_iface[10];
+    char ecm_iface[10];
+    memset(rndis_iface, 0, sizeof(rndis_iface));
+    memset(ecm_iface, 0, sizeof(ecm_iface));
+    ret = check_usb_interface(" ifconfig |grep rndis0 |awk '{print $1}' ",rndis_iface);
+    if (0 != ret)
+    {
+        fprintf(stderr, "[%s:%d] check_usb_interface fails for rndis0\n", __FUNCTION__,__LINE__);
+    }
+    ret = check_usb_interface(" ifconfig |grep ecm0 |awk '{print $1}' ",ecm_iface);
+    if (0 != ret)
+    {
+        fprintf(stderr, "[%s:%d]  check_usb_interface fails for ecm0\n", __FUNCTION__,__LINE__);
+    }
+
+    if ((strlen(rndis_iface) == 0) && (strlen(ecm_iface) == 0))
+    {
+        fprintf(stderr, "[%s:%d] not usb tethering interface\n", __FUNCTION__,__LINE__);
+        return;
+    }
+
+    if (strlen(rndis_iface) != 0)
+    {
+        system("ip link set rndis0 down");
+    }
+
+    if (strlen(ecm_iface) != 0)
+    {
+        system("ip link set ecm0 down");
+    }
+}
