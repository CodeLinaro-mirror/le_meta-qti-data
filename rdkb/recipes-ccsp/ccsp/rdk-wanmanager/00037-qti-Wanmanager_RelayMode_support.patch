 #include "wanmgr_utils.h"
 #endif
 #include "wanmgr_telemetry.h"
 
 extern WANMGR_DATA_ST gWanMgrDataBase;
+/***********************************************************************
+ Function to check whether a process is running
+***********************************************************************/
+BOOL IsProcessRunning(const char* process_name)
+{
+    char command[256] = {0};
+    FILE *fp = NULL;
+    BOOL process_running = FALSE;
+
+    if (process_name == NULL)
+    {
+        CcspTraceError(("%s %d NULL process name\n", __FUNCTION__, __LINE__));
+        return FALSE;
+    }
+
+    snprintf(command, sizeof(command), "pgrep -f %s", process_name);
+    fp = popen(command, "r");
+    if (fp != NULL)
+    {
+        process_running = (fgetc(fp) != EOF);
+        pclose(fp);
+        fp = NULL;
+    }
+    else
+    {
+        CcspTraceError(("%s %d Failed to execute command: %s\n", __FUNCTION__, __LINE__, command));
+    }
+
+    return process_running;
+}
 /***********************************************************************
 
  APIs for Object:
@@ -1548,6 +1580,12 @@ BOOL WanVirtualIf_GetParamBoolValue(ANSC_HANDLE hInsContext, char* ParamName, BO
             *pBool = p_VirtIf->VLAN.Reset;
             ret = TRUE;
         }
+        if (strcmp(ParamName, "X_QCOM_RelayModeEnable") == 0)
+        {
+            //This DM is used for Switching between Relay and Router mode.
+            *pBool = p_VirtIf->RelayModeEnable;
+            ret = TRUE;
+        }
         WanMgr_VirtualIfaceData_release(p_VirtIf);
     }
 
@@ -1581,6 +1619,9 @@ BOOL WanVirtualIf_GetParamBoolValue(ANSC_HANDLE hInsContext, char* ParamName, BO
 BOOL WanVirtualIf_SetParamBoolValue(ANSC_HANDLE hInsContext, char* ParamName, BOOL bValue)
 {
     BOOL ret = FALSE;
+    char ifname[16] = {0};
+    FILE *fp = NULL;
+    int valid_ifname = 0;
 
     DML_VIRTUAL_IFACE* p_VirtIf = WanMgr_getVirtualIface_locked(((DML_VIRTUAL_IFACE*) hInsContext)->baseIfIdx, ((DML_VIRTUAL_IFACE*) hInsContext)->VirIfIdx);
     if(p_VirtIf != NULL)
@@ -1645,6 +1686,68 @@ BOOL WanVirtualIf_SetParamBoolValue(ANSC_HANDLE hInsContext, char* ParamName, BO
             p_VirtIf->VLAN.Reset = bValue;
             ret = TRUE;
         }
+        sysevent_get(sysevent_fd, sysevent_token, "current_wan_ifname", ifname, sizeof(ifname));
+        if (ifname[0] != '\0' && strlen(ifname) < sizeof(ifname) - 1)
+        {
+            valid_ifname = 1;
+            for (int i = 0; ifname[i] != '\0'; i++)
+            {
+                if (!isalnum(ifname[i]) && ifname[i] != '_' && ifname[i] != '.')
+                {
+                    valid_ifname = 0;
+                    break;
+                }
+            }
+        }
+        if ((strcmp(ParamName, "X_QCOM_RelayModeEnable") == 0) && (strstr(ifname,"eth1") != NULL))
+        {
+            if (bValue == TRUE)
+            {
+               if(!IsProcessRunning("6brd") && valid_ifname)
+               {
+                   int status = v_secure_system("6brd -f !%s ~brlan0 &",ifname);
+                   if ( status == -1 )
+                       CcspTraceInfo(("%s %d v_secure_system failed \n", __FUNCTION__, __LINE__));
+               }
+               else
+               {
+                   CcspTraceInfo(("%s %d 6brd is already running \n", __FUNCTION__, __LINE__));
+               }
+               if(IsProcessRunning("zebra"))
+               {
+                   int process_killed = v_secure_system("killall zebra");
+                   if (process_killed == -1)
+                       CcspTraceError(("%s %d v_secure_system failed to kill zebra\n", __FUNCTION__, __LINE__));
+               }
+               v_secure_system("sysevent set relay_mode_enable true");
+               p_VirtIf->RelayModeEnable = bValue;
+               ret = TRUE;
+            }
+            else if (bValue == FALSE)
+            {
+               if(!IsProcessRunning("zebra") && valid_ifname)
+               {
+                   int status = v_secure_system("sysevent set zebra-restart");
+                   if ( status == -1 )
+                       CcspTraceInfo(("%s %d v_secure_system failed \n", __FUNCTION__, __LINE__));
+               }
+               else
+               {
+                   CcspTraceInfo(("%s %d zebra is already running \n", __FUNCTION__, __LINE__));
+               }
+               if(IsProcessRunning("6brd"))
+               {
+                   int process_killed = v_secure_system("killall 6brd");
+                   if (process_killed == -1)
+                       CcspTraceError(("%s %d v_secure_system failed to kill 6brd\n", __FUNCTION__, __LINE__));
+               }
+               v_secure_system("sysevent set relay_mode_enable false");
+               p_VirtIf->RelayModeEnable = bValue;
+               ret = TRUE;
+            }
+            else
+               ret = FALSE;
+        }
         WanMgr_VirtualIfaceData_release(p_VirtIf);
     }
 
