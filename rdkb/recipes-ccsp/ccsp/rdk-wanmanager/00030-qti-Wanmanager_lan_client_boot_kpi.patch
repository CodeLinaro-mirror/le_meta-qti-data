     char addr[BUFLEN_256] = {0};
     char interface_name[BFR_SIZE] = {0};
     char mac_address[BFR_SIZE] = {0};
-
+    char if_name[80]={0};
+    kpi_if_type_t if_type = 0;
     ndm = NLMSG_DATA(nlmsg);
 
     /* Neighbor messages: parse NDA attributes */
@@ -1348,6 +1429,23 @@ void handle_netlink_ipneigh_new(struct nlmsghdr *nlmsg, int len)
         DBG_MONITOR_PRINT("RTM_NEWNEIGH len %d ip %s %d family %d IF (%u) \n",
                           len, addr, nlmsg->nlmsg_type,
                           ndm->ndm_family, ndm->ndm_ifindex);
+        get_interface_details(if_name, ndm->ndm_ifindex);
+        if(strlen(if_name) !=0 ) {
+            if ((strstr(if_name,"brlan") != NULL) || (strstr(if_name,"eth") != NULL)) {
+                 if_type = KPI_ETH_CLIENT;
+            }
+            else if ((strstr(if_name,"ath") != NULL) || (strstr(if_name,"mld") != NULL)) {
+                 if_type = KPI_WIFI_CLIENT ;
+            }
+            else if (strstr(if_name,"rndis") != NULL) {
+                 if_type = KPI_USB_CLIENT ;
+            }
+            else {
+                 if_type = KPI_UNKNOWN_CLIENT ;
+            }
+        }
+        if (if_type != KPI_UNKNOWN_CLIENT)
+            set_boot_kpi(if_type, AF_INET);
 
         if (true == isIPALanStatEnable())
         {
@@ -1381,9 +1479,25 @@ void handle_netlink_ip6neigh_new(struct nlmsghdr *nlmsg, int len)
     struct rtattr *tb[NDA_MAX + 1] = {NULL};
     char addr[BUFLEN_256] = {0};
     int ret = -1;
+    char if_name[80]={0};
+    kpi_if_type_t if_type = 0;
 
     ndm = NLMSG_DATA(nlmsg);
-
+    get_interface_details(if_name, ndm->ndm_ifindex);
+    if(strlen(if_name) !=0 ) {
+       if ((strstr(if_name,"brlan") != NULL) || (strstr(if_name,"eth") != NULL)) {
+            if_type = KPI_ETH_CLIENT;
+       }
+       else if ((strstr(if_name,"ath") != NULL) || (strstr(if_name,"mld") != NULL)) {
+            if_type = KPI_WIFI_CLIENT ;
+       }
+       else if (strstr(if_name,"rndis") != NULL) {
+            if_type = KPI_USB_CLIENT ;
+       }
+       else {
+            if_type = KPI_UNKNOWN_CLIENT ;
+       }
+    }
     /* Parse attributes and extract fields of interest. */
     parse_rtattr_pd(tb, NDA_MAX, NDA_RTA(ndm), len);
 
@@ -1479,6 +1593,8 @@ void handle_netlink_ip6neigh_new(struct nlmsghdr *nlmsg, int len)
                 fp = NULL;
             }
         }
+        if (if_type != KPI_UNKNOWN_CLIENT)
+            set_boot_kpi(if_type, AF_INET6);
         ret = v_secure_system("echo %s >> /tmp/ipv6_neighbor.txt", addr);
         if (ret == 0) {
             ipv6_clients_count++;
@@ -1683,7 +1799,7 @@ void handle_pd_neigh_event(struct nlmsghdr *nl_msgHdr)
         }
     }
 
-    if ((strcmp(pd_enable, "1") == 0) || (isIPALanStatEnable() == true))
+    if ((strcmp(pd_enable, "1") == 0) || (log_kpi_first_eth_local_ipv4) || (log_kpi_first_eth_local_ipv6) || (log_kpi_first_wlan_local_ipv4) || (log_kpi_first_wlan_local_ipv6) || (log_kpi_first_usb_local_ipv4) || (log_kpi_first_usb_local_ipv6) || (isIPALanStatEnable() == true))
     {
         len = nl_msgHdr->nlmsg_len - NLMSG_LENGTH(sizeof(struct ndmsg));
         if (len < 0)
