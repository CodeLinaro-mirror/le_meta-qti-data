+/* Resolve the bridge port for the MAC carried by this neighbor event. */
+static int get_interface_details(char *if_name, size_t if_name_size,
+                                 const struct rtattr *lladdr)
+{
+    const unsigned char *mac = NULL;
+    char mac_address[18] = {0};
     FILE *fp = NULL;
-    snprintf(cmd ,sizeof(cmd), "bridge fdb show | grep -m 1 -v permanent | grep -i 'master brlan0' | awk '{print$3}'");
-    fp=popen(cmd,"r");
-    if (fp == NULL)
+    int ret = -1;
+
+    if ((if_name == NULL) || (if_name_size == 0) || (lladdr == NULL) ||
+        (RTA_PAYLOAD(lladdr) < ETH_ALEN))
     {
         return -1;
     }
-    if (NULL != fgets(cmd2,100,fp))
+
+    mac = RTA_DATA(lladdr);
+    snprintf(mac_address, sizeof(mac_address),
+             "%02x:%02x:%02x:%02x:%02x:%02x", mac[0], mac[1], mac[2],
+             mac[3], mac[4], mac[5]);
+
+    fp = popen("bridge fdb show", "r");
+    if (fp == NULL)
     {
-        strlcpy(if_name,cmd2,sizeof(cmd2));
+        return -1;
     }
+
+    ret = find_interface_in_fdb(fp, mac_address, LAN_BRIDGE_NAME,
+                                if_name, if_name_size);
     pclose(fp);
-    fp = NULL;
-    return 0;
+    return ret;
+}
+
+static kpi_if_type_t get_kpi_interface_type(const char *if_name)
+{
+    if ((if_name == NULL) || (if_name[0] == '\0'))
+    {
+        return KPI_UNKNOWN_CLIENT;
+    }
+
+    if ((strstr(if_name, "brlan") != NULL) ||
+        (strstr(if_name, "eth") != NULL))
+    {
+        return KPI_ETH_CLIENT;
+    }
+    if ((strstr(if_name, "ath") != NULL) ||
+        (strstr(if_name, "mld") != NULL))
+    {
+        return KPI_WIFI_CLIENT;
+    }
+    if (strstr(if_name, "rndis") != NULL)
+    {
+        return KPI_USB_CLIENT;
+    }
+
+    return KPI_UNKNOWN_CLIENT;
+}
+void set_boot_kpi(kpi_if_type_t if_type, uint16_t address_family)
+{
+     int ret = 0;
+
+     switch (if_type)
+     {
+        case KPI_ETH_CLIENT:
+             if((address_family == AF_INET) && (log_kpi_first_eth_local_ipv4)) {
+                ret = v_secure_system("echo -n M - ETH Local IPV4 Assignment > /sys/kernel/boot_kpi/kpi_values ");
+                if (ret) {
+                    DBG_MONITOR_PRINT(" M - ETH Local IPV4 Assignment command execution failed ");
+                    return;
+                }
+                log_kpi_first_eth_local_ipv4 = false;
+             }
+             if((address_family == AF_INET6) && (log_kpi_first_eth_local_ipv6 )) {
+                ret = v_secure_system("echo -n M - ETH Local IPV6 Assignment > /sys/kernel/boot_kpi/kpi_values ");
+                if (ret) {
+                    DBG_MONITOR_PRINT(" M - ETH Local IPV6 Assignment command  execution failed ");
+                    return;
+                }
+                log_kpi_first_eth_local_ipv6 = false;
+             }
+        break;
+
+        case KPI_WIFI_CLIENT:
+             if((address_family == AF_INET) && (log_kpi_first_wlan_local_ipv4)) {
+                ret = v_secure_system("echo -n M - WLAN Local IPV4 Assignment  > /sys/kernel/boot_kpi/kpi_values");
+                if (ret) {
+                    DBG_MONITOR_PRINT("M - WLAN Local IPV4 Assignment command execution failed ");
+                    return;
+                }
+                log_kpi_first_wlan_local_ipv4 = false;
+             }
+             if((address_family == AF_INET6) && (log_kpi_first_wlan_local_ipv6)) {
+                ret = v_secure_system("echo -n M - WLAN Local IPV6 Assignment > /sys/kernel/boot_kpi/kpi_values");
+                if (ret) {
+                    DBG_MONITOR_PRINT("M - WLAN Local IPV6 Assignment command execution failed ");
+                    return;
+                }
+                log_kpi_first_wlan_local_ipv6= false;
+             }
+        break;
+
+        case KPI_USB_CLIENT:
+             if((address_family == AF_INET) && (log_kpi_first_usb_local_ipv4 )) {
+                ret = v_secure_system("echo -n M - USB Local IPV4 Assignment > /sys/kernel/boot_kpi/kpi_values");
+                if (ret) {
+                    DBG_MONITOR_PRINT("'M - USB Local IPV4 Assignment command execution failed ");
+                    return;
+                }
+                log_kpi_first_usb_local_ipv4 = false;
+             }
+             if((address_family == AF_INET6) && (log_kpi_first_usb_local_ipv6)) {
+                ret = v_secure_system("echo -n M - USB Local IPV6 Assignment > /sys/kernel/boot_kpi/kpi_values");
+                if (ret) {
+                    DBG_MONITOR_PRINT(" M - USB Local IPV6 Assignment command execution failed ");
+                    return;
+                }
+                log_kpi_first_usb_local_ipv6 = false;
+             }
+        break;
+        default:
+            break;
+     }
 }
