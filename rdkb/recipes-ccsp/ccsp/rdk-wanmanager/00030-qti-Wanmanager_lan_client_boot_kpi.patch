-/*
-  * To get interface details from bridge fdb show
-  * update in if_name
-  */
-int get_interface_details(char *if_name , uint if_index)
+static int find_interface_in_fdb(FILE *fdb_stream, const char *mac_address,
+                                 const char *bridge_name, char *if_name,
+                                 size_t if_name_size)
 {
-    char cmd[BUFSIZE]= {0};
-    char cmd2[BUFSIZE]={0};
+    char line[FDB_LINE_SIZE] = {0};
+
+    if ((fdb_stream == NULL) || (mac_address == NULL) ||
+        (bridge_name == NULL) || (if_name == NULL) ||
+        (if_name_size == 0))
+    {
+        return -1;
+    }
+
+    if_name[0] = '\0';
+
+    while (fgets(line, sizeof(line), fdb_stream) != NULL)
+    {
+        char *saveptr = NULL;
+        char *token = NULL;
+        char *entry_mac = NULL;
+        char *entry_interface = NULL;
+        char *entry_bridge = NULL;
+        int permanent = 0;
+
+        token = strtok_r(line, " \t\r\n", &saveptr);
+        if (token == NULL)
+        {
+            continue;
+        }
+        entry_mac = token;
+
+        while ((token = strtok_r(NULL, " \t\r\n", &saveptr)) != NULL)
+        {
+            if (strcasecmp(token, "permanent") == 0)
+            {
+                permanent = 1;
+            }
+            else if (strcmp(token, "dev") == 0)
+            {
+                entry_interface = strtok_r(NULL, " \t\r\n", &saveptr);
+            }
+            else if (strcmp(token, "master") == 0)
+            {
+                entry_bridge = strtok_r(NULL, " \t\r\n", &saveptr);
+            }
+        }
+
+        if (!permanent && (entry_interface != NULL) &&
+            (entry_bridge != NULL) &&
+            (strcasecmp(entry_mac, mac_address) == 0) &&
+            (strcasecmp(entry_bridge, bridge_name) == 0))
+        {
+            snprintf(if_name, if_name_size, "%s", entry_interface);
+            return 0;
+        }
+    }
+
+    return -1;
+}
