Index: git/source/WanManager/wanmgr_network_monitor_extn_qti.c
===================================================================
--- /dev/null
+++ git/source/WanManager/wanmgr_network_monitor_extn_qti.c
@@ -0,0 +1,244 @@
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+#include <linux/rtnetlink.h>
+#include <linux/neighbour.h>
+#include "wanmgr_network_monitor_extn_qti.h"
+#include "ansc_platform.h"
+#include "ccsp_trace.h"
+#include "secure_wrapper.h"
+#include "syscfg/syscfg.h"
+
+#define BUFLEN_8   8
+#define BUFLEN_256 256
+
+#ifndef DBG_MONITOR_PRINT
+#define DBG_MONITOR_PRINT(fmt, args...)  CcspTraceInfo((fmt, ##args))
+#endif
+
+static uint ipv6_clients_count = 0;
+
+/*
+ * parse_rtattr_pd - parse netlink attributes for neighbor messages.
+ * Local copy since parse_rtattr in wanmgr_network_monitor.c is static.
+ */
+static void parse_rtattr_pd(struct rtattr *tb[], int max,
+                             struct rtattr *rta, int len)
+{
+    memset(tb, 0, sizeof(struct rtattr *) * (max + 1));
+    while (RTA_OK(rta, len)) {
+        if (rta->rta_type <= max)
+            tb[rta->rta_type] = rta;
+        rta = RTA_NEXT(rta, len);
+    }
+}
+
+/*
+ * ipv6 clients connected link local address taking and
+ * saving in file /tmp/ipv6_neighbor.txt for PD , it will use in zebra
+ */
+static void handle_netlink_ip6neigh_new(struct nlmsghdr *nlmsg, int len)
+{
+    struct ndmsg *ndm = NULL;
+    struct rtattr *tb[NDA_MAX + 1] = {NULL};
+    char addr[BUFLEN_256] = {0};
+    int ret = -1;
+
+    ndm = NLMSG_DATA(nlmsg);
+
+    /* Parse attributes and extract fields of interest. */
+    parse_rtattr_pd(tb, NDA_MAX, NDA_RTA(ndm), len);
+
+    if (!tb[NDA_DST])
+        return;
+
+    inet_ntop(AF_INET6, RTA_DATA(tb[NDA_DST]), addr, INET6_ADDRSTRLEN);
+    DBG_MONITOR_PRINT("RTM_NEWNEIGH len %d ip %s %d family %d IF (%u) \n",
+                   len, addr, nlmsg->nlmsg_type, ndm->ndm_family,
+                   ndm->ndm_ifindex);
+
+    if (strncasecmp(addr, "fe80", 4) == 0) { /* only LLA storing */
+        if (ipv6_clients_count > 0) {
+            FILE *fp = NULL;
+
+            fp = fopen(IPV6_NEI_FILE, "r");
+            if (fp == NULL) {
+                DBG_MONITOR_PRINT("%s : unable to open file %s\n",
+                                  __FUNCTION__, IPV6_NEI_FILE);
+                return;
+            }
+
+            if (fp != NULL) {
+                ssize_t nread;
+                size_t len = 0;
+                char *line = NULL;
+
+                while ((nread = getline(&line, &len, fp)) != -1) {
+                    if (strstr(line, addr)) {
+                        DBG_MONITOR_PRINT("addr %s already in file \n ",
+                                          addr);
+                        if (line) {
+                            free(line);
+                            line = NULL;
+                        }
+                        fclose(fp);
+                        fp = NULL;
+                        return;
+                    }
+                }
+                if (line) {
+                    free(line);
+                    line = NULL;
+                }
+                fclose(fp);
+                fp = NULL;
+            }
+        }
+        ret = v_secure_system("echo %s >> /tmp/ipv6_neighbor.txt", addr);
+        if (ret == 0) {
+            ipv6_clients_count++;
+            DBG_MONITOR_PRINT(" %s addr writing into the file,"
+                              "No.of ipv6_clients %u \n",
+                              addr, ipv6_clients_count);
+        }
+        else {
+            DBG_MONITOR_PRINT("Failure in executing command ret:[%d] \n",
+                              ret);
+        }
+    }
+    return;
+}
+
+/*
+ * ipv6 clients disconneted link local address taking and
+ * removing from file /tmp/ipv6_neighbor.txt for PD , it will use in zebra
+ */
+static void handle_netlink_ip6neigh_del(struct nlmsghdr *nlmsg, int len)
+{
+    struct ndmsg *ndm = NULL;
+    struct rtattr *tb[NDA_MAX + 1] = {NULL};
+    char addr[BUFLEN_256] = {0};
+
+    ndm = NLMSG_DATA(nlmsg);
+
+    /* Parse attributes and extract fields of interest. */
+    parse_rtattr_pd(tb, NDA_MAX, NDA_RTA(ndm), len);
+
+    if (!tb[NDA_DST])
+        return;
+
+    inet_ntop(AF_INET6, RTA_DATA(tb[NDA_DST]), addr, INET6_ADDRSTRLEN);
+    DBG_MONITOR_PRINT("RTM_DELNEIGH len %d ip %s %d family %d IF (%u) \n",
+                   len, addr, nlmsg->nlmsg_type, ndm->ndm_family,
+                   ndm->ndm_ifindex);
+
+    if (strncasecmp(addr, "fe80", 4) == 0) { /* only LLA */
+
+        FILE *orig_fp = NULL, *tmp_fp = NULL;
+
+        orig_fp = fopen(IPV6_NEI_FILE, "r");
+        tmp_fp = fopen(IPV6_NEI_TMPFILE, "w");
+
+        if (orig_fp == NULL) {
+            if (tmp_fp) {
+                fclose(tmp_fp);
+                tmp_fp = NULL;
+            }
+            DBG_MONITOR_PRINT("%s : unable to open file %s \n",
+                              __FUNCTION__, IPV6_NEI_FILE);
+            return;
+        }
+        if (tmp_fp == NULL) {
+            DBG_MONITOR_PRINT("%s : unable to open file %s \n",
+                              __FUNCTION__, IPV6_NEI_TMPFILE);
+            fclose(orig_fp);
+            orig_fp = NULL;
+            return;
+        }
+
+        if (orig_fp != NULL) {
+            ssize_t nread;
+            size_t len = 0;
+            char *line = NULL;
+
+            while ((nread = getline(&line, &len, orig_fp)) != -1) {
+                if (strstr(line, addr)) {
+                    if (ipv6_clients_count > 0) {
+                        ipv6_clients_count--;
+                    }
+                    DBG_MONITOR_PRINT("addr %s removing from file, "
+                                      "No.of ipv6_clients %u \n",
+                                      addr, ipv6_clients_count);
+                    continue;
+                }
+                fwrite(line, nread, 1, tmp_fp);
+            }
+
+            if (line) {
+                free(line);
+                line = NULL;
+            }
+            fclose(orig_fp);
+            orig_fp = NULL;
+        }
+        fclose(tmp_fp);
+        tmp_fp = NULL;
+        if (rename(IPV6_NEI_TMPFILE, IPV6_NEI_FILE) != 0) {
+            DBG_MONITOR_PRINT("%s: rename failed: %s\n",
+                              __FUNCTION__, strerror(errno));
+            unlink(IPV6_NEI_TMPFILE);
+        }
+    }
+    return;
+}
+
+/*
+ * handle_pd_neigh_event - Entry point called from
+ * NetMonitor_ProcessNetlinkRouteMonitorFd() for
+ * RTM_NEWNEIGH and RTM_DELNEIGH events.
+ */
+void handle_pd_neigh_event(struct nlmsghdr *nl_msgHdr)
+{
+    struct ndmsg *ndm = NULL;
+    int len = 0;
+    char pd_enable[BUFLEN_8] = {0};
+
+    memset(pd_enable, 0, sizeof(pd_enable));
+    syscfg_get(NULL, "PD_enable", pd_enable, sizeof(pd_enable));
+    if (strcmp(pd_enable, "1") == 0)
+    {
+        len = nl_msgHdr->nlmsg_len - NLMSG_LENGTH(sizeof(struct ndmsg));
+        if (len < 0)
+            return;
+        ndm = NLMSG_DATA(nl_msgHdr);
+        if (ndm->ndm_family != AF_INET6) /* only requires IPV6 neighbor */
+            return;
+
+        DBG_MONITOR_PRINT(" %s Received event on 0x%x NEIGH and state 0x%x\n",
+                               __FUNCTION__, nl_msgHdr->nlmsg_type,
+                               ndm->ndm_state);
+        if ((nl_msgHdr->nlmsg_type == RTM_NEWNEIGH) &&
+            (ndm->ndm_state == NUD_REACHABLE)) {
+            handle_netlink_ip6neigh_new(nl_msgHdr, len);
+        }
+        /* Kernel may not send RTM_DELNEIGH for aged-out neighbours.
+         * Treat NUD_FAILED / NUD_STALE transitions as implicit deletes. */
+        if ((nl_msgHdr->nlmsg_type == RTM_NEWNEIGH) &&
+                    (ndm->ndm_state & (NUD_FAILED | NUD_STALE))) {
+            handle_netlink_ip6neigh_del(nl_msgHdr, len);
+        }
+        if (nl_msgHdr->nlmsg_type == RTM_DELNEIGH)
+        {
+            handle_netlink_ip6neigh_del(nl_msgHdr, len);
+        }
+    }
+    return;
+}
