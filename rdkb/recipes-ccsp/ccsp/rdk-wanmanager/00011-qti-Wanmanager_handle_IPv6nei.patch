===================================================================
--- /dev/null
+++ git/source/WanManager/wanmgr_network_monitor_extn_qti.h
@@ -0,0 +1,26 @@
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ */
+
+#ifndef _WANMGR_NETWORK_MONITOR_EXTN_QTI_H_
+#define _WANMGR_NETWORK_MONITOR_EXTN_QTI_H_
+
+#include <linux/rtnetlink.h>
+#include <linux/neighbour.h>
+
+#ifndef NDA_RTA
+#define NDA_RTA(r) \
+    ((struct rtattr *)(((char *)(r)) + NLMSG_ALIGN(sizeof(struct ndmsg))))
+#endif
+
+#define IPV6_NEI_FILE    "/tmp/ipv6_neighbor.txt"
+#define IPV6_NEI_TMPFILE "/tmp/ipv6_neighbor_temp.txt"
+
+/*
+ * Handle IPv6 neighbor events for PD feature.
+ * Called from NetMonitor_ProcessNetlinkRouteMonitorFd()
+ */
+void handle_pd_neigh_event(struct nlmsghdr *nl_msgHdr);
+
+#endif /* _WANMGR_NETWORK_MONITOR_EXTN_QTI_H_ */
