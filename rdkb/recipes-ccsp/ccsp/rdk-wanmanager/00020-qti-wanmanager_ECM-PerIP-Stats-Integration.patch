From: ECM Integration <ecm@qti.qualcomm.com>
Date: Sun, 27 jul 2026 00:00:00 +0000
Subject: [PATCH] Add ECM packet statistics integration to WAN Manager

[Description]: Integrates ECM (Embedded Client Manager) with packet statistics
framework across all phases. Handles backhaul type detection, ECM registration,
per-IP stats collection, and cleanup operations. All ECM logic lives in
wanmgr_network_monitor_extn_qti.c/.h.

[RCA]: Packet statistics framework needed ECM integration for hardware acceleration
across all lifecycle phases.

Signed-off-by: talekhya <talekhya@qti.qualcomm.com>
---

--- git.orig/source/WanManager/wanmgr_network_monitor_extn_qti.h
+++ git/source/WanManager/wanmgr_network_monitor_extn_qti.h
@@ -28,4 +28,21 @@
 void handle_netlink_ipneigh_del(struct nlmsghdr *nlmsg, int len);
 void createStatsChain(void);
 bool isIPALanStatEnable(void);
+
+typedef enum {
+    BACKHAUL_TYPE_UNKNOWN = 0,
+    BACKHAUL_TYPE_WWAN = 1,
+    BACKHAUL_TYPE_ETHERNET = 2,
+    BACKHAUL_TYPE_USB = 3,
+    BACKHAUL_TYPE_WLAN = 4,
+    BACKHAUL_TYPE_PPP = 5,
+} backhaul_type_t;
+
+backhaul_type_t getBackhaulType(void);
+void registerECMBackhaulType(backhaul_type_t bh_type);
+void ECM_RegisterIPv4Prefix(void);
+void ECM_RegisterIPv6Prefix(const char *site_prefix);
+void resetECMStats(void);
+void unregisterECMBackhaulType(void);
+
 #endif /* _WANMGR_NETWORK_MONITOR_EXTN_QTI_H_ */
--- git.orig/source/WanManager/wanmgr_network_monitor_extn_qti.c
+++ git/source/WanManager/wanmgr_network_monitor_extn_qti.c
@@ -39,6 +39,7 @@
 #ifndef DBG_MONITOR_PRINT
 #define DBG_MONITOR_PRINT(fmt, args...)  CcspTraceInfo((fmt, ##args))
 #endif
+#define ECM_SYSFS_PATH "/proc/sys/net/ecm/ecm_sdx_stats"
 extern uint ipv4_stat_client;
 extern uint ipv6_stat_client;
 extern int sysevent_nwm_fd;
@@ -62,6 +63,311 @@
 /* Forward declaration for the PacketStats helper in wanmgr_network_monitor.c */
 extern void delClientForStats(char *file, char *type, char *addr);
 
+static const char* backhaul_type_to_string(backhaul_type_t type)
+{
+    switch (type) {
+        case BACKHAUL_TYPE_WWAN:      return "wwan";
+        case BACKHAUL_TYPE_ETHERNET:  return "ethernet";
+        case BACKHAUL_TYPE_USB:       return "usb";
+        case BACKHAUL_TYPE_WLAN:      return "wlan";
+        case BACKHAUL_TYPE_PPP:       return "ppp";
+        default:                      return "unknown";
+    }
+}
+
+static backhaul_type_t getBackhaulTypeFromInterface(const char *ifname)
+{
+    if (!ifname || strlen(ifname) == 0)
+        return BACKHAUL_TYPE_UNKNOWN;
+    if (strstr(ifname, "qmapmux") != NULL) return BACKHAUL_TYPE_WWAN;
+    if (strstr(ifname, "eth")     != NULL) return BACKHAUL_TYPE_ETHERNET;
+    if (strstr(ifname, "usb")     != NULL) return BACKHAUL_TYPE_USB;
+    if (strstr(ifname, "wlan")    != NULL) return BACKHAUL_TYPE_WLAN;
+    if (strstr(ifname, "ppp")     != NULL) return BACKHAUL_TYPE_PPP;
+    return BACKHAUL_TYPE_UNKNOWN;
+}
+
+static ANSC_STATUS isECMModuleLoaded(void)
+{
+    FILE *fp = NULL;
+    char path[256] = {0};
+
+    snprintf(path, sizeof(path), "%s/interface_type", ECM_SYSFS_PATH);
+    fp = fopen(path, "r");
+    if (fp) {
+        fclose(fp);
+        DBG_MONITOR_PRINT("[%s:%d] ECM module is loaded\n", __FUNCTION__, __LINE__);
+        return ANSC_STATUS_SUCCESS;
+    }
+    DBG_MONITOR_PRINT("[%s:%d] ECM module is NOT loaded\n", __FUNCTION__, __LINE__);
+    return ANSC_STATUS_FAILURE;
+}
+
+backhaul_type_t getBackhaulType(void)
+{
+    char wan_ifname[64] = {0};
+
+    syscfg_get(NULL, "wan_physical_ifname", wan_ifname, sizeof(wan_ifname));
+    if (strlen(wan_ifname) == 0) {
+        DBG_MONITOR_PRINT("[%s:%d] Failed to get wan_physical_ifname from syscfg\n",
+                          __FUNCTION__, __LINE__);
+        return BACKHAUL_TYPE_UNKNOWN;
+    }
+    backhaul_type_t type = getBackhaulTypeFromInterface(wan_ifname);
+    if (type == BACKHAUL_TYPE_UNKNOWN) {
+        DBG_MONITOR_PRINT("[%s:%d] Unable to determine backhaul type from interface %s\n",
+                          __FUNCTION__, __LINE__, wan_ifname);
+        return BACKHAUL_TYPE_UNKNOWN;
+    }
+    DBG_MONITOR_PRINT("[%s:%d] Detected backhaul type: %s (ifname=%s)\n",
+                      __FUNCTION__, __LINE__, backhaul_type_to_string(type), wan_ifname);
+    return type;
+}
+
+void registerECMBackhaulType(backhaul_type_t bh_type)
+{
+    int ret = 0;
+    char _ecm_path[256];
+
+    if (bh_type != BACKHAUL_TYPE_WWAN && bh_type != BACKHAUL_TYPE_ETHERNET) {
+        DBG_MONITOR_PRINT("[%s:%d] Backhaul type %s - skipping ECM registration\n",
+                          __FUNCTION__, __LINE__, backhaul_type_to_string(bh_type));
+        return;
+    }
+    if (ANSC_STATUS_SUCCESS != isECMModuleLoaded()) {
+        DBG_MONITOR_PRINT("[%s:%d] ECM module not loaded, cannot register backhaul type\n",
+                          __FUNCTION__, __LINE__);
+        return;
+    }
+    snprintf(_ecm_path, sizeof(_ecm_path), "%s/interface_type", ECM_SYSFS_PATH);
+    {
+        FILE *_fp = fopen(_ecm_path, "w");
+        ret = _fp ? (fprintf(_fp, "bh_type %s \n", backhaul_type_to_string(bh_type)) > 0 ? (fclose(_fp), 0) : (fclose(_fp), -1)) : -1;
+    }
+    if (ret != 0) {
+        DBG_MONITOR_PRINT("[%s:%d] Failed to register ECM backhaul type %s, ret=%d errno=%d (%s)\n",
+                          __FUNCTION__, __LINE__, backhaul_type_to_string(bh_type), ret, errno, strerror(errno));
+        return;
+    }
+    DBG_MONITOR_PRINT("[%s:%d] ECM: Registered %s backhaul type\n",
+                      __FUNCTION__, __LINE__, backhaul_type_to_string(bh_type));
+}
+
+static ANSC_STATUS registerECMLANPrefixes(void)
+{
+    char lan_ip[64] = {0};
+    char lan_netmask[64] = {0};
+    int ret = 0;
+    char _ecm_path[256];
+
+    if (ANSC_STATUS_SUCCESS != isECMModuleLoaded()) {
+        DBG_MONITOR_PRINT("[%s:%d] ECM module not loaded\n", __FUNCTION__, __LINE__);
+        return ANSC_STATUS_FAILURE;
+    }
+    syscfg_get(NULL, "lan_ipaddr", lan_ip, sizeof(lan_ip));
+    syscfg_get(NULL, "lan_netmask", lan_netmask, sizeof(lan_netmask));
+    if (strlen(lan_ip) > 0) {
+        snprintf(_ecm_path, sizeof(_ecm_path), "%s/lan_prefixes", ECM_SYSFS_PATH);
+        {
+            FILE *_fp = fopen(_ecm_path, "w");
+            ret = _fp ? (fprintf(_fp, "ipv4 %s %s \n", lan_ip, lan_netmask) > 0 ? (fclose(_fp), 0) : (fclose(_fp), -1)) : -1;
+        }
+        if (ret != 0) {
+            DBG_MONITOR_PRINT("[%s:%d] Failed to register IPv4 prefix, ret=%d\n",
+                              __FUNCTION__, __LINE__, ret);
+            return ANSC_STATUS_FAILURE;
+        }
+    }
+    DBG_MONITOR_PRINT("[%s:%d] ECM: Registered LAN prefixes\n", __FUNCTION__, __LINE__);
+    return ANSC_STATUS_SUCCESS;
+}
+
+void ECM_RegisterIPv4Prefix(void)
+{
+    char lan_ip[64] = {0};
+    char lan_netmask[64] = {0};
+    char _ecm_path[256];
+    int ret;
+
+    if (!isIPALanStatEnable()) return;
+    if (ANSC_STATUS_SUCCESS != isECMModuleLoaded()) return;
+    syscfg_get(NULL, "lan_ipaddr", lan_ip, sizeof(lan_ip));
+    syscfg_get(NULL, "lan_netmask", lan_netmask, sizeof(lan_netmask));
+    if (strlen(lan_ip) == 0) {
+        DBG_MONITOR_PRINT("[%s:%d] lan_ipaddr not available\n", __FUNCTION__, __LINE__);
+        return;
+    }
+    snprintf(_ecm_path, sizeof(_ecm_path), "%s/lan_prefixes", ECM_SYSFS_PATH);
+    {
+        FILE *_fp = fopen(_ecm_path, "w");
+        ret = _fp ? (fprintf(_fp, "ipv4 %s %s \n", lan_ip, lan_netmask) > 0 ?
+                     (fclose(_fp), 0) : (fclose(_fp), -1)) : -1;
+    }
+    DBG_MONITOR_PRINT("[%s:%d] ECM IPv4 LAN prefix %s/%s registration %s\n",
+                      __FUNCTION__, __LINE__, lan_ip, lan_netmask,
+                      ret == 0 ? "OK" : "FAILED");
+}
+
+void ECM_RegisterIPv6Prefix(const char *site_prefix)
+{
+    char _ecm_path[256];
+    int ret;
+
+    if (!isIPALanStatEnable()) return;
+    if (ANSC_STATUS_SUCCESS != isECMModuleLoaded()) return;
+    if (!site_prefix || strlen(site_prefix) == 0) {
+        DBG_MONITOR_PRINT("[%s:%d] IPv6 site prefix not available\n", __FUNCTION__, __LINE__);
+        return;
+    }
+    snprintf(_ecm_path, sizeof(_ecm_path), "%s/lan_prefixes", ECM_SYSFS_PATH);
+    {
+        FILE *_fp = fopen(_ecm_path, "w");
+        ret = _fp ? (fprintf(_fp, "ipv6 %s \n", site_prefix) > 0 ?
+                     (fclose(_fp), 0) : (fclose(_fp), -1)) : -1;
+    }
+    DBG_MONITOR_PRINT("[%s:%d] ECM IPv6 LAN prefix %s registration %s\n",
+                      __FUNCTION__, __LINE__, site_prefix,
+                      ret == 0 ? "OK" : "FAILED");
+}
+
+static ANSC_STATUS initializeECMForPacketStats(void)
+{
+    backhaul_type_t bh_type = getBackhaulType();
+    if (bh_type != BACKHAUL_TYPE_UNKNOWN)
+        registerECMBackhaulType(bh_type);
+    if (ANSC_STATUS_SUCCESS != registerECMLANPrefixes())
+        DBG_MONITOR_PRINT("[%s:%d] Failed to register ECM LAN prefixes\n",
+                          __FUNCTION__, __LINE__);
+    return ANSC_STATUS_SUCCESS;
+}
+
+static ANSC_STATUS queryECMClientStats(const char *ip_addr, uint64_t *tx_bytes, uint64_t *rx_bytes)
+{
+    char cmd[256] = {0};
+    char _ecm_path[256];
+    FILE *fp = NULL;
+    char buffer[256] = {0};
+    backhaul_type_t bh_type;
+    int ret = 0;
+
+    if (!ip_addr || strlen(ip_addr) == 0 || !tx_bytes || !rx_bytes) {
+        DBG_MONITOR_PRINT("[%s:%d] Invalid parameters\n", __FUNCTION__, __LINE__);
+        return ANSC_STATUS_FAILURE;
+    }
+    *tx_bytes = 0;
+    *rx_bytes = 0;
+    bh_type = getBackhaulType();
+    if (bh_type == BACKHAUL_TYPE_UNKNOWN || (bh_type != BACKHAUL_TYPE_WWAN && bh_type != BACKHAUL_TYPE_ETHERNET)) {
+        DBG_MONITOR_PRINT("[%s:%d] Backhaul type %s - skipping ECM query\n",
+                          __FUNCTION__, __LINE__, backhaul_type_to_string(bh_type));
+        return ANSC_STATUS_SUCCESS;
+    }
+    if (ANSC_STATUS_SUCCESS != isECMModuleLoaded()) {
+        DBG_MONITOR_PRINT("[%s:%d] ECM module not loaded\n", __FUNCTION__, __LINE__);
+        return ANSC_STATUS_SUCCESS;
+    }
+    snprintf(_ecm_path, sizeof(_ecm_path), "%s/per_ip_stats", ECM_SYSFS_PATH);
+    {
+        FILE *_fp = fopen(_ecm_path, "w");
+        ret = _fp ? (fprintf(_fp, "PER_IP_STATS %s \n", ip_addr) > 0 ? (fclose(_fp), 0) : (fclose(_fp), -1)) : -1;
+    }
+    if (ret != 0) {
+        DBG_MONITOR_PRINT("[%s:%d] Failed to query ECM stats for IP %s (write), ret=%d\n",
+                          __FUNCTION__, __LINE__, ip_addr, ret);
+        return ANSC_STATUS_SUCCESS;
+    }
+    snprintf(cmd, sizeof(cmd), "cat %s/per_ip_stats 2>/dev/null | grep -w %s",
+             ECM_SYSFS_PATH, ip_addr);
+    fp = popen(cmd, "r");
+    if (!fp) {
+        DBG_MONITOR_PRINT("[%s:%d] Failed to query ECM stats for IP %s (read)\n",
+                          __FUNCTION__, __LINE__, ip_addr);
+        return ANSC_STATUS_SUCCESS;
+    }
+    if (fgets(buffer, sizeof(buffer), fp))
+        sscanf(buffer, "%*s %*s rx_bytes=\"%lu\" tx_bytes=\"%lu\"", rx_bytes, tx_bytes);
+    pclose(fp);
+    return ANSC_STATUS_SUCCESS;
+}
+
+static ANSC_STATUS deleteECMClientIP(const char *ip_addr)
+{
+    int ret = 0;
+    char _ecm_path[256];
+    backhaul_type_t bh_type;
+
+    if (!ip_addr || strlen(ip_addr) == 0) {
+        DBG_MONITOR_PRINT("[%s:%d] Invalid IP address\n", __FUNCTION__, __LINE__);
+        return ANSC_STATUS_FAILURE;
+    }
+    bh_type = getBackhaulType();
+    if (bh_type == BACKHAUL_TYPE_UNKNOWN || (bh_type != BACKHAUL_TYPE_WWAN && bh_type != BACKHAUL_TYPE_ETHERNET)) {
+        DBG_MONITOR_PRINT("[%s:%d] Backhaul type %s - skipping ECM cleanup\n",
+                          __FUNCTION__, __LINE__, backhaul_type_to_string(bh_type));
+        return ANSC_STATUS_SUCCESS;
+    }
+    if (ANSC_STATUS_SUCCESS != isECMModuleLoaded()) {
+        DBG_MONITOR_PRINT("[%s:%d] ECM module not loaded\n", __FUNCTION__, __LINE__);
+        return ANSC_STATUS_SUCCESS;
+    }
+    snprintf(_ecm_path, sizeof(_ecm_path), "%s/per_ip_stats", ECM_SYSFS_PATH);
+    {
+        FILE *_fp = fopen(_ecm_path, "w");
+        ret = _fp ? (fprintf(_fp, "DELETE %s \n", ip_addr) > 0 ? (fclose(_fp), 0) : (fclose(_fp), -1)) : -1;
+    }
+    if (ret != 0) {
+        DBG_MONITOR_PRINT("[%s:%d] Failed to delete ECM client IP %s, ret=%d\n",
+                          __FUNCTION__, __LINE__, ip_addr, ret);
+        return ANSC_STATUS_FAILURE;
+    }
+    DBG_MONITOR_PRINT("[%s:%d] ECM: Deleted client IP %s\n", __FUNCTION__, __LINE__, ip_addr);
+    return ANSC_STATUS_SUCCESS;
+}
+
+void resetECMStats(void)
+{
+    int ret = 0;
+    char _ecm_path[256];
+
+    if (ANSC_STATUS_SUCCESS != isECMModuleLoaded()) {
+        DBG_MONITOR_PRINT("[%s:%d] ECM module not loaded\n", __FUNCTION__, __LINE__);
+        return;
+    }
+    snprintf(_ecm_path, sizeof(_ecm_path), "%s/stats", ECM_SYSFS_PATH);
+    {
+        FILE *_fp = fopen(_ecm_path, "w");
+        ret = _fp ? (fprintf(_fp, "RESET_ALL \n") > 0 ? (fclose(_fp), 0) : (fclose(_fp), -1)) : -1;
+    }
+    if (ret != 0) {
+        DBG_MONITOR_PRINT("[%s:%d] Failed to reset ECM stats, ret=%d\n",
+                          __FUNCTION__, __LINE__, ret);
+        return;
+    }
+    DBG_MONITOR_PRINT("[%s:%d] ECM: Reset all stats\n", __FUNCTION__, __LINE__);
+}
+
+void unregisterECMBackhaulType(void)
+{
+    int ret = 0;
+    char _ecm_path[256];
+
+    if (ANSC_STATUS_SUCCESS != isECMModuleLoaded()) {
+        DBG_MONITOR_PRINT("[%s:%d] ECM module not loaded\n", __FUNCTION__, __LINE__);
+        return;
+    }
+    snprintf(_ecm_path, sizeof(_ecm_path), "%s/interface_type", ECM_SYSFS_PATH);
+    {
+        FILE *_fp = fopen(_ecm_path, "w");
+        ret = _fp ? (fprintf(_fp, "bh_type NULL \n") > 0 ? (fclose(_fp), 0) : (fclose(_fp), -1)) : -1;
+    }
+    if (ret != 0) {
+        DBG_MONITOR_PRINT("[%s:%d] Failed to unregister ECM backhaul type, ret=%d\n",
+                          __FUNCTION__, __LINE__, ret);
+        return;
+    }
+    DBG_MONITOR_PRINT("[%s:%d] ECM: Unregistered backhaul type\n", __FUNCTION__, __LINE__);
+}
+
