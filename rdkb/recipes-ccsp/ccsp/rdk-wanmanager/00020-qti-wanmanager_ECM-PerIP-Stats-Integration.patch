     v_secure_system("iptables -t mangle -A POSTROUTING -j TRAFFIC_ACCT");
     v_secure_system("ip6tables -t mangle -A POSTROUTING -j TRAFFIC_ACCT");
+    /* Phase 2: ECM Initialization */
+    if (true == isIPALanStatEnable()) {
+        DBG_MONITOR_PRINT("[%s:%d] Phase 2: Initializing ECM for packet stats\n", __FUNCTION__, __LINE__);
+        initializeECMForPacketStats();
