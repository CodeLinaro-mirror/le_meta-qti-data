+        ifname_temp = strtok_r(NULL, " ", &saveptr);
+        strlcpy(iface_name, ifname_temp, sizeof(iface_name));
+    }
+    else
+    {
+        DBG_MONITOR_PRINT("[%s:%d] no matched mac found\n",__FUNCTION__,__LINE__);
+        if (line)
