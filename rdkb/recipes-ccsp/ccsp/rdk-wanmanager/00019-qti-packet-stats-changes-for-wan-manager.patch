+/*
+  * add the stats of disconnecting clients to dmesg
+  *
+*/
+int printStatsInDmesg(char *iface, char *addr, char *mac,char *type, char *deviceMode)
+{
+    char command[COMMAND_SIZE] = {0};
+    char client_type[IFACE_SIZE] = {0};
+    uint64_t iptables_tx_bytes = 0, iptables_rx_bytes = 0;
+    uint64_t ip6tables_tx_bytes = 0, ip6tables_rx_bytes = 0;
+    uint64_t ip6tables_total_tx_bytes = 0, ip6tables_total_rx_bytes = 0;
+    uint64_t total_tx_bytes = 0, total_rx_bytes = 0;
+    int iptables_ret = -1;
+    int ip6tables_ret = -1;
+    int err_ret = 0;
+    ssize_t nread;
+    size_t len = 0;
+    char *line = NULL;
+    FILE *fp = NULL;
+    char *ip_temp = NULL, *ptr;
+    char *ipaddr;
+    if (NULL == iface || NULL == addr || NULL == mac || NULL == deviceMode)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    if ((0 == strcmp(iface,"eth0")) || (0 == strcmp(iface,"eth1")))
+        strlcpy(client_type, "Ethernet", sizeof(client_type));
+    else if ((0 == strcmp(iface,"rndis0")) || (0 == strcmp(iface,"ecm0")))
+        strlcpy(client_type, "USB", sizeof(client_type));
+    else
+    {
+        DBG_MONITOR_PRINT("[%s:%d] client_type not available for iface (%s)\n",__FUNCTION__,__LINE__,iface);
+        return -1;
+    }
+    iptables_ret = getIPv4Stats(addr, &iptables_tx_bytes, &iptables_rx_bytes);
+    if (-1 == iptables_ret)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] getIPv4Stats failed\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    /*get iptables stat for ipv4 ip of client in dual mode or ipv4 only mode*/
+    if ((0 == strcmp(deviceMode, IPV4_MODE)) || (0 == strcmp(deviceMode, DUAL_MODE)))
+    {
+        iptables_ret = getIPv4Stats(addr, &iptables_tx_bytes, &iptables_rx_bytes);
+        if (-1 == iptables_ret)
+        {
+            DBG_MONITOR_PRINT("[%s:%d] getIPv4Stats failed\n",__FUNCTION__,__LINE__);
+            return -1;
+        }
+    }
+    /*get ip6tables stat for all ipv6 global and temporary ips of a client in dual or ipv6 mode*/
+    if ((0 == strcmp(deviceMode, IPV6_MODE)) || (0 == strcmp(deviceMode, DUAL_MODE)))
+    {
+        fp = fopen(IPV6_STATS_FILE, "r");
+        if (NULL == fp)
+        {
+            DBG_MONITOR_PRINT("[%s:%d] fopen failed\n",__FUNCTION__,__LINE__);
+            return -1;
+        }
+        line = (char *) malloc(BFR_SIZE * sizeof(char));
+        if (NULL == line)
+        {
+            DBG_MONITOR_PRINT("[%s:%d] malloc failed\n",__FUNCTION__,__LINE__);
+            fclose(fp);
+            fp = NULL;
+            return -1;
+        }
+        while ((nread = getline(&line, &len, fp)) != -1)
+        {
+            line[strlen(line) - 1] = '\0';
+            if (strlen(line) <= 0 )
+            {
+                DBG_MONITOR_PRINT("[%s:%d] getline failed\n",__FUNCTION__,__LINE__);
+                err_ret = -1;
+                break;
+            }
+            if (strstr(line, mac))
+            {
+                strtok_r(line, " ", &ptr);
+                ip_temp = strtok_r(NULL, " ", &ptr);
+                if (NULL == ip_temp)
+                {
+                    DBG_MONITOR_PRINT("[%s:%d] strtok_r failed\n",__FUNCTION__,__LINE__);
+                    err_ret = -1;
+                    break;
+                }
+                ipaddr = strstr(ip_temp, "=");
+                if (NULL == ipaddr)
+                {
+                    DBG_MONITOR_PRINT("[%s:%d] strstr failed ,no substring found\n",__FUNCTION__,__LINE__);
+                    err_ret = -1;
+                    break;
+                }
+                ip6tables_ret = getIPv6Stats(ipaddr+1, &ip6tables_tx_bytes, &ip6tables_rx_bytes);
+                if (-1 == ip6tables_ret)
+                {
+                    DBG_MONITOR_PRINT("[%s:%d] getIPv6Stats failed\n",__FUNCTION__,__LINE__);
+                    err_ret = -1;
+                    break;
+                }
+                ip6tables_total_tx_bytes += ip6tables_tx_bytes;
+                ip6tables_total_rx_bytes += ip6tables_rx_bytes;
+            }
+            ip6tables_tx_bytes = 0;
+            ip6tables_rx_bytes = 0;
+        }
+        fclose(fp);
+        fp = NULL;
+        if (line)
+        {
+            free(line);
+            line = NULL;
+        }
+        if (-1 == err_ret)
+            return err_ret;
+    }
+    total_tx_bytes = iptables_tx_bytes + ip6tables_total_tx_bytes;
+    total_rx_bytes = iptables_rx_bytes + ip6tables_total_rx_bytes;
+    v_secure_system("echo %s client, MAC:%s iptables stats RX:%lu, TX:%lu > /dev/kmsg ",client_type,mac,iptables_rx_bytes,iptables_tx_bytes);
+    v_secure_system("echo %s client, MAC:%s ip6tables stats RX:%lu, TX:%lu > /dev/kmsg ",client_type,mac,ip6tables_total_rx_bytes,ip6tables_total_tx_bytes);
+    v_secure_system("echo %s client, MAC:%s Total stats RX:%lu, TX:%lu > /dev/kmsg ",client_type,mac,total_rx_bytes,total_tx_bytes);
+    return 0;
+}
+/*
+  * add ipv4/v6 clients into a file for stats
+  * and this file will be used by firewall
+  */
+void addClientForStats(char *file,char *type,char *addr,char *ifname,char *mac_addr)
+{
+    FILE *statsfp = NULL;
+
+    if (NULL == file || NULL == type || NULL == addr || NULL ==ifname || NULL ==mac_addr)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input params NULL\n ",__FUNCTION__,__LINE__);
+        return;
+    }
+    statsfp = fopen(file, "a");
+    if (NULL == statsfp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] fopen failed\n",__FUNCTION__,__LINE__);
+        return;
+    }
+    fprintf(statsfp, "ifname=%s ",ifname);
+    fprintf(statsfp, "ip=%s ",addr);
+    fprintf(statsfp, "mac=%s\n",mac_addr);
+    fclose(statsfp);
+    if (0 == strcmp(type,"ipv4"))
+        ipv4_stat_client++;
+    else if (0 == strcmp(type,"ipv6"))
+        ipv6_stat_client++;
+}
+/*
+  * delete ipv4/v6 clients into a file for stats
+  * and this file will be used by firewall
+  */
+void delClientForStats(char *file,char *type,char *addr)
+{
+    FILE *statsfp = NULL, *tmpfp = NULL;
+    ssize_t nread;
+    size_t len = 0;
+    char *line = NULL;
+    char *ifname_temp, *mac_temp, *saveptr;
+    char *ifname, *mac;
+    int ret = -1;
+    int ret1 = -1;
+    char curWanIfname[BUFLEN_64] = {0};
+    char deviceMode[BUFLEN_8] = {0};
+    if (NULL == file || NULL == type || NULL == addr)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input params NULL\n ",__FUNCTION__,__LINE__);
+        return;
+    }
+    statsfp = fopen(file, "r");
+    if (NULL == statsfp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] statsfp fopen failed, error (%d) (%s)\n ",__FUNCTION__,__LINE__,errno,strerror(errno));
+        return;
+    }
+    syscfg_get(NULL, "last_erouter_mode", deviceMode, sizeof(deviceMode));
+
+    if ((0 == strcmp(type,"ipv6")))
+        tmpfp = fopen(IPV6_STATS_TMPFILE, "w");
+    else
+        tmpfp = fopen(STATS_TMPFILE, "w");
+    if (NULL == tmpfp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] tmpfp fopen failed, error (%d) (%s)\n ",__FUNCTION__,__LINE__,errno,strerror(errno));
+        fclose(statsfp);
+        statsfp = NULL;
+        return;
+    }
+    line = (char *) malloc(BFR_SIZE * sizeof(char));
+    if (NULL == line)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] malloc failed\n ",__FUNCTION__,__LINE__);
+        fclose(statsfp);
+        statsfp = NULL;
+        fclose(tmpfp);
+        tmpfp = NULL;
+        return;
+    }
+    while ((nread = getline(&line, &len, statsfp)) != -1)
+    {
+        line[strlen(line) - 1] = '\0';
+        if (strstr(line, addr))
+        {
+            ifname_temp = strtok_r(line, " ", &saveptr);
+            strtok_r(NULL, " ", &saveptr);
+            mac_temp = strtok_r(NULL, " ", &saveptr);
+            ifname = strstr(ifname_temp, "=");
+            mac = strstr(mac_temp, "=");
+            if (0 == strcmp(type,"ipv4"))
+            {
+                ipv4_stat_client--;
+                ret1 = printStatsInDmesg(ifname+1, addr, mac+1, type, deviceMode);
+                if (-1 == ret1)
+                {
+                    DBG_MONITOR_PRINT("[%s:%d] printStatsInDmesg failed \n ",__FUNCTION__,__LINE__);
+                }
+                ret = delIpv4Rules(addr);
+                if (-1 == ret)
+                {
+                    DBG_MONITOR_PRINT("[%s:%d] delIpv4Rules failed \n ",__FUNCTION__,__LINE__);
+                }
+            }
+            else if (0 == strcmp(type,"ipv6"))
+            {
+                ipv6_stat_client--;
+                /*check if device mode is ipv6 only mode*/
+                if (0 == strcmp(deviceMode, IPV6_MODE))
+                {
+                    ret1 = printStatsInDmesg(ifname+1, addr, mac+1, type, deviceMode);
+                    if (-1 == ret1)
+                    {
+                        DBG_MONITOR_PRINT("[%s:%d] printStatsInDmesg failed \n ",__FUNCTION__,__LINE__);
+                    }
+                }
+                ret = delIpv6Rules(addr);
+                if (-1 == ret)
+                {
+                    DBG_MONITOR_PRINT("[%s:%d] delIpv6Rules failed \n ",__FUNCTION__,__LINE__);
+                }
+            }
+            continue;
+        }
+        fprintf(tmpfp, "%s\n",line);
+    }
+    fclose(statsfp);
+    statsfp = NULL;
+    fclose(tmpfp);
+    tmpfp = NULL;
+    if (line)
+    {
+        free(line);
+        line = NULL;
+    }
+    if ((0 == strcmp(type,"ipv6")))
+        rename (IPV6_STATS_TMPFILE, IPV6_STATS_FILE);
+    else
+        rename (STATS_TMPFILE, IPV4_STATS_FILE);
+}
+/*
+  * add iptables rules for ipv4 client
+  *
+  */
+void addIpv4Rules(char *if_name, char *addr, char *mac_addr)
+{
+    int ret;
+    char curWanIfname[BUFLEN_64] = {0};
+    if ((NULL == if_name) || (NULL == addr) || (NULL == mac_addr))
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input param NULL\n ",__FUNCTION__,__LINE__);
+        return;
+    }
+    if (ipv4_stat_client > 0)
+    {
+        ret = checkStatsClient(IPV4_STATS_FILE,addr);
+        if (-1 == ret)
+        {
+            DBG_MONITOR_PRINT("[%s:%d] error opening file or invalid arguments passed\n ",__FUNCTION__,__LINE__);
+            return;
+        }
+        else if (1 == ret)
+        {
+            DBG_MONITOR_PRINT("[%s:%d] addr (%s) already present in the file\n ",__FUNCTION__,__LINE__,addr);
+            return;
+        }
+    }
+    sysevent_get(sysevent_fd, sysevent_token, "current_wan_ifname", curWanIfname, sizeof(curWanIfname));
+    if (!strcmp(curWanIfname, "\0"))
+    {
+        DBG_MONITOR_PRINT("[%s:%d] failed to get sysevent current_wan_ifname\n", __FUNCTION__,__LINE__);
+        return;
+    }
+    ret = IsIptablesRuleAdded(addr);
+    if (1 == ret)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] iptables rule already present for addr (%s)\n",__FUNCTION__, __LINE__, addr);
+        return;
+    }
+        v_secure_system("iptables -t mangle -A FORWARD -s %s -o %s -j MARK --set-xmark 0x1",addr,curWanIfname);
+        v_secure_system("iptables -t mangle -A FORWARD -d %s -i %s -j MARK --set-xmark 0x2",addr,curWanIfname);
+        v_secure_system("iptables -t mangle -A TRAFFIC_ACCT -m mark --mark 0x1 -s %s -j ACCEPT",addr);
+        v_secure_system("iptables -t mangle -A TRAFFIC_ACCT -m mark --mark 0x2 -d %s -j ACCEPT",addr);
+        addClientForStats(IPV4_STATS_FILE,"ipv4",addr,if_name,mac_addr);
+}
