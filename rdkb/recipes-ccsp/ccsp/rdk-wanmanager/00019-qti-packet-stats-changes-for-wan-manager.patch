+ /*
+  * check if ipv6 rules already added
+  *
+  */
+int IsIp6tablesRuleAdded(char* addr)
+{
+    char cmd[COMMAND_SIZE]= {0};
+    char tmp[COMMAND_SIZE]= {0};
+    FILE *fp = NULL;
+    int addr_found = 0;
+    if (NULL == addr)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    snprintf(cmd, COMMAND_SIZE,"ip6tables -t mangle -L FORWARD -n -v -x  --line-numbers -w 2");
+    strlcat(cmd, IP6TABLES_AWK_FORWARD, COMMAND_SIZE);
+    snprintf(tmp, COMMAND_SIZE, " | grep -w %s", addr);
+    strlcat(cmd, tmp, COMMAND_SIZE);
+    fp = popen(cmd,"r");
+    if (NULL == fp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] popen failed\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    if(fgetc(fp) != EOF)
+    {
+        addr_found = 1;
+    }
+    pclose(fp);
+    fp = NULL;
+    return addr_found;
+}
