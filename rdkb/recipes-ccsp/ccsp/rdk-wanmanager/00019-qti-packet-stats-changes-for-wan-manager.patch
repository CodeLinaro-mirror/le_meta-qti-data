+/*
+ * Packet-stats entry for NEWNEIGH.
+ * Common IPv6 LLA/PD file-maintenance logic is not duplicated here;
+ * AF_INET6 path reuses handle_netlink_ip6neigh_new().
+ */
+void handle_netlink_ipneigh_new(struct nlmsghdr *nlmsg, int len)
+{
+    struct ndmsg *ndm = NULL;
+    struct rtattr *tb[NDA_MAX + 1] = {NULL};
+    char addr[BUFLEN_256] = {0};
+    char interface_name[BFR_SIZE] = {0};
+    char mac_address[BFR_SIZE] = {0};
+
+    ndm = NLMSG_DATA(nlmsg);
+
+    /* Neighbor messages: parse NDA attributes */
+    parse_rtattr_pd(tb, NDA_MAX, NDA_RTA(ndm), len);
+
+    if (!tb[NDA_DST])
+        return;
+
+    if (ndm->ndm_family == AF_INET)
+    {
+        if (inet_ntop(AF_INET, RTA_DATA(tb[NDA_DST]), addr, INET_ADDRSTRLEN) == NULL)
+        {
+            DBG_MONITOR_PRINT("%s: inet_ntop(AF_INET) failed\n", __FUNCTION__);
+            return;
+        }
+        DBG_MONITOR_PRINT("RTM_NEWNEIGH len %d ip %s %d family %d IF (%u) \n",
+                          len, addr, nlmsg->nlmsg_type,
+                          ndm->ndm_family, ndm->ndm_ifindex);
+
+        if (true == isIPALanStatEnable())
+        {
+            if ((0 == getClientDetails(addr, mac_address, interface_name)) &&
+                (0 != interface_name[0]) &&
+                (0 != strcmp(mac_address, "00:00:00:00:00:00")))
+            {
+                addIpv4Rules(interface_name, addr, mac_address);
+            }
+        }
+        return;
+    }
+
+    if (ndm->ndm_family == AF_INET6)
+    {
+        /* Reuse IPv6 handler to avoid duplicating common IPv6 logic */
+        handle_netlink_ip6neigh_new(nlmsg, len);
+        return;
+    }
+
+    return;
+}
 
