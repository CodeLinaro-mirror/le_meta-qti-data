+/*
+  * create a new chain TRAFFIC_ACCT for stats
+  * and add postrouting rule
+  */
+void createStatsChain()
+{
+    v_secure_system("iptables -t mangle -N TRAFFIC_ACCT");
+    v_secure_system("ip6tables -t mangle -N TRAFFIC_ACCT");
+    v_secure_system("iptables -t mangle -A POSTROUTING -j TRAFFIC_ACCT");
+    v_secure_system("ip6tables -t mangle -A POSTROUTING -j TRAFFIC_ACCT");
+}
+/*
+  * get mac and interface name of a client
+  * update in macaddr and ifname
+  */
+int getClientDetails(char *addr, char *macaddr, char *ifname)
+{
+    ssize_t nread;
+    size_t length = 0;
+    char *line = NULL;
+    char cmd[BUFSIZE]= {0};
+    char mac_addr[BFR_SIZE] = {0};
+    char ip[BFR_SIZE] = {0};
+    char *iface_name[BFR_SIZE] = {0};
+    char *ifname_temp, *mac_addr_temp, *ip_temp, *ip1, *reach;
+    char *saveptr, *saveptr1;
+    FILE *bridge_fp = NULL;
+    FILE *ipnei_fp = NULL;
+    if (NULL == addr || NULL == macaddr || NULL == ifname)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    snprintf(cmd ,sizeof(cmd), "ip nei |grep -w %s",addr);
+    ipnei_fp = popen(cmd,"r");
+    if (NULL == ipnei_fp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] ipnei_fp NULL\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    if ((nread = getline(&line, &length, ipnei_fp)) != -1)
+    {
+        if (strlen(line) > 0)
+        {
+           line[strlen(line) - 1] = '\0';
+        }
+        else
+        {
+            DBG_MONITOR_PRINT("[%s:%d] getline failed\n",__FUNCTION__,__LINE__);
+            pclose(ipnei_fp);
+            ipnei_fp = NULL;
+            if (line)
+            {
+                free(line);
+                line = NULL;
+            }
+            return -1;
+        }
+    }
+    pclose(ipnei_fp);
+    ip_temp = strtok_r(line, " ", &saveptr);
+    if (NULL == ip_temp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] strtok_r failed\n",__FUNCTION__,__LINE__);
+        if (line)
+        {
+            free(line);
+            line = NULL;
+        }
+        return -1;
+    }
+    if (0 == strcmp(addr,ip_temp))
+    {
+        strtok_r(NULL, " ", &saveptr);
+        strtok_r(NULL, " ", &saveptr);
+        strtok_r(NULL, " ", &saveptr);
+        mac_addr_temp = strtok_r(NULL, " ", &saveptr);
+        reach = strtok_r(NULL, " ", &saveptr);
+        if (reach != NULL && strcmp(reach, "REACHABLE") == 0)
+        {
+            strlcpy(ip, addr, sizeof(ip));
+            strlcpy(mac_addr, mac_addr_temp, sizeof(mac_addr));
+        }
+        else
+        {
+            DBG_MONITOR_PRINT("[%s:%d] ip nei status not reachable for ip (%s)\n",__FUNCTION__,__LINE__,addr);
+            if (line)
+            {
+                free(line);
+                line = NULL;
+            }
+            return -1;
+        }
+    }
+    memset(cmd,0,BUFSIZE);
+    snprintf(cmd ,sizeof(cmd), "bridge fdb show | grep -v permanent | grep -i 'master brlan0' | grep %s",mac_addr);
+    bridge_fp = popen(cmd,"r");
+    if (NULL == bridge_fp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] bridge_fp NULL\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    if ((nread = getline(&line, &length, bridge_fp)) != -1)
+    {
+        if (strlen(line) > 0)
+        {
+            line[strlen(line) - 1] = '\0';
+        }
+        else
+        {
+            DBG_MONITOR_PRINT("[%s:%d] getline failed\n",__FUNCTION__,__LINE__);
+            pclose(bridge_fp);
+            bridge_fp = NULL;
+            if (line)
+            {
+                free(line);
+                line = NULL;
+            }
+            return -1;
+        }
+    }
+    pclose(bridge_fp);
+    bridge_fp = NULL;
+    mac_addr_temp = strtok_r(line, " ", &saveptr);
+    if (NULL == mac_addr_temp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] strtok_r failed\n",__FUNCTION__,__LINE__);
+        if (line)
+        {
+           free(line);
+           line = NULL;
+        }
+        return -1;
+    }
+    if (0 == strcmp(mac_addr_temp,mac_addr))
