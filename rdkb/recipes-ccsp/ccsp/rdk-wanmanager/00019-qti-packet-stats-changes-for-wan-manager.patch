+/*
+  * To get interface details from bridge fdb show
+  * update in if_name
+  */
+int get_interface_details(char *if_name , uint if_index)
+{
+    char cmd[BUFSIZE]= {0};
+    char cmd2[BUFSIZE]={0};
+    FILE *fp = NULL;
+    snprintf(cmd ,sizeof(cmd), "bridge fdb show | grep -m 1 -v permanent | grep -i 'master brlan0' | awk '{print$3}'");
+    fp=popen(cmd,"r");
+    if (fp == NULL)
+    {
+        return -1;
+    }
+    if (NULL != fgets(cmd2,100,fp))
+    {
+        strlcpy(if_name,cmd2,sizeof(cmd2));
+    }
+    pclose(fp);
+    fp = NULL;
+    return 0;
