+    strlcpy(ifname, iface_name, (strlen(iface_name)+1));
+    if (line)
+    {
+        free(line);
+        line = NULL;
+    }
+    return 0;
+}
+/*
+  * check if the client addr is already added
+  * return -1:error 1:if present 0:if not present
+  */
+int checkStatsClient(char *file,char *addr)
+{
+    ssize_t nread;
+    size_t len = 0;
+    char *line = NULL;
+    FILE *statsfp = NULL;
+    int retval = -1;
+    char *ipaddr = NULL, *iface_name = NULL, *ptr, *ip;
+
+    if (NULL == file || NULL == addr)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input params NULL\n ",__FUNCTION__,__LINE__);
+        return retval;
+    }
+    statsfp = fopen(file, "r");
+    if (NULL == statsfp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] fopen failed, error (%d) (%s)\n ",__FUNCTION__,__LINE__,errno,strerror(errno));
+        return retval;
+    }
+
+    line = (char *) malloc(BFR_SIZE * sizeof(char));
+    if (NULL == line)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] malloc failed\n ",__FUNCTION__,__LINE__);
+        fclose(statsfp);
+        statsfp = NULL;
+        return retval;
+    }
+    while ((nread = getline(&line, &len, statsfp)) != -1)
+    {
+        line[strlen(line) - 1] = '\0';
+        iface_name = strtok_r(line, " ", &ptr);
+        ipaddr = strtok_r(NULL, " ", &ptr);
+        if (NULL == ipaddr)
+        {
+            DBG_MONITOR_PRINT("[%s:%d] strtok_r failed\n",__FUNCTION__,__LINE__);
+            return retval;
+        }
+        ip = strstr(ipaddr, "=");
+        if (NULL != ip)
+        {
+            if (0 == strcmp(ip+1,addr))
+            {
+                retval = 1;
+                break;
+            }
+            else
+            {
+                retval = 0;
+                DBG_MONITOR_PRINT("[%s:%d] addr (%s) NOT available\n",__FUNCTION__,__LINE__,addr);
+            }
+        }
+    }
+    fclose(statsfp);
+    statsfp = NULL;
+    if(line)
+    {
+        free(line);
+        line = NULL;
+    }
+    return retval;
+}
+/*
+  * check if ipv4 rules already added
+  *
+  */
+int IsIptablesRuleAdded(char* addr)
+{
+    char cmd[COMMAND_SIZE]= {0};
+    char tmp[COMMAND_SIZE]= {0};
+    FILE *fp = NULL;
+    int addr_found = 0;
+
+    if (NULL == addr)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    snprintf(cmd, COMMAND_SIZE,"iptables -t mangle -L FORWARD -n -v -x  --line-numbers -w 2");
+    strlcat(cmd, IPTABLES_AWK_FORWARD, COMMAND_SIZE);
+    snprintf(tmp, COMMAND_SIZE, " | grep -w %s", addr);
+    strlcat(cmd, tmp, COMMAND_SIZE);
+
+    fp = popen(cmd,"r");
+    if (NULL == fp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] popen failed\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    if(fgetc(fp) != EOF)
+    {
+        addr_found = 1;
+    }
+    pclose(fp);
+    fp = NULL;
+    return addr_found;
+}
+/*
+  * get iptables rx and tx bytes for disconnecting clients
+  *
+  */
+int getIPv4Stats(char *ipv4addr, uint64_t *tx_bytes, uint64_t *rx_bytes)
+{
+    ssize_t nread;
+    size_t length = 0;
+    unsigned int mark_val = 0;
+    char *stringline = NULL;
+    char cmd[COMMAND_SIZE]= {0};
+    char tmp[COMMAND_SIZE]= {0};
+    char *line_number = NULL,*bytes=NULL,*saddr=NULL, *daddr=NULL, *mark=NULL,*ptr;
+    FILE *fp = NULL;
+    if (NULL == ipv4addr || NULL == tx_bytes || NULL == rx_bytes)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] input param NULL\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    snprintf(cmd, COMMAND_SIZE,"iptables -t mangle -L TRAFFIC_ACCT -n -v -x  --line-numbers -w 2");
+    strlcat(cmd, IPTABLES_AWK_STATS, COMMAND_SIZE);
+    snprintf(tmp, COMMAND_SIZE, " | grep -i %s", ipv4addr);
+    strlcat(cmd, tmp, COMMAND_SIZE);
+    fp = popen(cmd,"r");
+    if (NULL == fp)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] popen failed\n",__FUNCTION__,__LINE__);
+        return -1;
+    }
+    stringline = (char *)malloc(BFR_SIZE * sizeof(char));
+    if (NULL == stringline)
+    {
+        DBG_MONITOR_PRINT("[%s:%d] malloc failed\n",__FUNCTION__,__LINE__);
+        pclose(fp);
+        return -1;
+    }
+    while ((nread = getline(&stringline, &length, fp)) != -1)
+    {
+        if (strlen(stringline) > 0)
+        {
+            stringline[strlen(stringline) - 1] = '\0';
+        }
+        else
+        {
+            DBG_MONITOR_PRINT("[%s:%d] getline faied, string length 0\n",__FUNCTION__,__LINE__);
+            pclose(fp);
+            fp = NULL;
+            if (stringline)
+            {
+                free(stringline);
+                stringline = NULL;
+            }
+            return -1;
+        }
+        line_number = strtok_r(stringline, ",", &ptr);
+        bytes = strtok_r(NULL, ",", &ptr);
+        saddr = strtok_r(NULL, ",", &ptr);
+        daddr = strtok_r(NULL, ",", &ptr);
+        mark = strtok_r(NULL, ",", &ptr);
+
+        if ((NULL == mark) || (NULL == bytes))
+        {
+            DBG_MONITOR_PRINT("[%s:%d] mark or bytes are NULL\n",__FUNCTION__,__LINE__);
+            pclose(fp);
+            fp = NULL;
+            if (stringline)
+            {
+                free(stringline);
+                stringline = NULL;
+            }
+            return -1;
+        }
+        mark_val = strtoull(mark,&ptr,16);
+        if (mark_val%2 == 0)
+        {
+            *rx_bytes = strtoull(bytes,&ptr,10);
+        }
+        else
+        {
+            *tx_bytes = strtoull(bytes,&ptr,10);
+        }
+    }
+    pclose(fp);
+    fp = NULL;
+    if (NULL != stringline)
+    {
+        free(stringline);
+        stringline = NULL;
+    }
+    return 0;
+}
