+/*
+ *Handle the "ipv6 nd managed-client-prefix-flag" configuration in zebra.conf
+ */
+DEFUN (ipv6_nd_managed_client_prefix_flag,
+       ipv6_nd_managed_client_prefix_flag_cmd,
+       "ipv6 nd managed-client-prefix-flag",
+       "Interface IPv6 config commands\n"
+       "Neighbor discovery\n"
+       "Managed client prefix configuration flag\n")
+{
+  struct interface *ifp;
+  struct zebra_if *zif;
+
+  ifp = (struct interface *) vty->index;
+  zif = ifp->info;
+
+  zif->rtadv.AdvManagedClientPrefixFlag = 1;
+  zlog_debug(" rtadv.AdvManagedClientPrefixFlag set \n");
+
+  if(zif->rtadv.AdvManagedClientPrefixFlag)
+  {
+     struct zebra_vrf *zvrf = vrf_info_lookup (ifp->vrf_id);
+     if (zvrf == NULL)
+         return CMD_SUCCESS;
+     inittime_rtadv_send_packet (zvrf, ifp);
+  }
+
+  return CMD_SUCCESS;
+}
+
+/*
+ *Handle the "no ipv6 nd managed-client-prefix-flag" configuration in zebra.conf
+ */
+DEFUN (no_ipv6_nd_managed_client_prefix_flag,
+       no_ipv6_nd_managed_client_prefix_flag_cmd,
+       "no ipv6 nd managed-client-prefix-flag",
+       NO_STR
+       "Interface IPv6 config commands\n"
+       "Neighbor discovery\n"
+       "Managed client prefix configuration flag\n")
+{
+  struct interface *ifp;
+  struct zebra_if *zif;
+
+  ifp = (struct interface *) vty->index;
+  zif = ifp->info;
+
+  zif->rtadv.AdvManagedClientPrefixFlag = 0;
+
+  return CMD_SUCCESS;
+}
+
 
