+/*
+ *This function handle the events when the ipv6 client
+ *removed from the device and release the allocated prefix of client
+ *
+ */
+static int
+handle_netlink_ipneigh_del(struct nlmsghdr *nlmsg, int len)
+{
+        struct ndmsg *ndm;
+        struct rtattr *tb[NDA_MAX + 1];
+        char buffer[PREFIX_STRLEN]={0};
+
+        ndm = NLMSG_DATA(nlmsg);
+
+        /* Parse attributes and extract fields of interest. */
+        netlink_parse_rtattr(tb, NDA_MAX, NDA_RTA(ndm), len);
+
+        if (!tb[NDA_DST]) {
+                zlog_debug("RTL_DELNEIGH %d family %d IF (%u) - no DST",
+                           nlmsg->nlmsg_type,
+                           ndm->ndm_family,
+                           ndm->ndm_ifindex);
+                return 0;
+        }
+
+        inet_ntop(AF_INET6,RTA_DATA(tb[NDA_DST]),buffer,INET6_ADDRSTRLEN);
+        zlog_debug("RTL_DELNEIGH len %d ip %s %d family %d IF (%u)",
+                   len, buffer, nlmsg->nlmsg_type, ndm->ndm_family, ndm->ndm_ifindex);
+        prefix_release(ndm->ndm_ifindex, buffer);
+        return 0;
+}
+
 static int
 netlink_link_change (struct sockaddr_nl *snl, struct nlmsghdr *h,
     vrf_id_t vrf_id)
@@ -1244,7 +1284,8 @@ netlink_information_fetch (struct sockad
       zlog ( NULL, LOG_ERR, "Ignoring message from pid %u", snl->nl_pid );
       return 0;
     }
-
+  struct ndmsg *ndm;
+  int len;
   switch (h->nlmsg_type)
     {
     case RTM_NEWROUTE:
@@ -1265,6 +1306,15 @@ netlink_information_fetch (struct sockad
     case RTM_DELADDR:
       return netlink_interface_addr (snl, h, vrf_id);
       break;
+    case RTM_DELNEIGH:
+      len = h->nlmsg_len - NLMSG_LENGTH(sizeof(struct ndmsg));
+      if (len < 0)
+          return -1;
+      ndm = NLMSG_DATA(h);
+      if (ndm->ndm_family != AF_INET6)// only requires IPV6 neighbor deletion details
+          return 0;
+      return handle_netlink_ipneigh_del(h, len);
+      break;
     default:
       zlog_warn ("Unknown netlink nlmsg_type %d vrf %u\n", h->nlmsg_type,
                  vrf_id);
